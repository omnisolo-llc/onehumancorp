load("@rules_shell//shell:sh_test.bzl", "sh_test")

# ── TypeScript compile check ───────────────────────────────────────────────────
# Verifies that the Playwright spec file and playwright.config.ts compile
# without errors.  Runs as part of `bazel test //...` without needing a live
# server or browser.
sh_test(
    name = "e2e_typecheck_test",
    srcs = ["typecheck_test.sh"],
    data = glob([
        "*.ts",
        "*.d.ts",
        "*.json",
    ]),
)

# ── Full Playwright E2E suite ──────────────────────────────────────────────────
# Runs the complete 80-test Playwright suite against a live docker-compose stack.
# Requires:  docker, docker compose, and network access to localhost:8080.
# Run with:  bazel test //tests/e2e:e2e_playwright_test
sh_test(
    name = "e2e_playwright_test",
    size = "large",
    srcs = ["playwright_test.sh"],
    data = glob([
        "*.ts",
        "*.d.ts",
        "*.json",
    ]) + [
        "//deploy:docker-compose.yml",
    ],
    tags = [
        "large",
        "manual",
        "no-remote-exec",
        "requires-docker",
    ],
)
