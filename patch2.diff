+// startTokenBurnRateEngine calculates the token burn rate forecast periodically.
+func (h *Hub) startTokenBurnRateEngine(ctx context.Context) {
+	ticker := time.NewTicker(1 * time.Minute)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			h.tokenUsageMu.Lock()
+			usage := h.tokenUsageWindow["default"]
+			h.tokenUsageWindow["default"] = 0
+			h.tokenUsageMu.Unlock()
+
+			// Extrapolate to tokens per minute (rate is usage over 1 min)
+			burnRate := float64(usage)
+			// Update the metric
+			telemetry.RecordTokenBurnRate(ctx, "default", burnRate)
+		}
+	}
+}
