    pub fn consume_tokens(&self, amount: usize) -> Result<(), String> {
        let mut current = self.token_budget.load(Ordering::SeqCst);
        loop {
            if current < amount {
                return Err("Token budget exceeded".to_string());
            }
            match self.token_budget.compare_exchange_weak(
                current,
                current - amount,
                Ordering::SeqCst,
                Ordering::Relaxed,
            ) {
                Ok(_) => return Ok(()),
                Err(val) => current = val,
            }
        }
