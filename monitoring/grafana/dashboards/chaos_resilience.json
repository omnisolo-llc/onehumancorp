{
  "title": "Chaos Resilience Dashboard",
  "panels": [
    {
      "title": "Chaos Events Injected",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ohc_chaos_injected_total[5m])) by (EnvMode)",
          "legendFormat": "{{EnvMode}} Chaos Events"
        }
      ]
    },
    {
      "title": "Task Recovery Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ohc_task_recovery_time_ms_bucket[5m])) by (le, EnvMode))",
          "legendFormat": "{{EnvMode}} Recovery Time (p95 ms)"
        }
      ]
    },
    {
      "title": "Sandbox Violations",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ohc_sandbox_violation_total[5m])) by (EnvMode)",
          "legendFormat": "{{EnvMode}} Violations"
        }
      ]
    }
  ]
}
