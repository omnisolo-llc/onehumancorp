{
  "title": "Chaos Resilience Dashboard",
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 3
      },
      "id": 9999,
      "options": {
        "content": "<style>\n  .grafana-app {\n      backdrop-filter: blur(20px) saturate(200%) !important;\n      background: rgba(255, 255, 255, 0.03) !important;\n      font-family: 'Outfit', 'Inter', sans-serif !important;\n  }\n  .panel-container {\n      backdrop-filter: blur(20px) saturate(200%);\n      background: rgba(255, 255, 255, 0.03) !important;\n      font-family: 'Outfit', 'Inter', sans-serif !important;\n      border-radius: 12px !important;\n      border: 1px solid rgba(255, 255, 255, 0.1) !important;\n  }\n</style>\n<div style=\"backdrop-filter: blur(20px) saturate(200%); font-family: Outfit, Inter; padding: 10px; border-radius: 8px; color: #fff; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);\">OHC Premium Infrastructure Dashboard</div>",
        "mode": "html"
      }
    },
    {
      "title": "Chaos Events Injected",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ohc_chaos_injected_total[5m])) by (EnvMode)",
          "legendFormat": "{{EnvMode}} Chaos Events"
        }
      ]
    },
    {
      "title": "Task Recovery Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ohc_task_recovery_time_ms_bucket[5m])) by (le, EnvMode))",
          "legendFormat": "{{EnvMode}} Recovery Time (p95 ms)"
        }
      ]
    },
    {
      "title": "Sandbox Violations",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ohc_sandbox_violation_total[5m])) by (EnvMode)",
          "legendFormat": "{{EnvMode}} Violations"
        }
      ]
    }
  ]
}