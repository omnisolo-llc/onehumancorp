{
  "title": "Chaos Resilience Dashboard",
  "panels": [
    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 999999,
      "options": {
        "content": "<style>\n  .panel-container {\n    backdrop-filter: blur(20px) saturate(200%);\n    background: rgba(255, 255, 255, 0.03) !important;\n    border-radius: 12px;\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    font-family: 'Outfit', 'Inter', sans-serif !important;\n  }\n</style>\n<div class=\"panel-container\" style=\"font-size: 24px; font-weight: bold; text-align: center; color: white; padding: 10px;\">\n  OHC Premium Telemetry\n</div>",
        "mode": "html"
      },
      "type": "text",
      "transparent": true
    },
    {
      "title": "Chaos Events Injected",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ohc_chaos_injected_total[5m])) by (EnvMode)",
          "legendFormat": "{{EnvMode}} Chaos Events"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 3
      }
    },
    {
      "title": "Task Recovery Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ohc_task_recovery_time_ms_bucket[5m])) by (le, EnvMode))",
          "legendFormat": "{{EnvMode}} Recovery Time (p95 ms)"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      }
    },
    {
      "title": "Sandbox Violations",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ohc_sandbox_violation_total[5m])) by (EnvMode)",
          "legendFormat": "{{EnvMode}} Violations"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      }
    }
  ]
}