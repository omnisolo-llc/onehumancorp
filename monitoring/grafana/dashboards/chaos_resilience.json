{
  "title": "Chaos Resilience Dashboard",
  "panels": [
    {
      "type": "text",
      "title": "OHC Premium CSS",
      "options": {
        "content": "<style>\n/* OHC premium CSS tokens */\n:root {\n  --ohc-glass-bg: rgba(255, 255, 255, 0.1);\n  --ohc-glass-border: rgba(255, 255, 255, 0.2);\n  --ohc-glass-blur: blur(10px);\n}\n.panel-container {\n  background: var(--ohc-glass-bg) !important;\n  backdrop-filter: var(--ohc-glass-blur) !important;\n  border: 1px solid var(--ohc-glass-border) !important;\n  border-radius: 12px !important;\n}\n</style>",
        "mode": "html"
      },
      "gridPos": { "h": 2, "w": 2, "x": 0, "y": 0 }
    },
    {
      "title": "Chaos Events Injected",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ohc_chaos_injected_total[5m])) by (EnvMode)",
          "legendFormat": "{{EnvMode}} Chaos Events"
        }
      ]
    },
    {
      "title": "Task Recovery Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ohc_task_recovery_time_ms_bucket[5m])) by (le, EnvMode))",
          "legendFormat": "{{EnvMode}} Recovery Time (p95 ms)"
        }
      ]
    },
    {
      "title": "Sandbox Violations",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ohc_sandbox_violation_total[5m])) by (EnvMode)",
          "legendFormat": "{{EnvMode}} Violations"
        }
      ]
    }
  ]
}
