{
  "title": "LLM Provider Health",
  "uid": "llm-provider-health",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "Cost",
    "OHC",
    "Observability",
    "Provider"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 3
      },
      "id": 9999,
      "options": {
        "content": "<style>\n  .grafana-app {\n      backdrop-filter: blur(20px) saturate(200%) !important;\n      background: rgba(255, 255, 255, 0.03) !important;\n      font-family: 'Outfit', 'Inter', sans-serif !important;\n  }\n  .panel-container {\n      backdrop-filter: blur(20px) saturate(200%);\n      background: rgba(255, 255, 255, 0.03) !important;\n      font-family: 'Outfit', 'Inter', sans-serif !important;\n      border-radius: 12px !important;\n      border: 1px solid rgba(255, 255, 255, 0.1) !important;\n  }\n</style>\n<div style=\"backdrop-filter: blur(20px) saturate(200%); font-family: Outfit, Inter; padding: 10px; border-radius: 8px; color: #fff; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);\">OHC Premium Infrastructure Dashboard</div>",
        "mode": "html"
      }
    },
    {
      "type": "timeseries",
      "title": "Total Tokens by Tenant",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(ohc_tenant_token_usage_total[5m])) by (tenant_id)",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "transparent": true
    },
    {
      "type": "timeseries",
      "title": "Agent Cost",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(ohc_agent_cost[5m])) by (organization_id)",
          "legendFormat": "{{organization_id}}",
          "refId": "A"
        }
      ],
      "transparent": true
    },
    {
      "type": "timeseries",
      "title": "API Response Latency",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(ohc_swarm_job_latency_by_entity_seconds_sum[5m]) / rate(ohc_swarm_job_latency_by_entity_seconds_count[5m])",
          "legendFormat": "Latency - {{entity}}",
          "refId": "A"
        }
      ],
      "transparent": true
    },
    {
      "type": "timeseries",
      "title": "API Call Costs",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(ohc_api_call_cost[5m])) by (entity)",
          "legendFormat": "{{entity}}",
          "refId": "A"
        }
      ],
      "transparent": true
    }
  ]
}