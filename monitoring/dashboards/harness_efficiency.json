{
  "title": "Harness Efficiency Dashboard",
  "panels": [
    {
      "type": "text",
      "title": "OHC Visual Excellence",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "content": "<div style=\"backdrop-filter: blur(15px) saturate(200%); background: rgba(255, 255, 255, 0.03); font-family: 'Outfit', 'Inter', sans-serif; padding: 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); color: #fff;\"><h1>OHC Infra Observability</h1><p>Premium CSS Tokens Applied</p></div>",
        "mode": "html"
      }
    },
    {
      "type": "text",
      "title": "OHC Aesthetics",
      "id": 1,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "options": {
        "mode": "html",
        "content": "<style>\n  .grafana-app {\n      backdrop-filter: blur(20px) saturate(200%) !important;\n      background: rgba(255, 255, 255, 0.03) !important;\n      font-family: 'Outfit', 'Inter', sans-serif !important;\n  }\n</style>"
      },
      "transparent": true
    },
    {
      "title": "Harness Init Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(harness_init_latency_seconds_bucket[5m])) by (le, deployment_mode))",
          "legendFormat": "{{deployment_mode}} Init Latency (p95)"
        }
      ]
    },
    {
      "title": "Harness DB I/O Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(harness_db_io_latency_seconds_bucket[5m])) by (le, deployment_mode, operation))",
          "legendFormat": "{{deployment_mode}} {{operation}} Latency (p95)"
        }
      ]
    }
  ]
}