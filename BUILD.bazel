load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@gazelle//:def.bzl", "gazelle")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

npm_link_all_packages(name = "node_modules")

exports_files(["tsconfig.json"])

# Plugin and rule infrastructure for protobuf TypeScript generation in bazel/rules

# Fix for misplaced alias error with rules_nodejs
filegroup(
    name = "node_fixed",
    srcs = ["@nodejs//:node"],
    visibility = ["//visibility:public"],
)

# gazelle:prefix github.com/onehumancorp/mono
exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "pubspec.yaml",
    "playwright.config.ts",
    "package.json",
    "package-lock.json",
])

config_setting(
    name = "linux",
    constraint_values = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "macos",
    constraint_values = ["@platforms//os:macos"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
)

alias(
    name = "buildifier",
    actual = "@buildifier_prebuilt//:buildifier",
    visibility = ["//visibility:public"],
)

alias(
    name = "buildozer",
    actual = "@buildifier_prebuilt//:buildozer",
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "cargo",
    srcs = ["//scripts:cargo_from_toolchain.sh"],
    args = [
        "$(rootpath @rules_rust//rust/toolchain:current_cargo_files)",
        "$(rootpath @rules_rust//rust/toolchain:current_rustc_files)",
    ],
    data = [
        "@rules_rust//rust/toolchain:current_cargo_files",
        "@rules_rust//rust/toolchain:current_rust_toolchain",
        "@rules_rust//rust/toolchain:current_rustc_files",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

alias(
    name = "rust_lint",
    actual = "//scripts:rust_lint",
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "deploy_dev",
    srcs = ["//deploy:deploy_dev.sh"],
    data = [
        "//deploy:docker-compose.yml",
        "//deploy:server_load",
        "//deploy:setup_k8s.sh",
    ],
    tags = ["manual"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

filegroup(
    name = "docs_srcs",
    srcs = glob([
        "docs/**",
    ]) + [
        "mkdocs.yml",
    ],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "docs_build",
    srcs = ["docs/mkdocs_via_bazel.sh"],
    args = ["build"],
    data = [":docs_srcs"],
    tags = ["manual"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

sh_binary(
    name = "docs_serve",
    srcs = ["docs/mkdocs_via_bazel.sh"],
    args = ["serve"],
    data = [":docs_srcs"],
    tags = ["manual"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

sh_binary(
    name = "update-deps",
    srcs = ["update_deps.sh"],
    data = [
        "MODULE.bazel",
    ],
    tags = ["manual"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

# Alias to run hello-world agent easily
alias(
    name = "hello-world",
    actual = "//src/examples/hello-world-agent:hello-world",
    tags = ["manual"],
)

# gazelle:prefix onehumancorp
gazelle(name = "gazelle")
