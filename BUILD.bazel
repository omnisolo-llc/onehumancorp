# Unified Development target (Backend + Flutter Web)
# This is a pure-Bazel orchestrator that launches both components concurrently.
genrule(
    name = "gen_dev_sh",
    outs = ["dev_generated.sh"],
    cmd = """
cat << 'EOF' > $@
#!/usr/bin/env bash
# Pure-Bazel development orchestrator
set -e
trap 'kill $$(jobs -p)' EXIT

# Start backend (API Server)
echo "--- Starting Go Backend (8080) ---"
./srcs/server/ohc &

# Give the backend a moment to bind its port
sleep 1

# Start Flutter Web Client
echo "--- Starting Flutter Web Client (8081) ---"
cd srcs/app
# We use flutter run -d chrome for the best developer experience (hot restart).
flutter run -d chrome --web-port 8081
EOF
""",
)

sh_binary(
    name = "dev",
    srcs = [":gen_dev_sh"],
    data = [
        "//srcs/app:srcs",
        "//srcs/server:ohc",
    ],
    tags = ["manual"],
)

# Unified Desktop target (Standalone Mode)
# This launches the Flutter app in native mode, which then manages its own backend.
genrule(
    name = "gen_desktop_sh",
    srcs = [
        "@flutter_sdk//:flutter_binary_unix",
        "@flutter_sdk//:flutter_binary_windows",
    ],
    outs = ["desktop_generated.sh"],
    cmd = """
FLUTTER_UNIX="$(rootpath @flutter_sdk//:flutter_binary_unix)"
FLUTTER_WIN="$(rootpath @flutter_sdk//:flutter_binary_windows)"

cat << 'EOF' > $@
#!/usr/bin/env bash
# Standalone Desktop App orchestrator
set -e

# Support for the app to manage its own backend lifecycle.
# Expose the standalone wrapper as `ohc` so the app can start/stop/doctor the backend.
OHC_BIN_DIR="$$(mktemp -d)"
trap 'rm -rf "$$OHC_BIN_DIR"' EXIT
ln -sf "$$PWD/srcs/server/standalone_ohc_exec" "$$OHC_BIN_DIR/ohc"
export PATH="$$OHC_BIN_DIR:$$PATH"

# Detect platform if not explicitly provided
PLATFORM="auto"
if [ "$$PLATFORM" = "auto" ]; then
  case "$$(uname -s)" in
    Linux*)     PLATFORM=linux;;
    Darwin*)    PLATFORM=macos;;
    MSYS*|MINGW*|CYGWIN*) PLATFORM=windows;;
    *)          PLATFORM=linux;;
  esac
fi

# Enable Standalone Mode via dart-define so the app knows to start its backend.
echo "--- Starting OHC Desktop App (Standalone Mode, Platform: $$PLATFORM) ---"

# Resolve the Flutter binary to use.
# FLUTTER_BIN_OVERRIDE may be set by tests (or tooling) to point to a
# custom/fake Flutter executable.  When not set, the hermetic SDK binary that
# was baked into this launcher at build time is used.
if [[ -n "$${FLUTTER_BIN_OVERRIDE:-}" ]]; then
  FLUTTER_CMD="$${FLUTTER_BIN_OVERRIDE}"
elif [[ "$$PLATFORM" == "windows" ]]; then
  FLUTTER_CMD="../../REPLACE_ME_WIN"
else
  FLUTTER_CMD="../../REPLACE_ME_UNIX"
fi

cd srcs/app
"$${FLUTTER_CMD}" run -d "$$PLATFORM" --dart-define=OHC_STANDALONE=true
EOF
sed -i "s|REPLACE_ME_UNIX|$$FLUTTER_UNIX|g" $@
sed -i "s|REPLACE_ME_WIN|$$FLUTTER_WIN|g" $@
""",
)

