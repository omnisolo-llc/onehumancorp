load("@gazelle//:def.bzl", "gazelle")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

npm_link_all_packages(name = "node_modules")

exports_files(["tsconfig.json"])

# gazelle:prefix github.com/onehumancorp/mono
exports_files([
    "go.mod",
    "go.sum",
    "pubspec.yaml",
])

# gazelle:exclude srcs/proto
# gazelle:resolve go github.com/onehumancorp/mono/srcs/proto //srcs/proto:hub_go_proto
gazelle(name = "gazelle")

config_setting(
    name = "linux",
    constraint_values = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "macos",
    constraint_values = ["@platforms//os:macos"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
)


gazelle(
    name = "gazelle-update-repos",
    args = [
        "-from_file=go.mod",
        "-to_macro=repositories.bzl%go_repositories",
        "-prune",
    ],
    command = "update-repos",
)

sh_binary(
    name = "deploy_dev",
    srcs = ["//deploy:deploy_dev.sh"],
    data = [
        "//deploy:backend_load",
        "//deploy:docker-compose.yml",
        "//deploy:frontend_load",
        "//deploy:setup_k8s.sh",
    ],
    tags = ["manual"],
)

# Unified Development target (Backend + Flutter Web)
# This is a pure-Bazel orchestrator that launches both components concurrently.
genrule(
    name = "gen_dev_sh",
    outs = ["dev_generated.sh"],
    cmd = """
cat << 'EOF' > $@
#!/usr/bin/env bash
# Pure-Bazel development orchestrator
set -e
trap 'kill $$(jobs -p)' EXIT

# Start backend (API Server)
echo "--- Starting Go Backend (8080) ---"
./srcs/server/ohc &

# Give the backend a moment to bind its port
sleep 1

# Start Flutter Web Client
echo "--- Starting Flutter Web Client (8081) ---"
cd srcs/app
# We use flutter run -d chrome for the best developer experience (hot restart).
flutter run -d chrome --web-port 8081
EOF
""",
)

sh_binary(
    name = "dev",
    srcs = [":gen_dev_sh"],
    data = [
        "//srcs/app:srcs",
        "//srcs/server:ohc",
    ],
    tags = ["manual"],
)

# Unified Desktop target (Standalone Mode)
# This launches the Flutter app in native mode, which then manages its own backend.
genrule(
    name = "gen_desktop_sh",
    outs = ["desktop_generated.sh"],
    cmd = """
cat << 'EOF' > $@
#!/usr/bin/env bash
# Standalone Desktop App orchestrator
set -e

# Support for the app to manage its own backend lifecycle.
# The ohc binary must be in the PATH.
export PATH=$$PWD/srcs/server:$$PATH

# Detect platform if not explicitly provided
PLATFORM="auto"
if [ "$$PLATFORM" = "auto" ]; then
  case "$$(uname -s)" in
    Linux*)     PLATFORM=linux;;
    Darwin*)    PLATFORM=macos;;
    MSYS*|MINGW*|CYGWIN*) PLATFORM=windows;;
    *)          PLATFORM=linux;;
  esac
fi

# Enable Standalone Mode via dart-define so the app knows to start its backend.
echo "--- Starting OHC Desktop App (Standalone Mode, Platform: $$PLATFORM) ---"
cd srcs/app
flutter run -d "$$PLATFORM" --dart-define=OHC_STANDALONE=true
EOF
""",
)



sh_binary(
    name = "desktop",
    srcs = [":gen_desktop_sh"],
    data = [
        "//srcs/server:ohc",
        "//srcs/app:srcs",
    ] + select({
        ":linux": ["//srcs/app:app.linux"],
        ":macos": ["//srcs/app:app.macos"],
        ":windows": ["//srcs/app:app.windows"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
)


# Alias to start the standalone desktop environment quickly.
alias(
    name = "up-desktop",
    actual = ":desktop",
)


# Alias to start the local developer environment quickly.
alias(
    name = "up",
    actual = ":deploy_dev",
)

# Alias to start the primary Flutter Web Gateway
alias(
    name = "start-web",
    actual = "//srcs/app:start",
    visibility = ["//visibility:public"],
)

# Alias to start the Flutter app (Web)
alias(
    name = "start-app",
    actual = "//srcs/app:start",
    visibility = ["//visibility:public"],
)

# Alias to start the backend (Go)
alias(
    name = "start-backend",
    actual = "//srcs/server:ohc",
    visibility = ["//visibility:public"],
)

# Alias to run tests
alias(
    name = "e2e",
    actual = "//deploy:kind_e2e_test",
    visibility = ["//visibility:public"],
)

# Alias to run hello-world agent easily
alias(
    name = "hello-world",
    actual = "//examples/hello-world-agent:hello-world",
)
