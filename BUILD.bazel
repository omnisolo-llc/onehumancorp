load("@gazelle//:def.bzl", "gazelle")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

npm_link_all_packages(name = "node_modules")

exports_files(["tsconfig.json"])

# gazelle:prefix github.com/onehumancorp/mono
exports_files([
    "go.mod",
    "go.sum",
    "pubspec.yaml",
])

# gazelle:exclude srcs/proto
# gazelle:resolve go github.com/onehumancorp/mono/srcs/proto //srcs/proto:hub_go_proto
gazelle(name = "gazelle")

gazelle(
    name = "gazelle-update-repos",
    args = [
        "-from_file=go.mod",
        "-to_macro=repositories.bzl%go_repositories",
        "-prune",
    ],
    command = "update-repos",
)

sh_binary(
    name = "deploy_dev",
    srcs = ["//deploy:deploy_dev.sh"],
    data = [
        "//deploy:backend_load",
        "//deploy:docker-compose.yml",
        "//deploy:frontend_load",
        "//deploy:setup_k8s.sh",
    ],
    tags = ["manual"],
)

# Unified Development target (Backend + Flutter Web)
# This is a pure-Bazel orchestrator that launches both components concurrently.
genrule(
    name = "gen_dev_sh",
    outs = ["dev_generated.sh"],
    cmd = """
cat << 'EOF' > $@
#!/usr/bin/env bash
# Pure-Bazel development orchestrator
set -e
trap 'kill $$(jobs -p)' EXIT

# Start backend (API Server)
echo "--- Starting Go Backend (8080) ---"
./srcs/server/ohc &

# Give the backend a moment to bind its port
sleep 1

# Start Flutter Web Client
echo "--- Starting Flutter Web Client (8081) ---"
cd srcs/app
# We use flutter run -d chrome for the best developer experience (hot restart).
flutter run -d chrome --web-port 8081
EOF
""",
)

sh_binary(
    name = "dev",
    srcs = [":gen_dev_sh"],
    data = [
        "//srcs/app:srcs",
        "//srcs/server:ohc",
    ],
    tags = ["manual"],
)

# Alias to start the local developer environment quickly.
alias(
    name = "up",
    actual = ":deploy_dev",
)

# Alias to start the primary Flutter Web Gateway
alias(
    name = "start-web",
    actual = "//srcs/app:start",
    visibility = ["//visibility:public"],
)

# Alias to start the Flutter app (Web)
alias(
    name = "start-app",
    actual = "//srcs/app:start",
    visibility = ["//visibility:public"],
)

# Alias to start the backend (Go)
alias(
    name = "start-backend",
    actual = "//srcs/server:ohc",
    visibility = ["//visibility:public"],
)

# Alias to run tests
alias(
    name = "e2e",
    actual = "//deploy:kind_e2e_test",
    visibility = ["//visibility:public"],
)

# Alias to run hello-world agent easily
alias(
    name = "hello-world",
    actual = "//examples/hello-world-agent:hello-world",
)
