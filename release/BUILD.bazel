# Cross-platform release packaging for the OHC application binaries.
#
# CI builds this package once per platform config, then renames the generic
# archive to include the resolved target triple before uploading it.

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_pkg//pkg:deb.bzl", "pkg_deb")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:rpm.bzl", "pkg_rpm")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "windows_arm64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "macos_aarch64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

OHC_UNIX_ARCHIVE_NAME = select({
    ":linux_arm64": "ohc-aarch64-unknown-linux-gnu.tar.gz",
    ":linux_x86_64": "ohc-x86_64-unknown-linux-gnu.tar.gz",
    ":macos_aarch64": "ohc-aarch64-apple-darwin.tar.gz",
    ":macos_x86_64": "ohc-x86_64-apple-darwin.tar.gz",
    "//conditions:default": "ohc-application.tar.gz",
})

OHC_WINDOWS_ARCHIVE_NAME = select({
    ":windows_arm64": "ohc-aarch64-pc-windows-msvc.zip",
    ":windows_x86_64": "ohc-x86_64-pc-windows-gnu.zip",
    "//conditions:default": "ohc-application.zip",
})

selects.config_setting_group(
    name = "linux_with_rpmbuild",
    match_all = [
        "//:linux",
        "@rules_pkg//toolchains/rpm:have_rpmbuild",
    ],
)

pkg_files(
    name = "ohc_unix_files",
    srcs = [
        "//src/agents/builtin:ohc-builtin-agent",
        "//src/server",
    ],
    renames = {
        "//src/agents/builtin:ohc-builtin-agent": "bin/ohc-builtin-agent",
        "//src/server:server": "bin/ohc-server",
    },
    strip_prefix = strip_prefix.from_pkg(),
    target_compatible_with = select({
        "//:linux": [],
        "//:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

pkg_files(
    name = "ohc_windows_files",
    srcs = [
        "//src/agents/builtin:ohc-builtin-agent",
        "//src/server",
    ],
    renames = {
        "//src/agents/builtin:ohc-builtin-agent": "ohc-builtin-agent.exe",
        "//src/server:server": "ohc-server.exe",
    },
    strip_prefix = strip_prefix.from_pkg(),
    target_compatible_with = select({
        "//:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

pkg_tar(
    name = "ohc_unix_archive",
    srcs = [":ohc_unix_files"],
    extension = "tar.gz",
    package_file_name = OHC_UNIX_ARCHIVE_NAME,
    target_compatible_with = select({
        "//:linux": [],
        "//:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

pkg_zip(
    name = "ohc_windows_archive",
    srcs = [":ohc_windows_files"],
    package_file_name = OHC_WINDOWS_ARCHIVE_NAME,
    target_compatible_with = select({
        "//:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

pkg_deb(
    name = "ohc_deb",
    architecture = "amd64",
    data = ":ohc_unix_archive",
    description = "One Human Corp application bundle",
    maintainer = "One Human Corp <support@onehumancorp.com>",
    package = "ohc",
    priority = "optional",
    section = "utils",
    target_compatible_with = select({
        "//:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    version = "0.4.48",
)

pkg_rpm(
    name = "ohc_rpm",
    package_name = "ohc",
    srcs = [":ohc_unix_files"],
    description = "One Human Corp application bundle",
    license = "Apache-2.0",
    release = "1",
    summary = "One Human Corp application bundle",
    tags = ["manual"],
    target_compatible_with = select({
        ":linux_with_rpmbuild": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    version = "0.4.48",
)

filegroup(
    name = "release_archive",
    srcs = select({
        "//:linux": [
            ":ohc_unix_archive",
        ],
        "//:macos": [
            ":ohc_unix_archive",
        ],
        "//:windows": [
            ":ohc_windows_archive",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "all_release_artifacts",
    srcs = select({
        "//:linux": [
            ":ohc_deb",
            ":ohc_unix_archive",
        ],
        "//:macos": [
            ":ohc_unix_archive",
        ],
        "//:windows": [
            ":ohc_windows_archive",
        ],
        "//conditions:default": [],
    }),
)
