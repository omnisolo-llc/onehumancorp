# Cross-platform release packaging.

load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")
load("@rules_pkg//pkg:deb.bzl", "pkg_deb")
load("@rules_pkg//pkg:rpm.bzl", "pkg_rpm")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")

package(default_visibility = ["//visibility:public"])

# ── Universal App Files ───────────────────────────────────────────────────────

pkg_files(
    name = "app_files",
    srcs = ["//src/ui/tauri:app"],
    renames = {"//src/ui/tauri:app": "ohc-app"},
    strip_prefix = strip_prefix.from_pkg(),
)

# ── IronClaw Archives ─────────────────────────────────────────────────────────
# These targets are expected by the release workflow.

[
    pkg_tar(
        name = "ironclaw-" + target,
        srcs = ["//src/server:server"],
        extension = "tar.gz",
    )
    for target in [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc",
    ]
]

# ── Linux Packages ────────────────────────────────────────────────────────────

pkg_tar(
    name = "app_tar",
    srcs = [":app_files"],
    extension = "tar.gz",
)

pkg_deb(
    name = "app_deb",
    architecture = "amd64",
    maintainer = "One Human Corp <support@onehumancorp.com>",
    package = "ohc-app",
    version = "0.4.42+1",
    description = "One Human Corp Desktop Application",
    section = "utils",
    priority = "optional",
    data = ":app_tar",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

pkg_rpm(
    name = "app_rpm",
    package_name = "ohc-app",
    version = "0.4.42+1",
    license = "Apache-2.0",
    summary = "One Human Corp Desktop Application",
    description = "One Human Corp Desktop Application",
    srcs = [":app_files"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

# ── Windows Packages ──────────────────────────────────────────────────────────

pkg_zip(
    name = "app_windows_zip",
    srcs = [":app_files"],
    package_file_name = "ohc-app-windows-0.4.42+1.zip",
)

# ── OCI Docker Image ──────────────────────────────────────────────────────────

oci_image(
    name = "app_image",
    base = "@distroless_cc",
    entrypoint = ["/ohc-app"],
    tars = [":app_tar"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

oci_load(
    name = "app_image_tarball",
    image = ":app_image",
    repo_tags = ["ohc-app:latest"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

# ── Convenience Groups ───────────────────────────────────────────────────────

filegroup(
    name = "all_release_artifacts",
    srcs = [
        ":app_image_tarball",
    ],
)
