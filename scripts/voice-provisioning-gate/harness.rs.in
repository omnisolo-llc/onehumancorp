#![allow(dead_code)]
extern crate self as server_common;
extern crate self as server_config;
extern crate self as server_integrations_twilio;
extern crate self as server_telemetry;
use serde::{Deserialize, Serialize};
use std::sync::{Arc, atomic::{AtomicBool, AtomicUsize, Ordering}};
pub static DYNAMIC_TELEMETRY_ENABLED: AtomicBool = AtomicBool::new(false);
pub fn record_error_signal(_: &str) {}
pub struct Config { pub standalone: bool, pub multitenant: bool }
pub fn get() -> Config { Config { standalone: false, multitenant: true } }
pub mod config {
    pub fn get_safe_user_dir() -> std::path::PathBuf { panic!("The harness never uses actual user settings") }
}
pub mod utils {
    #[path = "@ROOT@/src/server/utils/fs.rs"] pub mod fs;
}
#[path = "@ROOT@/src/server/settings.rs"] pub mod settings;
#[path = "@ROOT@/src/server/integrations/twilio/client.rs"] pub mod client;
#[path = "@ROOT@/src/server/api/voice_provisioning.rs"] pub mod voice_provisioning;
@CLAIMS@
static EFFECTS: AtomicUsize = AtomicUsize::new(0);
pub mod provider {
    pub struct TwilioProvider;
    #[async_trait::async_trait]
    impl super::client::TwilioClientWrapper for TwilioProvider {
        async fn send_sms(&self, _: &str, _: &str, _: &str) -> Result<(), String> { panic!("No SMS action belongs in this test") }
        async fn send_whatsapp(&self, _: &str, _: &str, _: &str) -> Result<(), String> { panic!("No WhatsApp action belongs in this test") }
        async fn provision_number(&self, _: &str) -> Result<String, String> {
            super::EFFECTS.fetch_add(1, super::Ordering::SeqCst);
            tokio::task::yield_now().await;
            Err("Unknown provider outcome sentinel; no external request occurred".into())
        }
    }
}
fn voice_routes(settings_store: Arc<settings::Store>, _standalone: bool) -> axum::Router {
@ROUTES@
}

#[cfg(test)]
mod boundary_tests {
    use super::*;
    use axum::{body::Body, http::{Request, StatusCode}, Extension};
    use tower::ServiceExt;
    fn user(tenant: &str, admin: bool) -> Claims {
        Claims { sub: format!("actor-{tenant}"), organization_id: Some(tenant.into()), roles: vec![if admin { "ADMIN" } else { "MEMBER" }.into()], exp: i64::MAX, iat: 1, username: String::new(), email: String::new(), session_id: None, jti: String::new() }
    }
    fn request(method: &str, path: &str, body: &str) -> Request<Body> {
        Request::builder().method(method).uri(path).header("content-type", "application/json").body(Body::from(body.to_owned())).unwrap()
    }
    fn persistent() -> (tempfile::TempDir, Arc<settings::Store>) {
        let root = tempfile::tempdir().unwrap();
        let store = Arc::new(settings::Store::from_file(root.path().join("settings.json")).unwrap());
        EFFECTS.store(0, Ordering::SeqCst);
        (root, store)
    }
    #[tokio::test]
    async fn hosted_tenant_admin_cannot_read_instance_global_voice_settings() {
        let (_root, store) = persistent();
        let app = voice_routes(store, false).layer(Extension(user("tenant-a", true)));
        let response = app.oneshot(request("GET", "/api/v1/settings/voice", "")).await.unwrap();
        assert_eq!(response.status(), StatusCode::FORBIDDEN);
        assert_eq!(EFFECTS.load(Ordering::SeqCst), 0);
    }
    #[tokio::test]
    async fn hosted_update_preserves_existing_settings() {
        let (_root, store) = persistent();
        store.set_voice_settings(false, None, Some("Original".into()), None).unwrap();
        let app = voice_routes(store.clone(), false).layer(Extension(user("tenant-a", true)));
        let response = app.oneshot(request("POST", "/api/v1/settings/voice", r#"{"voice_receptionist_persona":"Changed"}"#)).await.unwrap();
        assert_eq!(response.status(), StatusCode::FORBIDDEN);
        assert_eq!(store.get().voice_receptionist_persona.as_deref(), Some("Original"));
    }
    #[tokio::test]
    async fn non_admin_cannot_dispatch_provider_effects() {
        let (_root, store) = persistent();
        let app = voice_routes(store, true).layer(Extension(user("tenant-a", false)));
        let response = app.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap();
        assert_eq!(response.status(), StatusCode::FORBIDDEN);
        assert_eq!(EFFECTS.load(Ordering::SeqCst), 0);
    }
    #[tokio::test]
    async fn missing_authentication_is_rejected_without_provider_effects() {
        let (_root, store) = persistent();
        let response = voice_routes(store, true).oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap();
        assert_eq!(response.status(), StatusCode::UNAUTHORIZED);
        assert_eq!(EFFECTS.load(Ordering::SeqCst), 0);
    }
    #[tokio::test]
    async fn unknown_provisioning_outcome_survives_store_restart_without_retry() {
        let (root, store) = persistent();
        let first = voice_routes(store, true).layer(Extension(user("tenant-a", true)));
        let _ = first.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap();
        assert_eq!(EFFECTS.load(Ordering::SeqCst), 1);
        let reopened = Arc::new(settings::Store::from_file(root.path().join("settings.json")).unwrap());
        let second = voice_routes(reopened, true).layer(Extension(user("tenant-a", true)));
        let response = second.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap();
        assert_eq!(EFFECTS.load(Ordering::SeqCst), 1, "A lost outcome must not dispatch another provisioning attempt");
        assert_eq!(response.status(), StatusCode::CONFLICT);
    }
    #[tokio::test]
    async fn independent_stores_cannot_both_dispatch_the_same_operation() {
        let (root, first_store) = persistent();
        let second_store = Arc::new(settings::Store::from_file(root.path().join("settings.json")).unwrap());
        let first = voice_routes(first_store, true).layer(Extension(user("tenant-a", true)));
        let second = voice_routes(second_store, true).layer(Extension(user("tenant-a", true)));
        let _ = tokio::join!(first.oneshot(request("POST", "/api/v1/settings/voice/provision", "")), second.oneshot(request("POST", "/api/v1/settings/voice/provision", "")));
        assert_eq!(EFFECTS.load(Ordering::SeqCst), 1);
    }
    #[tokio::test]
    async fn a_foreign_tenant_cannot_reuse_or_replace_an_unknown_operation() {
        let (root, store) = persistent();
        let first = voice_routes(store, true).layer(Extension(user("tenant-a", true)));
        let _ = first.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap();
        let reopened = Arc::new(settings::Store::from_file(root.path().join("settings.json")).unwrap());
        let other = voice_routes(reopened, true).layer(Extension(user("tenant-b", true)));
        let response = other.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap();
        assert_eq!(response.status(), StatusCode::FORBIDDEN);
        assert_eq!(EFFECTS.load(Ordering::SeqCst), 1);
    }

    async fn json(response: axum::response::Response) -> serde_json::Value {
        serde_json::from_slice(&axum::body::to_bytes(response.into_body(), 16384).await.unwrap()).unwrap()
    }
    fn provider_state(store: Arc<settings::Store>, client: client::RealTwilioClient) -> voice_provisioning::VoiceState {
        voice_provisioning::VoiceState { store, provider: Arc::new(client), standalone: true, multitenant: false, configured: true, account_sid: "AC11111111111111111111111111111111".into() }
    }
    fn receipt() -> String {
        serde_json::json!({"sid":"PN22222222222222222222222222222222","account_sid":"AC11111111111111111111111111111111","phone_number":"+14155550123"}).to_string()
    }
    #[tokio::test]
    async fn actual_http_confirmation_is_persisted_and_replayed_without_another_purchase() {
        let (root, store) = persistent();
        store.set_voice_settings(true, None, Some("Original persona".into()), Some("Original instructions".into())).unwrap();
        let (client, calls, task) = client::provisioning_tests::recorded_provider(201, receipt(), false).await;
        let state = provider_state(store.clone(), client);
        let app = voice_provisioning::router_with_state(state.clone()).layer(Extension(user("tenant-a", true)));
        let response = app.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap();
        assert_eq!(response.status(), StatusCode::OK);
        assert_eq!(json(response).await, serde_json::json!({"success":true,"number":"+14155550123"}));
        assert_eq!(calls.load(Ordering::SeqCst), 2);
        let reopened = Arc::new(settings::Store::from_file(root.path().join("settings.json")).unwrap());
        assert_eq!(reopened.get().voice_receptionist_number.as_deref(), Some("+14155550123"));
        assert_eq!(reopened.get().voice_receptionist_persona.as_deref(), Some("Original persona"));
        assert_eq!(reopened.get().voice_receptionist_instructions.as_deref(), Some("Original instructions"));
        assert!(reopened.get().voice_receptionist_enabled);
        let replay = voice_provisioning::router_with_state(voice_provisioning::VoiceState { store: reopened, ..state }).layer(Extension(user("tenant-a", true)));
        let response = replay.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap();
        assert_eq!(response.status(), StatusCode::OK);
        assert_eq!(json(response).await["number"], "+14155550123");
        assert_eq!(calls.load(Ordering::SeqCst), 2);
        assert!(!task.is_finished()); task.abort();
    }
    #[tokio::test]
    async fn failed_settings_persistence_after_real_receipt_remains_held_across_restart() {
        let (root, store) = persistent();
        // Inject a real filesystem failure only after the actual HTTP POST
        // arrives. A pre-existing directory is now rejected before any effect.
        let settings_path = root.path().join("settings.json");
        let (client, calls, task) = client::provisioning_tests::recorded_provider_with_hook(201, receipt(), false, move || {
            std::fs::create_dir(settings_path).unwrap();
        }).await;
        let state = provider_state(store.clone(), client);
        let app = voice_provisioning::router_with_state(state.clone()).layer(Extension(user("tenant-a", true)));
        let response = app.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap();
        assert_eq!(response.status(), StatusCode::CONFLICT);
        assert_eq!(store.get().voice_receptionist_number, None);
        std::fs::remove_dir(root.path().join("settings.json")).unwrap();
        let reopened = Arc::new(settings::Store::from_file(root.path().join("settings.json")).unwrap());
        let app = voice_provisioning::router_with_state(voice_provisioning::VoiceState { store: reopened, ..state }).layer(Extension(user("tenant-a", true)));
        let response = app.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap();
        assert_eq!(response.status(), StatusCode::CONFLICT);
        assert_eq!(calls.load(Ordering::SeqCst), 2);
        assert!(!task.is_finished()); task.abort();
    }
    #[tokio::test]
    async fn dropped_real_http_reply_is_durably_held_without_retry() {
        let (root, store) = persistent();
        let (client, calls, task) = client::provisioning_tests::recorded_provider(201, receipt(), true).await;
        let state = provider_state(store, client);
        let app = voice_provisioning::router_with_state(state.clone()).layer(Extension(user("tenant-a", true)));
        assert_eq!(app.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap().status(), StatusCode::CONFLICT);
        let reopened = Arc::new(settings::Store::from_file(root.path().join("settings.json")).unwrap());
        let app = voice_provisioning::router_with_state(voice_provisioning::VoiceState { store: reopened, ..state }).layer(Extension(user("tenant-a", true)));
        let status = json(app.clone().oneshot(request("GET", "/api/v1/settings/voice", "")).await.unwrap()).await;
        assert_eq!(status["provisioning_available"], false);
        assert_eq!(status["provisioning_state"], "pending");
        assert_eq!(status["voice_receptionist_number"], serde_json::Value::Null);
        assert_eq!(app.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap().status(), StatusCode::CONFLICT);
        assert_eq!(calls.load(Ordering::SeqCst), 2);
        assert!(!task.is_finished()); task.abort();
    }
    #[tokio::test]
    async fn foreign_tenant_actor_or_provider_account_cannot_read_or_reuse_receipt() {
        let (_root, store) = persistent();
        let (client, calls, task) = client::provisioning_tests::recorded_provider(201, receipt(), false).await;
        let state = provider_state(store.clone(), client);
        let app = voice_provisioning::router_with_state(state.clone()).layer(Extension(user("tenant-a", true)));
        assert_eq!(app.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap().status(), StatusCode::OK);
        let mut different_actor = user("tenant-a", true); different_actor.sub = "another-actor".into();
        for (claims, account) in [(user("tenant-b", true), state.account_sid.clone()), (different_actor, state.account_sid.clone()), (user("tenant-a", true), "AC33333333333333333333333333333333".into())] {
            let other = voice_provisioning::router_with_state(voice_provisioning::VoiceState { account_sid: account, ..state.clone() }).layer(Extension(claims));
            for (method, path) in [("GET", "/api/v1/settings/voice"), ("POST", "/api/v1/settings/voice/provision"), ("POST", "/api/v1/settings/voice")] {
                let response = other.clone().oneshot(request(method, path, "{}")).await.unwrap();
                assert_eq!(response.status(), StatusCode::FORBIDDEN);
                let body = json(response).await.to_string();
                assert!(!body.contains("+14155550123")); assert!(!body.contains("actor-tenant-a"));
            }
        }
        assert_eq!(calls.load(Ordering::SeqCst), 2); assert!(!task.is_finished()); task.abort();
    }
    #[tokio::test]
    async fn corrupt_hold_and_missing_persistence_never_dispatch_a_provider() {
        let (root, store) = persistent();
        std::fs::write(root.path().join("settings.json.voice-provisioning.json"), b"interrupted marker").unwrap();
        for store in [store, Arc::new(settings::Store::new())] {
            let app = voice_routes(store, true).layer(Extension(user("tenant-a", true)));
            let response = app.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap();
            assert!(matches!(response.status(), StatusCode::CONFLICT | StatusCode::SERVICE_UNAVAILABLE));
        }
        assert_eq!(EFFECTS.load(Ordering::SeqCst), 0);
        assert_eq!(std::fs::read(root.path().join("settings.json.voice-provisioning.json")).unwrap(), b"interrupted marker");
    }
    #[tokio::test]
    async fn unavailable_provider_or_hosted_mode_never_starts_an_operation() {
        let (root, store) = persistent();
        let base = voice_provisioning::VoiceState { store, provider: Arc::new(provider::TwilioProvider), standalone: true, multitenant: false, configured: false, account_sid: String::new() };
        for state in [base.clone(), voice_provisioning::VoiceState { configured: true, multitenant: true, ..base }] {
            let app = voice_provisioning::router_with_state(state).layer(Extension(user("tenant-a", true)));
            let response = app.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap();
            assert!(matches!(response.status(), StatusCode::FORBIDDEN | StatusCode::SERVICE_UNAVAILABLE));
        }
        assert_eq!(EFFECTS.load(Ordering::SeqCst), 0);
        assert!(!root.path().join("settings.json.voice-provisioning.json").exists());
    }
    #[tokio::test]
    async fn failed_preference_save_preserves_memory_and_disk() {
        let (root, store) = persistent();
        store.set_voice_settings(false, None, Some("Original".into()), None).unwrap();
        let original = std::fs::read(root.path().join("settings.json")).unwrap();
        std::fs::rename(root.path().join("settings.json"), root.path().join("original.json")).unwrap();
        std::fs::create_dir(root.path().join("settings.json")).unwrap();
        let app = voice_routes(store.clone(), true).layer(Extension(user("tenant-a", true)));
        let response = app.oneshot(request("POST", "/api/v1/settings/voice", r#"{"voice_receptionist_enabled":true,"voice_receptionist_persona":"Changed"}"#)).await.unwrap();
        assert_eq!(response.status(), StatusCode::SERVICE_UNAVAILABLE);
        assert!(!store.get().voice_receptionist_enabled);
        assert_eq!(store.get().voice_receptionist_persona.as_deref(), Some("Original"));
        assert_eq!(std::fs::read(root.path().join("original.json")).unwrap(), original);
    }

    #[tokio::test]
    async fn an_older_full_preference_payload_cannot_erase_a_confirmed_provider_number() {
        let (root, store) = persistent();
        let (client, calls, task) = client::provisioning_tests::recorded_provider(201, receipt(), false).await;
        let app = voice_provisioning::router_with_state(provider_state(store.clone(), client)).layer(Extension(user("tenant-a", true)));
        assert_eq!(app.clone().oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap().status(), StatusCode::OK);
        let stale = r#"{"voice_receptionist_enabled":true,"voice_receptionist_number":"","voice_receptionist_persona":"Professional"}"#;
        let response = app.clone().oneshot(request("POST", "/api/v1/settings/voice", stale)).await.unwrap();
        assert_eq!(response.status(), StatusCode::OK);
        let reopened = settings::Store::from_file(root.path().join("settings.json")).unwrap();
        assert_eq!(reopened.get().voice_receptionist_number.as_deref(), Some("+14155550123"));
        assert_eq!(reopened.get().voice_receptionist_persona.as_deref(), Some("Professional"));
        assert_eq!(store.get().voice_receptionist_number.as_deref(), Some("+14155550123"));
        assert_eq!(app.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap().status(), StatusCode::OK);
        assert_eq!(calls.load(Ordering::SeqCst), 2); assert!(!task.is_finished()); task.abort();
    }

    #[tokio::test]
    async fn a_second_stale_store_cannot_erase_the_confirmed_number() {
        let (root, first) = persistent();
        let second = Arc::new(settings::Store::from_file(root.path().join("settings.json")).unwrap());
        let (client, calls, task) = client::provisioning_tests::recorded_provider(201, receipt(), false).await;
        let first_app = voice_provisioning::router_with_state(provider_state(first, client)).layer(Extension(user("tenant-a", true)));
        assert_eq!(first_app.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap().status(), StatusCode::OK);
        let second_app = voice_routes(second, true).layer(Extension(user("tenant-a", true)));
        assert_eq!(second_app.oneshot(request("POST", "/api/v1/settings/voice", r#"{"voice_receptionist_persona":"Second store"}"#)).await.unwrap().status(), StatusCode::OK);
        let disk = settings::Store::from_file(root.path().join("settings.json")).unwrap();
        assert_eq!(disk.get().voice_receptionist_number.as_deref(), Some("+14155550123"));
        assert_eq!(disk.get().voice_receptionist_persona.as_deref(), Some("Second store"));
        assert_eq!(calls.load(Ordering::SeqCst), 2); assert!(!task.is_finished()); task.abort();
    }
    #[tokio::test]
    async fn provisioning_from_a_stale_store_preserves_the_latest_saved_preferences() {
        let (root, first) = persistent();
        let second = Arc::new(settings::Store::from_file(root.path().join("settings.json")).unwrap());
        let second_app = voice_routes(second, true).layer(Extension(user("tenant-a", true)));
        assert_eq!(second_app.oneshot(request("POST", "/api/v1/settings/voice", r#"{"voice_receptionist_persona":"Newer preference"}"#)).await.unwrap().status(), StatusCode::OK);
        let (client, calls, task) = client::provisioning_tests::recorded_provider(201, receipt(), false).await;
        let first_app = voice_provisioning::router_with_state(provider_state(first, client)).layer(Extension(user("tenant-a", true)));
        assert_eq!(first_app.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap().status(), StatusCode::OK);
        let disk = settings::Store::from_file(root.path().join("settings.json")).unwrap();
        assert_eq!(disk.get().voice_receptionist_number.as_deref(), Some("+14155550123"));
        assert_eq!(disk.get().voice_receptionist_persona.as_deref(), Some("Newer preference"));
        assert_eq!(calls.load(Ordering::SeqCst), 2); assert!(!task.is_finished()); task.abort();
    }
    #[tokio::test]
    async fn a_busy_shared_settings_lock_rejects_preferences_without_mutation() {
        let (root, store) = persistent();
        let lock = std::fs::File::create_new(root.path().join("settings.json.voice-settings.lock")).unwrap();
        lock.try_lock().unwrap();
        let app = voice_routes(store.clone(), true).layer(Extension(user("tenant-a", true)));
        let response = app.oneshot(request("POST", "/api/v1/settings/voice", r#"{"voice_receptionist_persona":"Rejected"}"#)).await.unwrap();
        assert_eq!(response.status(), StatusCode::SERVICE_UNAVAILABLE);
        assert_ne!(store.get().voice_receptionist_persona.as_deref(), Some("Rejected"));
        assert!(!root.path().join("settings.json").exists());
    }

    #[tokio::test]
    async fn a_stale_store_cannot_provision_over_a_persisted_legacy_number() {
        let (root, stale) = persistent();
        let other = settings::Store::from_file(root.path().join("settings.json")).unwrap();
        other.set_voice_settings(true, Some("+14155550999".into()), Some("Legacy".into()), None).unwrap();
        let app = voice_routes(stale, true).layer(Extension(user("tenant-a", true)));
        let response = app.oneshot(request("POST", "/api/v1/settings/voice/provision", "")).await.unwrap();
        assert_eq!(response.status(), StatusCode::CONFLICT);
        assert_eq!(EFFECTS.load(Ordering::SeqCst), 0);
        let disk = settings::Store::from_file(root.path().join("settings.json")).unwrap();
        assert_eq!(disk.get().voice_receptionist_number.as_deref(), Some("+14155550999"));
        assert!(!root.path().join("settings.json.voice-provisioning.json").exists());
    }
}
