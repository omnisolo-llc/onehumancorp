{
  "name": "mono",
  "version": "0.4.47",
  "private": true,
  "engines": {
    "node": ">=22.22.1 <23"
  },
  "scripts": {
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:desktop-ui": "vitest run --config vitest.config.ts src/ui/tauri/src",
    "lint:node": "eslint . --max-warnings 0",
    "check:rust": "cargo check --locked --workspace --exclude app --all-targets",
    "test:rust": "make test-rust",
    "test:pricing": "cargo test --locked -p server_pricing",
    "test:billing": "cargo test --locked -p server_services_billing",
    "test:web": "npm --prefix src/ui/next test --",
    "typecheck:web": "npm --prefix src/ui/next run typecheck",
    "test:build": "node --test scripts/native-build.test.mjs scripts/node-runtime.test.mjs",
    "test:contracts": "node scripts/native-contracts.mjs",
    "test:e2e": "node scripts/run-playwright.mjs",
    "build:server": "cargo build --locked --release -p omnisolo --bin server",
    "build:worker": "cargo build --locked --release -p omnisolo_harness_worker --bin omnisolo-harness-worker",
    "build:web": "node scripts/build-web.mjs",
    "dev:web": "npm --prefix src/ui/next run dev",
    "desktop:dev": "node scripts/run-tauri.mjs dev",
    "desktop:build": "node scripts/run-tauri.mjs build",
    "mobile:android": "node scripts/run-tauri.mjs android build",
    "mobile:ios": "node scripts/run-tauri.mjs ios build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@bufbuild/protoplugin": "^2.11.0",
    "@journeyapps/wa-sqlite": "^1.7.0",
    "@modelcontextprotocol/server-github": "^0.6.2",
    "@powersync/react": "^1.10.0",
    "@powersync/web": "^1.38.3",
    "@stripe/terminal-js": "^0.26.0",
    "@types/react-dom": "19.2.3",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/uuid": "^10.0.0",
    "dompurify": "^3.4.13",
    "framer-motion": "^12.40.0",
    "glob": "^13.0.6",
    "google-protobuf": "^3.21.4",
    "isomorphic-dompurify": "^3.18.0",
    "marked": "^18.0.5",
    "next": "^16.3.3",
    "pg": "8.21.0",
    "react": "^19.2.5",
    "react-icons": "^5.6.0",
    "swagger-ui-react": "^5.32.6",
    "ts-proto": "^2.11.6",
    "uuid": "^14.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.0",
    "c8": "^11.0.0",
    "date-fns": "^4.4.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "ink-spinner": "^5.0.0",
    "ink-testing-library": "^4.0.0",
    "ink-text-input": "^6.0.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "next-router-mock": "^1.0.5",
    "playwright": "^1.61.1",
    "postcss": "8.5.23",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.1.10",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "@hono/node-server": "2.0.10",
