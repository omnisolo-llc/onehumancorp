module(
    name = "mono",
    version = "0.1.0",
)

bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.47.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "34.1")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_shell", version = "0.7.1")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "aspect_rules_js", version = "3.0.3")

# ── Flutter rules (vendored fork) ─────────────────────────────────────────────
bazel_dep(name = "rules_flutter", version = "0.0.0")
local_path_override(
    module_name = "rules_flutter",
    path = "bazel/rules/flutter",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.29.3")
use_repo(
    flutter,
    "flutter_sdk",
    "flutter_toolchains",
)

register_toolchains("@flutter_toolchains//:all")

pub = use_extension("@rules_flutter//flutter:extensions.bzl", "pub")
use_repo(
    pub,
    "pub_async",
    "pub_collection",
    "pub_cross_file",
    "pub_fake_async",
    "pub_file",
    "pub_http_multi_server",
    "pub_lints",
    "pub_mock",
    "pub_path",
    "pub_plugin_platform_interface",
    "pub_pool",
    "pub_shared_preferences",
    "pub_shared_preferences_android",
    "pub_shared_preferences_foundation",
    "pub_shared_preferences_ios",
    "pub_shared_preferences_linux",
    "pub_shared_preferences_macos",
    "pub_shared_preferences_platform_interface",
    "pub_shared_preferences_web",
    "pub_shared_preferences_windows",
    "pub_shelf",
    "pub_source_span",
    "pub_stream_channel",
    "pub_test",
    "pub_test_api",
    "pub_test_core",
    "pub_vector_math",
    "pub_web_socket_channel",
)

# ── Go dependencies ───────────────────────────────────────────────────────────
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_centrifugal_centrifuge",
    "com_github_google_uuid",
    "com_github_prometheus_client_golang",
    "in_gopkg_yaml_v3",
    "io_opentelemetry_go_otel",
    "io_opentelemetry_go_otel_exporters_prometheus",
    "io_opentelemetry_go_otel_metric",
    "io_opentelemetry_go_otel_sdk_metric",
    "org_golang_google_grpc",
    "org_golang_google_grpc_cmd_protoc_gen_go_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_crypto",
    "org_modernc_sqlite",
)

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.eslintignore",
)
use_repo(npm, "npm")

# ── Docker OCI Rules ──────────────────────────────────────────────────────────
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_base",
    digest = "sha256:d8bd6c4f697cc649df16a7e080eb5c3de5765d7554d3102434559b3f3b9095df",
    image = "gcr.io/distroless/base",
)
use_repo(oci, "distroless_base")

single_version_override(
    module_name = "rules_android",
    patch_cmds = [
        "sed -i 's/@local_config_platform\\/\\/:constraints.bzl/@platforms\\/\\/host:constraints.bzl/g' rules/android_sdk_repository/helper.bzl",
        "find rules -name \"*.bzl\" -exec sed -i -e '/CcInfo/!b' -e '/@rules_cc\\/\\/cc\\/common:cc_info.bzl/!s/CcInfo/CcInfo/g' -e '1i\\load(\"@rules_cc//cc/common:cc_info.bzl\", \"CcInfo\")' {} \\;",
    ],
)
