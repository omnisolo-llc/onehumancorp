module(
    name = "mono",
    version = "0.4.29",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "bazel-diff", version = "18.1.0")
bazel_dep(name = "protobuf", version = "34.1")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_android", version = "0.7.2")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.50.0")

# ── Rust support ──────────────────────────────────────────────────────────────
bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.70.0")
bazel_dep(name = "rules_rust_prost", version = "0.70.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "x86_64-pc-windows-msvc",
        "x86_64-pc-windows-gnu",
        "i686-pc-windows-msvc",
        "i686-pc-windows-gnu",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin",
        "aarch64-apple-ios",
        "aarch64-linux-android",
        "wasm32-unknown-unknown",
    ],
    versions = [
        "1.95.0",
    ],
)
use_repo(rust, "rust_toolchains")

register_toolchains("//bazel/toolchains:prost_toolchain")
register_toolchains("@rust_toolchains//:all")

# ── WASM bindgen support ──────────────────────────────────────────────────────
# rules_rust_wasm_bindgen provides wasm-bindgen-cli 0.2.105, but our code uses 0.2.120
# The wasm binary build succeeds, but binding generation fails due to version mismatch
# Users should either:
#   1. Wait for rules_rust_wasm_bindgen to release a version with wasm-bindgen 0.2.120
#   2. Downgrade wasm-bindgen in Cargo.toml to 0.2.105 (requires also downgrading wasm-bindgen-futures)

register_toolchains("@rules_rust_wasm_bindgen//:default_wasm_bindgen_toolchain")

# Required for wasm32 builds - dummy CC toolchain workaround - TEMPORARILY DISABLED
# register_toolchains("@rules_rust//rust/private/dummy_cc_toolchain:dummy_cc_wasm32_toolchain")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
    ],
)
crate.annotation(
    build_script_env = {
        "CARGO_PKG_AUTHORS": "Unknown",
        "CARGO_PKG_DESCRIPTION": "Unknown",
        "CARGO_PKG_NAME": "rav1e",
        "CARGO_PKG_VERSION": "0.8.1",
        "CARGO_PKG_HOMEPAGE": "Unknown",
        "CARGO_PKG_LICENSE": "Unknown",
        "CARGO_PKG_REPOSITORY": "Unknown",
    },
    crate = "rav1e",
)
crate.annotation(
    crate = "protoc-gen-prost",
    gen_binaries = ["protoc-gen-prost"],
)
crate.annotation(
    crate = "protoc-gen-tonic",
    gen_binaries = ["protoc-gen-tonic"],
)

# wasm-bindgen crate version must match what the toolchain provides
# rules_rust_wasm_bindgen 0.70.0 ships with wasm-bindgen-cli 0.2.105
# We accept this mismatch and the user will need to update rules_rust_wasm_bindgen
# to a version that ships with 0.2.120
use_repo(crate, "crates")

rules_pkg_rpm = use_extension(
    "@rules_pkg//toolchains/rpm:rpmbuild_configure.bzl",
    "find_system_rpmbuild_bzlmod",
)
use_repo(rules_pkg_rpm, "rules_pkg_rpmbuild")

register_toolchains("@rules_pkg_rpmbuild//:all")

bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_nodejs", version = "6.7.4")
bazel_dep(name = "aspect_rules_js", version = "3.0.3")

# ── Flutter rules (vendored fork) ─────────────────────────────────────────────
bazel_dep(name = "rules_flutter", version = "0.0.0")
local_path_override(
    module_name = "rules_flutter",
    path = "bazel/rules/flutter",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.29.3")
use_repo(
    flutter,
    "flutter_sdk",
    "flutter_toolchains",
)

register_toolchains("@flutter_toolchains//:all")

# Flutter pub dependencies removed as requested.
# ─────────────────────────────────────────────────────────────────────────────

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "23.6.0")
use_repo(node, "nodejs")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    bins = {
        "ts-proto": ["protoc-gen-ts_proto=protoc-gen-ts_proto"],
    },
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

platforms_host = use_extension("@platforms//host:extension.bzl", "host_platform")
use_repo(platforms_host, "host_platform")

bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")

buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
buildbuddy.gcc_toolchain()
use_repo(buildbuddy, "buildbuddy_toolchain")

register_toolchains("@buildbuddy_toolchain//:all")

