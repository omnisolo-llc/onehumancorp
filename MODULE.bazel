module(
    name = "mono",
    version = "0.3.2",
)

bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.47.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "bazel-diff", version = "18.1.0")
bazel_dep(name = "protobuf", version = "34.1")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_shell", version = "0.7.1")
bazel_dep(name = "rules_android", version = "0.7.1")
bazel_dep(name = "rules_pkg", version = "1.2.0")

# ── Rust support ──────────────────────────────────────────────────────────────
bazel_dep(name = "rules_rust", version = "0.69.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.85.0", "nightly/2026-01-01"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//src/app:Cargo.toml",
    ],
)
crate.annotation(
    crate = "rav1e",
    build_script_env = {
        "CARGO_PKG_AUTHORS": "Unknown",
        "CARGO_PKG_DESCRIPTION": "Unknown",
        "CARGO_PKG_NAME": "rav1e",
        "CARGO_PKG_VERSION": "0.8.1",
        "CARGO_PKG_HOMEPAGE": "Unknown",
        "CARGO_PKG_LICENSE": "Unknown",
        "CARGO_PKG_REPOSITORY": "Unknown",
    },
)
use_repo(crate, "crates")



rules_pkg_rpm = use_extension(
    "@rules_pkg//toolchains/rpm:rpmbuild_configure.bzl",
    "find_system_rpmbuild_bzlmod",
)
use_repo(rules_pkg_rpm, "rules_pkg_rpmbuild")

register_toolchains("@rules_pkg_rpmbuild//:all")

bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "aspect_rules_js", version = "3.0.3")

# ── Flutter rules (vendored fork) ─────────────────────────────────────────────
bazel_dep(name = "rules_flutter", version = "0.0.0")
local_path_override(
    module_name = "rules_flutter",
    path = "bazel/rules/flutter",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.29.3")
use_repo(
    flutter,
    "flutter_sdk",
    "flutter_toolchains",
)

register_toolchains("@flutter_toolchains//:all")

# Flutter pub dependencies removed as requested.
# ─────────────────────────────────────────────────────────────────────────────

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "23.6.0")
use_repo(node, "nodejs")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.1")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Fix for centrifuge's vtprotobuf-generated files: disable proto-library generation
# so that control.pb.go and control_vtproto.pb.go are included together in the
# same go_library target instead of separate proto_library / go_proto_library rules.
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable",
    ],
    path = "github.com/centrifugal/centrifuge",
)

# Fix for centrifugal/protocol: disable proto-library generation so that
# client.pb.go, client.pb_easyjson.go, and client_vtproto.pb.go are all
# compiled together in one go_library target.
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable",
    ],
    path = "github.com/centrifugal/protocol",
)
use_repo(go_deps, "com_github_alicebob_miniredis_v2", "com_github_centrifugal_centrifuge", "com_github_google_uuid", "com_github_gorilla_websocket", "com_github_jackc_pgx_v5", "com_github_mattn_go_sqlite3", "com_github_minio_minio_go_v7", "com_github_modelcontextprotocol_go_sdk", "com_github_nats_io_nats_go", "com_github_playwright_community_playwright_go", "com_github_pressly_goose_v3", "com_github_prometheus_client_golang", "com_github_redis_go_redis_v9", "com_github_redis_rueidis", "com_github_slack_go_slack", "com_github_smacker_go_tree_sitter", "com_github_spf13_afero", "com_github_spf13_viper", "com_github_stretchr_testify", "in_gopkg_yaml_v3", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_prometheus", "io_opentelemetry_go_otel_metric", "io_opentelemetry_go_otel_sdk_metric", "io_opentelemetry_go_otel_trace", "org_golang_google_grpc", "org_golang_google_grpc_cmd_protoc_gen_go_grpc", "org_golang_google_protobuf", "org_golang_x_crypto", "org_modernc_sqlite")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    bins = {
        "ts-proto": ["protoc-gen-ts_proto=protoc-gen-ts_proto"],
    },
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

platforms_host = use_extension("@platforms//host:extension.bzl", "host_platform")
use_repo(platforms_host, "host_platform")

bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")

buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
buildbuddy.gcc_toolchain()
use_repo(buildbuddy, "buildbuddy_toolchain")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_static",
    image = "gcr.io/distroless/static",
    platforms = ["linux/amd64"],
    tag = "latest",
)
oci.pull(
    name = "distroless_cc",
    image = "gcr.io/distroless/cc",
    platforms = ["linux/amd64"],
    tag = "latest",
)
oci.pull(
    name = "nginx_alpine",
    image = "index.docker.io/library/nginx",
    platforms = ["linux/amd64"],
    tag = "alpine",
)
use_repo(oci, "distroless_cc", "distroless_cc_linux_amd64", "distroless_static", "distroless_static_linux_amd64", "nginx_alpine", "nginx_alpine_linux_amd64")

# ── Proto dependencies (Hermetic Dart Plugin) ────────────────────────────────
proto_deps = use_extension("//bazel/rules:extensions.bzl", "proto_deps_extension")
use_repo(proto_deps, "google_protobuf_dart")
