+    pub async fn decide_approval(&self, mission_id: &str, tenant_id: &str, approved: bool) -> Result<(), sqlx::Error> {
+        let new_approval_status = if approved { "APPROVED" } else { "REJECTED" };
+        let new_status = if approved { "PENDING" } else { "FAILED" };
+
+        match &self.store {
+            DbStore::Postgres => {
+                let _ = sqlx::query("UPDATE agent_missions SET approval_status = $1, status = $2, updated_at = CURRENT_TIMESTAMP WHERE id = $3 AND tenant_id = $4")
+                    .bind(new_approval_status)
+                    .bind(new_status)
+                    .bind(mission_id)
+                    .bind(tenant_id)
+                    .execute(&self.pool)
+                    .await?;
+            }
+            DbStore::Sqlite(pool) => {
+                let _ = sqlx::query("UPDATE agent_missions SET approval_status = ?, status = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ? AND tenant_id = ?")
+                    .bind(new_approval_status)
+                    .bind(new_status)
+                    .bind(mission_id)
+                    .bind(tenant_id)
+                    .execute(pool)
+                    .await?;
+            }
+        }
+        Ok(())
+    }
