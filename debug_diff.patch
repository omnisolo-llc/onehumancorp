+                .fetch_one(&pool)
+                .await
+                .unwrap();
+
+            let status: String = row.get("status");
+            assert_eq!(status, "FAILED");
+
+            // Clean up
+            sqlx::query("DELETE FROM agent_missions WHERE id = 'test_mission_stuck'").execute(&pool).await.unwrap();
+        }
