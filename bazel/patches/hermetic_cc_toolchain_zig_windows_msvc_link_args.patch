diff --git a/toolchain/zig-wrapper.zig b/toolchain/zig-wrapper.zig
index a34c88a..f61c5b7 100644
--- a/toolchain/zig-wrapper.zig
+++ b/toolchain/zig-wrapper.zig
@@ -233,7 +233,7 @@ fn parseArgs(
             continue;
         }

-        try args.append(arena, arg);
+        try appendArg(arena, &args, run_mode, arg);
     }

     // Add -target as the last parameter. The wrapper should overwrite
@@ -261,3 +261,89 @@ fn shouldSkipArg(run_mode: RunMode, arg: []const u8) bool {
         mem.eql(u8, arg, "--disable-auto-image-base");
 }

+fn appendArg(
+    arena: mem.Allocator,
+    args: *ArrayListUnmanaged([]const u8),
+    run_mode: RunMode,
+    arg: []const u8,
+) !void {
+    switch (run_mode) {
+        .cc => |target| {
+            if (mem.indexOf(u8, target, "windows") != null and
+                try appendMsvcLinkArg(arena, args, arg))
+            {
+                return;
+            }
+        },
+        else => {},
+    }
+
+    try args.append(arena, arg);
+}
+
+fn appendMsvcLinkArg(
+    arena: mem.Allocator,
+    args: *ArrayListUnmanaged([]const u8),
+    arg: []const u8,
+) !bool {
+    if (mem.eql(u8, arg, "-nolibc")) {
+        try args.append(arena, "-nodefaultlibs");
+        return true;
+    }
+
+    if (mem.eql(u8, arg, "--unwindlib=none") or
+        mem.eql(u8, arg, "-lmsvcrt"))
+    {
+        return true;
+    }
+
+    if (mem.eql(u8, arg, "-Wl,-Bdynamic")) {
+        try args.append(arena, "-Wl,-Bstatic");
+        return true;
+    }
+
+    if (mem.eql(u8, arg, "/NOLOGO") or
+        mem.eql(u8, arg, "/DEBUG") or
+        mem.eql(u8, arg, "/NXCOMPAT") or
+        mem.startsWith(u8, arg, "/OPT:") or
+        mem.startsWith(u8, arg, "/PDBALTPATH:"))
+    {
+        return true;
+    }
+
+    if (mem.startsWith(u8, arg, "/OUT:")) {
+        try args.append(arena, "-o");
+        try args.append(arena, arg["/OUT:".len..]);
+        return true;
+    }
+
+    if (mem.startsWith(u8, arg, "/LIBPATH:")) {
+        try args.append(arena, "-L");
+        try args.append(arena, arg["/LIBPATH:".len..]);
+        return true;
+    }
+
+    if (mem.startsWith(u8, arg, "/defaultlib:")) {
+        const lib_name = arg["/defaultlib:".len..];
+        if (!mem.eql(u8, lib_name, "msvcrt")) {
+            try appendLib(arena, args, lib_name);
+        }
+        return true;
+    }
+
+    if (mem.endsWith(u8, arg, ".lib") and
+        mem.indexOfScalar(u8, arg, '/') == null and
+        mem.indexOfScalar(u8, arg, '\\') == null)
+    {
+        try appendLib(arena, args, arg[0 .. arg.len - ".lib".len]);
+        return true;
+    }
+
+    return false;
+}
+
+fn appendLib(arena: mem.Allocator, args: *ArrayListUnmanaged([]const u8), name: []const u8) !void {
+    const lib_name = if (mem.endsWith(u8, name, ".lib")) name[0 .. name.len - ".lib".len] else name;
+    try args.append(arena, try std.fmt.allocPrint(arena, "-l{s}", .{lib_name}));
+}
+
