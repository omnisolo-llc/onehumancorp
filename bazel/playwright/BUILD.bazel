# This BUILD file gathers the browser binaries into the directory structure Playwright expects.
# Playwright expects a directory containing:
#  - chromium-1200/
#  - firefox-1497/
#  - ffmpeg-1011/

# We use genrules to create this structure.

genrule(
    name = "browsers",
    srcs = [
        "@playwright_chromium//:files",
        "@playwright_firefox//:files",
        "@playwright_ffmpeg//:files",
    ],
    outs = ["ms-playwright/marker"],
    output_to_bindir = 1,
    cmd = """
        mkdir -p $(@D)/ms-playwright/chromium-1200
        mkdir -p $(@D)/ms-playwright/firefox-1497
        mkdir -p $(@D)/ms-playwright/ffmpeg-1011

        cp -RL external/+playwright_browsers_extension+playwright_chromium/* $(@D)/ms-playwright/chromium-1200/ || cp -RL external/playwright_chromium/* $(@D)/ms-playwright/chromium-1200/
        cp -RL external/+playwright_browsers_extension+playwright_firefox/* $(@D)/ms-playwright/firefox-1497/ || cp -RL external/playwright_firefox/* $(@D)/ms-playwright/firefox-1497/
        cp -RL external/+playwright_browsers_extension+playwright_ffmpeg/* $(@D)/ms-playwright/ffmpeg-1011/ || cp -RL external/playwright_ffmpeg/* $(@D)/ms-playwright/ffmpeg-1011/
        touch $@
    """,
    visibility = ["//visibility:public"],
)
