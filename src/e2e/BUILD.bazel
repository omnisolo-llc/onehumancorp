load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//bazel/rules/playwright:playwright_tests.bzl", "define_playwright_tests")

# Shell script wrapper for running ALL playwright tests via docker compose
# (manual invocation: `bazel run //src/e2e:run_playwright_e2e`)
sh_binary(
    name = "run_playwright_e2e",
    srcs = ["//bazel/rules/playwright:run_playwright.sh"],
    data = [
        "//deploy:docker-compose.e2e.yml",
        "//scripts:run-playwright.mjs",
        "//src/server",
    ],
    tags = ["manual"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

# Per-spec Playwright test targets plus the stable aggregate used by
# `bazel test //...`.
# Run CI suite: bazel test //src/e2e:playwright
# Run one:   bazel test //src/e2e:playwright_app_spec_ts
define_playwright_tests(
    ci_specs = [
        "ambassador_reply.spec.ts",
        "grandmother_test.spec.ts",
        "help.spec.ts",
        "kairos_orchestration.spec.ts",
        "landing_ux.spec.ts",
        "login.spec.ts",
        "login_ux.spec.ts",
        "telemetry_sync.spec.ts",
        "viral_embed.spec.ts",
    ],
    specs = glob(["*.spec.ts"]),
    server = "//src/server:server",
)
