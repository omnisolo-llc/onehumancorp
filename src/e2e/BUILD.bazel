# Shell script wrapper for running ALL playwright tests via docker compose
# (manual invocation: `bazel run //src/e2e:run_playwright_e2e`)
sh_binary(
    name = "run_playwright_e2e",
    srcs = ["//bazel/rules/playwright:run_playwright.sh"],
    data = [
        "//deploy:docker-compose.e2e.yml",
        "//scripts:run-playwright.mjs",
        "//src/server",
    ],
    tags = ["manual"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

# Per-spec Playwright test targets plus the shard targets used by the explicit
# `//src/e2e:playwright` CI gate. A generated check ensures the CI subset only
# references discovered specs.
# Run suite: bazel test //src/e2e:playwright
# Run one CI shard: bazel test //src/e2e:playwright_shard_1_of_1
# Run one:   bazel test //src/e2e:playwright_app_spec_ts
define_playwright_tests(
    ci_discovery_data = [
        "//src/ui/next:next_e2e_specs",
    ],
    ci_shard_count = 1,
    data = [
        "//src/ui/next:next_app_e2e_data",
        "//src/ui/tauri/src/ui:all_files",
    ],
    server = "//src/server:server",
    specs = glob(["**/*.spec.ts"]) + _NEXT_UI_E2E_SPECS,
)

sh_test(
    name = "verify_artifacts_test",
    srcs = ["verify_artifacts.sh"],
    data = ["//release:all_release_artifacts"],
    tags = ["lint"],
)
