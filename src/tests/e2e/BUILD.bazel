load("@rules_go//go:def.bzl", "go_test")

# Shared infrastructure files included in every per-category test binary.
# Splitting by category allows Bazel to cache individual test results: a change
# to agent_test.go only invalidates the e2e_agents_test binary, not the others.
_SHARED_SRCS = [
    "e2e_test.go",
    "helpers_test.go",
    "fake_llm_test.go",
]

_COMMON_DEPS = [
    "@com_github_playwright_community_playwright_go//:playwright-go",
]

_COMMON_DATA = [
    "//src/server:ohc",
    "//src/app:app",
]

_COMMON_ENV = {
    # Skip playwright host-requirements validation so tests are hermetic and
    # pass even when the host is missing optional system libraries (CI containers).
    "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS": "1",
}

_COMMON_TAGS = [
    "requires-network",
]

# ── Auth CUJ ──────────────────────────────────────────────────────────────────
go_test(
    name = "e2e_auth_test",
    size = "large",
    timeout = "eternal",
    srcs = ["auth_login_test.go"],
    data = _COMMON_DATA,
    env = _COMMON_ENV,
    importpath = "github.com/onehumancorp/mono/src/tests/e2e",
    tags = _COMMON_TAGS,
    deps = _COMMON_DEPS,
)

go_test(
    name = "e2e_hybrid_sync_test",
    size = "large",
    timeout = "eternal",
    srcs = ["hybrid_sync_e2e_test.go"],
    data = _COMMON_DATA,
    env = _COMMON_ENV,
    importpath = "github.com/onehumancorp/mono/src/tests/e2e",
    tags = _COMMON_TAGS,
    deps = _COMMON_DEPS + [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

