load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

js_library(
    name = "lib",
    srcs = glob(
        [
            "src/**/*.ts",
            "src/**/*.tsx",
        ],
        allow_empty = True,
    ) + [
        "package.json",
        "tsconfig.json",
    ],
    visibility = ["//visibility:public"],
)

js_binary(
    name = "cli",
    data = [
        ":lib",
        "//:node_modules",
    ],
    entry_point = "src/index.tsx",
)

# Test target - native Bazel test rule
# Uses src/cli:node_modules which is a proper Bazel dependency
sh_test(
    name = "cli_test",
    srcs = ["test_runner.sh"],
    data = [
        ":lib",
        "//src/cli:node_modules",
    ],
    args = ["run", "--coverage"],
    visibility = ["//visibility:public"],
)
