load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "scout",
    srcs = glob(["**/*.rs"]),
    crate_name = "ohc_scout_agent",
    edition = "2024",
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//src/agents/builtin:core",
        "@crates//:chrono",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sqlx",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "unit_tests",
    crate = ":scout",
    edition = "2024",
    deps = [
        "@crates//:tokio",
        "@crates//:sqlx",
    ],
)
