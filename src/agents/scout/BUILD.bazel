load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "scout_lib",
    srcs = [
        "agent.rs",
        "db.rs",
        "lib.rs",
        "tests.rs",
    ],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//src/agents/builtin:core",
        "@crates//:chrono",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sqlx",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "scout_test",
    crate = ":scout_lib",
    edition = "2024",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
