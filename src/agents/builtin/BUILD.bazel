# Filtered module targets are useful for local debugging, but each one builds a
# separate test harness for the same crate. Keep them out of wildcard test runs.
[
    rust_test(
        name = module + "_unit_test",
        size = "small",
        args = [module],
        crate = ":ohc_builtin_agent_lib",
        edition = "2024",
        tags = ["manual"],
        target_compatible_with = select({
            "@platforms//os:linux": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
    )
    for module in AGENT_UNIT_TEST_FILTERS
]

