# Individual test targets for better caching
[
    rust_test(
        name = module + "_unit_test",
        crate = ":ohc_builtin_agent_lib",
        args = [module],
        edition = "2024",
        size = "small",
        target_compatible_with = select({
            "@platforms//os:linux": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
    )
    for module in [
        "agent",
        "auth",
        "budget",
        "caveman",
        "checkpointer",
        "codex_runner",
        "verification_loops",
        "guardrails",
        "harness",
        "memory_store",
        "sqlite_memory",
        "memory_exhaustive_tests",
        "consolidation_worker",
        "output_parser",
        "pubsub",
        "registry",
        "local_provider",
        "deerflow",
    ]
]

