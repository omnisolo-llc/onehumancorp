load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "tools",
    srcs = glob(["*.rs"]),
    crate_root = "mod.rs",
    crate_name = "ohc_builtin_agent_tools",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//src/agents/builtin:core",
        "//src/proto:agent_service_tonic",
        "@crates//:base64",
        "@crates//:chrono",
        "@crates//:dashmap",
        "@crates//:glob",
        "@crates//:qrcode",
        "@crates//:regex",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:urlencoding",
        "@crates//:uuid",
    ],
    proc_macro_deps = [
        "@crates//:async-recursion",
        "@crates//:async-trait",
    ],
)

rust_test(
    name = "tools_unit_test",
    crate = ":tools",
    edition = "2024",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@crates//:tokio",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:temp-env",
    ],
)
