load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "tools",
    srcs = glob(["**/*.rs"]),
    crate_name = "ohc_builtin_agent_tools",
    crate_root = "mod.rs",
    edition = "2024",
    proc_macro_deps = [
        "@crates//:async-trait",
        "@crates//:async-recursion",
    ],
    visibility = [
        "//src/agents/builtin:__pkg__",
        "//src/agents/builtin:__subpackages__",
    ],
    deps = [
        "@crates//:chrono",
        "@crates//:glob",
        "@crates//:qrcode",
        "@crates//:regex",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:urlencoding",
        "@crates//:uuid",
    ],
)
