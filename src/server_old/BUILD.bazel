load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "github.com/onehumancorp/mono/src/server",
    visibility = ["//visibility:private"],
    deps = [
        "//src/server_old/auth",
        "//src/server_old/billing",
        "//src/server_old/dashboard",
        "//src/server_old/db",
        "//src/server_old/domain",
        "//src/server_old/integrations/chatwoot",
        "//src/server_old/orchestration",
        "//src/server_old/orchestration/hybrid_sync",
        "//src/server_old/pipeline",
        "//src/server_old/scheduler",
        "//src/server_old/settings",
        "//src/server_old/sync",
        "//src/server_old/telemetry",
        "//src/server_old/integrations/mcp_sync",
        "//src/server_old/workers",
        "//src/server_old/workers/distillation",
        "//src/server_old/checkpointer",
        "//src/server_old/memory/autodream",
        "//src/server_old/memory",
        "@org_golang_google_grpc//:grpc",
        "@com_github_redis_rueidis//:rueidis",
    ],
)

go_binary(
    name = "ohc",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)

# To build the standalone desktop distribution (SQLite + embedded NATS only,
# no env-var overrides for storage backend), run:
#
#   bazel build //src/server_old:ohc --@rules_go//go/config:tags=standalone
#
# This activates the build constraints in config_standalone.go which force
# SQLite and standalone mode regardless of DATABASE_URL / REDIS_URL env vars.

genrule(
    name = "standalone_ohc_exec_file",
    srcs = ["standalone_ohc.sh"],
    outs = ["standalone_ohc_exec"],
    cmd = "cp $< $@ && chmod 0755 $@",
    visibility = ["//visibility:public"],
)



# Added repository to deps if needed. It usually should be, let's keep it simple.
