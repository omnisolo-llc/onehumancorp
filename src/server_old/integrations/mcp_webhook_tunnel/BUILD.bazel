load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "tunnel_proto",
    srcs = ["tunnel.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "tunnel_go_proto",
    compilers = ["@rules_go//proto:go_grpc"],
    importpath = "github.com/onehumancorp/mono/src/server/integrations/mcp_webhook_tunnel",
    proto = ":tunnel_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "mcp_webhook_tunnel",
    srcs = ["relay.go"],
    embed = [":tunnel_go_proto"],
    importpath = "github.com/onehumancorp/mono/src/server/integrations/mcp_webhook_tunnel",
    visibility = ["//visibility:public"],
    deps = [
        "@@gazelle++go_deps+io_opentelemetry_go_otel//:otel",
        "@@gazelle++go_deps+io_opentelemetry_go_otel//attribute",
        "@@gazelle++go_deps+org_golang_google_grpc//:grpc",
        "@@gazelle++go_deps+org_golang_google_grpc//codes",
        "@@gazelle++go_deps+org_golang_google_grpc//status",
        "@@gazelle++go_deps+org_golang_google_grpc//peer",
        "@@gazelle++go_deps+org_golang_google_grpc//credentials",
    ],
)

go_test(
    name = "mcp_webhook_tunnel_test",
    srcs = ["webhook_tunnel_test.go"],
    deps = [
        ":mcp_webhook_tunnel",
        "//src/server_old/db",
        "//src/server_old/tools/mcpwebhooktunnel",
        "@@gazelle++go_deps+org_golang_google_grpc//:grpc",
        "@@gazelle++go_deps+org_golang_google_grpc//credentials",
        "@@gazelle++go_deps+org_golang_google_grpc//credentials/insecure",
        "@@gazelle++go_deps+org_golang_google_grpc//peer",
        "@@gazelle++go_deps+org_golang_google_grpc//test/bufconn",
    ],
)
