go_test(
    name = "mesh_test",
    srcs = [
        "broker_test.go",
        "mesh_coordinator_test.go",
        "mesh_test.go",
    ],
    embed = [":mesh"],
    deps = [
        "//src/server/db",
        "@com_github_alicebob_miniredis_v2//:miniredis",
        "@com_github_redis_go_redis_v9//:go-redis",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_modernc_sqlite//:sqlite",
    ],
)
