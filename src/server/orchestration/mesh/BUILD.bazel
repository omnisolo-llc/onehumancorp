load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "mesh",
    srcs = [
        "broker.go",
        "http_handler.go",
        "local_broker.go",
        "local_mesh.go",
        "mesh.go",
        "mesh_coordinator.go",
        "redis_broker.go",
        "redis_mesh.go",
        "server.go",
    ],
    importpath = "github.com/onehumancorp/mono/src/server/orchestration/mesh",
    visibility = ["//visibility:public"],
    deps = [
        "//src/server/db",
        "@com_github_google_uuid//:uuid",
        "@com_github_redis_go_redis_v9//:go-redis",
        "@com_github_redis_rueidis//:rueidis",
    ],
