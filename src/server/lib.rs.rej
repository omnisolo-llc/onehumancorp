+
+    let pending_orders_res = sqlx::query_scalar::<_, i64>("SELECT COUNT(*) FROM orders WHERE tenant_id =  AND status = 'pending'")
+        .bind(&tenant_id)
+        .fetch_one(&mut *tx)
+        .await;

