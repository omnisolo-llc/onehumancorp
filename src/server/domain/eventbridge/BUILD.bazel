load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "eventbridge",
    srcs = [
        "mod.rs",
        "schema.rs",
        "queue.rs",
        "ingress.rs",
        "dispatcher.rs",
    ],
    edition = "2024",
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:uuid",
        "@crates//:chrono",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "eventbridge_test",
    crate = ":eventbridge",
    edition = "2024",
    deps = [
        "@crates//:tokio",
        "@crates//:serde_json",
        "@crates//:uuid",
        "@crates//:chrono",
    ],
)
