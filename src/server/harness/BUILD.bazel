load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "harness",
    srcs = [
        "ast_validator.go",
        "bwrap_runner.go",
        "daemon_harness.go",
        "harness.go",
        "interceptor.go",
        "macos_sandbox.go",
        "manager.go",
        "registry.go",
    ],
    importpath = "github.com/onehumancorp/mono/src/server/harness",
    visibility = ["//visibility:public"],
    deps = [
        "//src/server/harness/authz",
        "//src/server/telemetry",
        "@com_github_smacker_go_tree_sitter//:go-tree-sitter",
