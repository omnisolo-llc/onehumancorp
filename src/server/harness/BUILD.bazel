load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "server_harness",
    srcs = [
        "executor.rs",
        "mod.rs",
        "telemetry/mod.rs",
        "telemetry/store.rs",
        "sandbox/mod.rs",
        "sandbox/manager.rs",
        "sandbox/ast.rs",
        "sandbox/permissions.rs",
        "sandbox/catalog.rs",
        "sandbox/wrapper.rs",
        "sandbox/macos_sandbox.rs",
        "network/mod.rs",
        "network/bridge.rs",
        "sandbox/linux_sandbox.rs",
        "mcp/mod.rs",
        "mcp/client.rs",
    ],
    crate_root = "mod.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//src/server/telemetry:server_telemetry",
        "@crates//:chrono",
        "@crates//:opentelemetry",
        "@crates//:regex",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sqlx",
        "@crates//:tokio",
        "@crates//:tree-sitter",
        "@crates//:tree-sitter-bash",
        "@crates//:uuid",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
)

load("@rules_rust//rust:defs.bzl", "rust_test")

rust_test(
    name = "server_harness_test",
    crate = ":server_harness",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@crates//:tokio",
    ],
)
