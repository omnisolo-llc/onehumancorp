load("@rules_rust//rust:defs.bzl", "rust_library")
load("@rules_go//go:def.bzl", "go_library", "go_test")

rust_library(
    name = "server_harness",
    srcs = [
        "executor.rs",
        "mod.rs",
        "telemetry/mod.rs",
        "telemetry/store.rs",
        "sandbox/mod.rs",
        "sandbox/manager.rs",
        "sandbox/ast.rs",
        "sandbox/permissions.rs",
        "sandbox/wrapper.rs",
    ],
    crate_root = "mod.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//src/server/telemetry:server_telemetry",
        "@crates//:chrono",
        "@crates//:opentelemetry",
        "@crates//:regex",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sqlx",
        "@crates//:tokio",
        "@crates//:tree-sitter",
        "@crates//:tree-sitter-bash",
        "@crates//:uuid",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
)

go_library(
    name = "harness_go",
    srcs = ["sandbox_manager.go"],
    importpath = "github.com/onehumancorp/mono/src/server/harness",
    visibility = ["//visibility:public"],
)

go_test(
    name = "harness_go_test",
    srcs = ["sandbox_manager_test.go"],
    embed = [":harness_go"],
)
