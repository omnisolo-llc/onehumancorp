package autodream

import (
	"context"
	"fmt"
	"time"

	"github.com/onehumancorp/mono/src/server/auth"
	"github.com/onehumancorp/mono/src/server/memory"
)

type LLMClient interface {
	Reason(ctx context.Context, prompt string) (string, error)
	GenerateEmbedding(ctx context.Context, text string) ([]float32, error)
}

type Service struct {
	vectorRepo *memory.VectorRepository
	llm        LLMClient
}

func NewService(vectorRepo *memory.VectorRepository, llm LLMClient) *Service {
	return &Service{
		vectorRepo: vectorRepo,
		llm:        llm,
	}
}

func (s *Service) PruneStaleMemories(ctx context.Context, organizationID string, olderThan time.Time) error {
	return s.vectorRepo.Prune(ctx, organizationID, olderThan)
}

func (s *Service) Consolidate(ctx context.Context, taskID string, logs []string) error {
	// 1. Gather text
	var combinedLogs string
	for _, log := range logs {
		combinedLogs += log + "\n"
	}

	if len(combinedLogs) == 0 {
		return nil // Nothing to consolidate
	}

	// 2. Synthesize
	prompt := fmt.Sprintf("Summarize the key technical decisions, user preferences, and permanent facts from these logs:\n%s", combinedLogs)
	summary, err := s.llm.Reason(ctx, prompt)
	if err != nil {
		return fmt.Errorf("failed to synthesize memory: %w", err)
	}

	// 3. Embed
	embedding, err := s.llm.GenerateEmbedding(ctx, summary)
	if err != nil {
		return fmt.Errorf("failed to generate embedding: %w", err)
	}

	claims := auth.ClaimsFromContext(ctx)
	if claims == nil || claims.OrganizationID == "" {
		return fmt.Errorf("unauthorized: missing claims or organization ID")
	}

	// 4. Conflict Resolution
	// Find top 5 similar memories to detect conflicts
	similarMemories, searchErr := s.vectorRepo.SemanticSearch(ctx, claims.OrganizationID, embedding, 5)
	if searchErr != nil {
		return fmt.Errorf("failed to search similar memories for conflict resolution: %w", searchErr)
	}

	if len(similarMemories) > 0 {
		var memoryContext string
		for _, sm := range similarMemories {
			memoryContext += fmt.Sprintf("- ID: %s, Content: %s\n", sm.ID, sm.Content)
		}

		conflictPrompt := fmt.Sprintf(`Detect any conflicting facts between the new context and existing memories.
If conflicts exist, resolve them based on recency (prefer new context) and synthesize a final consolidated memory.
If there are no conflicts, output the New Context exactly as it is, and an empty list of conflicting IDs.
Respond in JSON format like this:
{
  "consolidated_memory": "The resolved text",
  "conflicting_ids": ["mem-id-1", "mem-id-2"]
}
Existing Memories:
%s
New Context:
%s`, memoryContext, summary)

		// Parse the JSON response
		type ConflictResolution struct {
			ConsolidatedMemory string   `json:"consolidated_memory"`
			ConflictingIDs     []string `json:"conflicting_ids"`
		}

		resolutionJson, reasonErr := s.llm.Reason(ctx, conflictPrompt)
		if reasonErr == nil && resolutionJson != "" {
			var resolution ConflictResolution
			// Using regex or direct unmarshal to parse LLM json output
			// In production, we'd ensure valid JSON, but let's just attempt Unmarshal.
			if err := json.Unmarshal([]byte(resolutionJson), &resolution); err == nil {
				if len(resolution.ConflictingIDs) > 0 && resolution.ConsolidatedMemory != "" {
					newEmbedding, embedErr := s.llm.GenerateEmbedding(ctx, resolution.ConsolidatedMemory)
					if embedErr == nil {
						summary = resolution.ConsolidatedMemory
						embedding = newEmbedding

						// Only delete actual conflicting memories as specified by the LLM
						_ = s.vectorRepo.Delete(ctx, resolution.ConflictingIDs)
					}
				}
			}
		}
	}

	// 5. Persist
	record := &memory.EmbeddingRecord{
		ID:           taskID + "-summary", // Simplification
		OrganizationID: claims.OrganizationID,           // Secure isolation
		MemoryType:   "TASK_SUMMARY",
		Content:      summary,
		Embedding:    embedding,
		CreatedAt:    time.Now(),
		SourceTaskID: taskID,
	}

	if err := s.vectorRepo.Upsert(ctx, record); err != nil {
		return fmt.Errorf("failed to upsert memory record: %w", err)
	}

	return nil
}
