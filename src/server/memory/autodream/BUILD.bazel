go_test(
    name = "autodream_test",
    srcs = ["service_test.go"],
    embed = [":autodream"],
    deps = [
        "//src/server/auth",
        "//src/server/db",
        "//src/server/memory",
        "@org_modernc_sqlite//:sqlite",
    ],
