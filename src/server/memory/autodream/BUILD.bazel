load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "autodream",
    srcs = [
        "pipeline.go",
        "service.go",
        "consolidator.go",
    ],
    importpath = "github.com/onehumancorp/mono/src/server/memory/autodream",
    visibility = ["//visibility:public"],
    deps = [
        "//src/server/memory",
        "//src/server/auth",
        "//src/server/db",
        "//src/server/telemetry",
        "@com_github_fsnotify_fsnotify//:fsnotify",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "autodream_test",
    srcs = [
        "service_test.go",
        "consolidator_test.go",
    ],
    embed = [":autodream"],
    deps = [
        "//src/server/db",
        "//src/server/memory",
        "//src/server/auth",
    ],
)
