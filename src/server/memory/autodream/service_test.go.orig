package autodream

import (
	"context"
	"database/sql"
	"testing"
	"time"

	"github.com/onehumancorp/mono/src/server/auth"
	"github.com/onehumancorp/mono/src/server/db"
	"github.com/onehumancorp/mono/src/server/memory"
	_ "modernc.org/sqlite"
)

type mockLLM struct {
	reasonCount int
	conflictMode bool
}

func (m *mockLLM) Reason(ctx context.Context, prompt string) (string, error) {
	m.reasonCount++
	if m.conflictMode && m.reasonCount > 1 {
		return `{"consolidated_memory": "Resolved summary", "conflicting_ids": ["mem-1"]}`, nil
	}
	return "Mock summary", nil
}

func (m *mockLLM) GenerateEmbedding(ctx context.Context, text string) ([]float32, error) {
	return []float32{0.1, 0.2, 0.3}, nil
}

func TestAutoDreamConsolidation(t *testing.T) {
	dbConn, err := sql.Open("sqlite", ":memory:")
	if err != nil {
		t.Fatalf("failed to open test sqlite db: %v", err)
	}
	defer dbConn.Close()

	provider := db.NewSqliteProvider(dbConn)
	claims := &auth.Claims{OrganizationID: "test-tenant-123"}
	ctx := context.WithValue(context.Background(), auth.ClaimsContextKeyForTest, claims)

	_, err = provider.Exec(ctx, `CREATE TABLE IF NOT EXISTS autodream_memories_master (
		id VARCHAR PRIMARY KEY,
		organization_id VARCHAR NOT NULL,
		memory_type TEXT NOT NULL,
		content TEXT NOT NULL,
		embedding BLOB,
		created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
		source_task_id VARCHAR
	);`)
	if err != nil {
		t.Fatalf("failed to create table: %v", err)
	}

	repo := memory.NewVectorRepository(provider)
	llm := &mockLLM{}
	service := NewService(repo, llm)

	err = service.Consolidate(ctx, "task-123", []string{"log 1", "log 2"})
	if err != nil {
		t.Errorf("expected no error, got %v", err)
	}

	results, _ := repo.SemanticSearch(ctx, "test-tenant-123", []float32{0.1, 0.2, 0.3}, 10)
	if len(results) != 1 {
		t.Fatalf("expected 1 result, got %d", len(results))
	}
	if results[0].Content != "Mock summary" {
		t.Errorf("expected Mock summary")
	}

	// Test conflict resolution mode
	llm.conflictMode = true
	llm.reasonCount = 0 // reset
	err = service.Consolidate(ctx, "task-456", []string{"log 3", "log 4"})
	if err != nil {
		t.Errorf("expected no error, got %v", err)
	}

	results, _ = repo.SemanticSearch(ctx, "test-tenant-123", []float32{0.1, 0.2, 0.3}, 10)
	if len(results) != 1 {
		t.Fatalf("expected 1 result after conflict resolution, got %d", len(results))
	}
	if results[0].Content != "Resolved summary" {
		t.Errorf("expected Resolved summary, got %s", results[0].Content)
	}

	// Test PruneStaleMemories
	err = service.PruneStaleMemories(ctx, "test-tenant-123", time.Now().Add(1 * time.Hour))
	if err != nil {
		t.Errorf("expected no error from prune")
	}
	results, _ = repo.SemanticSearch(ctx, "test-tenant-123", []float32{0.1, 0.2, 0.3}, 10)
	if len(results) != 0 {
		t.Fatalf("expected 0 results after pruning, got %d", len(results))
	}
}
