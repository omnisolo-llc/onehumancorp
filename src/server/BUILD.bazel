# Filtered module targets are useful for local debugging, but each one builds a
# separate test harness for server_lib. Keep them out of wildcard test runs.
[
    rust_test(
        name = module + "_unit_test",
        size = "large",
        args = [
            "--test",
            module,
        ],
        crate = ":server_lib",
        data = ["//src/server/migrations"] + ["//deploy/scripts:ohc-standalone.sh"],
        edition = "2024",
        env = {
            "RUST_TEST_THREADS": "1",
        },
        proc_macro_deps = [
            "@crates//:async-trait",
        ],
        tags = ["manual"],
        target_compatible_with = select({
            "@platforms//os:linux": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
            "@crates//:tempfile",
            "@crates//:tokio-tungstenite",
        ],
    )
    for module in [
        "analytics",
        "benchmarks",
        "chaos",
        "db",
        "hub",
        "msgbus",
        "pipeline",
        "powersync",
        "scheduler",
        "settings",
        "tasks",
        "ultraplan",
        "orchestration",
        "interop",
        "domain",
        "workers",
        "builder",
    ]
]

