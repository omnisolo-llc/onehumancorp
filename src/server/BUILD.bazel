        "@crates//:tree-sitter-bash",
        "@crates//:walkdir",
        "@crates//:temp-env",
    ],
)

rust_binary(
    name = "server",
    srcs = ["main.rs"],
    edition = "2024",
    compile_data = ["//src/server/services:srcs"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/proto:mcp_proxy_tonic",
        "//src/proto:mcp_proxy_prost",
        ":server_lib",
        "@crates//:tokio",
    ],
)

# Individual unit test targets for server_lib
[
    rust_test(
        name = module + "_unit_test",
        size = "large",
        crate = ":server_lib",
        args = ["--test", module],
        data = ["//src/server/migrations"] + ["//deploy/scripts:ohc-standalone.sh"],
        edition = "2024",
        env = {
            "RUST_TEST_THREADS": "1",
        },
        proc_macro_deps = [
            "@crates//:async-trait",
        ],
        target_compatible_with = select({
            "@platforms//os:linux": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
            "@crates//:tempfile",
            "@crates//:tokio-tungstenite",
        ],
    )
    for module in [
        "analytics",
        "benchmarks",
        "chaos",
        "db",
        "hub",
        "msgbus",
        "pipeline",
        "powersync",
        "scheduler",
        "settings",
        "tasks",
        "ultraplan",
        "orchestration",
        "interop",
        "workers",
        "builder",
    ]
]

