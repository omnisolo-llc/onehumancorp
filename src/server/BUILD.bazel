rust_test(
    name = "hybridfsmcp_unit_test",
    size = "large",
    args = [
        "--test",
        "tools::hybridfsmcp",
    ],
    crate = ":server_lib",
    data = ["//src/server/migrations"] + ["//deploy/scripts:ohc-standalone.sh"],
    edition = "2024",
    env = {
        "RUST_TEST_THREADS": "1",
    },
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    tags = ["manual"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@crates//:serde_json",
        "@crates//:sqlx",
        "@crates//:temp-env",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)

