load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    data = [
        "//src/proto:agent_service.proto",
        "//src/proto:common.proto",
        "//src/proto:hub.proto",
        "//src/proto:organization.proto",
        "@protobuf//:protoc",
    ],
    edition = "2021",
    deps = [
        "@crates//:tonic-build",
    ],
)

rust_binary(
    name = "server-rust",
    srcs = glob(["**/*.rs"]),
    data = glob(["migrations/*.sql"]),
    edition = "2021",
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":build_script",
        "@crates//:aes-gcm",
        "@crates//:axum",
        "@crates//:base64",
        "@crates//:bcrypt",
        "@crates//:chrono",
        "@crates//:config",
        "@crates//:ed25519-dalek",
        "@crates//:flate2",
        "@crates//:hex",
        "@crates//:hmac",
        "@crates//:jsonwebtoken",
        "@crates//:opentelemetry",
        "@crates//:prost",
        "@crates//:rand",
        "@crates//:redis",
        "@crates//:regex",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:serde_yaml",
        "@crates//:sha2",
        "@crates//:sqlx",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
        "@crates//:uuid",
        "@crates//:walkdir",
    ],
)

rust_test(
    name = "server_test",
    srcs = glob(["**/*.rs"]),
    crate_root = "main.rs",
    data = glob(["migrations/*.sql"]),
    edition = "2021",
    size = "large",
    env = {
        "RUST_TEST_THREADS": "1",
    },
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    deps = [
        ":build_script",
        "@crates//:aes-gcm",
        "@crates//:base64",
        "@crates//:bcrypt",
        "@crates//:chrono",
        "@crates//:config",
        "@crates//:ed25519-dalek",
        "@crates//:flate2",
        "@crates//:futures",
        "@crates//:hex",
        "@crates//:hmac",
        "@crates//:jsonwebtoken",
        "@crates//:opentelemetry",
        "@crates//:prost",
        "@crates//:rand",
        "@crates//:redis",
        "@crates//:regex",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:serde_yaml",
        "@crates//:sha2",
        "@crates//:sqlx",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
        "@crates//:uuid",
        "@crates//:axum",
        "@crates//:walkdir",
    ],
)

rust_test(
    name = "crypto_test",
    srcs = ["crypto.rs"],
    crate_root = "crypto.rs",
    edition = "2021",
    deps = [
        "@crates//:aes-gcm",
        "@crates//:base64",
        "@crates//:hmac",
        "@crates//:sha2",
    ],
)

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])
