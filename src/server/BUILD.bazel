        "@crates//:aes-gcm",
        "@crates//:axum",
        "@crates//:async-nats",
        "@crates//:base64",
        "@crates//:bcrypt",
        "@crates//:chrono",
        "@crates//:config",
        "@crates//:dashmap",
        "@crates//:ed25519-dalek",
        "@crates//:flate2",
        "@crates//:futures",
        "@crates//:futures-util",
        "@crates//:hex",
        "@crates//:hmac",
        "@crates//:image",
        "@crates//:jsonwebtoken",
        "@crates//:opentelemetry",
        "@crates//:prost",
        "@crates//:rand",
        "@crates//:redis",
        "@crates//:regex",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
