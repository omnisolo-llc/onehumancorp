rust_test(
    name = "hybridfsmcp_unit_test",
    size = "large",
    args = [
        "--test",
        "tools::hybridfsmcp",
    ],
    crate = ":server_lib",
    data = ["//src/server/migrations"] + ["//deploy/scripts:ohc-standalone.sh"],
    edition = "2024",
    env = {
        "RUST_TEST_THREADS": "1",
    },
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    tags = ["manual"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@crates//:serde_json",
        "@crates//:sqlx",
        "@crates//:temp-env",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)

rust_binary(
    name = "server",
    srcs = ["main.rs"],
    compile_data = ["//src/server/services:srcs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":server_lib",
        "//src/proto:mcp_proxy_prost",
        "//src/proto:mcp_proxy_tonic",
        "@crates//:tokio",
    ],
)

SERVER_LIB_TEST_FILTER_GROUPS = [
    (
        "server_lib_core_unit_test",
        [
            "analytics",
            "benchmarks",
            "builder",
            "chaos",
            "db",
            "domain",
            "hub",
            "msgbus",
            "pipeline",
            "scheduler",
            "settings",
            "tasks",
            "ultraplan",
        ],
    ),
    (
        "server_lib_orchestration_unit_test",
        [
            "hybrid_sync",
            "interop",
            "orchestration",
            "workers",
        ],
    ),
    (
        "server_lib_sync_tools_unit_test",
        [
            "power_sync",
            "powersync",
            "tools::config_sync",
            "tools::hybridfsmcp",
        ],
    ),
    (
        "server_lib_api_agents_unit_test",
        [
            "agents",
            "api::growth",
        ],
    ),
]

[
    rust_test(
        name = name,
        size = "large",
        args = filters,
        crate = ":server_lib",
        data = ["//src/server/migrations"] + ["//deploy/scripts:ohc-standalone.sh"],
        edition = "2024",
        env = {
            "RUST_TEST_THREADS": "1",
        },
        proc_macro_deps = [
            "@crates//:async-trait",
        ],
        target_compatible_with = select({
            "@platforms//os:linux": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
            "@crates//:serde_json",
            "@crates//:sqlx",
            "@crates//:temp-env",
            "@crates//:tempfile",
            "@crates//:tokio",
            "@crates//:tokio-tungstenite",
            "@crates//:tree-sitter-bash",
            "@crates//:walkdir",
        ],
    )
    for name, filters in SERVER_LIB_TEST_FILTER_GROUPS
]

# Filtered module targets are useful for local debugging, but each one builds a
# separate test harness for server_lib. Keep them out of wildcard test runs.
[
    rust_test(
        name = module + "_unit_test",
        size = "large",
        args = [
            "--test",
            module,
        ],
        crate = ":server_lib",
        data = ["//src/server/migrations"] + ["//deploy/scripts:ohc-standalone.sh"],
        edition = "2024",
        env = {
            "RUST_TEST_THREADS": "1",
        },
        proc_macro_deps = [
            "@crates//:async-trait",
        ],
        tags = ["manual"],
        target_compatible_with = select({
            "@platforms//os:linux": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
            "@crates//:tempfile",
            "@crates//:tokio-tungstenite",
        ],
    )
    for module in [
        "analytics",
        "benchmarks",
        "chaos",
        "db",
        "hub",
        "msgbus",
        "pipeline",
        "powersync",
        "scheduler",
        "settings",
        "tasks",
        "ultraplan",
        "orchestration",
        "interop",
        "domain",
        "workers",
        "builder",
    ]
]

