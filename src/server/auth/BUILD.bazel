exports_files(["Cargo.toml"])

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "server_auth",
    srcs = [
        "grpc.rs",
        "mod.rs",
        "orchestration.rs",
        "postgres_store.rs",
        "sqlite_store.rs",
        "user_repository.rs",
        "multitenancy_isolation.rs",
        "oidc_middleware.rs",

    ],
    edition = "2024",
    crate_root = "mod.rs",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:temp-env",
        "//src/server/config:server_config",
        "//src/server/common:server_common",
        "//src/server/ohc:server_ohc",
        "//src/server/oidc:server_oidc",
        "@crates//:axum",
        "@crates//:bcrypt",
        "@crates//:chrono",
        "@crates//:hex",
        "@crates//:hmac",
        "@crates//:jsonwebtoken",
        "@crates//:rand",
        "@crates//:redis",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:sqlx",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:tracing",
        "@crates//:uuid",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
)

rust_test(
    name = "server_auth_unit_test",
    size = "small",
    crate = ":server_auth",
    edition = "2024",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
