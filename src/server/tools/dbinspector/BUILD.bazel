load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "dbinspector",
    srcs = ["mcp.go"],
    importpath = "github.com/onehumancorp/mono/src/server/tools/dbinspector",
    visibility = ["//visibility:public"],
    deps = [
        "//src/server/auth",
        "//src/server/db",
