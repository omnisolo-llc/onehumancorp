)

go_test(
    name = "dbinspector_test",
    srcs = ["mcp_test.go"],
    embed = [":dbinspector"],
    deps = [
        "//src/server/auth",
        "//src/server/db",
        "@org_modernc_sqlite//:sqlite",
    ],
)
