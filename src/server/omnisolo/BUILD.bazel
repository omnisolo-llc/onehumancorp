exports_files(["Cargo.toml"])

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "server_omnisolo",
    srcs = glob(["src/**/*.rs", "mod.rs", "src/lib.rs", "src/chat/*.rs", "src/chat/**/*.rs"], allow_empty = True),
    edition = "2024",
    rustc_flags = ["--cfg=omnisolo_bazel"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/proto:agent_prost",
        "//src/proto:agent_service_tonic",
        "//src/proto:app_tonic",
        "//src/proto:inventory_tonic",
        "//src/proto:billing_tonic",
        "//src/proto:campaign_tonic",
        "//src/proto:collective_tonic",
        "//src/proto:common_prost",
        "//src/proto:hub_tonic",
        "//src/proto:interop_prost",
        "//src/proto:mcp_proxy_tonic",
        "//src/proto:organization_prost",
        "//src/proto:invoice_tonic",
        "//src/proto:harness_middleware_prost",
        "//src/proto:harness_middleware_tonic",
        "@crates//:tonic",
        "@crates//:tokio",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:uuid",
        "@crates//:chrono",
        "@crates//:dashmap",
        "@crates//:axum",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
)

rust_test(
    name = "server_omnisolo_test",
    crate = ":server_omnisolo",
    edition = "2024",
    rustc_flags = ["--cfg=omnisolo_bazel"],
    deps = [
        "@crates//:tokio",
        "@crates//:uuid",
        "@crates//:chrono",
    ],
)
