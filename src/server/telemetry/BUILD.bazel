exports_files(["Cargo.toml"])

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "server_telemetry",
    srcs = [
        "mod.rs",
        "forecaster.rs",
        "dashboard_test.rs",
    ],
    crate_root = "mod.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//src/server/config:server_config",
        "@crates//:chrono",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sqlx",
        "@crates//:tracing",
        "@crates//:opentelemetry",
        "@crates//:tokio",
        "@crates//:regex",
    ],
)

rust_test(
    name = "server_telemetry_unit_test",
    size = "small",
    crate = ":server_telemetry",
    data = [
        "//src/server/monitoring:dashboards/ohc-hybrid-telemetry.json",
        "//deploy:hybrid_telemetry_dashboard_mirrors",
    ],
    edition = "2024",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

# Added rules for mcp sync worker
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "mcp_sync_worker",
    srcs = ["mcp_sync_worker.go"],
    importpath = "github.com/onehumancorp/mono/src/server/telemetry",
    visibility = ["//visibility:public"],
)

go_test(
    name = "mcp_sync_worker_test",
    srcs = ["mcp_sync_worker_test.go"],
    embed = [":mcp_sync_worker"],
)
