filegroup(
    name = "srcs",
    srcs = [
        "booking.rs",
        "mod.rs",
        "wizard.rs",
        "//src/server/services/agent:srcs",
        "//src/server/services/autodream:srcs",
        "//src/server/services/b2b:srcs",
        "//src/server/services/billing:srcs",
        "//src/server/services/chat:srcs",
        "//src/server/services/dashboard:srcs",
        "//src/server/services/docs:srcs",
        "//src/server/services/growth:srcs",
        "//src/server/services/integration:srcs",
        "//src/server/services/mcp:srcs",
        "//src/server/services/onboarding:srcs",
        "//src/server/services/ops:srcs",
        "//src/server/services/org:srcs",
        "//src/server/services/scheduler:srcs",
        "//src/server/services/sync:srcs",
    ],
    visibility = ["//src/server:__pkg__"]
)

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "services_go",
    srcs = ["task_store.go"],
    importpath = "github.com/onehumancorp/mono/src/server/services",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_google_uuid//:uuid",
    ],
)

go_test(
    name = "services_go_test",
    srcs = ["task_store_test.go"],
    embed = [":services_go"],
    deps = [
        "@com_github_mattn_go_sqlite3//:go_sqlite3",
    ],
)
