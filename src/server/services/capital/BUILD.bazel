load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    [
        "mod.rs",
        "ledger.rs",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "server_services_capital",
    srcs = [
        "mod.rs",
        "ledger.rs",
        "funding_engine.rs",
        "multi_currency_ledger.rs",
        "fx_cache.rs",
    ],
    crate_root = "mod.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:sqlx",
        "@crates//:serde",
        "@crates//:uuid",
        "@crates//:redis",
        "//src/server/common:server_common",
    ],
)

rust_test(
    name = "server_services_capital_unit_test",
    size = "small",
    crate = ":server_services_capital",
    edition = "2024",
    env = {
        "RUST_TEST_THREADS": "1",
    },
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
