load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    [
        "mod.rs",
        "forecast.rs",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "server_services_finance",
    srcs = [
        "mod.rs",
        "forecast.rs",
    ],
    crate_root = "mod.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [],
)

rust_test(
    name = "server_services_finance_unit_test",
    size = "small",
    crate = ":server_services_finance",
    edition = "2024",
    env = {
        "RUST_TEST_THREADS": "1",
    },
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
