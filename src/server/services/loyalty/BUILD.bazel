load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "loyalty",
    srcs = glob(["**/*.rs"]),
    crate_root = "mod.rs",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:serde",
        "@crates//:sqlx",
        "@crates//:rand",
        "@crates//:hex",
        "//src/server:server_lib",
    ],
)

rust_test(
    name = "loyalty_test",
    crate = ":loyalty",
    deps = [
        "@crates//:tokio",
    ],
)
