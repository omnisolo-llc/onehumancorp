load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "server_config",
    srcs = ["mod.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:config",
        "@crates//:serde",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "server_config_unit_test",
    size = "small",
    crate = ":server_config",
    edition = "2024",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
