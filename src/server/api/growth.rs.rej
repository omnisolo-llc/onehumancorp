+#[derive(Deserialize)]
+pub struct StartLeadGenRequest {
+    pub tenant_id: String,
+    pub budget: i64,
+    pub service_radius: String,
+}
+
+#[derive(Serialize)]
+pub struct StartLeadGenResponse {
+    pub campaign: serde_json::Value,
+}
+
+async fn handle_start_lead_gen(
+    Extension(state): Extension<GrowthState>,
+    Json(req): Json<StartLeadGenRequest>,
+) -> impl IntoResponse {
+    let id = uuid::Uuid::new_v4().to_string();
+
+    let payload = serde_json::json!({
+        "campaign_id": id,
+        "budget": req.budget,
+        "service_radius": req.service_radius
+    });
+
+    let job_id = uuid::Uuid::new_v4().to_string();
+    let _ = sqlx::query(
+        "INSERT INTO ohc_job_queue (id, tenant_id, job_type, payload, status) VALUES ($1, $2, 'lead_gen', $3, 'PENDING')"
+    )
+    .bind(&job_id)
+    .bind(&req.tenant_id)
+    .bind(&payload)
+    .execute(&state.pool)
+    .await;
+
+    Json(StartLeadGenResponse {
+        campaign: payload,
+    })
+}
