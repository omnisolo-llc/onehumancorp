load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    [
        "tool.rs",
        "mod.rs",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "server_integrations_hybrid_cache",
    srcs = [
        "bazel_lib.rs",
        "tool.rs",
        "mod.rs",
    ],
    crate_root = "bazel_lib.rs",
    edition = "2024",
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:redis",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "server_integrations_hybrid_cache_test",
    size = "small",
    crate = ":server_integrations_hybrid_cache",
    edition = "2024",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
