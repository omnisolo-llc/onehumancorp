+    pub fn get_twilio_client(&self, integration_id: &str) -> Result<std::sync::Arc<crate::integrations::twilio::provider::TwilioProvider>, String> {
+        let clients = self.twilio_clients.read().unwrap();
+        if let Some(client) = clients.get(integration_id) {
+            return Ok(client.clone());
+        }
+        Err("Twilio client not found".to_string())
+    }
