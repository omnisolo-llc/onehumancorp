load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "server_integrations_printnode",
    srcs = glob(["**/*.rs"]),
    crate_root = "lib.rs",
    visibility = ["//visibility:public"],
    deps = [
        "//src/server/integrations/core:server_integrations_core",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "server_integrations_printnode_test",
    crate = ":server_integrations_printnode",
    deps = [
        "@crates//:tokio",
    ],
)
