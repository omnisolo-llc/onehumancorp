load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "tunnel_proto",
    srcs = ["tunnel.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "tunnel_go_proto",
    compilers = ["@io_bazel_rules_go//proto:go_grpc_v2"],
    importpath = "github.com/onehumancorp/mono/src/server/integrations/mcp_webhook_tunnel",
    proto = ":tunnel_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "mcp_webhook_tunnel",
    srcs = ["relay.go"],
    embed = [":tunnel_go_proto"],
    importpath = "github.com/onehumancorp/mono/src/server/integrations/mcp_webhook_tunnel",
    visibility = ["//visibility:public"],
    deps = [
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//attribute",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//peer",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "mcp_webhook_tunnel_test",
    srcs = ["webhook_tunnel_test.go"],
    deps = [
        ":mcp_webhook_tunnel",
        "//src/server/db",
        "//src/server/tools/mcpwebhooktunnel",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//peer",
        "@org_golang_google_grpc//test/bufconn",
    ],
)
