load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "server_integrations_whatsapp",
    srcs = glob(["*.rs"]),
    crate_root = "mod.rs",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:axum",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:redis",
        "@crates//:sqlx",
        "//src/server:server_lib",
    ],
)

rust_test(
    name = "server_integrations_whatsapp_test",
    crate = ":server_integrations_whatsapp",
    deps = [
        "@crates//:tower-0.4.13",
        "//src/agents/builtin:ohc_builtin_agent_lib",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
)
