rust_test(
    name = "server_integrations_pubsub_unit_test",
    size = "small",
    crate = ":server_integrations_pubsub",
    edition = "2024",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@crates//:tokio",
    ],
)
