load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "server_integrations_pubsub",
    srcs = [
        "mcp.rs",
        "mod.rs",
    ],
    crate_root = "mod.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//src/agents/builtin:ohc_builtin_agent_lib",
        "//src/server/ohc:server_ohc",
        "@crates//:prost",
        "@crates//:uuid",
    ],
