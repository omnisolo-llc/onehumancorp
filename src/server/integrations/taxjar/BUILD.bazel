load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "server_integrations_taxjar",
    srcs = [
        "bazel_lib.rs",
        "client.rs",
        "provider.rs",
    ],
    crate_name = "server_integrations_taxjar",
