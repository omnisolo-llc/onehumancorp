exports_files(["Cargo.toml"])

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(
    [
        "mod.rs",
        "entities.rs",
        "adapter.rs",
        "api.rs",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "server_integrations_chat",
    srcs = [
        "bazel_lib.rs",
        "mod.rs",
        "entities.rs",
        "adapter.rs",
        "api.rs",
    ],
    crate_root = "bazel_lib.rs",
    edition = "2024",
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//src/server/common:server_common",
        "@crates//:axum",
        "@crates//:sea-orm",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sqlx",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "server_integrations_chat_test",
    size = "small",
    crate = ":server_integrations_chat",
    edition = "2024",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
