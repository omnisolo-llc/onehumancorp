exports_files(["Cargo.toml"])

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "server_ohc",
    srcs = [
        "mod.rs",
        "omnichannel/mod.rs",
        "omnichannel/models.rs",
        "omnichannel/repository.rs",
        "omnichannel/repository_tests.rs",
    ],
    crate_root = "mod.rs",
    edition = "2024",
    rustc_flags = ["--cfg=ohc_bazel"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/proto:agent_proto",
        "//src/proto:agent_service_proto",
        "//src/proto:app_proto",
        "//src/proto:billing_proto",
        "//src/proto:campaign_proto",
        "//src/proto:collective_proto",
        "//src/proto:common_proto",
        "//src/proto:hub_proto",
        "//src/proto:interop_proto",
        "//src/proto:inventory_proto",
        "//src/proto:invoice_proto",
        "//src/proto:mcp_proxy_proto",
        "//src/proto:organization_proto",
        "@crates//:async-trait",
        "@crates//:chrono",
        "@crates//:prost",
        "@crates//:serde",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "server_ohc_test",
    crate = ":server_ohc",
    rustc_flags = ["--cfg=ohc_bazel"],
)
