)

rust_binary(
    name = "omnisolo-harness-worker",
    srcs = ["main.rs"],
    crate_root = "main.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":omnisolo_harness_worker",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
    ],
