exports_files(["Cargo.toml"], visibility = ["//visibility:public"])

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

rust_library(
    name = "omnisolo_harness_worker",
    srcs = ["lib.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//src/server/harness:server_harness",
        "//src/server/ohc:server_ohc",
        "@crates//:axum",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:serde_json",
