load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "mcp",
    srcs = [
        "blob_sync.go",
        "config_sync.go",
        "config_sync_api.go",
        "log_tool.go",
        "proxy.go",
        "secrets.go",
        "tools.go",
    ],
    importpath = "github.com/onehumancorp/mono/src/server/interop/mcp",
    visibility = ["//visibility:public"],
    deps = [
        "//src/server/auth",
        "//src/server/db",
        "@com_github_google_uuid//:uuid",
    ],
)

go_test(
    name = "mcp_test",
    srcs = [
        "blob_sync_test.go",
        "config_sync_api_test.go",
        "config_sync_coverage_test.go",
        "config_sync_e2e_test.go",
        "config_sync_test.go",
        "log_tool_coverage_test.go",
        "log_tool_test.go",
        "proxy_test.go",
        "secrets_test.go",
        "tools_test.go",
    ],
    embed = [":mcp"],
    deps = [
        "//src/server/auth",
        "//src/server/db",
        "@com_github_google_uuid//:uuid",
    ],
)

go_test(
    name = "tools_test",
    srcs = ["tools_test.go"],
    embed = [":mcp"],
    deps = [
        "//src/server/db",
        "@com_github_google_uuid//:uuid",
    ],
)
