load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files([
    "mod.rs",
    "engine.rs",
    "router.rs",
], visibility = ["//visibility:public"])

rust_library(
    name = "voice",
    srcs = glob(["**/*.rs"]),
    crate_root = "mod.rs",
    visibility = ["//visibility:public"],
    rustc_flags = ["--cfg=ohc_bazel_package"],
    deps = [
        "//src/server/domain:server_domain",
        "//src/server/integrations/twilio:server_integrations_twilio",
        "//src/server:minimax",
        "//src/server/orchestration:server_orchestration",
        "//src/server/telemetry:server_telemetry",
        "@crates//:chrono",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sqlx",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:uuid",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
)

rust_test(
    name = "voice_test",
    crate = ":voice",
    rustc_flags = ["--cfg=ohc_bazel_package"],
    deps = [
        "@crates//:tokio",
    ],
)
