load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "ohc_chat",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:tokio",
        "@crates//:axum",
        "@crates//:sqlx",
        "@crates//:uuid",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:chrono",
        "@crates//:futures",
        "@crates//:tower",
        "@crates//:tower_http",
        "@crates//:tracing",
        "@crates//:tracing_subscriber",
        "@crates//:anyhow",
    ],
)

rust_test(
    name = "ohc_chat_test",
    crate = ":ohc_chat",
    deps = [
        "@crates//:reqwest",
        "@crates//:tokio_tungstenite",
    ],
)
