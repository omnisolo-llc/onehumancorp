load("@rules_go//go:def.bzl", "go_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

# ── Go LLM client library ──────────────────────────────────────────────────────
# Provides the LLMClient interface, Tool type, and concrete LLM client
# implementations (Anthropic, OpenAI, Ollama) used by autodream_pipeline,
# mcp/client_manager, and mcp_config_sync.
go_library(
    name = "builtin",
    srcs = [
        "llm_anthropic.go",
        "llm_ollama.go",
        "llm_openai.go",
        "tools.go",
        "types.go",
    ],
    importpath = "github.com/onehumancorp/mono/src/server/agents/builtin",
    visibility = ["//visibility:public"],
    deps = [
        "//src/server_old/telemetry",
        "//src/server_old/utils",
    ],
)

# Rust sources include pre-generated proto code in src/gen/.
# No protoc dependency needed in the Bazel build.
RUST_DEPS = [
    "@crates//:base64",
    "@crates//:chrono",
    "@crates//:flate2",
    "@crates//:futures",
    "@crates//:glob",
    "@crates//:hex",
    "@crates//:hmac",
    "@crates//:once_cell",
    "@crates//:prost",
    "@crates//:rand",
    "@crates//:regex",
    "@crates//:reqwest",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:sha2",
    "@crates//:tokio",
    "@crates//:tokio-stream",
    "@crates//:tonic",
    "@crates//:tracing",
    "@crates//:tracing-subscriber",
    "@crates//:urlencoding",
    "@crates//:uuid",
]

# Proc-macro crates must be in proc_macro_deps, not deps.
RUST_PROC_MACRO_DEPS = [
    "@crates//:async-recursion",
    "@crates//:async-trait",
]

# Rust targets moved to src/BUILD.bazel
