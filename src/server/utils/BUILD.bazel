load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "server_utils",
    srcs = [
        "payload_validator.rs",
        "sip_protocol.rs",
        "cache.rs",
        "compression_test.rs",
        "dialect.rs",
        "fs.rs",
        "json_minify.rs",
        "mod.rs",
        "slug.rs",
        "tier_middleware.rs",
    ],
    crate_root = "mod.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//src/server/config:server_config",
        "//src/server/auth:server_auth",
        "//src/server/pricing:server_pricing",
        "@crates//:axum",
        "@crates//:tower-http",
        "@crates//:base64",
        "@crates//:chrono",
        "@crates//:flate2",
        "@crates//:futures",
        "@crates//:rand",
        "@crates//:redis",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sqlx",
        "@crates//:tokio",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "server_utils_test",
    crate = ":server_utils",
    edition = "2024",
    deps = [
        "@crates//:tower",
        "@crates//:reqwest",
    ],
)
