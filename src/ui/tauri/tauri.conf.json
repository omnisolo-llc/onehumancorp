{
  "$schema": "https://v2.tauri.app/schemas/2.0.0/config.schema.json",
  "productName": "OHC",
  "version": "0.4.44+1",
  "identifier": "com.onehumancorp.ohc",
  "build": {
    "frontendDist": "./next_out",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OHC",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
