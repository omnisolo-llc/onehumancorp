{
  "$schema": "https://v2.tauri.app/schemas/2.0.0/config.schema.json",
  "productName": "App",
  "version": "0.4.42+1",
  "identifier": "com.app.desktop",
  "build": {
    "frontendDist": "./next_out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cd ../next && npm run dev",
    "beforeBuildCommand": "cd ../next && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "App",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}