# Tauri v2 Desktop Application
# Build with: cd src/ui/tauri && cargo build --release
# Or use: bazel run //src/ui/tauri:app

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//bazel/rules:tauri_mobile.bzl", "tauri_mobile_package")

bool_flag(
    name = "build_tauri",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "tauri_enabled",
    flag_values = {
        ":build_tauri": "true",
    },
)

genrule(
    name = "tauri_ui_build",
    srcs = glob(["tauri-ui/**", "tauri-ui/**/*"]),
    outs = [
        "tauri-ui/dist",
    ],
    cmd = """
TMP_UI=$$(mktemp -d)
cp -R src/ui/tauri/tauri-ui/* $$TMP_UI/
cd $$TMP_UI
npm install
npm run build
mkdir -p $(@D)/tauri-ui
cp -R dist $(@D)/tauri-ui/
""",
    target_compatible_with = select({
        ":tauri_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

genrule(
    name = "tauri_context",
    srcs = [
        "tauri.conf.json",
        "capabilities/default.json",
        "tauri-ui/dist",
    ],
    outs = [
        "tauri_out/acl-manifests.json",
        "tauri_out/capabilities.json",
        "context/index.html",
        "tauri-build-context.rs",
        "tauri_config.json",
    ],
    cmd = """
mkdir -p $(@D)/tauri_out $(@D)/context
cp $(location capabilities/default.json) $(@D)/tauri_out/capabilities.json

# If there is a dummy index.html needed for build macro context parsing
if [ -f "$(location tauri-ui/dist)/index.html" ]; then
    cp $(location tauri-ui/dist)/index.html $(@D)/context/index.html
else
    echo "<html></html>" > $(@D)/context/index.html
fi

cp $(location tauri.conf.json) $(@D)/tauri_config.json
cat > $(@D)/tauri_out/acl-manifests.json << 'ACL_EOF'
{
  "core": {
    "default_permission": {
      "identifier": "default",
      "description": "Default core permissions.",
      "permissions": ["default"]
    },
    "permissions": {},
    "permission_sets": {},
    "global_scope_schema": null
  },
  "shell": {
    "default_permission": null,
    "permissions": {},
    "permission_sets": {},
    "global_scope_schema": null
  }
}
ACL_EOF
cat > $(@D)/tauri-build-context.rs << 'CTX_EOF'
use tauri::Context;
use tauri::utils::config::Config;
use std::collections::BTreeMap;
use std::borrow::Cow;

pub fn tauri_context() -> Context<tauri::Wry> {
    let config: Config = serde_json::from_str(include_str!("tauri_config.json")).expect("failed to parse tauri_config.json");
    let package_info = tauri::PackageInfo {
        name: "OHC".into(),
        version: "0.4.45".parse().expect("invalid version"),
        authors: "",
        description: "",
        crate_name: "app",
    };
    let pattern = tauri::Pattern::Brownfield;
    let runtime_authority = tauri::ipc::RuntimeAuthority::new(
        BTreeMap::new(),
        tauri::utils::acl::resolved::Resolved::default(),
    );
    // When using frontendDist in v2, context macro can typically build with a dummy asset map
    // because standard filesystem resolution will overlay it.
    let assets = tauri::utils::assets::EmbeddedAssets::default();
    Context::new(
        config,
        Box::new(assets),
        None,
        None,
        package_info,
        pattern,
        runtime_authority,
        None,
    )
}
CTX_EOF
""",
    target_compatible_with = select({
        ":tauri_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

rust_library(
    name = "app_lib",
    srcs = ["src/lib.rs"],
    compile_data = [
        ":tauri_context",
    ],
    edition = "2024",
    rustc_env = {
        "TAURI_ENV_TARGET_TRIPLE": "x86_64-unknown-linux-gnu",
        "OUT_DIR": "bazel-out/k8-fastbuild/bin/src/ui/tauri",
    },
    rustc_flags = [
        "--cfg=ohc_bazel_tauri_context",
    ],
    target_compatible_with = select({
        ":tauri_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tauri",
        "@crates//:tauri-plugin-shell",
        "@crates//:tauri-plugin-updater",
    ],
)

rust_binary(
    name = "app",
    srcs = ["src/main.rs"],
    edition = "2024",
    target_compatible_with = select({
        ":tauri_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":app_lib",
    ],
)

TAURI_MOBILE_SRCS = glob([
    "src/**/*.rs",
    "capabilities/**",
    "icons/**",
    "tauri-ui/**",
]) + [
    "//:Cargo.lock",
    "//:Cargo.toml",
    "Cargo.toml",
    "build.rs",
    "tauri.conf.json",
]

tauri_mobile_package(
    name = "tauri_android_apk",
    srcs = TAURI_MOBILE_SRCS,
    out = "ohc-android-aarch64.apk",
    android_sdk = "@tauri_android_sdk//:sdk",
    android_sdk_root = "@tauri_android_sdk//:.sdk_root",
    package_type = "apk",
    target_compatible_with = select({
        "//:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

tauri_mobile_package(
    name = "tauri_android_aab",
    srcs = TAURI_MOBILE_SRCS,
    out = "ohc-android-aarch64.aab",
    android_sdk = "@tauri_android_sdk//:sdk",
    android_sdk_root = "@tauri_android_sdk//:.sdk_root",
    package_type = "aab",
    target_compatible_with = select({
        "//:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

tauri_mobile_package(
    name = "tauri_ios_ipa",
    srcs = TAURI_MOBILE_SRCS,
    out = "ohc-ios-aarch64.ipa",
    ios_export_method = "app-store-connect",
    package_type = "ipa",
    target_compatible_with = select({
        "//:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)
