# Quarantined historical Playwright contracts that used synthetic browser or
# service data. The suffix deliberately excludes them from E2E discovery while
# keeping the migration debt visible and queryable.
filegroup(
    name = "legacy_playwright_mock_contracts",
    srcs = glob([], allow_empty=True), #


    # ]),
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "next_app_e2e_data",
    srcs = glob(
        [
            "src/**",
            "public/**",


            "*.mjs",
            "*.mts",
            "*.json",
            "*.ts",
            "*.png",
        ],
        exclude = [
            "src/e2e/**",
            "src/**/*.test.ts",
            "src/**/*.test.tsx",
        ],
    ) + [
        ":node_modules",
    ],
    visibility = ["//visibility:public"],
)

