import { Button, VerticalBox, HorizontalBox, LineEdit, ComboBox, CheckBox, TextEdit } from "std-widgets.slint";

export component AgentConfig inherits Window {
    title: "AI Agent Configuration";
    width: 800px;
    height: 600px;

    in-out property <bool> advanced-mode: false;

    // Theme
    property <color> bg-color: #0A0A0A;
    property <color> text-color: #FFFFFF;
    property <color> text-muted: #A0A0A0;

    background: bg-color;

    VerticalBox {
        padding: 40px;
        spacing: 20px;

        Text {
            text: "Manage my AI team";
            font-size: 24px;
            color: text-color;
        }

        HorizontalBox {
            spacing: 20px;

            // Customer Support
            VerticalBox {
                Text { text: "Customer Support"; color: text-color; }
                CheckBox { text: "Reply to customer messages"; }
                Button { text: "Add to my team"; }
            }

            // Social Media Manager
            VerticalBox {
                Text { text: "Social Media Manager"; color: text-color; }
                CheckBox { text: "Post to Instagram & Facebook"; }
                Button { text: "Add to my team"; }
            }

            // SEO Booster
            VerticalBox {
                Text { text: "SEO Booster"; color: text-color; }
                CheckBox { text: "Write product descriptions"; }
                Button { text: "Add to my team"; }
            }

            // Order Manager
            VerticalBox {
                Text { text: "Order Manager"; color: text-color; }
                CheckBox { text: "Send order updates"; }
                Button { text: "Add to my team"; }
            }
        }

        Text {
            text: "How often should this agent work?";
            color: text-color;
            margin-top: 20px;
        }

        HorizontalBox {
            Button { text: "Real-time"; }
            Button { text: "Hourly"; }
            Button { text: "Daily"; }
            Button { text: "Weekly"; }
        }

        Button {
            text: "Activate";
            margin-top: 40px;
        }
    }
}
