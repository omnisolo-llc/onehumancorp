    "agent_service.proto",
    "app.proto",
    "billing.proto",
    "common.proto",
    "docs.proto",
    "hub.proto",
    "model.proto",
    "organization.proto",
    "skills.proto",
], visibility = ["//visibility:public"])

# ── Hub / Orchestration ────────────────────────────────────────────────────────

