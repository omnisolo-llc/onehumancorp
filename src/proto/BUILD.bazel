load("@rules_proto//proto:defs.bzl", "proto_library")
load("//bazel/rules:proto_go_grpc_library.bzl", "proto_go_grpc_library", "go_proto_library_with_tags")
load("//bazel/rules:proto_ts_library.bzl", "proto_ts_library")
load("//bazel/rules:proto_dart_library.bzl", "proto_dart_library")

# ── Hub / Orchestration ────────────────────────────────────────────────────────

proto_library(
    name = "hub_proto",
    srcs = ["hub.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library_with_tags(
    name = "hub_go_proto",
    protos = ["hub.proto"],
    importpath = "github.com/onehumancorp/mono/src/proto",
    visibility = ["//visibility:public"],
)

proto_ts_library(
    name = "proto_types_ts",
    protos = ":hub_proto",
    visibility = ["//visibility:public"],
)

proto_dart_library(
    name = "hub_dart_proto",
    protos = ":hub_proto",
    use_grpc = True,
    visibility = ["//visibility:public"],
)

