load("@rules_flutter//flutter:defs.bzl", "flutter_library", "flutter_test")

package(default_visibility = ["//src/app:__subpackages__"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["*.dart", "help/*.dart"],
        allow_empty = True,
    ) + ["BUILD.bazel"],
    visibility = ["//src/app:__pkg__"],
)

filegroup(
    name = "dart_srcs",
    srcs = glob(
        ["*.dart", "help/*.dart"],
        allow_empty = True,
        exclude = ["*_test.dart"],
    ),
    visibility = ["//src/app:__pkg__"],
)

# All widget sources in ONE library → single pub-prepare action.
flutter_library(
    name = "widgets_lib",
    srcs = glob(
        ["*.dart", "help/*.dart"],
        exclude = ["*_test.dart"],
    ),
    pubspec = "//src/app:pubspec.yaml",
    workspace_pubspec = "//:pubspec.yaml",
    deps = [
        "//src/app/lib/models:models_lib",
        "@flutter_sdk//flutter/packages/flutter",
        "@pub_web_socket_channel//:web_socket_channel",
    ],
)

alias(
    name = "org_tree_widget",
    actual = ":widgets_lib",
)

alias(
    name = "slide_to_approve",
    actual = ":widgets_lib",
)

alias(
    name = "sub_agent_queue_widget",
    actual = ":widgets_lib",
)


WIDGET_TESTS = glob(["**/*_test.dart"])

[
    flutter_test(
        name = file.replace(".dart", "").replace("/", "_"),
        srcs = [file],
        embed = ["//src/app:app_for_tests"],
        test_files = [file],
        workspace_pubspec = "//:pubspec.yaml",
    )
    for file in WIDGET_TESTS
]

test_suite(
    name = "all_tests",
    tags = ["manual"],
    tests = [":" + file.replace(".dart", "").replace("/", "_") for file in WIDGET_TESTS],
)
