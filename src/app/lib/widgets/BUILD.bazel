load("@rules_flutter//flutter:defs.bzl", "flutter_library")

package(default_visibility = ["//src/app:__subpackages__"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["*.dart", "help/*.dart"],
        allow_empty = True,
    ) + ["BUILD.bazel"],
    visibility = ["//src/app:__pkg__"],
)

filegroup(
    name = "dart_srcs",
    srcs = glob(
        ["*.dart", "help/*.dart"],
        allow_empty = True,
        exclude = ["*_test.dart"],
    ),
    visibility = ["//src/app:__pkg__"],
)

# All widget sources in ONE library → single pub-prepare action.
flutter_library(
    name = "widgets_lib",
    srcs = glob(
        ["*.dart", "help/*.dart"],
        exclude = ["*_test.dart"],
    ),
    pubspec = "//src/app:pubspec.yaml",
    workspace_pubspec = "//:pubspec.yaml",
    deps = [
        "//src/app/lib/models:models_lib",
        "@flutter_sdk//flutter/packages/flutter",
        "@pub_web_socket_channel//:web_socket_channel",
    ],
)

alias(
    name = "org_tree_widget",
    actual = ":widgets_lib",
)

alias(
    name = "slide_to_approve",
    actual = ":widgets_lib",
)

alias(
    name = "sub_agent_queue_widget",
    actual = ":widgets_lib",
)
