import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Diagnostics inherits Window {
    min-width: 375px;
    preferred-width: 500px;
    height: 600px;
    title: "Diagnostics Dashboard";
    out property <string> test_title: root.title;

    callback run_diagnostics();
    in-out property <string> db_status: "Connected";
    in-out property <string> cache_status: "Connected";
    in-out property <string> ai_status: "Connected";
    in-out property <string> execution_mode: "STANDALONE";
    in-out property <string> cloud_connectivity: "CONNECTED";
    in-out property <string> mesh_status: "ACTIVE";
    in-out property <int> stuck_missions: 0;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        Text { text: "Day One Setup Health Check"; font-size: 20px; font-weight: 700; color: #1e293b; horizontal-alignment: center; }

        VerticalBox {
            spacing: 10px;
            
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 12px;
                    Text { text: "🗄️ Business Records"; color: #1e293b; }
                    Rectangle {}
                    Text { text: "Connected"; color: #10b981; }
                }
            }
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 12px;
                    Text { text: "🧠 Memory"; color: #1e293b; }
                    Rectangle {}
                    Text { text: "Connected"; color: #10b981; }
                }
            }
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 12px;
                    Text { text: "🧠 AI Connections"; color: #1e293b; }
                    Rectangle {}
                    Text { text: "Connected"; color: #10b981; }
                }
            }
        }

        Text { text: "Hybrid Health Status"; font-size: 20px; font-weight: 700; color: #1e293b; }

        VerticalBox {
            spacing: 8px;
            
            HorizontalBox {
                Text { text: "Execution Mode"; color: #64748b; }
                Rectangle {}
                Text { text: "STANDALONE"; color: #a855f7; font-weight: 700; }
            }
            HorizontalBox {
                Text { text: "Cloud Connectivity"; color: #64748b; }
                Rectangle {}
                Text { text: "CONNECTED"; color: #10b981; font-weight: 700; }
            }
            HorizontalBox {
                Text { text: "Mesh Status"; color: #64748b; }
                Rectangle {}
                Text { text: "ACTIVE"; color: #10b981; font-weight: 700; }
            }
            HorizontalBox {
                Text { text: "Stuck Missions"; color: #64748b; }
                Rectangle {}
                Text { text: "0"; color: #1e293b; font-weight: 700; }
            }
        }

        Button {
            text: "Run Diagnostics";
            clicked => { run_diagnostics(); }
        }
    }
}
