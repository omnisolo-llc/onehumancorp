import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct UiHelpArticle {
    title: string,
    description: string,
    category: string,
}

export component HelpCenter inherits Window {
    width: 600px;
    height: 800px;
    title: "Help Center";
    background: #f8fafc;

    in-out property <string> search_query: "";
    in property <[UiHelpArticle]> articles;

    callback search_query_changed(string);

    changed search_query => {
        search_query_changed(search_query);
    }

    VerticalBox {
        padding: 16px;
        spacing: 16px;

        Text {
            text: "How can we help?";
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
        }

        LineEdit {
            placeholder-text: "Search help articles...";
            text <=> search_query;
        }

        ScrollView {
            VerticalBox {
                spacing: 16px;

                for article in articles : Rectangle {
                    background: white; border-radius: 8px;
                    VerticalBox {
                        padding: 12px;
                        spacing: 4px;
                        Text { text: article.category; font-size: 12px; font-weight: 700; color: #64748b; }
                        Text { text: article.title; font-weight: 700; font-size: 16px; color: #0f172a; }
                        Text { text: article.description; color: #64748b; wrap: word-wrap; }
                    }
                }
            }
        }
    }

    Rectangle {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        width: 56px;
        height: 56px;
        border-radius: 28px;
        background: #0ea5e9;

        Text {
            text: "?";
            color: white;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
