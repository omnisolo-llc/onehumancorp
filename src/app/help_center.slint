import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct UiHelpArticle {
    category: string,
    title: string,
    content: string,
}

export component HelpCenter inherits Window {
    width: 600px;
    height: 800px;
    title: "Help Center";
    background: #f8fafc;

    in-out property <string> search_query: "";
    callback search_query_changed(string);
    changed search_query => {
        search_query_changed(search_query);
    }

    in property <[UiHelpArticle]> articles: [
        {
            category: "Getting Started",
            title: "Set up your store in 5 minutes",
            content: "Follow our simple guide to add your first product and go live."
        },
        {
            category: "For Bakers (Maya)",
            title: "Setting up your baker catalog",
            content: "Learn how to showcase your custom cakes with beautiful photos and flavor options."
        },
        {
            category: "For Handymen (Carlos)",
            title: "How to list handyman services",
            content: "List your repair services and set up a booking calendar so customers can hire you."
        },
        {
            category: "For Boutiques (Priya)",
            title: "Syncing boutique inventory",
            content: "Keep your in-store and online inventory in sync automatically."
        },
        {
            category: "Payments",
            title: "How to accept Apple Pay",
            content: "Enable Apple Pay with one click in your payment settings."
        },
        {
            category: "AI Agents",
            title: "What can the Customer Success Agent do?",
            content: "Your agent can reply to customer emails and Instagram DMs automatically."
        }
    ];

    VerticalBox {
        padding: 16px;
        spacing: 16px;

        Text {
            text: "How can we help?";
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
        }

        LineEdit {
            placeholder-text: "Search help articles...";
            text <=> search_query;
        }

        ScrollView {
            VerticalBox {
                spacing: 16px;

                for article in articles : VerticalBox {
                    spacing: 4px;
                    Text {
                        text: article.category;
                        font-weight: 700;
                        font-size: 14px;
                        color: #64748b;
                    }
                    Rectangle {
                        background: white;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #e2e8f0;
                        VerticalBox {
                            padding: 12px;
                            Text { text: article.title; font-weight: 700; font-size: 16px; color: #0f172a; }
                            Text { text: article.content; color: #475569; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
    }

    TouchArea {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        width: 56px;
        height: 56px;
        clicked => { root.visible = false; }
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 28px;
            background: #0ea5e9;

            Text {
                text: "×";
                color: white;
                font-size: 32px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
