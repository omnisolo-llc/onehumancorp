// Documentation fully implemented
import { TooltipElement } from "tooltip_element.slint";
import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct HelpArticle {
    title: string,
    description: string,
    category: string,
}

export component HelpCenter inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "Help Center";
    out property <string> test_title: root.title;
    background: #0f172a;

    in-out property <string> search_query: "";
    callback execute_search();
    callback close();

    changed search_query => { root.execute_search(); }

    in property <[HelpArticle]> articles: [
        { category: "Getting Started", title: "Set up your store in 5 minutes", description: "Follow our simple guide to add your first product and go live." },
        { category: "Getting Started", title: "How OHC works", description: "Learn how your AI Helpers work together to run your business." },
        { category: "My Store", title: "How to add products", description: "Learn how to list new items, add photos, and set prices." },
        { category: "My Store", title: "Managing your inventory", description: "Keep track of what you have in stock and get alerts when items are low." },
        { category: "Payments", title: "How to accept Apple Pay", description: "Enable Apple Pay with one click in your payment settings." },
        { category: "Payments", title: "Connecting your bank account", description: "Securely connect your bank to receive your sales money directly." },
        { category: "AI Helpers", title: "What can the Customer Success Helper do?", description: "Your helper can reply to customer emails and Instagram DMs automatically." },
        { category: "AI Helpers", title: "Training your Helpers", description: "Teach your helpers about your business so they can give better answers." },
        { category: "Marketing", title: "How to run a promotion", description: "Learn how to create discount codes and share them on social media." },
        { category: "Marketing", title: "Sending your first email campaign", description: "Create and send beautiful emails to your customers with just a few taps." },
        { category: "Account & Billing", title: "How to change your subscription", description: "Find out how to upgrade or downgrade your plan and view past invoices." },
        { category: "Account & Billing", title: "Understanding your bill", description: "A simple guide to how OHC billing works and what you are being charged for." }
    ];

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            padding: 16px;
            spacing: 16px;

            HorizontalBox {
                alignment: space-between;
                Text {
                    text: "How can we help?";
                    font-size: 24px;
                    font-weight: 700;
                    color: white;
                }
                Button {
                    text: "Close";
                    clicked => { root.close(); }
                }
            }

            TooltipElement {
                tooltip_id: "help_search";
                LineEdit {
                    placeholder-text: "Search help articles...";
                    text <=> search_query;
                }
            }

            ScrollView {
                VerticalBox {
                    spacing: 16px;

                    for article in articles : VerticalBox {
                        spacing: 16px;

                        Text { text: article.category; font-weight: 700; font-size: 18px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 12px;
                                Text { text: article.title; font-weight: 700; font-size: 16px; color: white; }
                                Text { text: article.description; color: white; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        width: 56px;
        height: 56px;
        border-radius: 28px;
        background: #0ea5e9;

        Text {
            text: "?";
            color: white;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
