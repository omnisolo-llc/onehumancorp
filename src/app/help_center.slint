import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct HelpArticle {
    category: string,
    title: string,
    body: string,
}

export component HelpCenter inherits Window {
    width: 600px;
    height: 800px;
    title: "Help Center";
    background: #f8fafc;

    in-out property <string> search_query: "";
    in-out property <[HelpArticle]> articles: [];

    callback search_query_changed(string);

    VerticalBox {
        padding: 16px;
        spacing: 16px;

        Text {
            text: "How can we help?";
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
        }

        LineEdit {
            placeholder-text: "Search help articles...";
            text <=> search_query;
            edited => { search_query_changed(self.text); }
        }

        ScrollView {
            VerticalBox {
                spacing: 16px;

                for article[index] in articles : VerticalBox {
                    spacing: 8px;
                    if index == 0 || article.category != articles[index - 1].category : Text {
                        text: article.category;
                        font-weight: 700;
                        font-size: 18px;
                        color: #334155;
                    }
                    Rectangle {
                        background: white; border-radius: 8px;
                        VerticalBox {
                            padding: 12px;
                            Text { text: article.title; font-weight: 700; font-size: 16px; color: #0f172a; }
                            Text { text: article.body; color: #64748b; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        width: 56px;
        height: 56px;
        border-radius: 28px;
        background: #0ea5e9;

        Text {
            text: "?";
            color: white;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
