// Documentation fully implemented
import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";
import { TooltipElement } from "tooltip_element.slint";

export struct HelpArticle {
    title: string,
    description: string,
    category: string,
}

export component HelpCenter inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "Help Center";
    out property <string> test_title: root.title;
    background: #0f172a;

    in-out property <string> search_query: "";
    callback execute_search();

    changed search_query => { root.execute_search(); }

    in property <[HelpArticle]> articles: [
        { category: "Getting Started", title: "Set up your store in 5 minutes", description: "Follow our simple guide to add your first product and go live." },
        { category: "My Store", title: "How to add products", description: "Learn how to list new items, add photos, and set prices." },
        { category: "Payments & Billing", title: "How to accept Apple Pay", description: "Enable Apple Pay with one click in your payment settings." },
        { category: "AI Helpers", title: "What can the Customer Success Helper do?", description: "Your helper can reply to customer emails and Instagram DMs automatically." },
        { category: "Marketing", title: "How to run a promotion", description: "Learn how to create discount codes and share them on social media." },
                { category: "Troubleshooting", title: "App is running slow", description: "Learn how to clear your cache and speed up the app." },
        { category: "Account & Billing", title: "How to change your subscription", description: "Find out how to upgrade or downgrade your plan and view past invoices." }
    ];

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            padding: 16px;
            spacing: 16px;

            Text {
                text: "How can we help?";
                font-size: 24px;
                font-weight: 700;
                color: white;
            }

            LineEdit {
                placeholder-text: "Search help articles...";
                text <=> search_query;
            }

            ScrollView {
                VerticalBox {
                    spacing: 16px;

                    for article in articles : VerticalBox {
                        spacing: 16px;

                        Text { text: article.category; font-weight: 700; font-size: 18px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 12px;
                                Text { text: article.title; font-weight: 700; font-size: 16px; color: white; }
                                Text { text: article.description; color: white; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
        }
    }

    TooltipElement {
        tooltip_id: "help_floating_button";
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        width: 56px;
        height: 56px;

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 28px;
            background: #0ea5e9;

            Text {
                text: "?";
                color: white;
                font-size: 24px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
