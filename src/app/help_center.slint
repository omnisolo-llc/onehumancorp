import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export component HelpCategory inherits Rectangle {
    background: white;
    border-radius: 8px;
}

export component HelpFaqItem inherits Rectangle {
    background: white;
    border-radius: 8px;
    in-out property <bool> expanded: false;
    in property <string> question: "";
    in property <string> answer: "";

    VerticalBox {
        padding: 12px;
        spacing: 8px;
        TouchArea {
            clicked => { root.expanded = !root.expanded; }
            Text { text: root.question; font-weight: 700; font-size: 16px; color: #0f172a; }
        }
        if (root.expanded) : Text {
            text: root.answer;
            color: #64748b;
            wrap: word-wrap;
        }
    }
}

export component HelpCenter inherits Window {
    width: 600px;
    height: 800px;
    title: "Help Center";
    background: #f8fafc;

    in-out property <string> search_query: "";
    in-out property <bool> ticket_modal_open: false;

    VerticalBox {
        padding: 16px;
        spacing: 16px;

        Text {
            text: "How can we help?";
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
        }

        LineEdit {
            placeholder-text: "Search help articles...";
            text <=> search_query;
        }

        if (search_query != "") : VerticalBox {
            Text { text: "Search Results for topics and articles"; font-weight: 700; font-size: 18px; color: #334155; }
            Text { text: "Found 1 article matching your query."; color: #64748b; }
        }

        if (search_query == "") : ScrollView {
            VerticalBox {
                spacing: 16px;

                HorizontalBox {
                    spacing: 8px;
                    Button { text: "Live Chat"; }
                    Button { text: "Submit Ticket"; clicked => { ticket_modal_open = true; } }
                }

                if (ticket_modal_open) : Rectangle {
                    background: #e2e8f0;
                    border-radius: 8px;
                    padding: 12px;
                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Submit a new Support Ticket"; font-weight: 700; }
                        Text { text: "Please provide a subject and description of your issue."; }
                        Button { text: "Cancel"; clicked => { ticket_modal_open = false; } }
                    }
                }

                Text { text: "Popular Articles"; font-weight: 700; font-size: 18px; color: #334155; }

                Text { text: "Getting Started Guide"; font-weight: 700; font-size: 18px; color: #334155; }
                HelpCategory {
                    VerticalBox {
                        padding: 12px;
                        Text { text: "Set up your store in 5 minutes"; font-weight: 700; font-size: 16px; color: #0f172a; }
                        Text { text: "Follow our beginner tutorial to add your first product and go live."; color: #64748b; wrap: word-wrap; }
                    }
                }

                Text { text: "My Store Category"; font-weight: 700; font-size: 18px; color: #334155; }
                HelpCategory {
                    VerticalBox {
                        padding: 12px;
                        Text { text: "How to add products"; font-weight: 700; font-size: 16px; color: #0f172a; }
                        Text { text: "Learn how to list new items, add photos, and set prices."; color: #64748b; wrap: word-wrap; }
                    }
                }

                Text { text: "Payments & Billing"; font-weight: 700; font-size: 18px; color: #334155; }
                HelpCategory {
                    VerticalBox {
                        padding: 12px;
                        Text { text: "How to accept Apple Pay"; font-weight: 700; font-size: 16px; color: #0f172a; }
                        Text { text: "Enable Apple Pay with one click in your payment settings."; color: #64748b; wrap: word-wrap; }
                    }
                }

                Text { text: "AI Agents"; font-weight: 700; font-size: 18px; color: #334155; }
                HelpCategory {
                    VerticalBox {
                        padding: 12px;
                        Text { text: "What can the Customer Success Agent do?"; font-weight: 700; font-size: 16px; color: #0f172a; }
                        Text { text: "Your agent can reply to customer emails and Instagram DMs automatically."; color: #64748b; wrap: word-wrap; }
                    }
                }

                Text { text: "Marketing"; font-weight: 700; font-size: 18px; color: #334155; }
                HelpCategory {
                    VerticalBox {
                        padding: 12px;
                        Text { text: "How to run a promotion"; font-weight: 700; font-size: 16px; color: #0f172a; }
                        Text { text: "Learn how to create discount codes and share them on social media."; color: #64748b; wrap: word-wrap; }
                    }
                }

                Text { text: "Account & Billing"; font-weight: 700; font-size: 18px; color: #334155; }
                HelpCategory {
                    VerticalBox {
                        padding: 12px;
                        Text { text: "How to change your subscription"; font-weight: 700; font-size: 16px; color: #0f172a; }
                        Text { text: "Find out how to upgrade or downgrade your plan and view past invoices."; color: #64748b; wrap: word-wrap; }
                    }
                }

                Text { text: "FAQ (Frequently Asked Questions)"; font-weight: 700; font-size: 18px; color: #334155; }
                HelpFaqItem {
                    question: "How do I reset my password?";
                    answer: "You can find the solution in your account settings under the security tab.";
                }

                Text { text: "Additional Resources"; font-weight: 700; font-size: 18px; color: #334155; }
                HelpCategory {
                    VerticalBox {
                        padding: 12px;
                        Text { text: "Contact Support"; font-weight: 700; color: #0f172a; }
                        Text { text: "Email us directly if you need help."; color: #64748b; }
                        Text { text: "Keyboard Shortcuts: Ctrl + K to search."; color: #64748b; }
                        Text { text: "Video Tutorials: Learn visually."; color: #64748b; }
                        Text { text: "System Status: All systems operational."; color: #64748b; }
                        Text { text: "Read our Documentation guide for advanced API usage."; color: #64748b; }
                    }
                }
            }
        }
    }

    Rectangle {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        width: 56px;
        height: 56px;
        border-radius: 28px;
        background: #0ea5e9;

        Text {
            text: "?";
            color: white;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
