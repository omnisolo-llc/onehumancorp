// Documentation fully implemented
import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";
import { TooltipElement } from "tooltip_element.slint";

export struct HelpArticle {
    title: string,
    description: string,
    category: string,
}

export component HelpCenter inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "Help Center";
    out property <string> test_title: root.title;
    background: transparent;

    in-out property <string> search_query: "";
    callback execute_search();

    changed search_query => { root.execute_search(); }

    in property <[HelpArticle]> articles: [
        { category: "Getting Started", title: "Set up your store in 5 minutes", description: "Follow our simple guide to add your first product and go live." },
        { category: "My Store", title: "How to add products", description: "Learn how to list new items, add photos, and set prices." },
        { category: "Payments", title: "How to accept Apple Pay", description: "Enable Apple Pay with one click in your payment settings." },
        { category: "AI Agents", title: "What can the Customer Success Helper do?", description: "Your helper can reply to customer emails and Instagram DMs automatically." },
        { category: "Marketing", title: "How to run a promotion", description: "Learn how to create discount codes and share them on social media." },
        { category: "Troubleshooting", title: "App is running slow", description: "Learn how to clear your cache and speed up the app." },
        { category: "Account & Billing", title: "How to change your subscription", description: "Find out how to upgrade or downgrade your plan and view past invoices." }
    ];

    Rectangle {
        background: #0f172a.transparentize(20%);
        width: 100%;
        height: 100%;
        drop-shadow-blur: 20px;
    }

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            padding: 24px;
            spacing: 20px;

            Text {
                text: "How can we help your business grow?";
                font-size: 28px;
                font-weight: 700;
                font-family: "Outfit";
                color: white;
            }

            LineEdit {
                placeholder-text: "Search for answers and guides...";
                text <=> search_query;
            }

            ScrollView {
                VerticalBox {
                    spacing: 20px;

                    for article in articles : VerticalBox {
                        spacing: 12px;

                        Text { text: article.category; font-weight: 700; font-size: 20px; font-family: "Outfit"; color: #38bdf8; }
                        GlassCard {
                            border-radius: 12px;
                            border-color: rgba(255, 255, 255, 0.2);
                            border-width: 1px;
                            VerticalBox {
                                padding: 16px;
                                Text { text: article.title; font-weight: 700; font-size: 18px; font-family: "Inter"; color: white; }
                                Text { text: article.description; color: #cbd5e1; wrap: word-wrap; font-family: "Inter"; font-size: 14px; }
                            }
                        }
                    }
                }
            }
        }
    }
}
