import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct HelpArticle {
    title: string,
    description: string,
    category: string,
}

export component HelpCenter inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "Help Center";
    background: #f8fafc;

    in-out property <string> search_query: "";
    callback execute_search();

    changed search_query => { root.execute_search(); }

    in property <[HelpArticle]> articles: [
        { category: "Getting Started", title: "Set up your store in 5 minutes", description: "Follow our simple guide to add your first product and go live." },
        { category: "Getting Started", title: "What is OneHumanCorp?", description: "Learn how our platform empowers you to run your business with AI." },
        { category: "My Store", title: "How to add products", description: "Learn how to list new items, add photos, and set prices." },
        { category: "My Store", title: "Managing your inventory", description: "Keep track of what's in stock and get alerts when items are low." },
        { category: "Payments", title: "How to accept Apple Pay", description: "Enable Apple Pay with one click in your payment settings." },
        { category: "Payments", title: "Setting up Stripe", description: "Connect your bank account to start receiving money from customers." },
        { category: "AI Helpers", title: "Meet your AI Team", description: "Understand the different roles your AI helpers can play in your business." },
        { category: "AI Helpers", title: "Automating customer replies", description: "Let your Customer Success helper handle common questions while you sleep." },
        { category: "Marketing", title: "How to run a promotion", description: "Learn how to create discount codes and share them on social media." },
        { category: "Marketing", title: "Getting found on Google (SEO)", description: "Simple steps to make sure customers find your store when they search online." },
        { category: "Account & Billing", title: "How to change your subscription", description: "Find out how to upgrade or downgrade your plan and view past invoices." },
        { category: "Account & Billing", title: "Managing your profile", description: "Update your business name, logo, and contact information." }
    ];

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            padding: 16px;
            spacing: 20px;

            Text {
                text: "Help Center";
                font-family: "Outfit";
                font-size: 28px;
                font-weight: 700;
                color: #0f172a;
            }

            LineEdit {
                placeholder-text: "Search help articles...";
                font-family: "Inter";
                height: 44px;
                text <=> search_query;
            }

            ScrollView {
                VerticalBox {
                    spacing: 24px;
                    padding-bottom: 80px; // Space for the floating button

                    for article in articles : Rectangle {
                        background: white;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #e2e8f0;

                        VerticalBox {
                            padding: 16px;
                            spacing: 8px;

                            Text {
                                text: article.category;
                                font-weight: 700;
                                font-size: 12px;
                                color: #6366f1;
                                font-family: "Inter";
                            }
                            Text {
                                text: article.title;
                                font-weight: 700;
                                font-size: 18px;
                                color: #0f172a;
                                font-family: "Outfit";
                            }
                            Text {
                                text: article.description;
                                color: #475569;
                                wrap: word-wrap;
                                font-family: "Inter";
                            }

                            HorizontalBox {
                                alignment: end;
                                Text {
                                    text: "Read more →";
                                    color: #6366f1;
                                    font-weight: 700;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        width: 56px;
        height: 56px;
        border-radius: 28px;
        background: #0ea5e9;

        Text {
            text: "?";
            color: white;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
