import { LineEdit, Button, HorizontalBox, VerticalBox } from "std-widgets.slint";

export component PasswordInput inherits Rectangle {
    in property <string> placeholder-text: "Password";
    in-out property <string> text: "";
    callback edited();
    property <bool> show_password: false;

    height: 44px;

    HorizontalBox {
        padding: 0;
        spacing: 8px;

        LineEdit {
            height: 44px;
            placeholder-text: root.placeholder-text;
            input-type: root.show_password ? InputType.text : InputType.password;
            text <=> root.text;
            edited => { root.edited(); }
            horizontal-stretch: 1;
        }

        Button {
            height: 44px;
            text: root.show_password ? "Hide" : "Show";
            clicked => {
                root.show_password = !root.show_password;
            }
        }
    }
}
