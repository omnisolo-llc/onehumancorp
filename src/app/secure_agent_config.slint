import { PasswordInput } from "password_input.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";

export component SecureAgentConfig inherits Window {
    width: 400px;
    height: 400px;
    title: "Helper Setup";

    callback save_config(string);

    in-out property <string> token: "";
    in-out property <string> error_text: "";

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 32px;
        alignment: center;

        Text { text: "Helper Setup"; font-size: 24px; font-weight: 700; color: #1e293b; }
        
        Text {
            text: "Enter your connection code to link your helper.";
            color: #64748b;
            wrap: word-wrap;
        }

        PasswordInput {
            placeholder-text: "Example: code-1234";
            text <=> token;
        }
        
        if (error_text != "") : Text { text: error_text; color: #ef4444; }

        Button {
            text: "Save Connection";
            enabled: token != "" && error_text == "";
            clicked => { save_config(token); }
        }
    }
}
