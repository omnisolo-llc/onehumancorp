import {  Button, VerticalBox, HorizontalBox  } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component InteractiveWalkthrough inherits Window {
    width: 600px;
    height: 800px;
    background: transparent;
    always-on-top: true;

    in-out property <int> current_step: 0;

    // Overlay Mask
    Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.4);
    }

    VerticalBox {
        alignment: current_step == 0 ? start : (current_step == 1 ? center : end);
        padding-top: current_step == 0 ? 100px : 0;
        padding-bottom: current_step == 2 || current_step == 3 ? 100px : 0;

        HorizontalBox {
            alignment: current_step == 0 ? start : (current_step == 1 ? center : end);
            padding-left: current_step == 0 ? 20px : 0;
            padding-right: current_step == 2 || current_step == 3 ? 20px : 0;

            HorizontalBox {
                alignment: start;
                spacing: 8px;

                if (current_step == 1) : VerticalBox { alignment: center; Text { text: "▶"; color: rgba(255, 255, 255, 0.5); font-size: 24px; } }

                VerticalBox {
                    if (current_step == 0) : Text { text: "▲"; color: rgba(255, 255, 255, 0.5); font-size: 24px; horizontal-alignment: center; }

                    GlassCard {
                        width: 335px;

                        VerticalBox {
                            padding: 20px;
                            spacing: 16px;

                            Text {
                                text: current_step == 0 ? "Welcome to your store!" :
                                      current_step == 1 ? "Add your first product" :
                                      current_step == 2 ? "Set up payments" :
                                      "You're all set!";
                                font-size: 20px;
                                font-family: "Outfit";
                                font-weight: 700;
                                color: white;
                            }

                            Text {
                                text: current_step == 0 ? "Let's take a quick tour to get you set up." :
                                      current_step == 1 ? "Click here to add photos and prices for what you sell." :
                                      current_step == 2 ? "Connect your bank so you can get paid by customers." :
                                      "Your store is ready. You can always find more help in the Help Center.";
                                color: #94a3b8;
                                font-family: "Inter";
                                wrap: word-wrap;
                            }

                            HorizontalBox {
                                alignment: end;
                                spacing: 12px;

                                Button {
                                    text: "Skip tour";
                                    clicked => { root.visible = false; }
                                }

                                Button {
                                    text: current_step < 3 ? "Next" : "Done";
                                    clicked => {
                                        if (current_step < 3) {
                                            current_step += 1;
                                        } else {
                                            root.visible = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if (current_step == 2 || current_step == 3) : Text { text: "▼"; color: rgba(255, 255, 255, 0.5); font-size: 24px; horizontal-alignment: center; }
                }
            }
        }
    }
}