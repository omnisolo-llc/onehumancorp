import {  Button, VerticalBox, HorizontalBox  } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component InteractiveWalkthrough inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    background: transparent;
    always-on-top: true;

    in-out property <int> current_step: 0;

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            alignment: current_step == 0 ? start : (current_step == 1 ? center : end);
            padding-top: current_step == 0 ? 100px : 0;
            padding-bottom: current_step >= 2 ? 100px : 0;

            HorizontalBox {
                alignment: current_step == 0 ? start : (current_step == 1 ? center : end);
                padding-left: current_step == 0 ? 20px : 0;
                padding-right: current_step >= 2 ? 20px : 0;

                GlassCard {
                    width: 335px;

                    VerticalBox {
                        padding: 20px;
                        spacing: 16px;

                        Text {
                            text: current_step == 0 ? "Welcome to your store!" :
                                  current_step == 1 ? "Add your first product" :
                                  current_step == 2 ? "Set up payments" :
                                  current_step == 3 ? "Activate your AI Support Agent" :
                                  "You're all set!";
                            font-size: 20px;
                            font-family: "Outfit";
                            font-weight: 700;
                            color: white;
                        }

                        Text {
                            text: current_step == 0 ? "Let's take a quick tour to get you set up." :
                                  current_step == 1 ? "Click here to add photos and prices for what you sell." :
                                  current_step == 2 ? "Connect your bank so you can get paid by customers." :
                                  current_step == 3 ? "Turn on your AI helper to automatically answer questions while you sleep." :
                                  "Your store is ready. You can always find more help in the Help Center.";
                            color: #94a3b8;
                            font-family: "Inter";
                            wrap: word-wrap;
                        }

                        HorizontalBox {
                            alignment: end;
                            spacing: 12px;

                            Button {
                                text: "Skip tour";
                                clicked => { root.visible = false; }
                            }

                            Button {
                                text: current_step < 4 ? "Next" : "Done";
                                clicked => {
                                    if (current_step < 4) {
                                        current_step += 1;
                                    } else {
                                        root.visible = false;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
