import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component InteractiveWalkthroughOverlay inherits Rectangle {
    background: rgba(0, 0, 0, 0.4); // Semi-transparent background

    in-out property <int> current_step: 0;
    callback close();

    // Coordinates for the speech bubble based on the step
    // Step 0: Welcome (Centered-ish)
    // Step 1: Add Product (Bottom left)
    // Step 2: Chat (Bottom middle)
    // Step 3: Stats (Bottom right)
    property <length> bubble_x: current_step == 0 ? (root.width - 335px)/2 : (current_step == 1 ? 10px : (current_step == 2 ? (root.width - 335px)/2 : (current_step == 3 ? root.width - 345px : (root.width - 335px)/2)));
    property <length> bubble_y: current_step == 0 ? 150px : (current_step == 1 ? root.height - 350px : (current_step == 2 ? root.height - 350px : (current_step == 3 ? root.height - 350px : 200px)));

    // Consume all clicks to prevent interaction with background
    TouchArea {}

    // Highlight circle
    if (current_step > 0 && current_step < 4) : Rectangle {
        x: current_step == 1 ? 20px : (current_step == 2 ? 140px : (current_step == 3 ? 210px : 0px));
        y: root.height - 70px;
        width: 60px;
        height: 60px;
        border-radius: 30px;
        border-width: 3px;
        border-color: #0ea5e9;
        background: transparent;
    }

    Rectangle {
        x: bubble_x;
        y: bubble_y;
        width: 335px;

        GlassCard {
            width: 100%;

            VerticalBox {
                padding: 20px;
                spacing: 16px;

                Text {
                    text: current_step == 0 ? "Welcome to OHC!" :
                          current_step == 1 ? "1. Add a Product" :
                          current_step == 2 ? "2. Chat with Customers" :
                          current_step == 3 ? "3. View Your Stats" :
                          "Ready to Grow!";
                    font-size: 20px;
                    font-family: "Outfit";
                    font-weight: 700;
                    color: white;
                }

                Text {
                    text: current_step == 0 ? "We'll show you the 3 most important tools for your business." :
                          current_step == 1 ? "Click here to add photos and prices for what you sell. Your AI Helper will write descriptions for you!" :
                          current_step == 2 ? "This is your inbox. Reply to Instagram DMs and emails all in one place." :
                          current_step == 3 ? "See how much you've sold today and track your progress here." :
                          "You're all set! If you ever get stuck, just click the '?' button for help.";
                    color: #cbd5e1;
                    font-family: "Inter";
                    wrap: word-wrap;
                }

                HorizontalBox {
                    alignment: end;
                    spacing: 12px;

                    Button {
                        text: "Skip";
                        clicked => { root.close(); }
                    }

                    Button {
                        text: current_step < 4 ? "Next" : "Done";
                        clicked => {
                            if (current_step < 4) {
                                current_step += 1;
                            } else {
                                root.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component InteractiveWalkthrough inherits Window {
    title: "Interactive Walkthrough";
    in-out property <int> current_step <=> overlay.current_step;
    callback close();
    overlay := InteractiveWalkthroughOverlay {
        close => { root.close(); }
    }
}
