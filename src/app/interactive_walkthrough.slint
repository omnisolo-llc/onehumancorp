import {  Button, VerticalBox, HorizontalBox  } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component InteractiveWalkthrough inherits Window {
    width: 375px;
    height: 800px;
    background: transparent;
    always-on-top: true;

    in-out property <int> current_step: 0;
    in-out property <string> active_tour: "store_setup"; // "store_setup", "payment", "ai_agent"

    // Properties for anchoring
    in-out property <length> target_x: 0;
    in-out property <length> target_y: 0;
    in-out property <length> target_width: 0;
    in-out property <length> target_height: 0;

    // Overlay to dim the background
    Rectangle {
        width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.5);
    }

    // Transparent cutout for the target element
    Rectangle {
        x: target_x - 4px;
        y: target_y - 4px;
        width: target_width + 8px;
        height: target_height + 8px;
        border-radius: 8px;
        border-width: 2px;
        border-color: #3b82f6; // Highlight ring
        background: transparent;
    }

    // Speech bubble anchored to the target
    Rectangle {
        x: target_y > 300px ? target_x : target_x; // simplified positioning logic
        y: target_y > 300px ? target_y - self.height - 16px : target_y + target_height + 16px;

        GlassCard {
            width: 335px;

            VerticalBox {
                padding: 20px;
                spacing: 16px;

                Text {
                    text: active_tour == "store_setup" ? (
                            current_step == 0 ? "Welcome to your store!" :
                            current_step == 1 ? "Add your first product" :
                            current_step == 2 ? "Set up payments" :
                            "You're all set!"
                          ) :
                          active_tour == "ai_agent" ? (
                            current_step == 0 ? "Meet your AI Support Agent" :
                            "Let's turn it on!"
                          ) : "Guided Tour";
                    font-size: 20px;
                    font-family: "Outfit";
                    font-weight: 700;
                    color: white;
                }

                Text {
                    text: active_tour == "store_setup" ? (
                            current_step == 0 ? "Let's take a quick tour to get you set up." :
                            current_step == 1 ? "Click here to add photos and prices for what you sell." :
                            current_step == 2 ? "Connect your bank so you can get paid by customers." :
                            "Your store is ready. You can always find more help in the Help Center."
                          ) :
                          active_tour == "ai_agent" ? (
                            current_step == 0 ? "This agent can reply to your customers automatically." :
                            "Click here to activate."
                          ) : "Follow the steps to complete this guide.";
                    color: #cbd5e1;
                    font-family: "Inter";
                    wrap: word-wrap;
                }

                HorizontalBox {
                    alignment: end;
                    spacing: 12px;

                    Button {
                        text: "Skip tour";
                        clicked => { root.visible = false; }
                    }

                    Button {
                        text: current_step < 3 ? "Next" : "Done";
                        clicked => {
                            if (current_step < 3) {
                                current_step += 1;
                            } else {
                                root.visible = false;
                            }
                        }
                    }
                }
            }
        }
    }
}
