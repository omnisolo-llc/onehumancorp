import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component InteractiveWalkthroughOverlay inherits Rectangle {
    background: rgba(0, 0, 0, 0.4); // Semi-transparent background

    in-out property <int> current_step: 0;
    callback close();

    // Coordinates for the speech bubble based on the step
    // Step 0: Welcome (Centered)
    // Step 1: Set up your store (Website Builder / Add Product)
    // Step 2: Accept your first payment (Connect Apps / Payments)
    // Step 3: Activate your AI Helper (Hire Helper)
    property <length> bubble_x: current_step == 0 ? (root.width - 335px)/2 : (current_step == 1 ? 10px : (current_step == 2 ? (root.width - 335px)/2 : (current_step == 3 ? root.width - 345px : (root.width - 335px)/2)));
    property <length> bubble_y: current_step == 0 ? 150px : (current_step == 1 ? root.height - 350px : (current_step == 2 ? root.height - 350px : (current_step == 3 ? root.height - 350px : 200px)));

    // Consume all clicks to prevent interaction with background
    TouchArea {}

    // Pulsing highlight circle
    if (current_step > 0 && current_step < 4) : Rectangle {
        x: current_step == 1 ? 20px : (current_step == 2 ? 210px : (current_step == 3 ? 10px : 0px)); // Approximating bottom bar or top actions
        y: current_step == 3 ? 20px : root.height - 70px;
        width: 60px;
        height: 60px;
        border-radius: 30px;
        border-width: 3px;
        border-color: #0ea5e9;
        background: rgba(14, 165, 233, 0.2);
    }

    Rectangle {
        x: bubble_x;
        y: bubble_y;
        width: 335px;

        GlassCard {
            width: 100%;

            VerticalBox {
                padding: 20px;
                spacing: 16px;

                Text {
                    text: current_step == 0 ? "Welcome to OneHumanCorp!" :
                          current_step == 1 ? "✨ Set up your store" :
                          current_step == 2 ? "💰 Accept your first payment" :
                          current_step == 3 ? "🤖 Activate your AI Helper" :
                          "Ready for Business!";
                    font-size: 20px;
                    font-family: "Outfit";
                    font-weight: 700;
                    color: white;
                }

                Text {
                    text: current_step == 0 ? "Let's quickly tour the 3 steps to get your business live and selling." :
                          current_step == 1 ? "Use the 'Add' button to list your products. Your AI Helper will even write professional descriptions for you!" :
                          current_step == 2 ? "In 'Connect Apps', you can link your bank or Apple Pay to start receiving money from customers instantly." :
                          current_step == 3 ? "Go to 'Helpers' to hire your first AI teammate. They'll handle your emails and customer questions 24/7." :
                          "You're all set! Use the 'Ask anything' button anytime you have a question. We're here to help you grow!";
                    color: #cbd5e1;
                    font-family: "Inter";
                    wrap: word-wrap;
                    font-size: 15px;
                }

                HorizontalBox {
                    alignment: end;
                    spacing: 12px;

                    Button {
                        text: "Skip tour";
                        clicked => { root.close(); }
                    }

                    Button {
                        text: current_step < 4 ? "Next Step" : "Get Started";
                        clicked => {
                            if (current_step < 4) {
                                current_step += 1;
                            } else {
                                root.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component InteractiveWalkthrough inherits Window {
    title: "Interactive Walkthrough";
    in-out property <int> current_step <=> overlay.current_step;
    callback close();
    overlay := InteractiveWalkthroughOverlay {
        close => { root.close(); }
    }
}
