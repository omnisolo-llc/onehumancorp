import {  Button, VerticalBox, HorizontalBox  } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component InteractiveWalkthrough inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    background: transparent;
    always-on-top: true;

    in-out property <int> current_step: 0;

    // Overlay to dim the background
    Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);

        // Simulated spotlight highlight for the active element
        Rectangle {
            x: current_step == 0 ? 20px : (current_step == 1 ? root.width / 2 - 100px : root.width - 220px);
            y: current_step == 0 ? 80px : (current_step == 1 ? root.height / 2 - 40px : root.height - 150px);
            width: 200px;
            height: 80px;
            border-radius: 8px;
            background: transparent;
            border-color: #0ea5e9;
            border-width: 2px;
            clip: false;

            // Speech Bubble Pointer
            Rectangle {
                width: 16px;
                height: 16px;
                background: #1e293b;
                x: parent.width / 2 - 8px;
                y: current_step == 1 ? parent.height - 8px : -8px;
            }
        }
    }

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            alignment: current_step == 0 ? start : (current_step == 1 ? center : end);
            padding-top: current_step == 0 ? 170px : 0;
            padding-bottom: current_step == 2 || current_step == 3 ? 170px : 0;

            HorizontalBox {
                alignment: current_step == 0 ? start : (current_step == 1 ? center : end);
                padding-left: current_step == 0 ? 20px : 0;
                padding-right: current_step == 2 || current_step == 3 ? 20px : 0;

                GlassCard {
                    width: 335px;

                    // Speech Bubble styling (represented by the GlassCard itself along with the pointer above)
                    VerticalBox {
                        padding: 20px;
                        spacing: 16px;

                        Text {
                            text: current_step == 0 ? "Welcome to your store!" :
                                  current_step == 1 ? "Add your first product" :
                                  current_step == 2 ? "Set up payments" :
                                  "You're all set!";
                            font-size: 20px;
                            font-family: "Outfit";
                            font-weight: 700;
                            color: white;
                        }

                        Text {
                            text: current_step == 0 ? "Let's take a quick tour to get you set up." :
                                  current_step == 1 ? "Click here to add photos and prices for what you sell." :
                                  current_step == 2 ? "Connect your bank so you can get paid by customers." :
                                  "Your store is ready. You can always find more help in the Help Center.";
                            color: #94a3b8;
                            font-family: "Inter";
                            wrap: word-wrap;
                        }

                        HorizontalBox {
                            alignment: end;
                            spacing: 12px;

                            Button {
                                text: "Skip tour";
                                clicked => { root.visible = false; }
                            }

                            Button {
                                text: current_step < 3 ? "Next" : "Done";
                                clicked => {
                                    if (current_step < 3) {
                                        current_step += 1;
                                    } else {
                                        root.visible = false;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
