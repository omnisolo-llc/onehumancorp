import {  Button, VerticalBox, HorizontalBox  } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component InteractiveWalkthrough inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    background: transparent;
    always-on-top: true;

    in-out property <int> current_step: 0;
    in-out property <string> flow_type: "onboarding"; // 'onboarding', 'payments', 'helpers'

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            alignment: current_step == 0 ? start : (current_step == 1 ? center : end);
            padding-top: current_step == 0 ? 100px : 0;
            padding-bottom: current_step == 2 || current_step == 3 ? 100px : 0;

            HorizontalBox {
                alignment: current_step == 0 ? start : (current_step == 1 ? center : end);
                padding-left: current_step == 0 ? 20px : 0;
                padding-right: current_step == 2 || current_step == 3 ? 20px : 0;

                GlassCard {
                    width: 335px;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.2);

                    VerticalBox {
                        padding: 24px;
                        spacing: 16px;

                        Text {
                            text: flow_type == "onboarding" ?
                                  (current_step == 0 ? "Welcome to your store!" :
                                   current_step == 1 ? "Add your first product" :
                                   current_step == 2 ? "Set up your storefront" :
                                   "You're ready to grow!") :
                                  (flow_type == "payments" ?
                                  (current_step == 0 ? "Get Paid Instantly" :
                                   current_step == 1 ? "Connect Stripe" :
                                   current_step == 2 ? "Test a Transaction" :
                                   "Money is Flowing!") :
                                  (current_step == 0 ? "Meet Your Helpers" :
                                   current_step == 1 ? "Assign a Task" :
                                   current_step == 2 ? "Review a Draft" :
                                   "Automation Active!"));
                            font-size: 20px;
                            font-family: "Outfit";
                            font-weight: 700;
                            color: white;
                        }

                        Text {
                            text: flow_type == "onboarding" ?
                                  (current_step == 0 ? "Let's take a quick tour to get you set up." :
                                   current_step == 1 ? "Click the 'Add' button to list photos and prices for what you sell." :
                                   current_step == 2 ? "Choose a template that matches your brand vibe." :
                                   "Your store is live. AI helpers are now optimizing it for you.") :
                                  (flow_type == "payments" ?
                                  (current_step == 0 ? "OHC makes it easy to accept credit cards and Apple Pay." :
                                   current_step == 1 ? "Click here to securely connect your bank account." :
                                   current_step == 2 ? "We'll send a small test to make sure everything works." :
                                   "You're all set to accept payments from anywhere in the world.") :
                                  (current_step == 0 ? "Your AI helpers work 24/7 to run your business." :
                                   current_step == 1 ? "Ask your Helper to 'Write a product description' for you." :
                                   current_step == 2 ? "Check your drafts to approve what your Helper created." :
                                   "Your business is now running on autopilot!"));
                            color: #cbd5e1;
                            font-family: "Inter";
                            wrap: word-wrap;
                            font-size: 14px;
                        }

                        HorizontalBox {
                            alignment: end;
                            spacing: 12px;

                            Button {
                                text: "Skip tour";
                                height: 44px;
                                clicked => { root.visible = false; }
                            }

                            Button {
                                text: current_step < 3 ? "Next" : "Done";
                                height: 44px;
                                clicked => {
                                    if (current_step < 3) {
                                        current_step += 1;
                                    } else {
                                        root.visible = false;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
