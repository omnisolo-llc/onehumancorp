
import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, CheckBox, ScrollView } from "std-widgets.slint";

export struct BuilderBlock {
    id: string,
    block_type: string,
    title: string,
    content: string,
}

export component WebsiteBuilder inherits Window {
    width: 600px;
    height: 800px;
    title: "Website Builder";
    background: #0f172a;

    in-out property <[BuilderBlock]> blocks: [
        { id: "1", block_type: "Hero", title: "Welcome to My Store", content: "We sell the best products." }
    ];
    in-out property <bool> is_publishing: false;
    in-out property <bool> is_advanced: false;
    in-out property <bool> show_add_modal: false;
    in-out property <bool> show_edit_modal: false;
    in-out property <int> edit_index: -1;
    in-out property <string> edit_title: "";
    in-out property <string> edit_content: "";

    callback publish_site(string /* template */, string /* primary_color */, string /* product_name */, string /* product_price */, string /* product_description */, string /* domain_choice */);
    callback copy_to_clipboard(string);
    callback open_ohc_signup();

    callback block_moved(int, int);
    callback block_added(string);
    callback block_edited(int, string, string);
    callback block_deleted(int);
    callback perform_publish();

    VerticalBox {
        alignment: center;

        // Canvas Container
        Rectangle {
            width: 375px;
            height: 600px;
            background: white;
            border-radius: 20px;
            clip: true;

            ScrollView {
                VerticalBox {
                    padding: 0px;
                    spacing: 0px;
                    for block[index] in blocks : Rectangle {
                        height: 150px;
                        background: block.block_type == "Hero" ? #f8fafc : (block.block_type == "Product Grid" ? #f1f5f9 : #e2e8f0);
                        border-width: 1px;
                        border-color: #cbd5e1;

                        VerticalBox {
                            padding: 16px;
                            Text { text: block.block_type; font-size: 12px; color: #64748b; font-family: "Inter"; }
                            Text { text: block.title; font-size: 24px; color: #0f172a; font-family: "Outfit"; font-weight: 700; wrap: word-wrap; }
                            Text { text: block.content; font-size: 14px; color: #475569; font-family: "Inter"; wrap: word-wrap; }
                        }

                        // Block Controls overlay
                        HorizontalBox {
                            y: 8px;
                            x: parent.width - self.width - 8px;
                            spacing: 4px;

                            Rectangle {
                                width: 32px; height: 32px; background: #e2e8f0; border-radius: 4px;
                                Text { text: "↑"; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { block_moved(index, index - 1); } }
                            }
                            Rectangle {
                                width: 32px; height: 32px; background: #e2e8f0; border-radius: 4px;
                                Text { text: "↓"; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { block_moved(index, index + 1); } }
                            }
                            Rectangle {
                                width: 32px; height: 32px; background: #e2e8f0; border-radius: 4px;
                                Text { text: "✎"; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => {
                                    edit_index = index;
                                    edit_title = block.title;
                                    edit_content = block.content;
                                    show_edit_modal = true;
                                } }
                            }
                            Rectangle {
                                width: 32px; height: 32px; background: #fee2e2; border-radius: 4px;
                                Text { text: "×"; horizontal-alignment: center; vertical-alignment: center; color: #ef4444; }
                                TouchArea { clicked => { block_deleted(index); } }
                            }
                        }
                    }
                }
            }
        }

        // Bottom Action Bar
        GlassCard {
            height: 80px;
            width: 375px;
            background: rgba(15, 23, 42, 0.8);
            HorizontalBox {
                padding: 16px;
                alignment: space-between;
                GlassCard {
                    width: 140px; height: 44px; background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; Text { text: "+ Add Block"; color: white; horizontal-alignment: center; font-family: "Inter"; font-weight: 700; } }
                    TouchArea { clicked => { show_add_modal = true; } }
                }
                GlassCard {
                    width: 140px; height: 44px; background: rgba(168, 85, 247, 0.8);
                    VerticalBox { alignment: center; Text { text: "Publish →"; color: white; horizontal-alignment: center; font-family: "Inter"; font-weight: 700; } }
                    TouchArea { clicked => { perform_publish(); } }
                }
            }
        }
    }

    // Add Block Modal
    if (show_add_modal) : Rectangle {
        background: rgba(0, 0, 0, 0.5);
        TouchArea { clicked => { show_add_modal = false; } }
        GlassCard {
            width: 300px; height: 400px; background: #1e293b;
            VerticalBox {
                padding: 24px; spacing: 16px;
                Text { text: "Add a Block"; font-size: 20px; color: white; font-family: "Outfit"; font-weight: 700; }

                GlassCard {
                    height: 60px; background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; Text { text: "🛒 Product Grid"; color: white; horizontal-alignment: center; font-family: "Inter"; font-weight: 700; } }
                    TouchArea { clicked => { block_added("Product Grid"); show_add_modal = false; } }
                }
                GlassCard {
                    height: 60px; background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; Text { text: "🖼️ Hero Section"; color: white; horizontal-alignment: center; font-family: "Inter"; font-weight: 700; } }
                    TouchArea { clicked => { block_added("Hero"); show_add_modal = false; } }
                }
                GlassCard {
                    height: 60px; background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; Text { text: "📝 Text & Image"; color: white; horizontal-alignment: center; font-family: "Inter"; font-weight: 700; } }
                    TouchArea { clicked => { block_added("Text & Image"); show_add_modal = false; } }
                }
                GlassCard {
                    height: 60px; background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; Text { text: "⭐ Testimonials"; color: white; horizontal-alignment: center; font-family: "Inter"; font-weight: 700; } }
                    TouchArea { clicked => { block_added("Testimonials"); show_add_modal = false; } }
                }
            }
        }
    }

    // Edit Block Modal
    if (show_edit_modal) : Rectangle {
        background: rgba(0, 0, 0, 0.5);
        TouchArea { clicked => { show_edit_modal = false; } }
        GlassCard {
            width: 340px; height: 300px; background: #1e293b;
            TouchArea {} // Prevent click-through
            VerticalBox {
                padding: 24px; spacing: 16px;
                Text { text: "Edit Block"; font-size: 20px; color: white; font-family: "Outfit"; font-weight: 700; }

                Text { text: "Title"; color: #94a3b8; font-size: 14px; font-family: "Inter"; }
                LineEdit { text <=> edit_title; height: 44px; }

                Text { text: "Content"; color: #94a3b8; font-size: 14px; font-family: "Inter"; }
                LineEdit { text <=> edit_content; height: 44px; }

                HorizontalBox {
                    alignment: space-between;
                    GlassCard {
                        width: 100px; height: 44px; background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        VerticalBox { alignment: center; Text { text: "Cancel"; color: white; horizontal-alignment: center; font-family: "Inter"; } }
                        TouchArea { clicked => { show_edit_modal = false; } }
                    }
                    GlassCard {
                        width: 100px; height: 44px; background: rgba(168, 85, 247, 0.8);
                        VerticalBox { alignment: center; Text { text: "Save"; color: white; horizontal-alignment: center; font-family: "Inter"; font-weight: 700; } }
                        TouchArea { clicked => {
                            block_edited(edit_index, edit_title, edit_content);
                            show_edit_modal = false;
                        } }
                    }
                }
            }
        }
    }
}
