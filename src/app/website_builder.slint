import { GlassCard } from "glass_card.slint";
import { HeroBlock, ProductGridBlock, CalendarBlock } from "smart_blocks.slint";
import { Button, VerticalBox, HorizontalBox, ScrollView, LineEdit, CheckBox } from "std-widgets.slint";

export component WebsiteBuilder inherits Window {
    width: 600px;
    height: 600px;
    title: "Build My Website";

    callback publish_site(string, string, string, string, string, string);
    callback open_ohc_signup();
    callback copy_to_clipboard(string);

    // Placeholder actions
    callback upload_logo();
    callback generate_logo();
    callback generate_description();
    callback upload_photo();
    callback save_state();

    in-out property <int> step: 0;
    in-out property <string> selected_template: "";
    in-out property <string> primary_color: "#FF3B30";
    in-out property <string> product_name: "";
    in-out property <string> product_price: "";
    in-out property <string> product_description: "";
    in-out property <string> domain_choice: "subdomain";
    in-out property <bool> is_advanced: false;
    in-out property <bool> is_publishing: false;

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Website Builder"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; }
            Rectangle {}
            HorizontalBox {
                spacing: 8px;
                alignment: end;
                Text { text: "Advanced"; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
                TouchArea {
                    width: 20px;
                    height: 20px;
                    clicked => { is_advanced = !is_advanced; save_state(); }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 4px;
                        border-color: #a855f7;
                        border-width: 1px;
                        background: is_advanced ? #a855f7 : transparent;
                        Text { text: is_advanced ? "✓" : ""; color: white; horizontal-alignment: center; }
                    }
                }
            }
        }

        // Step 0: Template
        if (step == 0) : VerticalBox {
            if (is_advanced) : VerticalBox {
                spacing: 8px;
                Text { text: "Advanced: Local CLI command"; font-family: "Inter"; font-size: 14px; color: #94a3b8; }
                Text { text: "ohc deploy --template " + (selected_template == "" ? "<template>" : selected_template); font-family: "Inter"; font-size: 12px; color: #64748b; }
            }
            spacing: 16px;
            Text { text: "Choose a template"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }
            Text { text: "Optimized for your business"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
            
            ScrollView {
                VerticalBox {
                    spacing: 16px;

                    GlassCard {
                        height: 120px;
                        background: selected_template == "Modern Minimal" ? rgba(16, 185, 129, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        VerticalBox {
                            padding: 12px; spacing: 8px;
                            Text { text: "Modern Minimal"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                            Text { text: "Industry: Portfolios, Creatives"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                            Rectangle { height: 40px; background: selected_template == "Modern Minimal" ? #10b981 : rgba(255,255,255,0.1); border-radius: 4px; Text { text: selected_template == "Modern Minimal" ? "Use this template →" : "Preview..."; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                        }
                        TouchArea { clicked => { selected_template = "Modern Minimal"; } }
                    }
                    GlassCard {
                        height: 120px;
                        background: selected_template == "Bold Retail" ? rgba(16, 185, 129, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        VerticalBox {
                            padding: 12px; spacing: 8px;
                            Text { text: "Bold Retail"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                            Text { text: "Industry: E-commerce, Stores"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                            Rectangle { height: 40px; background: selected_template == "Bold Retail" ? #10b981 : rgba(255,255,255,0.1); border-radius: 4px; Text { text: selected_template == "Bold Retail" ? "Use this template →" : "Preview..."; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                        }
                        TouchArea { clicked => { selected_template = "Bold Retail"; } }
                    }
                    GlassCard {
                        height: 120px;
                        background: selected_template == "Classic Service" ? rgba(16, 185, 129, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        VerticalBox {
                            padding: 12px; spacing: 8px;
                            Text { text: "Classic Service"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                            Text { text: "Industry: Consulting, Services"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                            Rectangle { height: 40px; background: selected_template == "Classic Service" ? #10b981 : rgba(255,255,255,0.1); border-radius: 4px; Text { text: selected_template == "Classic Service" ? "Use this template →" : "Preview..."; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                        }
                        TouchArea { clicked => { selected_template = "Classic Service"; } }
                    }
                }
            }
        }

        // Step 1: Branding
        if (step == 1) : VerticalBox {
            spacing: 16px;
            Text { text: "Brand Colors & Logo"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }
            Text { text: "Make it yours. AI suggests palettes based on your business type."; font-size: 14px; font-family: "Inter"; color: #94a3b8; }

            Text { text: "Primary Color Palette"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }

            HorizontalBox {
                spacing: 12px;
                Rectangle { height: 44px; border-radius: 4px; width: 44px; background: #FF3B30; border-color: primary_color == "#FF3B30" ? white : transparent; border-width: 2px; TouchArea { clicked => { primary_color = "#FF3B30"; } } }
                Rectangle { height: 44px; border-radius: 4px; width: 44px; background: #34C759; border-color: primary_color == "#34C759" ? white : transparent; border-width: 2px; TouchArea { clicked => { primary_color = "#34C759"; } } }
                Rectangle { height: 44px; border-radius: 4px; width: 44px; background: #007AFF; border-color: primary_color == "#007AFF" ? white : transparent; border-width: 2px; TouchArea { clicked => { primary_color = "#007AFF"; } } }
                Rectangle { height: 44px; border-radius: 4px; width: 44px; background: #AF52DE; border-color: primary_color == "#AF52DE" ? white : transparent; border-width: 2px; TouchArea { clicked => { primary_color = "#AF52DE"; } } }
            }

            GlassCard {
                height: 60px;
                background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                VerticalBox { alignment: center; padding: 12px;
                    Text { text: "✨ Generate Logo"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; horizontal-alignment: center;}
                    Text { text: "AI will create 3 options"; font-family: "Inter"; font-size: 12px; color: #94a3b8; horizontal-alignment: center;}
                }
                TouchArea { clicked => { generate_logo(); } }
            }
            GlassCard {
                height: 60px;
                background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                VerticalBox { alignment: center; padding: 12px;
                    Text { text: "📷 Upload Logo"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; horizontal-alignment: center;}
                    Text { text: "Background will be removed with AI"; font-family: "Inter"; font-size: 12px; color: #94a3b8; horizontal-alignment: center;}
                }
                TouchArea { clicked => { upload_logo(); } }
            }
        }

        // Step 2: Product
        if (step == 2) : VerticalBox {
            spacing: 16px;
            Text { text: "Add your first product or service"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }
            Text { text: "You can add more later"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }

            Text { text: "Name"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
            LineEdit { placeholder-text: "e.g. Custom Birthday Cake"; text <=> product_name; height: 44px; }

            Text { text: "Price"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
            LineEdit { placeholder-text: "e.g. 50.00"; text <=> product_price; height: 44px; input-type: decimal; }

            Text { text: "Description"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
            LineEdit { placeholder-text: "Short description"; text <=> product_description; height: 44px; }

            GlassCard {
                height: 44px;
                background: rgba(168, 85, 247, 0.4);
                VerticalBox { alignment: center; padding: 12px;
                    Text { text: "✨ Auto-generate description with AI"; font-family: "Inter"; font-size: 14px; color: white; font-weight: 700; horizontal-alignment: center;}
                }
                TouchArea { clicked => { generate_description(); } }
            }

            GlassCard {
                height: 100px;
                background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                VerticalBox { alignment: center; padding: 12px;
                    Text { text: "📷 Upload Photo (Camera/Upload)"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; horizontal-alignment: center;}
                    Text { text: "Tap to select an image"; font-family: "Inter"; font-size: 12px; color: #94a3b8; horizontal-alignment: center;}
                }
                TouchArea { clicked => { upload_photo(); } }
            }
        }

        // Step 3: Domain
        if (step == 3) : VerticalBox {
            spacing: 16px;
            Text { text: "Choose a Domain"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }
            Text { text: "Where will customers find you?"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }

            GlassCard {
                height: 80px;
                background: domain_choice == "subdomain" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                VerticalBox { alignment: center; padding: 12px;
                    Text { text: "🌐 Free OHC Domain"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                    Text { text: "mybusiness.ohc.app"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                }
                TouchArea { clicked => { domain_choice = "subdomain"; } }
            }
            GlassCard {
                height: 80px;
                background: domain_choice == "custom" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                VerticalBox { alignment: center; padding: 12px;
                    Text { text: "🌍 Connect Custom Domain"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                    Text { text: "e.g. www.mybusiness.com"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                }
                TouchArea { clicked => { domain_choice = "custom"; } }
            }
            GlassCard {
                height: 80px;
                background: domain_choice == "buy" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                VerticalBox { alignment: center; padding: 12px;
                    Text { text: "🛒 Buy a Domain"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                    Text { text: "Search and buy a new domain"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                }
                TouchArea { clicked => { domain_choice = "buy"; } }
            }

        }

        // Step 4: Review
        if (step == 4) : VerticalBox {
            spacing: 24px;
            Text { text: "Go Live: Review your site"; font-size: 28px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; horizontal-alignment: center; }

            ScrollView {
                VerticalBox {
                    spacing: 16px;

                    HeroBlock {
                        headline: product_name == "" ? "Welcome to My Business" : product_name;
                        subtitle: product_description == "" ? "The best services in town." : product_description;
                        cta_text: "Book Now";
                        cta_clicked => { }
                    }

                    ProductGridBlock {
                        product_name_1: product_name == "" ? "Product 1" : product_name;
                        product_price_1: product_price == "" ? "$10.00" : "$" + product_price;
                        product_name_2: "Custom Order";
                        product_price_2: "Contact Us";
                    }

                    CalendarBlock {}

                    GlassCard {
                        VerticalBox {
                            padding: 16px;
                            spacing: 12px;
                            Text { text: "Template: " + selected_template; font-family: "Inter"; font-size: 14px; color: #94a3b8; }
                            Text { text: "Color: " + primary_color; font-family: "Inter"; font-size: 14px; color: #94a3b8; }
                            Text { text: "Product: " + product_name; font-family: "Inter"; font-size: 14px; color: #94a3b8; }
                            Text { text: "Domain: " + domain_choice; font-family: "Inter"; font-size: 14px; color: #94a3b8; }
                        }
                    }
                }
            }

            if (is_publishing) : GlassCard {
                VerticalBox {
                    padding: 16px;
                    alignment: center;
                    spacing: 8px;
                    Text { text: "Publishing Site..."; font-size: 18px; font-family: "Outfit"; color: #a855f7; font-weight: 700; horizontal-alignment: center; }
                    Text { text: "Site goes live instantly!"; font-size: 14px; font-family: "Inter"; color: #94a3b8; horizontal-alignment: center; }

                    GlassCard {
                        height: 44px;
                        background: rgba(168, 85, 247, 0.2);
                        VerticalBox { alignment: center; padding: 12px;
                            Text { text: "📋 Copy Shareable Link"; font-family: "Inter"; font-size: 14px; color: white; font-weight: 700; horizontal-alignment: center;}
                        }
                        TouchArea { clicked => { copy_to_clipboard("https://mybusiness.ohc.app"); } }
                    }

                    // Viral Storefront Footer
                    GlassCard {
                        height: 44px;
                        background: rgba(255, 255, 255, 0.05);
                        border-color: rgba(255, 255, 255, 0.1);
                        border-radius: 12px;
                        VerticalBox { alignment: center; padding: 12px;
                            Text { text: "Built with OHC — Start your free business →"; font-family: "Inter"; font-size: 12px; color: #a855f7; horizontal-alignment: center;}
                        }
                        TouchArea { clicked => { open_ohc_signup(); } }
                    }
                }
            }
        }

        Rectangle {} // Spacer

        // Navigation
        HorizontalBox {
            alignment: space-between;
            if (step > 0 && !is_publishing) : GlassCard {
                width: 80px;
                height: 44px;
                VerticalBox { alignment: center; Text { text: "Back"; font-family: "Inter"; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { step = step - 1; } }
            }
            if (step == 0) : Rectangle { width: 80px; } // spacer

            if (!is_publishing) : GlassCard {
                width: 120px;
                height: 44px;
                background: rgba(168, 85, 247, 0.8);
                VerticalBox { alignment: center; Text { text: step == 4 ? "Publish →" : "Next →"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => {
                    if (step < 4) {
                        step += 1;
                    } else {
                        is_publishing = true;
                        publish_site(selected_template, primary_color, product_name, product_price, product_description, domain_choice);
                    }
                } }
            }
        }
    }
}
