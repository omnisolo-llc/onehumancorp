import { Button, VerticalBox, HorizontalBox, LineEdit, CheckBox, ComboBox, TextEdit } from "std-widgets.slint";

export component Settings inherits Window {
    width: 500px;
    height: 1200px;
    title: "Settings";

    property <bool> standalone_mode: true;
    property <bool> expert_mode: false;
    property <string> backend_url;
    in-out property <string> user_name;
    in-out property <string> user_email;
    in-out property <string> org_id;
    in-out property <string> user_role;
    in-out property <bool> local_service_running: true;

    in-out property <bool> email_notifications: false;
    in-out property <bool> push_notifications: false;
    in-out property <string> timezone: "";
    in-out property <string> language: "";
    in-out property <string> theme: "";
    in-out property <string> date_format: "";
    in-out property <string> bio: "";
    in-out property <string> phone_number: "";

    in-out property <string> current_password: "";
    in-out property <string> new_password: "";
    in-out property <string> confirm_password: "";
    in-out property <string> password_match_status: "";

    callback start_stop_service();
    callback run_doctor();
    callback trigger_hybrid_sync();

    callback save_settings();
    callback cancel_settings();
    callback update_profile();
    callback change_password();

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        Text { text: "General"; font-weight: 700; color: #1e293b; font-size: 20px; }

        HorizontalBox {
            Text { text: "Timezone"; }
            ComboBox { model: ["UTC", "PST"]; current-value <=> timezone; }
        }

        HorizontalBox {
            Text { text: "Language"; }
            ComboBox { model: ["English", "Spanish"]; current-value <=> language; }
        }

        HorizontalBox {
            Text { text: "Theme"; }
            ComboBox { model: ["Light", "Dark"]; current-value <=> theme; }
        }

        HorizontalBox {
            Text { text: "Date Format"; }
            ComboBox { model: ["MM/DD/YYYY", "DD/MM/YYYY"]; current-value <=> date_format; }
        }

        Text { text: "Notification"; font-weight: 700; color: #1e293b; font-size: 20px; }
        CheckBox { text: "Email"; checked <=> email_notifications; }
        CheckBox { text: "Push"; checked <=> push_notifications; }

        HorizontalBox {
            Button { text: "Save"; clicked => { save_settings(); } }
            Button { text: "Cancel"; clicked => { cancel_settings(); } }
        }

        Text { text: "Profile"; font-weight: 700; color: #1e293b; font-size: 20px; }
        Text { text: "Photo / Avatar"; }
        LineEdit { placeholder-text: "Photo URL or File"; }

        LineEdit { placeholder-text: "Name"; text <=> user_name; }
        TextEdit { text <=> bio; }
        LineEdit { placeholder-text: "Email"; text <=> user_email; }
        LineEdit { placeholder-text: "Phone"; text <=> phone_number; }

        Button { text: "Update"; clicked => { update_profile(); } }

        Text { text: "Password / Security"; font-weight: 700; color: #1e293b; font-size: 20px; }
        LineEdit { placeholder-text: "Current Password"; text <=> current_password; }
        LineEdit { placeholder-text: "New Password"; text <=> new_password; }
        LineEdit { placeholder-text: "Confirm Password"; text <=> confirm_password; }
        Text { text: password_match_status; }
        Button { text: "Change"; clicked => { change_password(); } }

        // User Info
        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 8px;
            
            HorizontalBox {
                spacing: 16px;
                padding: 16px;
                Text { text: "👤"; font-size: 32px; }
                VerticalBox {
                    Text { text: user_name; font-weight: 700; color: #1e293b; }
                    Text { text: user_email; color: #64748b; }
                }
            }
        }

        // Communication Section
        Text { text: "COMMUNICATION"; color: #7c3aed; font-weight: 700; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 8px;

            VerticalBox {
                spacing: 12px;
                padding: 16px;
                
                HorizontalBox {
                    Text { text: standalone_mode ? "💻 Offline Mode" : "☁️ Cloud Mode"; font-weight: 700; color: #1e293b; }
                }
                
                Text {
                    text: standalone_mode ? 
                        "Your app will run directly on this device without needing internet." :
                        "Your app will connect to your cloud server.";
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalBox {
            Text { text: "Cloud Server Address:"; color: #1e293b; horizontal-alignment: center; }
            LineEdit { text: backend_url; }
        }

        HorizontalBox {
            Text { text: "Work Offline"; color: #1e293b; }
            CheckBox {
                checked: standalone_mode;
                toggled => { standalone_mode = !standalone_mode; }
            }
        }

        // Local Backend Section (Conditional)
        if (standalone_mode) : VerticalBox {
            spacing: 10px;
            Text { text: "YOUR DEVICE"; color: #7c3aed; font-weight: 700; }
            
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 16px;
                    Text { text: "App Status: " + (local_service_running ? "Running" : "Stopped"); color: #1e293b; horizontal-alignment: center; }
                    Button { 
                        text: local_service_running ? "Stop" : "Start";
                        clicked => { start_stop_service(); }
                    }
                }
            }
            Button { 
                text: "Run Doctor Diagnostics";
                clicked => { run_doctor(); }
            }
        }

        // Other Settings
        HorizontalBox {
            Text { text: "Expert Mode"; color: #1e293b; }
            CheckBox {
                checked: expert_mode;
                toggled => { expert_mode = !expert_mode; }
            }
        }

        // Account Section
        Text { text: "ACCOUNT"; color: #7c3aed; font-weight: 700; }
        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 8px;
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                HorizontalBox {
                    Text { text: "Organization:"; color: #64748b; }
                    Text { text: org_id; color: #1e293b; }
                }
                HorizontalBox {
                    Text { text: "Role:"; color: #64748b; }
                    Text { text: user_role; color: #1e293b; }
                }
            }
        }

        Button {
            text: "Sync with Cloud";
            clicked => { trigger_hybrid_sync(); }
        }

        Button {
            text: "Sign Out";
        }
    }
}
