import { TooltipElement } from "tooltip_element.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, CheckBox } from "std-widgets.slint";

export component Settings inherits Window {
    width: 500px;
    height: 700px;
    title: "Settings";

    in-out property <bool> standalone_mode: true;
    in-out property <bool> is_advanced: false;
    property <string> backend_url;
    in-out property <string> user_name;
    in-out property <string> user_email;
    in-out property <string> org_id;
    in-out property <string> user_role;
    in-out property <bool> local_service_running: true;

    callback start_stop_service();
    callback run_doctor();
    callback trigger_hybrid_sync();
    callback save_state();
    callback sign_out();

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        // User Info
        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 8px;
            
            HorizontalBox {
                spacing: 16px;
                padding: 16px;
                Text { text: "👤"; font-size: 32px; }
                VerticalBox {
                    Text { text: user_name; font-weight: 700; color: #1e293b; }
                    Text { text: user_email; color: #64748b; }
                }
            }
        }

        // Communication Section
        Text { text: "COMMUNICATION"; color: #7c3aed; font-weight: 700; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 8px;

            VerticalBox {
                spacing: 12px;
                padding: 16px;
                
                HorizontalBox {
                    Text { text: standalone_mode ? "💻 Offline Mode" : "☁️ Cloud Mode"; font-weight: 700; color: #1e293b; }
                }
                
                Text {
                    text: standalone_mode ? 
                        "Your app will run directly on this device without needing internet." :
                        "Your app will connect to your cloud server.";
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalBox {
            Text { text: "Online Sync Server:"; color: #1e293b; horizontal-alignment: center; }
            LineEdit { text: backend_url; }
        }

        HorizontalBox {
            TooltipElement {
                tooltip_id: "offline_mode";
                Text { text: "Work Offline"; color: #1e293b; }
            }
            CheckBox {
                checked: standalone_mode;
                toggled => { standalone_mode = !standalone_mode; }
            }
        }

        // Local Backend Section (Conditional)
        if (standalone_mode) : VerticalBox {
            spacing: 10px;
            Text { text: "YOUR DEVICE"; color: #7c3aed; font-weight: 700; }
            
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 16px;
                    Text { text: "App Status: " + (local_service_running ? "Running" : "Stopped"); color: #1e293b; horizontal-alignment: center; }
                    Button { 
                        text: local_service_running ? "Stop" : "Start";
                        clicked => { start_stop_service(); }
                    }
                }
            }
            Button { 
                text: "Fix App Issues";
                clicked => { run_doctor(); }
            }
        }

        // Other Settings
        HorizontalBox {
            TooltipElement {
                tooltip_id: "advanced_mode";
                Text { text: "Advanced mode"; color: #1e293b; }
            }
            CheckBox {
                checked: is_advanced;
                toggled => { is_advanced = !is_advanced; save_state(); }
            }
        }

        // Account Section
        Text { text: "ACCOUNT"; color: #7c3aed; font-weight: 700; }
        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 8px;
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                HorizontalBox {
                    Text { text: "Organization:"; color: #64748b; }
                    Text { text: org_id; color: #1e293b; }
                }
                HorizontalBox {
                    Text { text: "Role:"; color: #64748b; }
                    Text { text: user_role; color: #1e293b; }
                }
            }
        }

        Button {
            text: "Sync with Cloud";
            clicked => { trigger_hybrid_sync(); }
        }

        Button {
            text: "Sign Out";
            clicked => { sign_out(); }
        }
    }
}
