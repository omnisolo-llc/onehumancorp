import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component HeroBlock inherits Rectangle {
    in property <string> headline: "Your Headline Here";
    in property <string> subtitle: "Add a short description about your business.";
    in property <string> cta_text: "Get Started";
    callback cta_clicked();

    min-width: 327px;

    VerticalBox {
        padding: 24px;
        spacing: 16px;
        alignment: center;

        Text {
            text: headline;
            font-family: "Outfit";
            font-size: 32px;
            font-weight: 700;
            color: white;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: subtitle;
            font-family: "Inter";
            font-size: 16px;
            color: #e2e8f0;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalBox {
            alignment: center;
            Rectangle {
                width: 140px;
                height: 44px;
                background: rgba(168, 85, 247, 0.8);
                VerticalBox {
                    alignment: center;
                    Text { text: cta_text; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; }
                }
                TouchArea { clicked => { cta_clicked(); } }
            }
        }
    }
}

export component ProductGridBlock inherits Rectangle {
