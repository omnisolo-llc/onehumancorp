            text: "Our Products";
            font-family: "Outfit";
            font-size: 24px;
            font-weight: 700;
            color: white;
            horizontal-alignment: left;
        }

        HorizontalBox {
            spacing: 12px;

            Rectangle {
                height: 150px;
                background: rgba(255, 255, 255, 0.05);
                VerticalBox {
                    alignment: end;
                    padding: 12px;
                    spacing: 4px;
                    Text { text: product_name_1; font-family: "Inter"; font-weight: 700; color: white; }
                    Text { text: product_price_1; font-family: "Inter"; color: #10b981; }
                }
            }

            Rectangle {
                height: 150px;
                background: rgba(255, 255, 255, 0.05);
                VerticalBox {
                    alignment: end;
                    padding: 12px;
                    spacing: 4px;
                    Text { text: product_name_2; font-family: "Inter"; font-weight: 700; color: white; }
                    Text { text: product_price_2; font-family: "Inter"; color: #10b981; }
                }
            }
        }
    }
}

