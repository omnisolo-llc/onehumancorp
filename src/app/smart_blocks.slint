export component CalendarBlock inherits Rectangle {
    min-width: 327px;

    in-out property <string> selected_date: "";
    in-out property <string> selected_time: "";
    in-out property <[string]> available_slots: [];
    in-out property <bool> is_booked: false;

    callback fetch_availability();
    callback select_date(string);
    callback select_time(string);
    callback book_slot();

    select_date(d) => {
        selected_date = d;
        selected_time = "";
        fetch_availability();
    }

    select_time(t) => {
        selected_time = t;
    }

    book_slot() => {
        is_booked = true;
    }

    VerticalBox {
        padding: 16px;
        spacing: 16px;

        if (!is_booked) : VerticalBox {
            spacing: 16px;
            Text {
                text: "Book an Appointment";
                font-family: "Outfit";
                font-size: 24px;
                font-weight: 700;
                color: white;
                horizontal-alignment: left;
            }

            VerticalBox {
                spacing: 8px;
                HorizontalBox {
                    alignment: space-between;
                    TouchArea { clicked => { select_date("Mon"); } Text { text: "Mon"; font-family: "Inter"; color: selected_date == "Mon" ? white : #94a3b8; font-size: 14px; font-weight: selected_date == "Mon" ? 700 : 400; } }
                    TouchArea { clicked => { select_date("Tue"); } Text { text: "Tue"; font-family: "Inter"; color: selected_date == "Tue" ? white : #94a3b8; font-size: 14px; font-weight: selected_date == "Tue" ? 700 : 400; } }
                    TouchArea { clicked => { select_date("Wed"); } Text { text: "Wed"; font-family: "Inter"; color: selected_date == "Wed" ? white : #94a3b8; font-size: 14px; font-weight: selected_date == "Wed" ? 700 : 400; } }
                    TouchArea { clicked => { select_date("Thu"); } Text { text: "Thu"; font-family: "Inter"; color: selected_date == "Thu" ? white : #94a3b8; font-size: 14px; font-weight: selected_date == "Thu" ? 700 : 400; } }
                    TouchArea { clicked => { select_date("Fri"); } Text { text: "Fri"; font-family: "Inter"; color: selected_date == "Fri" ? white : #94a3b8; font-size: 14px; font-weight: selected_date == "Fri" ? 700 : 400; } }
                }

                if (selected_date == "") : Rectangle {
                    height: 44px;
                    background: rgba(255, 255, 255, 0.1);
                    VerticalBox {
                        alignment: center;
                        Text { text: "Select a date"; font-family: "Inter"; color: white; horizontal-alignment: center; }
                    }
                }

                if (selected_date != "") : VerticalBox {
                    spacing: 8px;
                    for slot in available_slots : Rectangle {
                        height: 44px;
                        background: selected_time == slot ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.1);
                        border-width: selected_time == slot ? 2px : 0px;
                        border-color: rgba(168, 85, 247, 1.0);
                        VerticalBox {
                            alignment: center;
                            Text { text: slot; font-family: "Inter"; color: white; horizontal-alignment: center; font-weight: selected_time == slot ? 700 : 400; }
                        }
                        TouchArea { clicked => { select_time(slot); } }
                    }

                    if (available_slots.length == 0) : Text {
                        text: "Loading availability...";
                        font-family: "Inter";
                        color: #94a3b8;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }
                }

                if (selected_time != "") : Rectangle {
                    height: 44px;
                    background: rgba(168, 85, 247, 0.8);
                    VerticalBox {
                        alignment: center;
                        Text { text: "Confirm Booking"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; }
                    }
                    TouchArea { clicked => { book_slot(); } }
                }
            }
        }
        if (is_booked) : VerticalBox {
            spacing: 16px;
            alignment: center;
            Text { text: "✅ Booking Confirmed!"; font-family: "Outfit"; font-size: 24px; font-weight: 700; color: white; horizontal-alignment: center; }
            Text { text: "You're all set for " + selected_date + " at " + selected_time + "."; font-family: "Inter"; font-size: 16px; color: #cbd5e1; horizontal-alignment: center; wrap: word-wrap; }
        }
    }
}
