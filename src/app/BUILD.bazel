load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen")

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    data = glob(["*.slint"]) + [
        "//src/proto:hub.proto",
        "@protobuf//:protoc",
    ],
    edition = "2024",
    deps = [
        "@crates//:slint-build",
        "@crates//:tonic-build",
    ],
)

# WASM-specific build script (runs on host, generates slint code only - no proto)
cargo_build_script(
    name = "build_script_wasm",
    srcs = ["build_wasm.rs"],
    data = glob(["*.slint"]),
    edition = "2024",
    deps = [
        "@crates//:slint-build",
