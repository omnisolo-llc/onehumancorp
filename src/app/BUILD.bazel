# WASM build using Bazel rules (replaces wasm-pack genrule)
# Note: Build with: bazel build //src/app:app_web --platforms=@rules_rust//rust/platform:wasm32
# Note: Build bindings with: bazel build //src/app:app_web_bindgen
rust_shared_library(
    name = "app_web",
    srcs = ["main.rs"],
    data = glob(["*.slint"]),
    edition = "2024",
    deps = [
        ":build_script_wasm",
        "@crates//:chrono",
        "@crates//:futures",
        "@crates//:prost",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:serde_yaml",
        "@crates//:slint",
        "@crates//:wasm-bindgen",
        "@crates//:console_error_panic_hook",
        "@crates//:wasm-bindgen-futures",
        "@crates//:getrandom",
    ],
)

# Generate JS/TS bindings using rust_wasm_bindgen rule
# The toolchain uses wasm-bindgen-cli 0.2.105 which matches the wasm-bindgen crate (via version annotation)
rust_wasm_bindgen(
    name = "app_web_bindgen",
    wasm_file = ":app_web",
    target = "web",
    visibility = ["//visibility:public"],
)

exports_files([
    "Cargo.toml",
    "Cargo.lock",
    "index.html",
])
