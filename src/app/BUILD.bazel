load("@rules_rust//rust:defs.bzl", "rust_binary")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    edition = "2021",
    data = [
        "src/ongoing_management.slint",
        "//src/proto:hub.proto",
        "@protobuf//:protoc",
    ],
    deps = [
        "@crates//:slint-build",
        "@crates//:tonic-build",
    ],
)

rust_binary(
    name = "app-rust",
    srcs = ["src/main.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    data = ["src/ongoing_management.slint"],
    deps = [
        ":build_script",
        "@crates//:slint",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:prost",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])
