load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    data = glob(["*.slint"]) + [
        "//src/proto:hub.proto",
        "@protobuf//:protoc",
    ],
    edition = "2024",
    build_script_env = {
        "SLINT_STYLE": "native",
    },
    deps = [
        "@crates//:slint-build",
        # "@crates//:tonic-build",
    ],
)

rust_binary(
    name = "app-rust",
    srcs = [
        "agent.rs",
        "api_service.rs",
        "local_manager.rs",
        "desktop_platform.rs",
        "main.rs",
    ],
    data = glob(["*.slint"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":build_script",
        "@crates//:chrono",
        "@crates//:futures",
        "@crates//:prost",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:serde_yaml",
        "@crates//:slint",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

# WASM build target
rust_binary(
    name = "app-wasm",
    srcs = [
        "lib.rs",
    ],
    crate_root = "lib.rs",
    data = glob(["*.slint"]),
    edition = "2024",
    deps = [
        ":build_script",
        "@crates//:slint",
        "@crates//:wasm-bindgen",
    ],
)

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

# Filegroup for web assets (HTML entry point)
filegroup(
    name = "web_index_html",
    srcs = ["web/index.html"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "app_test",
    srcs = [
        "agent.rs",
        "api_service.rs",
        "local_manager.rs",
        "desktop_platform.rs",
        "main.rs",
    ],
    crate_root = "main.rs",
    data = glob(["*.slint"]),
    edition = "2024",
    deps = [
        ":build_script",
        "@crates//:chrono",
        "@crates//:futures",
        "@crates//:mockito",
        "@crates//:prost",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:serde_yaml",
        "@crates//:slint",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:i-slint-backend-testing",
    ],
)

rust_test(
    name = "app_e2e_test",
    srcs = [
        "e2e.rs",
    ],
    crate_root = "e2e.rs",
    data = glob(["*.slint"]),
    edition = "2024",
    deps = [
        ":build_script",
        "@crates//:slint",
        "@crates//:i-slint-backend-testing",
    ],
)
