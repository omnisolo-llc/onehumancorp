import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component SwarmMemory inherits Window {
    width: 900px;
    height: 600px;
    title: "Memory Dashboard";

    callback view_walkthrough();
    in-out property <string> mesh_activity: "None";
    in-out property <string> durable_memory: "Empty";
    in-out property <int> velocity_score: 0;
    out property <string> text-live-activity: "Live Agent Activity";
    out property <string> text-saved-history: "Saved History";
    out property <string> text-automatic-processes: "Automatic Processes";

    background: #f8fafc;

    HorizontalBox {
        spacing: 20px;
        padding: 24px;

        // Left Column: Live Mesh
        VerticalBox {
            spacing: 10px;
            width: 270px;
            
            Text { text: text_live_activity; font-size: 20px; font-weight: 700; color: #1e293b; }
            Text { text: "Real-time live feed"; color: #64748b; }
            
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 10px;
                    alignment: start;
                    
                    Rectangle {
                        background: #f1f5f9;
                        border-radius: 8px;
                        
                        VerticalBox {
                            padding: 8px;
                            Text { text: "Agent Alice"; font-weight: 700; color: #a855f7; }
                            Text { text: "Processed task 123"; color: #1e293b; }
                        }
                    }
                }
            }
        }

        // Center Column: Durable Memory
        VerticalBox {
            spacing: 10px;
            width: 270px;
            
            Text { text: text_saved_history; font-size: 20px; font-weight: 700; color: #1e293b; }
            Text { text: "Offline Sync"; color: #64748b; }
            
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 10px;
                    alignment: start;
                    
                    Rectangle {
                        background: #f1f5f9;
                        border-radius: 8px;
                        
                        VerticalBox {
                            padding: 8px;
                            Text { text: "Project goal defined"; color: #1e293b; }
                            Text { text: "2026-04-25 12:00"; color: #64748b; font-size: 12px; }
                        }
                    }
                }
            }
        }

        // Right Column: AutoDream
        VerticalBox {
            spacing: 10px;
            width: 270px;
            
            Text { text: text_automatic_processes; font-size: 20px; font-weight: 700; color: #1e293b; }
            Text { text: "Memory Visualizer"; color: #64748b; }
            
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: "[ Agent Speed Chart ]"; color: #64748b; horizontal-alignment: center; }
                    Text { text: "[ Memory Visualizer ]"; color: #64748b; horizontal-alignment: center; }
                    Button { text: "View Walkthrough"; clicked => { view_walkthrough(); } }
                }
            }
        }
    }
}
