import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component SwarmMemory inherits Window {
    width: 900px;
    height: 600px;
    title: "System Memory";

    callback view_walkthrough();
    in-out property <string> mesh_activity: "None";
    in-out property <string> durable_memory: "Empty";
    in-out property <int> velocity_score: 0;

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);


    HorizontalBox {
        spacing: 20px;
        padding: 24px;

        // Left Column: Live Mesh
        VerticalBox {
            spacing: 10px;
            width: 270px;
            
            Text { text: "Live Activity"; font-size: 20px; font-weight: 700; color: white; font-family: "Outfit"; }
            Text { text: "Live updates"; color: #94a3b8; font-family: "Inter"; }
            
            Rectangle {
                background: rgba(255, 255, 255, 0.03);
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 10px;
                    alignment: start;
                    
                    Rectangle {
                        background: rgba(255, 255, 255, 0.05);
                        border-radius: 8px;
                        
                        VerticalBox {
                            padding: 8px;
                            Text { text: "Helper Alice"; font-weight: 700; color: #a855f7; }
                            Text { text: "Processed task 123"; color: white; font-family: "Inter"; }
                        }
                    }
                }
            }
        }

        // Center Column: Durable Memory
        VerticalBox {
            spacing: 10px;
            width: 270px;
            
            Text { text: "Saved Information"; font-size: 20px; font-weight: 700; color: white; font-family: "Outfit"; }
            Text { text: "Cloud Backup"; color: #94a3b8; font-family: "Inter"; }
            
            Rectangle {
                background: rgba(255, 255, 255, 0.03);
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 10px;
                    alignment: start;
                    
                    Rectangle {
                        background: rgba(255, 255, 255, 0.05);
                        border-radius: 8px;
                        
                        VerticalBox {
                            padding: 8px;
                            Text { text: "Project goal defined"; color: white; font-family: "Inter"; }
                            Text { text: "2026-04-25 12:00"; color: #94a3b8; font-family: "Inter"; font-size: 12px; }
                        }
                    }
                }
            }
        }

        // Right Column: AutoDream
        VerticalBox {
            spacing: 10px;
            width: 270px;
            
            Text { text: "Automated Tasks"; font-size: 20px; font-weight: 700; color: white; font-family: "Outfit"; }
            Text { text: "System Insights"; color: #94a3b8; font-family: "Inter"; }
            
            Rectangle {
                background: rgba(255, 255, 255, 0.03);
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: "[ Task Speed ]"; color: #94a3b8; font-family: "Inter"; horizontal-alignment: center; }
                    Text { text: "[ Memory Viewer ]"; color: #94a3b8; font-family: "Inter"; horizontal-alignment: center; }
                    Button { text: "View Walkthrough"; clicked => { view_walkthrough(); } }
                }
            }
        }
    }
}
