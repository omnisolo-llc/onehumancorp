import { Button, VerticalBox, HorizontalBox, CheckBox, LineEdit } from "std-widgets.slint";

export struct UiHelperProvider {
    type_: string,
    label: string,
    description: string,
}

export component AgentHire inherits Window {
    width: 600px;
    height: 700px;
    title: "Hire New Helper";

    in-out property <int> step: 0;
    in-out property <string> selected_role: "";
    in-out property <string> selected_provider: "";
    in-out property <string> helper_name: "";
    
    out property <bool> next_enabled: step != 0 || selected_role != "";
    
    in property <[string]> roles;
    in property <[UiHelperProvider]> providers;
    
    callback deploy_helper(string, string, string);
    property <bool> cap_email: false;
    property <bool> cap_message: false;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        Text { text: "Hire New Helper"; font-size: 24px; font-weight: 700; color: #1e293b; }

        // Step 0: Role
        if (step == 0) : VerticalBox {
            spacing: 10px;
            Text { text: "Step 1 — Select Helper Role"; font-size: 18px; font-weight: 700; color: #1e293b; }
            
            HorizontalBox {
                spacing: 10px;
                for role in roles : Button {
                    text: role;
                    clicked => { selected_role = role; helper_name = "Senior " + role; }
                }
            }
            Text { text: "Selected: " + selected_role; color: #a855f7; }
        }

        // Step 1: Provider
        if (step == 1) : VerticalBox {
            spacing: 10px;
            Text { text: "Step 2 — Choose AI Provider"; font-size: 18px; font-weight: 700; color: #1e293b; }
            
            for p in providers : Button {
                text: p.label;
                clicked => { selected_provider = p.type_; }
            }
            Text { text: "Selected: " + selected_provider; color: #a855f7; }
        }

        // Step 2: Details
        if (step == 2) : VerticalBox {
            spacing: 10px;
            Text { text: "Step 3 — Helper Details"; font-size: 18px; font-weight: 700; color: #1e293b; }
            LineEdit {
                placeholder-text: "Helper Name";
                text <=> helper_name;
            }
        }

        // Step 3: Topology
        if (step == 3) : VerticalBox {
            spacing: 10px;
            Text { text: "Step 4 — Sub-helper Topology"; font-size: 18px; font-weight: 700; color: #1e293b; }
            Text { text: "[ Topology visualization placeholder ]"; color: #64748b; horizontal-alignment: center; }
        }

        // Step 4: Capabilities
        if (step == 4) : VerticalBox {
            spacing: 10px;
            Text { text: "Step 5 — Select Capabilities"; font-size: 18px; font-weight: 700; color: #1e293b; }
            HorizontalBox {
                Text { text: "Read my emails"; color: #1e293b; }
                CheckBox { checked: cap_email; toggled => { cap_email = !cap_email; } }
            }
            HorizontalBox {
                Text { text: "Send messages on my behalf"; color: #1e293b; }
                CheckBox { checked: cap_message; toggled => { cap_message = !cap_message; } }
            }
        }

        // Step 5: Limits
        if (step == 5) : VerticalBox {
            spacing: 10px;
            Text { text: "Step 6 — Resource Limits"; font-size: 18px; font-weight: 700; color: #1e293b; }
            Text { text: "Max sessions per day: 50"; color: #1e293b; }
            Text { text: "[ Slider ]"; color: #64748b; horizontal-alignment: center; }
        }

        // Step 6: Confirm
        if (step == 6) : VerticalBox {
            spacing: 10px;
            Text { text: "Step 7 — Confirm Deployment"; font-size: 18px; font-weight: 700; color: #1e293b; }
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    Text { text: "Name: " + helper_name; color: #1e293b; }
                    Text { text: "Role: " + selected_role; color: #1e293b; }
                    Text { text: "Provider: " + selected_provider; color: #1e293b; }
                }
            }
        }

        Rectangle {} // Spacer

        // Navigation
        HorizontalBox {
            if (step > 0) : Button {
                text: "Back";
                clicked => { step = step - 1; }
            }
            Rectangle {} // Spacer
            Button {
                text: step == 6 ? "Deploy Helper" : "Next";
                enabled: next_enabled;
                clicked => {
                    if (step < 6) {
                        step = step + 1;
                    } else {
                        deploy_helper(helper_name, selected_role, selected_provider);
                    }
                }
            }
        }
    }
}
