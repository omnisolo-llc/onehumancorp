import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct UiChatChannel {
    id: string,
    name: string,
    backend_name: string,
    icon: string,
    enabled: bool,
}

export component Channels inherits Window {
    min-width: 375px;
    preferred-width: 500px;
    height: 600px;
    title: "Chat Channels";
    out property <string> test_title: root.title;

    background: #f8fafc;

    in property <[UiChatChannel]> channels;
    callback add_channel();

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Chat Channels"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            Button { 
                text: "Add Channel"; 
                clicked => { add_channel(); }
            }
        }

        VerticalBox {
            spacing: 10px;
            
            for c in channels : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 16px;
                    Text { text: c.icon; font-size: 24px; horizontal-alignment: center; }
                    VerticalBox {
                        Text { text: c.name; font-weight: 700; color: #1e293b; }
                        Text { text: c.backend_name; color: #64748b; }
                    }
                    Rectangle {} 
                    Text { 
                        text: c.enabled ? "Enabled" : "Disabled"; 
                        color: c.enabled ? #10b981 : #9ca3af; 
                        horizontal-alignment: center; 
                    }
                }
            }
        }
    }
}
