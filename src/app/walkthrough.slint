import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Walkthrough inherits Window {
    width: 600px;
    height: 500px;
    title: "Cloud Sync Setup";

    property <int> current_step: 0;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;
        alignment: center;

        Text { text: "How Cloud Backup Works"; font-size: 24px; font-weight: 700; color: #1e293b; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 16px;
            width: 500px;
            
            VerticalBox {
                padding: 32px;
                spacing: 16px;
                
                Text {
                    text: current_step == 0 ? "1. Save Locally" :
                          current_step == 1 ? "2. Check for Updates" :
                          current_step == 2 ? "3. Gather New Data" :
                          current_step == 3 ? "4. Securely Upload" :
                          current_step == 4 ? "5. Save to Cloud" :
                          current_step == 5 ? "6. Confirm Save" :
                          "7. Mark as Backed Up";
                    font-size: 20px;
                    font-weight: 700;
                    color: #0284c7;
                }
                
                Text {
                    text: current_step == 0 ? "Your app saves new information to your phone or computer first." :
                          current_step == 1 ? "The app checks if there's any new information that hasn't been backed up yet." :
                          current_step == 2 ? "The app gathers all your recent changes together." :
                          current_step == 3 ? "Your changes are safely sent to your private cloud storage." :
                          current_step == 4 ? "Your data is securely saved in the cloud so you can access it from any device." :
                          current_step == 5 ? "The cloud confirms everything was saved correctly." :
                          "Your app marks the information as safely backed up!";
                    color: #1e293b;
                    wrap: word-wrap;
                }
                
                Rectangle {
                    background: #f1f5f9;
                    border-radius: 8px;
                    
                    HorizontalBox {
                        padding: 12px;
                        spacing: 12px;
                        Text { text: "🔄"; color: #0284c7; }
                        Text {
                            text: current_step == 0 ? "App -> Local Storage" :
                                  current_step == 1 ? "Background Saver -> Local Storage" :
                                  current_step == 2 ? "Local Storage -> Background Saver" :
                                  current_step == 3 ? "Background Saver -> Cloud" :
                                  current_step == 4 ? "Cloud -> Cloud Database" :
                                  current_step == 5 ? "Cloud -> Background Saver" :
                                  "Background Saver -> Local Storage";
                            color: #0284c7;
                            wrap: word-wrap;
                        }
                    }
                }
                
                HorizontalBox {
                    alignment: center;
                    spacing: 20px;
                    
                    Button {
                        text: "Previous Step";
                        enabled: current_step > 0;
                        clicked => { current_step = current_step - 1; }
                    }
                    
                    Text {
                        text: "Step " + (current_step + 1) + " of 7";
                        color: #9ca3af;
                        horizontal-alignment: center;
                    }
                    
                    Button {
                        text: "Next Step";
                        enabled: current_step < 6;
                        clicked => { current_step = current_step + 1; }
                    }
                }
            }
        }
    }
}
