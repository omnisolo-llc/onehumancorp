import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Walkthrough inherits Window {
    width: 600px;
    height: 500px;
    title: "Activate your AI Support Agent";

    property <int> current_step: 0;

    background: transparent;

    VerticalBox {
        spacing: 20px;
        padding: 24px;
        alignment: center;

        Text { text: "Interactive Guide: Setup AI Agent"; font-size: 24px; font-weight: 700; color: #1e293b; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 16px;
            width: 500px;
            
            VerticalBox {
                padding: 32px;
                spacing: 16px;
                
                Text {
                    text: current_step == 0 ? "1. Connect your account" :
                          current_step == 1 ? "2. AI learns your voice" :
                          current_step == 2 ? "3. Review AI answers" :
                          current_step == 3 ? "4. Publish agent" :
                          current_step == 4 ? "5. AI handles messages" :
                          current_step == 5 ? "6. Get weekly reports" :
                          "7. Everything synced";
                    font-size: 20px;
                    font-weight: 700;
                    color: #0284c7;
                }
                
                Text {
                    text: current_step == 0 ? "Connect your Instagram and email so the agent can see incoming messages." :
                          current_step == 1 ? "The agent reads your menu, prices, and past messages to understand how you talk." :
                          current_step == 2 ? "You can review test answers the AI writes before it talks to real customers." :
                          current_step == 3 ? "Turn on your AI agent so it starts replying to new messages." :
                          current_step == 4 ? "The AI will automatically reply to customer questions about your business." :
                          current_step == 5 ? "You'll get a simple summary every week showing what the AI handled." :
                          "You're all set! Your AI Support Agent is working perfectly.";
                    color: #1e293b;
                    wrap: word-wrap;
                }
                
                Rectangle {
                    background: #f1f5f9;
                    border-radius: 8px;
                    
                    HorizontalBox {
                        padding: 12px;
                        spacing: 12px;
                        Text { text: "🔄"; color: #0284c7; }
                        Text {
                            text: current_step == 0 ? "Instagram & Email Connected" :
                                  current_step == 1 ? "AI is reading your past messages" :
                                  current_step == 2 ? "Reviewing test answers" :
                                  current_step == 3 ? "Agent turned on" :
                                  current_step == 4 ? "AI replying to customers" :
                                  current_step == 5 ? "Weekly reports scheduled" :
                                  "All setup complete";
                            color: #0284c7;
                            wrap: word-wrap;
                        }
                    }
                }
                
                HorizontalBox {
                    alignment: center;
                    spacing: 20px;
                    
                    Button {
                        text: "Previous Step";
                        enabled: current_step > 0;
                        clicked => { current_step = current_step - 1; }
                    }
                    
                    Text {
                        text: "Step " + (current_step + 1) + " of 7";
                        color: #9ca3af;
                        horizontal-alignment: center;
                    }
                    
                    Button {
                        text: "Next Step";
                        enabled: current_step < 6;
                        clicked => { current_step = current_step + 1; }
                    }
                }
            }
        }
    }
}
