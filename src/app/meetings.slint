import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct UiMeeting {
    name: string,
    status: string,
    participants: int,
    is_active: bool,
}

export component Meetings inherits Window {
    min-width: 375px;
    preferred-width: 500px;
    height: 600px;
    title: "Meeting Rooms";
    out property <string> test_title: root.title;

    in-out property <[UiMeeting]> meetings;
    callback new_room();
    callback join_room(string);

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Meeting Rooms"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            Button { text: "New Room"; clicked => { new_room(); } }
        }

        VerticalBox {
            spacing: 12px;
            
            for m in meetings : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 16px;
                    Text { text: "📹"; font-size: 32px; horizontal-alignment: center; } 
                    VerticalBox {
                        Text { text: m.name; font-weight: 700; color: #1e293b; }
                        HorizontalBox {
                            spacing: 5px;
                            Rectangle { background: m.is_active ? #10b981 : #a855f7; border-radius: 4px; width: 8px; height: 8px; } 
                            Text { text: m.status; color: m.is_active ? #10b981 : #a855f7; font-size: 12px; }
                            Text { text: "👥 " + m.participants; color: #64748b; font-size: 12px; }
                        }
                    }
                    Rectangle {} 
                    Button { text: "Join"; clicked => { join_room(m.name); } }
                }
            }
        }
    }
}
