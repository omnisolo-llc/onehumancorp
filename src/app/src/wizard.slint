import { Button, VerticalBox, HorizontalBox, LineEdit, CheckBox } from "std-widgets.slint";

export component Wizard inherits Window {
    width: 600px;
    height: 500px;
    title: "Setup Wizard";

    property <int> step: 0;
    property <bool> is_advanced: false;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        Text { text: "Setup Wizard"; font-size: 24px; font-weight: 700; color: #1e293b; }

        HorizontalBox {
            spacing: 10px;
            alignment: center;
            
            Rectangle { 
                background: step >= 0 ? #a855f7 : #e2e8f0; 
                border-radius: 12px; 
                width: 24px; 
                height: 24px; 
                HorizontalBox {
                    padding: 2px;
                    Text { text: "1"; color: white; horizontal-alignment: center; } 
                }
            }
            Text { text: "Server"; color: step == 0 ? #1e293b : #64748b; }
            
            Rectangle { 
                background: step >= 1 ? #a855f7 : #e2e8f0; 
                border-radius: 12px; 
                width: 24px; 
                height: 24px; 
                HorizontalBox {
                    padding: 2px;
                    Text { text: "2"; color: white; horizontal-alignment: center; } 
                }
            }
            Text { text: "AI Provider"; color: step == 1 ? #1e293b : #64748b; }
            
            Rectangle { 
                background: step >= 2 ? #a855f7 : #e2e8f0; 
                border-radius: 12px; 
                width: 24px; 
                height: 24px; 
                HorizontalBox {
                    padding: 2px;
                    Text { text: "3"; color: white; horizontal-alignment: center; } 
                }
            }
            Text { text: "Real-time"; color: step == 2 ? #1e293b : #64748b; }
        }

        if (step == 0) : VerticalBox {
            spacing: 10px;
            Text { text: "Server Settings"; font-size: 18px; font-weight: 700; color: #1e293b; }
            if (is_advanced) : VerticalBox {
                spacing: 10px;
                LineEdit { placeholder-text: "Listen Address"; text: "0.0.0.0:18789"; }
                LineEdit { placeholder-text: "Database Path"; text: "ohc.db"; }
            }
            if (!is_advanced) : VerticalBox {
                Text { text: "Default server settings will be used. They are optimized for the easiest experience."; color: #64748b; wrap: word-wrap; }
            }
        }

        if (step == 1) : VerticalBox {
            spacing: 10px;
            Text { text: "AI Provider — Minimax"; font-size: 18px; font-weight: 700; color: #1e293b; }
            if (is_advanced) : VerticalBox {
                spacing: 10px;
                LineEdit { placeholder-text: "Minimax API Key"; }
                LineEdit { placeholder-text: "Default Model"; text: "abab6.5s"; }
            }
            if (!is_advanced) : VerticalBox {
                Text { text: "Default AI provider settings will be applied. Your agents are ready to help."; color: #64748b; wrap: word-wrap; }
            }
        }

        if (step == 2) : VerticalBox {
            spacing: 10px;
            Text { text: "Real-time Messaging (Centrifuge)"; font-size: 18px; font-weight: 700; color: #1e293b; }
            if (is_advanced) : VerticalBox {
                spacing: 10px;
                LineEdit { placeholder-text: "Centrifuge WebSocket URL"; text: "ws://localhost:8000/connection/websocket"; }
            }
            if (!is_advanced) : VerticalBox {
                Text { text: "Real-time messaging is enabled by default to keep you updated instantly."; color: #64748b; wrap: word-wrap; }
            }
        }

        Rectangle {} 

        HorizontalBox {
            if (step > 0) : Button {
                text: "Back";
                clicked => { step = step - 1; }
            }
            Rectangle {} 
            Button {
                text: step == 2 ? "Save Configuration" : "Next";
                clicked => {
                    if (step < 2) {
                        step = step + 1;
                    } else {
                        // Handle save
                    }
                }
            }
        }

        HorizontalBox {
            alignment: start;
            CheckBox {
                text: "Show advanced settings";
                checked: is_advanced;
                toggled => { is_advanced = !is_advanced; }
            }
        }
    }
}
