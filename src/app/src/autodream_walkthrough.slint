import { VerticalBox, HorizontalBox, Button } from "std-widgets.slint";

export component AutodreamWalkthrough {
    callback on_close();

    Rectangle {
        background: rgba(15, 23, 42, 0.7); // Dark backdrop overlay

        Rectangle {
            width: 400px;
            height: 300px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            border-color: rgba(255, 255, 255, 0.2);
            border-width: 1px;

            VerticalBox {
                padding: 24px;
                spacing: 16px;
                alignment: center;

                Text {
                    text: "Welcome to AutoDream";
                    font-family: "Outfit";
                    font-size: 24px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                }

                Text {
                    text: "AutoDream runs in the background, consolidating your swarm's tasks and memories into durable vector embeddings for long-term intelligence.";
                    font-family: "Inter";
                    font-size: 14px;
                    color: #cbd5e1;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                Button {
                    text: "Got it";
                    clicked => { on_close(); }
                }
            }
        }
    }
}
