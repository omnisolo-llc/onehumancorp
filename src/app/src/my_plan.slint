import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component MyPlan inherits Window {
    width: 500px;
    height: 400px;
    title: "My Plan";

    in-out property <string> tier: "Pro Tier";
    in-out property <string> total_actions: "1200";
    in-out property <string> action_limit: "Unlimited";
    in-out property <string> used_storage: "150.5 MB";
    in-out property <string> limit_storage: "10.0 GB";
    in-out property <string> estimated_bill: "$124.50";

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        Text { text: "My Plan"; font-size: 20px; font-weight: 700; color: #1e293b; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 8px;
            
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                Text { text: "Current Plan"; color: #64748b; }
                Text { text: tier; font-size: 28px; font-weight: 700; color: #1e293b; }
                Button { text: "Upgrade"; }
            }
        }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 8px;
            
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                Text { text: "Usage This Month"; font-size: 18px; font-weight: 700; color: #1e293b; }
                Text { text: "AI Actions: " + total_actions + " / " + action_limit; color: #1e293b; }
                Text { text: "Storage Used: " + used_storage + " / " + limit_storage; color: #1e293b; }
                Text { text: "Estimated Next Bill: " + estimated_bill; color: #1e293b; }
            }
        }
    }
}
