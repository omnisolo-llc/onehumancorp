import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component FixAgent inherits Window {
    width: 500px;
    height: 400px;
    title: "Agent Diagnostics";

    property <int> step: 0;
    property <bool> is_applying: false;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 32px;
        alignment: center;

        Text { text: "Help me fix this"; font-size: 24px; font-weight: 700; color: #1e293b; }

        if (step == 0) : VerticalBox {
            spacing: 16px;
            Text { text: "We detected a connection timeout with the primary database. The agent was unable to read the required state."; color: #1e293b; wrap: word-wrap; horizontal-alignment: center; }
            Button { text: "View Suggested Fix"; clicked => { step = 1; } }
        }

        if (step == 1) : VerticalBox {
            spacing: 16px;
            Text { text: "Suggested fix: Restart the agent process and clear local cache to reconnect."; color: #1e293b; wrap: word-wrap; horizontal-alignment: center; }
            Button {
                text: is_applying ? "Applying..." : "Apply Fix";
                enabled: !is_applying;
                clicked => {
                    is_applying = true;
                    // In a real app, this would trigger an async backend call
                    step = 2;
                    is_applying = false;
                }
            }
        }

        if (step == 2) : VerticalBox {
            spacing: 16px;
            Text { text: "✓"; font-size: 48px; color: #10b981; horizontal-alignment: center; }
            Text { text: "Fix applied successfully! The agent is healthy again."; color: #1e293b; horizontal-alignment: center; }
            Button { text: "Return to Agents"; }
        }
    }
}

export component GrowBusiness inherits Window {
    width: 500px;
    height: 450px;
    title: "Grow My Business";

    background: #f8fafc;

    VerticalBox {
        spacing: 24px;
        padding: 32px;
        alignment: center;

        Text { text: "Grow your business 🚀"; font-size: 24px; font-weight: 700; color: #1e293b; }
        Text { text: "Based on your activity, here's what to do next:"; color: #64748b; horizontal-alignment: center; }

        VerticalBox {
            spacing: 12px;
            Rectangle {
                background: white; border-radius: 12px; border-color: #e2e8f0; border-width: 1px;
                HorizontalBox { padding: 16px; Text { text: "Add 5 more products"; font-weight: 600; } Rectangle {} Button { text: "Do it"; } }
            }
            Rectangle {
                background: white; border-radius: 12px; border-color: #e2e8f0; border-width: 1px;
                HorizontalBox { padding: 16px; Text { text: "Connect Instagram"; font-weight: 600; } Rectangle {} Button { text: "Connect"; } }
            }
            Rectangle {
                background: white; border-radius: 12px; border-color: #e2e8f0; border-width: 1px;
                HorizontalBox { padding: 16px; Text { text: "Enable AI Auto-reply"; font-weight: 600; } Rectangle {} Button { text: "Enable"; } }
            }
        }
    }
}

export component Billing inherits Window {
    width: 500px;
    height: 400px;
    title: "Billing & Credits";

    background: #f8fafc;

    VerticalBox {
        spacing: 24px;
        padding: 32px;
        alignment: center;

        Text { text: "How much does this cost?"; font-size: 24px; font-weight: 700; color: #1e293b; }

        Rectangle {
            background: #e0f2fe;
            border-radius: 16px;
            border-color: #bae6fd;
            border-width: 1px;
            
            VerticalBox {
                padding: 24px;
                spacing: 8px;
                alignment: center;
                Text { text: "Current Usage"; color: #0369a1; }
                Text { text: "$42.50"; font-size: 32px; font-weight: 800; color: #0c4a6e; }
                Text { text: "Projected monthly cost: $85.00"; color: #0369a1; font-size: 12px; }
            }
        }

        Text { text: "Your current plan includes 1,000 AI tasks per day. You have used 450 today."; color: #1e293b; wrap: word-wrap; horizontal-alignment: center; }

        HorizontalBox {
            spacing: 12px;
            alignment: center;
            Button { text: "Add Credits"; }
            Button { text: "Switch Plan"; }
        }
    }
}
