import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export struct UiPricingTier {
    name: string,
    price: string,
    description: string,
}

export component Pricing inherits Window {
    width: 400px;
    height: 600px;
    title: "Pricing & Billing";

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    in property <[UiPricingTier]> tiers: [
        { name: "Free", price: "$0/mo", description: "Up to 100 AI Actions, 500MB storage." },
        { name: "Starter", price: "$29/mo", description: "Up to 1000 AI Actions, 5GB storage." },
        { name: "Pro", price: "$99/mo", description: "Unlimited AI Actions, 50GB storage." },
        { name: "Business", price: "Custom", description: "Enterprise features and support." },
    ];

    callback select_plan(string);

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        Text {
            text: "Pricing & Billing";
            font-size: 24px;
            font-weight: 700;
            color: white;
            font-family: "Outfit";
        }

        VerticalBox {
            spacing: 16px;
            for tier in tiers : GlassCard {
                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: tier.name;
                        font-size: 20px;
                        font-weight: 700;
                        color: white;
                        font-family: "Outfit";
                    }
                    Text {
                        text: tier.price;
                        font-size: 16px;
                        color: #a855f7;
                        font-family: "Inter";
                    }
                    Text {
                        text: tier.description;
                        color: #a8b2c1;
                        wrap: word-wrap;
                        font-family: "Inter";
                    }
                    Button {
                        height: 44px;
                        text: "Select Plan";
                        clicked => { select_plan(tier.name); }
                    }
                }
            }
        }
    }
}
