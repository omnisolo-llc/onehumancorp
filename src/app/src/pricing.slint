import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct UiPricingTier {
    name: string,
    price: string,
    description: string,
}

export component Pricing inherits Window {
    width: 400px;
    height: 600px;
    title: "Pricing & Billing";

    background: #f8fafc;

    in property <[UiPricingTier]> tiers: [
        { name: "Free", price: "$0/mo", description: "Up to 100 AI Actions, 500MB storage." },
        { name: "Starter", price: "$29/mo", description: "Up to 1000 AI Actions, 5GB storage." },
        { name: "Pro", price: "$99/mo", description: "Unlimited AI Actions, 50GB storage." },
        { name: "Business", price: "Custom", description: "Enterprise features and support." },
    ];

    in property <bool> show_upgrade_prompt: false;
    in property <string> upgrade_reason: "";
    callback select_plan(string);

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        Text { text: "Pricing & Billing"; font-size: 24px; font-weight: 700; color: #1e293b; }

        if (show_upgrade_prompt) : Rectangle {
            background: #fffbeb;
            border-color: #fbbf24;
            border-width: 1px;
            border-radius: 8px;
            padding: 16px;
            VerticalBox {
                spacing: 8px;
                Text { text: "Time to level up!"; font-weight: 700; color: #b45309; }
                Text { text: upgrade_reason; color: #92400e; wrap: word-wrap; }
                Text { text: "Upgrade to Starter or Pro to continue growing your business."; color: #92400e; wrap: word-wrap; }
            }
        }

        VerticalBox {
            spacing: 16px;
            for tier in tiers : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: tier.name; font-size: 20px; font-weight: 700; color: #1e293b; }
                    Text { text: tier.price; font-size: 16px; color: #a855f7; }
                    Text { text: tier.description; color: #64748b; wrap: word-wrap; }
                    Button {
                        text: "Select Plan";
                        clicked => { select_plan(tier.name); }
                    }
                }
            }
        }
    }
}
