import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component WelcomeChecklist inherits Window {
    width: 600px;
    height: 400px;
    title: "Welcome Checklist";

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    callback go_to_dashboard();

    VerticalBox {
        alignment: center;
        spacing: 20px;
        padding: 24px;

        Rectangle {
            background: #ffffff1a;
            border-radius: 16px;
            border-width: 1px;
            border-color: #ffffff33;
            drop-shadow-blur: 20px;
            drop-shadow-color: #00000033;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: 8px;
            VerticalBox {
                spacing: 16px;
                padding: 24px;

                Text {
                    text: "You're set up! Here's what to do next:";
                    font-size: 24px;
                    font-weight: 700;
                    color: white;
                    wrap: word-wrap;
                    font-family: "Outfit";
                }

                HorizontalBox {
                    spacing: 10px;
                    Text { text: "✓"; color: #10b981; } 
                    Text { text: "Business live"; color: white; font-family: "Inter"; }
                }
                HorizontalBox {
                    spacing: 10px;
                    Text { text: "○"; color: white; }
                    Text { text: "Add 3 more products"; color: white; font-family: "Inter"; }
                }
                HorizontalBox {
                    spacing: 10px;
                    Text { text: "○"; color: white; }
                    Text { text: "Connect Instagram"; color: white; font-family: "Inter"; }
                }
                HorizontalBox {
                    spacing: 10px;
                    Text { text: "○"; color: white; }
                    Text { text: "Share your link with a friend"; color: white; font-family: "Inter"; }
                }

                Button {
                    text: "Go to Dashboard";
                    clicked => {
                        root.go_to_dashboard();
                    }
                }
            }
        }
    }
}

