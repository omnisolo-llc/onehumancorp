import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Pipelines inherits Window {
    width: 375px;
    height: 600px;
    title: "SDLC Pipelines";

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "SDLC Pipelines"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            Button { text: "Refresh"; }
        }

        VerticalBox {
            spacing: 16px;
            
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 12px;
                    
                    HorizontalBox {
                        VerticalBox {
                            Text { text: "Main Pipeline"; font-weight: 700; color: #1e293b; }
                            Text { text: "branch: main"; color: #64748b; }
                        }
                        Rectangle {}
                        Text { text: "STAGING"; color: #06b6d4; horizontal-alignment: center; }
                    }
                    
                    Text { text: "Initiated by: System"; color: #64748b; }
                    
                    Rectangle {
                        background: #e2e8f0;
                        border-radius: 4px;
                        
                        HorizontalBox {
                            padding: 8px;
                            Text { text: "http://staging.example.com"; color: #0369a1; } 
                        }
                    }
                    
                    Text { text: "Promote to Production"; color: #1e293b; font-weight: 700; }
                    
                    Button {
                        text: "Slide to Approve (Tap)";
                    }
                }
            }
        }
    }
}
