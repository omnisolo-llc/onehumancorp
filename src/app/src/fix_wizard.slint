import { Button, VerticalBox, HorizontalBox, CheckBox, LineEdit } from "std-widgets.slint";

export component FixWizard inherits Window {
    width: 375px;
    height: 667px;
    title: "Help me fix this";

    in-out property <int> step: 0;
    in-out property <bool> is_advanced: false;
    in-out property <string> raw_logs: "ERROR [agent_runner]: Stripe connection refused.";
    in-out property <string> error_details: "Your Order Manager agent ran into an issue connecting to Stripe.";

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Help me fix this"; font-size: 24px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            CheckBox {
                text: "Expert Mode";
                checked: is_advanced;
                toggled => { is_advanced = !is_advanced; }
            }
        }

        if (step == 0) : VerticalBox {
            spacing: 15px;
            Text { text: "What happened?"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Text { text: error_details; color: #64748b; wrap: word-wrap; }
            if (is_advanced) : VerticalBox {
                spacing: 10px;
                Text { text: "Advanced: Raw Logs"; font-weight: 700; color: #1e293b; }
                LineEdit { text: raw_logs; }
            }
        }

        if (step == 1) : VerticalBox {
            spacing: 15px;
            Text { text: "How to fix it"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Text { text: "1. Go to your Integrations page."; color: #64748b; wrap: word-wrap; }
            Text { text: "2. Re-connect your Stripe account."; color: #64748b; wrap: word-wrap; }
            Text { text: "3. Restart the Order Manager agent."; color: #64748b; wrap: word-wrap; }
        }

        if (step == 2) : VerticalBox {
            spacing: 15px;
            Text { text: "Action"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Button { text: "Go to Integrations"; }
            Button { text: "Dismiss"; }
            if (is_advanced) : Button { text: "Advanced: CLI Restart Command"; }
        }

        Rectangle {} // Spacer

        // Navigation
        HorizontalBox {
            if (step > 0) : Button {
                text: "Back";
                clicked => { step = step - 1; }
            }
            Rectangle {} // Spacer
            Button {
                text: step == 2 ? "Finish" : "Next";
                clicked => {
                    if (step < 2) {
                        step = step + 1;
                    } else {
                        // Handle save
                    }
                }
            }
        }
    }
}
