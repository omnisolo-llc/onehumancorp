import { TooltipRegistry } from "tooltip_registry.slint";

export component TooltipButton inherits Rectangle {
    in property <string> text;
    in property <string> tooltip_id;
    callback clicked();

    border-radius: 4px;
    background: ta.pressed ? #334155 : (ta.has-hover ? #475569 : #1e293b);
    width: text_element.preferred-width + 24px;
    height: text_element.preferred-height + 16px;

    text_element := Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: white;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    property <bool> is_tooltip_shown: false;
    property <bool> suppress_click: false;
    property <bool> is_hovered: ta.has-hover;

    changed is_hovered => {
        if (self.is_hovered && !self.is_tooltip_shown) {
            self.is_tooltip_shown = true;
            TooltipRegistry.show_tooltip(root.tooltip_id, root.absolute-position.x, root.absolute-position.y + root.height);
        } else if (!self.is_hovered && self.is_tooltip_shown) {
            self.is_tooltip_shown = false;
            TooltipRegistry.hide_tooltip();
        }
    }

    t := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            root.is_tooltip_shown = true;
            root.suppress_click = true;
            TooltipRegistry.show_tooltip(root.tooltip_id, root.absolute-position.x, root.absolute-position.y + root.height);
        }
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.suppress_click = false;
                t.running = true;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                t.running = false;
                if (root.is_tooltip_shown) {
                    // Hide tooltip but don't reset suppress_click here so clicked can check it
                    root.is_tooltip_shown = false;
                    TooltipRegistry.hide_tooltip();
                }
            }
        }

        clicked => {
            if (root.suppress_click) {
                root.suppress_click = false;
                return;
            }
            root.clicked();
        }
    }
}
