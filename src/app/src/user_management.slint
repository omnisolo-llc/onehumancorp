import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct UiUser {
    id: string,
    username: string,
    email: string,
    role: string,
    joined_at: string,
    avatar_letter: string,
}

export component UserManagement inherits Window {
    width: 500px;
    height: 600px;
    title: "User Management";


    in property <[UiUser]> users;
    in property <string> referral_link: "ohc.to/ref/YOUR_CODE";
    in property <int> invites_sent: 0;
    in property <int> invites_accepted: 0;
    in property <int> pro_credits_earned: 0;
    callback delete_user(string);
    callback share_referral();


    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "User Management"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            Button { text: "Invite User"; }
        }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 8px;
            
            VerticalBox {
                padding: 16px;
                spacing: 12px;
                Text { text: "Refer a Friend, Get 1 Month Free Pro"; font-size: 16px; font-weight: 700; color: #1e293b; }

                HorizontalBox {
                    spacing: 8px;
                    Rectangle {
                        background: #f1f5f9;
                        border-radius: 4px;
                        padding: 8px;
                        Text { text: referral_link; color: #64748b; font-size: 14px; }
                    }
                    Button { text: "Share Link"; clicked => { share_referral(); } }
                }

                HorizontalBox {
                    spacing: 16px;
                    VerticalBox {
                        Text { text: invites_sent; font-size: 20px; font-weight: 700; color: #a855f7; }
                        Text { text: "Invites Sent"; color: #64748b; font-size: 12px; }
                    }
                    VerticalBox {
                        Text { text: invites_accepted; font-size: 20px; font-weight: 700; color: #10b981; }
                        Text { text: "Accepted"; color: #64748b; font-size: 12px; }
                    }
                    VerticalBox {
                        Text { text: pro_credits_earned; font-size: 20px; font-weight: 700; color: #f59e0b; }
                        Text { text: "Pro Credits"; color: #64748b; font-size: 12px; }
                    }
                }
            }
        }

        VerticalBox {
            spacing: 12px;
            
            for u in users : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 16px;
                    Rectangle {
                        background: #a855f7;
                        border-radius: 16px;
                        width: 32px;
                        height: 32px;
                        HorizontalBox { padding: 2px; Text { text: u.avatar_letter; font-size: 16px; font-weight: 700; color: white; horizontal-alignment: center; } }
                    }
                    VerticalBox {
                        HorizontalBox {
                            Text { text: u.username; font-weight: 700; color: #1e293b; }
                            Rectangle { 
                                background: rgba(168, 85, 247, 0.2); 
                                border-radius: 4px; 
                                HorizontalBox {
                                    padding: 2px;
                                    Text { text: u.role; color: #a855f7; font-size: 10px; } 
                                }
                            }
                        }
                        Text { text: u.email; color: #64748b; }
                        Text { text: "Joined: " + u.joined_at; color: #9ca3af; font-size: 12px; }
                    }
                    Rectangle {} 
                    Button { text: "Delete"; clicked => { delete_user(u.id); } }
                }
            }
        }
    }
}
