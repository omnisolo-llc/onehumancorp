import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct UiUser {
    id: string,
    username: string,
    email: string,
    role: string,
    joined_at: string,
    avatar_letter: string,
}

export component UserManagement inherits Window {
    width: 500px;
    height: 600px;
    title: "User Management";

    in property <[UiUser]> users;
    callback delete_user(string);
    callback generate_referral_link(string);
    in-out property <string> generated_link;
    in property <int> invites_sent;
    in property <int> invites_accepted;
    in property <string> reward_tier: "Bronze";

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "User Management"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            Button { text: "Invite User"; }
        }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 8px;
            
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                Text { text: "Your Referrals Dashboard"; font-size: 16px; font-weight: 700; color: #1e293b; }
                HorizontalBox {
                    Text { text: "Invites Sent: " + root.invites_sent; color: #64748b; }
                    Rectangle {}
                    Text { text: "Invites Accepted: " + root.invites_accepted; color: #64748b; }
                }
                Text { text: "Current Reward Tier: " + root.reward_tier; color: #a855f7; font-weight: 700; }
            }
        }

        Rectangle {
            // Glassmorphism styling per design docs
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.1);
            border-width: 1px;
            border-radius: 12px;

            VerticalBox {
                padding: 24px;
                spacing: 12px;

                Text { text: "Invite a Friend & Get 1 Month Free"; font-size: 18px; font-weight: 700; color: #1e293b; }
                Text { text: "Share OHC with a fellow business owner. When they join, you both get 1 month of Pro for free! Share your link to help them start their journey."; color: #64748b; wrap: word-wrap; }

                if (root.generated_link == "") : HorizontalBox {
                    Button {
                        text: "Generate Viral Invite Link";
                        clicked => {
                            generate_referral_link("user_123");
                        }
                    }
                    Rectangle {}
                }
                if (root.generated_link != "") : HorizontalBox {
                    Text { text: root.generated_link; color: #a855f7; }
                    Rectangle {}
                }
            }
        }

        VerticalBox {
            spacing: 12px;
            
            for u in users : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 16px;
                    Rectangle {
                        background: #a855f7;
                        border-radius: 16px;
                        width: 32px;
                        height: 32px;
                        HorizontalBox { padding: 2px; Text { text: u.avatar_letter; font-size: 16px; font-weight: 700; color: white; horizontal-alignment: center; } }
                    }
                    VerticalBox {
                        HorizontalBox {
                            Text { text: u.username; font-weight: 700; color: #1e293b; }
                            Rectangle { 
                                background: rgba(168, 85, 247, 0.2); 
                                border-radius: 4px; 
                                HorizontalBox {
                                    padding: 2px;
                                    Text { text: u.role; color: #a855f7; font-size: 10px; } 
                                }
                            }
                        }
                        Text { text: u.email; color: #64748b; }
                        Text { text: "Joined: " + u.joined_at; color: #9ca3af; font-size: 12px; }
                    }
                    Rectangle {} 
                    Button { text: "Delete"; clicked => { delete_user(u.id); } }
                }
            }
        }
    }
}
