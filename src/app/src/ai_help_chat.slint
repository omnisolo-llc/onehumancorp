import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export component AiHelpChat inherits Window {
    width: 600px;
    height: 800px;
    title: "AI Help Assistant";
    background: white;

    in-out property <string> user_input: "";
    callback send_message();

    VerticalBox {
        padding: 16px;
        spacing: 16px;

        Rectangle {
            background: #f1f5f9;
            border-radius: 8px;
            VerticalBox {
                padding: 16px;
                Text {
                    text: "Hi! I'm your OHC Help Assistant. I can answer any questions you have about using the app. What do you need help with today?";
                    color: #0f172a;
                    wrap: word-wrap;
                }
            }
        }

        ScrollView {
            VerticalBox {
                spacing: 16px;
                Rectangle {
                    background: #e2e8f0;
                    border-radius: 8px;
                    VerticalBox {
                        padding: 12px;
                        Text {
                            text: "How do I add a new product?";
                            color: #334155;
                            wrap: word-wrap;
                        }
                    }
                }
                Rectangle {
                    background: #f1f5f9;
                    border-radius: 8px;
                    VerticalBox {
                        padding: 12px;
                        spacing: 8px;
                        Text {
                            text: "To add a new product, go to your Dashboard and tap 'Add Product'. You can then upload a photo and enter the price.\n\nRead the full article ->";
                            color: #0f172a;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            LineEdit {
                placeholder-text: "Type your question here...";
                text <=> user_input;
            }
            Button {
                text: "Send";
                clicked => { send_message(); }
            }
        }
    }
}
