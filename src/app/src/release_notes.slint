import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export component ReleaseNotes inherits Window {
    width: 375px;
    height: 800px;
    title: "What's New";
    background: #f8fafc;

    VerticalBox {
        padding: 16px;
        spacing: 20px;

        Text {
            text: "What's New in OHC";
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
            horizontal-alignment: center;
        }

        ScrollView {
            VerticalBox {
                spacing: 24px;

                // Version entry
                VerticalBox {
                    spacing: 12px;
                    HorizontalBox {
                        Text { text: "v1.2.0"; font-weight: 700; color: #0ea5e9; }
                        Rectangle {}
                        Text { text: "Today"; color: #94a3b8; }
                    }
                    Rectangle {
                        background: white; border-radius: 12px;
                        VerticalBox {
                            padding: 16px; spacing: 12px;
                            Text { text: "✨ Multi-language Support"; font-weight: 700; font-size: 18px; color: #0f172a; }
                            Text { text: "Your store can now be viewed in English and Arabic. More languages coming soon!"; color: #475569; wrap: word-wrap; }
                            Rectangle {
                                height: 150px;
                                background: #f1f5f9;
                                border-radius: 8px;
                                Text { text: "[Screenshot: Language Switcher]"; color: #94a3b8; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }

                // Previous version
                VerticalBox {
                    spacing: 12px;
                    HorizontalBox {
                        Text { text: "v1.1.5"; font-weight: 700; color: #64748b; }
                        Rectangle {}
                        Text { text: "2 days ago"; color: #94a3b8; }
                    }
                    Rectangle {
                        background: white; border-radius: 12px;
                        VerticalBox {
                            padding: 16px; spacing: 12px;
                            Text { text: "🚀 Faster Checkout"; font-weight: 700; font-size: 18px; color: #0f172a; }
                            Text { text: "We optimized the payment flow to be 2x faster for your customers."; color: #475569; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
    }
}
