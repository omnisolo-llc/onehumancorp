import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component ReleaseNotes inherits Window {
    width: 375px;
    height: 812px;
    title: "What's New";
    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        padding: 16px;
        spacing: 20px;

        Text {
            text: "What's New in OHC";
            font-size: 24px;
            font-weight: 700;
            color: white;
            font-family: "Outfit";
        }

        ScrollView {
            VerticalBox {
                spacing: 16px;

                GlassCard {
                    VerticalBox {
                        padding: 16px; spacing: 8px;
                        Text { text: "Version 1.2 - New AI Agents"; font-weight: 700; font-size: 18px; color: white; font-family: "Outfit"; }
                        Text { text: "October 2023"; color: #a855f7; font-family: "Inter"; }
                        Text { text: "• Added the Customer Success Agent to handle Instagram DMs.\n• Improved store loading speeds on mobile.\n• Added support for Apple Pay in 12 new countries."; color: #a8b2c1; wrap: word-wrap; font-family: "Inter"; }
                    }
                }

                GlassCard {
                    VerticalBox {
                        padding: 16px; spacing: 8px;
                        Text { text: "Version 1.1 - Calendar Sync"; font-weight: 700; font-size: 18px; color: white; font-family: "Outfit"; }
                        Text { text: "September 2023"; color: #a855f7; font-family: "Inter"; }
                        Text { text: "• You can now sync your bookings with Google Calendar.\n• Fixed an issue where photos wouldn't upload on Android."; color: #a8b2c1; wrap: word-wrap; font-family: "Inter"; }
                    }
                }
            }
        }
    }
}
