import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct UiReferral {
    referral_code: string,
    user_id: string,
    clicks: int,
    conversions: int,
    created_at: string,
}

export component Referrals inherits Window {
    width: 500px;
    height: 600px;
    title: "Viral Loop Dashboard";

    background: #f8fafc;

    in property <[UiReferral]> referrals;
    in-out property <string> generated_link: "";
    callback refresh();
    callback generate_link();

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Viral Loop Dashboard"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            Button { 
                text: "Refresh"; 
                clicked => { refresh(); }
            }
        }

        VerticalBox {
            spacing: 8px;
            padding: 16px;
            Rectangle {
                background: @linear-gradient(135deg, #a855f7 0%, #3b82f6 100%);
                border-radius: 8px;
                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: "Share OHC with a friend, both get 1 month free Pro!";
                        color: white;
                        font-weight: 700;
                        font-size: 16px;
                        wrap: word-wrap;
                    }
                    HorizontalBox {
                        Button {
                            text: "Generate Link";
                            clicked => { generate_link(); }
                        }
                        Rectangle {}
                        if generated_link != "" : Text {
                            text: generated_link;
                            color: white;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        VerticalBox {
            spacing: 16px;
            for r in referrals : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    
                    HorizontalBox {
                        Text { text: "Ref: " + r.referral_code; font-weight: 700; color: #1e293b; }
                        Rectangle {}
                        Text { text: "👥"; font-size: 20px; }
                    }
                    
                    Text { text: "User: " + r.user_id; color: #64748b; }
                    
                    HorizontalBox {
                        alignment: space-around;
                        VerticalBox {
                            alignment: center;
                            Text { text: r.clicks; font-size: 24px; font-weight: 700; color: #a855f7; }
                            Text { text: "Clicks"; color: #64748b; font-size: 12px; }
                        }
                        VerticalBox {
                            alignment: center;
                            Text { text: r.conversions; font-size: 24px; font-weight: 700; color: #a855f7; }
                            Text { text: "Conversions"; color: #64748b; font-size: 12px; }
                        }
                    }
                    
                    Text { text: "Created: " + r.created_at; color: #64748b; font-size: 12px; }
                }
            }
        }
    }
}
