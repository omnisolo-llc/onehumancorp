import { Button, VerticalBox, HorizontalBox, CheckBox, LineEdit } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export struct UiPromptExample {
    q: string,
    a: string,
}

export component PromptTuning inherits Window {
    width: 700px;
    height: 500px;
    title: "Tune Agent";

    in-out property <int> step: 0;
    in-out property <string> tone: "Friendly";
    in-out property <bool> show_raw: false;
    
    in-out property <bool> focus_only_business: false;
    in-out property <bool> focus_avoid_competitors: false;
    in-out property <bool> focus_reply_spanish: false;
    
    in-out property <[UiPromptExample]> examples;
    
    callback add_example();
    callback save_prompt();

    background: #f8fafc;

    HorizontalBox {
        spacing: 20px;
        padding: 24px;

        // Left Column: Wizard Steps
        VerticalBox {
            width: 320px;
            spacing: 20px;
            
            Text { text: "Prompt Tuning"; font-size: 24px; font-weight: 700; color: #1e293b; }

            // Step 0: Tone
            if (step == 0) : VerticalBox {
                spacing: 10px;
                Text { text: "Personality & tone"; color: #1e293b; }

                HorizontalBox {
                    spacing: 10px;
                    GlassCard {
                        height: 50px;
                        background: tone == "Formal" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        VerticalBox { alignment: center; padding: 12px; Text { text: "Formal"; font-family: "Inter"; font-size: 14px; color: white; horizontal-alignment: center; } }
                        TouchArea { clicked => { tone = "Formal"; } }
                    }
                    GlassCard {
                        height: 50px;
                        background: tone == "Friendly" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        VerticalBox { alignment: center; padding: 12px; Text { text: "Friendly"; font-family: "Inter"; font-size: 14px; color: white; horizontal-alignment: center; } }
                        TouchArea { clicked => { tone = "Friendly"; } }
                    }
                    GlassCard {
                        height: 50px;
                        background: tone == "Concise" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        VerticalBox { alignment: center; padding: 12px; Text { text: "Concise"; font-family: "Inter"; font-size: 14px; color: white; horizontal-alignment: center; } }
                        TouchArea { clicked => { tone = "Concise"; } }
                    }
                }
                Text { text: "Selected: " + tone; color: #a855f7; }
            }

            // Step 1: Focus
            if (step == 1) : VerticalBox {
                spacing: 10px;
                Text { text: "Domain focus"; color: #1e293b; }

                GlassCard {
                    height: 40px;
                    background: focus_only_business ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px; Text { text: "Only discuss business"; font-family: "Inter"; font-size: 14px; color: white; } }
                    TouchArea { clicked => { focus_only_business = !focus_only_business; } }
                }
                GlassCard {
                    height: 40px;
                    background: focus_avoid_competitors ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px; Text { text: "Avoid competitors"; font-family: "Inter"; font-size: 14px; color: white; } }
                    TouchArea { clicked => { focus_avoid_competitors = !focus_avoid_competitors; } }
                }
                GlassCard {
                    height: 40px;
                    background: focus_reply_spanish ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px; Text { text: "Always reply in Spanish"; font-family: "Inter"; font-size: 14px; color: white; } }
                    TouchArea { clicked => { focus_reply_spanish = !focus_reply_spanish; } }
                }
            }

            // Step 2: Examples
            if (step == 2) : VerticalBox {
                spacing: 10px;
                Text { text: "Example interactions"; color: #1e293b; }
                Button { 
                    text: "Add Example"; 
                    clicked => { add_example(); }
                }
                for ex in examples : Text { text: "Q: " + ex.q + "\nA: " + ex.a; color: #64748b; }
            }

            // Step 3: Review
            if (step == 3) : VerticalBox {
                spacing: 10px;
                Text { text: "Review & Save"; color: #1e293b; }
                Text { text: "Ready to update the agent?"; color: #64748b; }
            }

            Rectangle {} // Spacer

            // Navigation
            HorizontalBox {
                if (step > 0) : Button {
                    text: "Back";
                    clicked => { step = step - 1; }
                }
                Rectangle {} // Spacer
                Button {
                    text: step == 3 ? "Save" : "Next";
                    clicked => {
                        if (step < 3) {
                            step = step + 1;
                        } else {
                            save_prompt();
                        }
                    }
                }
            }
        }

        // Right Column: Preview
        VerticalBox {
            width: 320px;
            spacing: 10px;
            
            HorizontalBox {
                Text { text: "Live Preview"; font-size: 18px; font-weight: 700; color: #1e293b; }
                Rectangle {}
                Button { text: show_raw ? "Hide raw" : "Show raw"; clicked => { show_raw = !show_raw; } }
            }
            
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    if (show_raw) : Text {
                        text: "You are an AI agent with a " + tone + " personality.\n"
                            + (focus_only_business ? "Domain Focus: Only discuss business.\n" : "")
                            + (focus_avoid_competitors ? "Domain Focus: Avoid competitors.\n" : "")
                            + (focus_reply_spanish ? "Domain Focus: Always reply in Spanish.\n" : "");
                        color: #1e293b;
                        wrap: word-wrap;
                    }
                    if (!show_raw) : VerticalBox {
                        spacing: 10px;
                        Rectangle {
                            background: #e2e8f0;
                            border-radius: 8px;
                            padding: 8px;
                            HorizontalBox {
                                Text { text: "User: Hello!"; color: #1e293b; }
                            }
                        }
                        Rectangle {
                            background: #a855f7;
                            border-radius: 8px;
                            padding: 8px;
                            HorizontalBox {
                                Text { text: "Agent: Hi there! How can I help you today?"; color: white; }
                            }
                        }
                        HorizontalBox {
                            spacing: 5px;
                            LineEdit { placeholder-text: "Type a message..."; width: parent.width - 60px; }
                            Button { text: "Send"; }
                        }
                    }
                }
            }
        }
    }
}
