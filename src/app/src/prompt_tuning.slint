import { Button, VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";

export component ToneTile inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    background: selected ? #f3e8ff : white;
    border-color: selected ? #a855f7 : #e2e8f0;
    border-width: 2px;
    border-radius: 12px;
    height: 80px;

    TouchArea { clicked => { root.clicked(); } }

    Text { text: root.text; horizontal-alignment: center; vertical-alignment: center; font-weight: 600; color: selected ? #7e22ce : #475569; }
}

export component PromptTuning inherits Window {
    width: 900px;
    height: 600px;
    title: "Tune Your Agent";

    property <int> step: 0;
    property <string> selected_tone: "Friendly";
    property <bool> advanced_mode: false;

    background: #f8fafc;

    HorizontalBox {
        spacing: 24px;
        padding: 32px;

        // Configuration Side
        VerticalBox {
            width: 400px;
            spacing: 24px;
            
            Text { text: "Fine-tune Personality"; font-size: 24px; font-weight: 800; color: #1e293b; }

            if (step == 0) : VerticalBox {
                spacing: 16px;
                Text { text: "Choose a Tone"; font-weight: 700; }
                HorizontalBox {
                    spacing: 12px;
                    ToneTile { text: "Friendly"; selected: selected_tone == "Friendly"; clicked => { selected_tone = "Friendly"; } }
                    ToneTile { text: "Professional"; selected: selected_tone == "Professional"; clicked => { selected_tone = "Professional"; } }
                    ToneTile { text: "Energetic"; selected: selected_tone == "Energetic"; clicked => { selected_tone = "Energetic"; } }
                }
            }

            if (step == 1) : VerticalBox {
                spacing: 16px;
                Text { text: "Focus Topics"; font-weight: 700; }
                Text { text: "Tell the agent what to prioritize (pick chips):"; color: #64748b; font-size: 14px; }
                HorizontalBox {
                    spacing: 8px;
                    Rectangle { background: #e0f2fe; border-radius: 16px; padding: 8px; Text { text: "Only my products"; color: #0369a1; } }
                    Rectangle { background: #e0f2fe; border-radius: 16px; padding: 8px; Text { text: "No competitors"; color: #0369a1; } }
                    Rectangle { background: #e0f2fe; border-radius: 16px; padding: 8px; Text { text: "Always helpful"; color: #0369a1; } }
                }
            }

            if (step == 2) : VerticalBox {
                spacing: 16px;
                Text { text: "Examples"; font-weight: 700; }
                LineEdit { placeholder-text: "Customer: Do you have vegan cakes?"; }
                LineEdit { placeholder-text: "Agent: Yes, we have chocolate and vanilla vegan options!"; }
                Button { text: "Add Example Pair"; }
            }

            Rectangle {} // Spacer

            HorizontalBox {
                if (step > 0) : Button { text: "Back"; clicked => { step = step - 1; } }
                Rectangle {}
                if (step < 2) : Button { text: "Next"; clicked => { step = step + 1; } }
                if (step == 2) : Button { text: "Save & Activate ✨"; }
            }
        }

        // Preview Side
        VerticalBox {
            spacing: 20px;
            Text { text: "Live Preview"; font-size: 20px; font-weight: 700; color: #1e293b; }
            
            Rectangle {
                background: white;
                border-radius: 20px;
                border-color: #e2e8f0;
                border-width: 1px;
                VerticalBox {
                    padding: 20px;
                    spacing: 16px;

                    // Chat bubbles
                    HorizontalBox {
                        Rectangle { width: 40px; height: 40px; background: #e2e8f0; border-radius: 20px; }
                        Rectangle { background: #f1f5f9; border-radius: 12px; padding: 12px; Text { text: "How can I help you today?"; color: #1e293b; } }
                        Rectangle {}
                    }

                    if (advanced_mode) : VerticalBox {
                        spacing: 8px;
                        Text { text: "System Prompt (Generated)"; font-size: 12px; font-weight: 700; color: #a855f7; }
                        Rectangle {
                            background: #1e293b;
                            border-radius: 8px;
                            padding: 12px;
                            Text { text: "You are a " + selected_tone + " assistant. Focus on business topics only..."; color: #f8fafc; font-family: "monospace"; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                }
            }

            HorizontalBox {
                Rectangle {}
                Button { text: advanced_mode ? "Hide Details" : "View Raw Prompt"; clicked => { advanced_mode = !advanced_mode; } }
            }
        }
    }
}
