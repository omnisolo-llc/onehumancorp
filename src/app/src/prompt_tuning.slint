import { Button, VerticalBox, HorizontalBox, CheckBox, LineEdit } from "std-widgets.slint";

export struct UiPromptExample {
    user_msg: string,
    agent_msg: string,
}

export component PromptTuning inherits Window {
    width: 375px;
    height: 667px;
    title: "Tune Agent";

    in-out property <int> step: 0;
    in-out property <bool> is_advanced: false;
    in-out property <string> tone: "Friendly & Warm";
    in-out property <bool> focus_products: false;
    in-out property <bool> avoid_competitors: false;
    in-out property <bool> specific_language: false;
    in-out property <string> language_name: "";
    in-out property <string> test_query: "";
    in-out property <string> test_response: "";
    in-out property <string> raw_json_config: "";
    
    in property <[UiPromptExample]> examples;

    callback save_tuning();
    callback test_agent(string);

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Tune Your Agent"; font-size: 24px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            CheckBox {
                text: "Expert Mode";
                checked: is_advanced;
                toggled => { is_advanced = !is_advanced; }
            }
        }

        // Step 0: Tone
        if (step == 0) : VerticalBox {
            spacing: 15px;
            Text { text: "Choose a tone"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Text { text: "Selected: " + tone; color: #a855f7; }
            VerticalBox {
                spacing: 10px;
                Button { text: "Friendly & Warm"; clicked => { tone = "Friendly & Warm"; } }
                Button { text: "Professional"; clicked => { tone = "Professional"; } }
                Button { text: "Energetic"; clicked => { tone = "Energetic"; } }
                Button { text: "Concise"; clicked => { tone = "Concise"; } }
            }
        }

        // Step 1: Focus Topics
        if (step == 1) : VerticalBox {
            spacing: 15px;
            Text { text: "Focus topics"; font-size: 20px; font-weight: 700; color: #1e293b; }
            VerticalBox {
                spacing: 10px;
                CheckBox { text: "Only about my products"; checked <=> focus_products; }
                CheckBox { text: "Avoid competitor mentions"; checked <=> avoid_competitors; }
                CheckBox { text: "Always reply in a specific language"; checked <=> specific_language; }
                if (specific_language) : LineEdit {
                    placeholder-text: "Language (e.g. Spanish)";
                    text <=> language_name;
                }
            }
        }

        // Step 2: Examples
        if (step == 2) : VerticalBox {
            spacing: 15px;
            Text { text: "Example interactions"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Text { text: "Show the agent how to reply."; color: #64748b; }

            VerticalBox {
                spacing: 10px;
                LineEdit { placeholder-text: "Customer says..."; }
                LineEdit { placeholder-text: "Agent replies..."; }
                Button { text: "Add Example"; }
            }

            for ex in examples : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 4px;
                padding: 8px;
                VerticalBox {
                    Text { text: "Q: " + ex.user_msg; color: #1e293b; }
                    Text { text: "A: " + ex.agent_msg; color: #64748b; }
                }
            }
        }

        // Step 3: Test
        if (step == 3) : VerticalBox {
            spacing: 15px;
            Text { text: "Live Preview"; font-size: 20px; font-weight: 700; color: #1e293b; }
            
            if (is_advanced) : VerticalBox {
                spacing: 10px;
                Text { text: "Advanced: Raw JSON Config"; font-weight: 700; color: #1e293b; }
                LineEdit { text <=> raw_json_config; }
            }

            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                padding: 16px;
                min-height: 150px;
                
                VerticalBox {
                    spacing: 10px;
                    Text { text: "Chat Sandbox"; font-weight: 700; color: #1e293b; }
                    if (test_response != "") : Text {
                        text: test_response;
                        color: #64748b;
                        wrap: word-wrap;
                    }
                    HorizontalBox {
                        LineEdit {
                            placeholder-text: "Say hello...";
                            text <=> test_query;
                        }
                        Button {
                            text: "Send";
                            clicked => { test_agent(test_query); }
                        }
                    }
                }
            }
        }

        Rectangle {} // Spacer

        // Navigation
        HorizontalBox {
            if (step > 0) : Button {
                text: "Back";
                clicked => { step = step - 1; }
            }
            Rectangle {} // Spacer
            Button {
                text: step == 3 ? "Save" : "Next";
                clicked => {
                    if (step < 3) {
                        step = step + 1;
                    } else {
                        save_tuning();
                    }
                }
            }
        }
    }
}
