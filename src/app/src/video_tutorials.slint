import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component VideoTutorials inherits Window {
    width: 375px;
    height: 812px;
    title: "Video Tutorials";
    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        padding: 16px;
        spacing: 20px;

        Text {
            text: "Watch & Learn";
            font-size: 24px;
            font-weight: 700;
            color: white;
            font-family: "Outfit";
        }

        ScrollView {
            VerticalBox {
                spacing: 24px;

                GlassCard {
                    VerticalBox {
                        padding: 16px; spacing: 12px;
                        Rectangle {
                            height: 200px;
                            background: rgba(255, 255, 255, 0.1);
                            border-radius: 8px;
                            Text { text: "▶ Play Video"; horizontal-alignment: center; vertical-alignment: center; font-weight: 700; color: white; font-family: "Inter"; }
                        }
                        Text { text: "How to add your first product"; font-weight: 700; font-size: 18px; color: white; font-family: "Outfit"; }
                        Text { text: "A quick 60-second guide to listing items in your store."; color: #a8b2c1; wrap: word-wrap; font-family: "Inter"; }
                    }
                }

                GlassCard {
                    VerticalBox {
                        padding: 16px; spacing: 12px;
                        Rectangle {
                            height: 200px;
                            background: rgba(255, 255, 255, 0.1);
                            border-radius: 8px;
                            Text { text: "▶ Play Video"; horizontal-alignment: center; vertical-alignment: center; font-weight: 700; color: white; font-family: "Inter"; }
                        }
                        Text { text: "Setting up AI Agents"; font-weight: 700; font-size: 18px; color: white; font-family: "Outfit"; }
                        Text { text: "Learn how to let AI handle your customer emails and social media."; color: #a8b2c1; wrap: word-wrap; font-family: "Inter"; }
                    }
                }
            }
        }
    }
}
