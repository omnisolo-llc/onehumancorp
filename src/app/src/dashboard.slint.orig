import {  Button, VerticalBox, HorizontalBox  } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";
import { SwarmObservability, UiMeshMessage } from "swarm_observability.slint";


export struct UiPendingApproval {
    task_id: string,
    title: string,
    proposed_content: string,
}

export struct UiRoleCount {
    role: string,
    count: int,
}

export component Dashboard inherits Window {
    width: 375px;
    height: 800px;
    title: "Dashboard";

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    in property <int> active_agents_count: 0;
    in property <int> active_tasks_count: 0;
    in property <int> scheduled_calls_count: 0;
    in property <int> team_members_count: 0;

    in property <[UiPendingApproval]> pending_approvals;
    in property <[UiRoleCount]> role_counts;
    in property <[UiMeshMessage]> mesh_messages;

    callback open_help_center();
    callback open_ai_chat();
    callback approve_task(string);

    Flickable {
    VerticalBox {
        spacing: 20px;
        padding: 24px;

        // Header
        HorizontalBox {
            spacing: 16px;
            Text { text: "Dashboard"; font-size: 28px; font-family: "Outfit"; font-weight: 700; color: white; vertical-alignment: center; }
            Rectangle {} // Spacer
            Button { text: "Ask AI"; height: 44px; clicked => { open_ai_chat(); } }
            Button { text: "Help"; height: 44px; clicked => { open_help_center(); } }
            Button { text: "Billing"; height: 44px; }
        }

        // Stat Cards
        VerticalBox {
            spacing: 16px;

            HorizontalBox {
                spacing: 16px;

                GlassCard {
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;
                    width: 100%;

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        VerticalBox {
                            padding: 16px;
                            Text { text: "Active Agents"; color: #94a3b8; }
                            Text { text: active_agents_count; font-size: 32px; font-family: "Outfit"; font-weight: 700; color: #a855f7; }
                        }
                    }
                }
                GlassCard {
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;
                    width: 100%;

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        VerticalBox {
                            padding: 16px;
                            Text { text: "Current Tasks"; color: #94a3b8; }
                            Text { text: active_tasks_count; font-size: 32px; font-family: "Outfit"; font-weight: 700; color: #06b6d4; }
                        }
                    }
                }
            }

            HorizontalBox {
                spacing: 16px;

                GlassCard {
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;
                    width: 100%;

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        VerticalBox {
                            padding: 16px;
                            Text { text: "Upcoming Calls"; color: #94a3b8; }
                            Text { text: scheduled_calls_count; font-size: 32px; font-family: "Outfit"; font-weight: 700; color: #10b981; }
                        }
                    }
                }
                GlassCard {
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;
                    width: 100%;

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        VerticalBox {
                            padding: 16px;
                            Text { text: "Team Members"; color: #94a3b8; }
                            Text { text: team_members_count; font-size: 32px; font-family: "Outfit"; font-weight: 700; color: #f59e0b; }
                        }
                    }
                }
            }
        }


        if (pending_approvals.length > 0) : VerticalBox {
            spacing: 16px;
            Text { text: "Action Required: Drafts for Review"; font-size: 20px; font-weight: 700; color: #b91c1c; }

            for approval in pending_approvals : Rectangle {
                background: #fef2f2;
                border-color: #fca5a5;
                border-width: 1px;
                border-radius: 8px;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;

                    Text { text: approval.title; font-weight: 700; color: #991b1b; }
                    Text { text: approval.proposed_content; color: #7f1d1d; wrap: word-wrap; }

                    HorizontalBox {
                        alignment: end;
                        spacing: 10px;
                        Button { text: "Edit"; height: 44px; }
                        Button {
                            text: "Approve";
                            height: 44px;
                            clicked => { approve_task(approval.task_id); }
                        }
                    }
                }
            }
        }

        SwarmObservability {
            messages: mesh_messages;
        }

        // Company Structure
        Text { text: "Company Structure"; font-size: 20px; font-family: "Outfit"; font-weight: 700; color: white; }

        VerticalBox {
            spacing: 10px;

            for role_count in role_counts : GlassCard {
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;

                HorizontalBox {
                    padding: 16px;
                    Text { text: role_count.role; font-weight: 700; color: white; horizontal-alignment: center; }
                    Rectangle {}
                    Button { text: "-"; width: 44px; height: 44px; }
                    Text { text: role_count.count; font-weight: 700; color: white; horizontal-alignment: center; }
                    Button { text: "+"; width: 44px; height: 44px; }
                }
            }
        }
    }
}
}
