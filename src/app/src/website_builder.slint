import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, CheckBox } from "std-widgets.slint";

export component WebsiteBuilder inherits Window {
    width: 600px;
    height: 600px;
    title: "Build My Website";

    callback publish_site(string, string, string, string);
    callback open_ohc_signup();

    in-out property <int> step: 0;
    in-out property <string> selected_template: "";
    in-out property <string> primary_color: "#FF3B30";
    in-out property <string> product_name: "";
    in-out property <string> domain_choice: "subdomain";
    in-out property <bool> is_advanced: false;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Website Builder"; font-size: 24px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            CheckBox {
                text: "Expert Mode";
                checked: is_advanced;
                toggled => { is_advanced = !is_advanced; }
            }
        }

        // Step 0: Template
        if (step == 0) : VerticalBox {
            if (is_advanced) : VerticalBox {
                spacing: 8px;
                Text { text: "Advanced: Local CLI command"; font-family: "Inter"; font-size: 14px; color: #1e293b; }
                Text { text: "ohc deploy --template " + (selected_template == "" ? "<template>" : selected_template); font-family: "Inter"; font-size: 12px; color: #64748b; }
            }
            spacing: 10px;
            Text { text: "Choose a template"; color: #1e293b; }
            
            HorizontalBox {
                spacing: 10px;
                GlassCard {
                    height: 80px;
                    background: selected_template == "E-commerce" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: "🛒 E-commerce"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; horizontal-alignment: center; }
                        Text { text: "Sell products online"; font-family: "Inter"; font-size: 12px; color: #94a3b8; horizontal-alignment: center; }
                    }
                    TouchArea { clicked => { selected_template = "E-commerce"; } }
                }
                GlassCard {
                    height: 80px;
                    background: selected_template == "Portfolio" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: "🎨 Portfolio"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; horizontal-alignment: center; }
                        Text { text: "Showcase your work"; font-family: "Inter"; font-size: 12px; color: #94a3b8; horizontal-alignment: center; }
                    }
                    TouchArea { clicked => { selected_template = "Portfolio"; } }
                }
            }
            Text { text: "Selected: " + selected_template; color: #a855f7; }
        }

        // Step 1: Colors
        if (step == 1) : VerticalBox {
            spacing: 10px;
            Text { text: "Brand Colors & Logo"; color: #1e293b; }
            Text { text: "Selected Color: " + primary_color; color: #64748b; }
            HorizontalBox {
                spacing: 10px;
                Button { text: "Red"; clicked => { primary_color = "#FF3B30"; } }
                Button { text: "Green"; clicked => { primary_color = "#34C759"; } }
                Button { text: "Blue"; clicked => { primary_color = "#007AFF"; } }
                Button { text: "✨ Generate Logo"; }
            }
        }

        // Step 2: Product
        if (step == 2) : VerticalBox {
            spacing: 10px;
            Text { text: "Add your first product or service"; color: #1e293b; }
            LineEdit {
                placeholder-text: "Product Name";
                text <=> product_name;
            }
            LineEdit {
                placeholder-text: "Price";
            }
            HorizontalBox {
                spacing: 10px;
                LineEdit {
                    placeholder-text: "Description";
                    width: parent.width - 210px;
                }
                Button { text: "✨ Auto-generate description"; width: 200px; }
            }
        }

        // Step 3: Domain
        if (step == 3) : VerticalBox {
            spacing: 10px;
            Text { text: "Connect a domain"; color: #1e293b; }
            Button { text: "Use a free OHC subdomain"; clicked => { domain_choice = "subdomain"; } }
            Button { text: "Use my own domain"; clicked => { domain_choice = "custom"; } }
            Button { text: "Buy a domain"; clicked => { domain_choice = "buy"; } }
            Text { text: "Choice: " + domain_choice; color: #a855f7; }
        }

        // Step 4: Review
        if (step == 4) : VerticalBox {
            spacing: 10px;
            Text { text: "Go Live: Review your site"; color: #1e293b; }
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    Text { text: "Template: " + selected_template; color: #1e293b; }
                    Text { text: "Color: " + primary_color; color: #1e293b; }
                    Text { text: "Product: " + product_name; color: #1e293b; }
                    Text { text: "Domain: " + domain_choice; color: #1e293b; }
                    Rectangle { height: 16px; } // Spacer
                    HorizontalBox {
                        alignment: center;
                        Text { text: "Built with OHC — "; color: #64748b; font-size: 12px; }
                        Button {
                            text: "Start your free business →";
                            // In a real app, this would trigger an external link open callback
                            clicked => { open_ohc_signup(); }
                        }
                    }
                }
            }
        }

        Rectangle {} // Spacer

        // Navigation
        HorizontalBox {
            if (step > 0) : Button {
                text: "Back";
                clicked => { step = step - 1; }
            }
            Rectangle {} // Spacer
            Button {
                text: step == 4 ? "Publish" : "Next";
                clicked => {
                    if (step < 4) {
                        step = step + 1;
                    } else {
                        // Handle publish
                        publish_site(selected_template, primary_color, product_name, domain_choice);
                    }
                }
            }
        }
    }
}
