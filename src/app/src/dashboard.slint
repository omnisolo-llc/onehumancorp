import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { SwarmObservability, UiMeshMessage } from "swarm_observability.slint";

export struct UiRoleCount {
    role: string,
    count: int,
}

export struct UiMilestone {
    icon: string,
    message: string,
    time: string,
}

export component Dashboard inherits Window {
    width: 800px;
    height: 800px;
    title: "Dashboard";

    background: #f8fafc;

    in property <int> active_agents_count: 0;
    in property <int> active_tasks_count: 0;
    in property <int> scheduled_calls_count: 0;
    in property <int> team_members_count: 0;

    in property <[UiRoleCount]> role_counts;
    in property <[UiMeshMessage]> mesh_messages;
    in property <[UiMilestone]> milestones: [
        { icon: "🎉", message: "You just got your 10th order!", time: "2m ago" },
        { icon: "🚀", message: "Your store had 100 visitors today!", time: "1h ago" }
    ];
    callback share_business();

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        // Header
        HorizontalBox {
            Text { text: "Dashboard"; font-size: 28px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            Button { text: "Share My Business"; clicked => { share_business(); } }
            Button { text: "Billing & Credits"; }
        }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 8px;
            padding: 16px;
            VerticalBox {
                spacing: 8px;
                Text { text: "Share Your Storefront"; font-weight: 700; font-size: 16px; }
                Text { text: "Copy this link to your Instagram bio or WhatsApp."; color: #64748b; }
                HorizontalBox {
                    Rectangle {
                        background: #f1f5f9;
                        border-radius: 4px;
                        padding: 8px;
                        Text { text: "https://my-store.ohc.app"; color: #3b82f6; }
                    }
                    Button { text: "Copy Link"; clicked => { share_business(); } }
                }
            }
        }

        // Milestones
        Text { text: "Success Milestones"; font-size: 20px; font-weight: 700; color: #1e293b; }
        VerticalBox {
            spacing: 8px;
            for m in milestones : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                HorizontalBox {
                    padding: 12px;
                    spacing: 12px;
                    Text { text: m.icon; font-size: 20px; }
                    VerticalBox {
                        Text { text: m.message; font-weight: 700; color: #1e293b; }
                        Text { text: m.time; color: #64748b; font-size: 12px; }
                    }
                }
            }
        }

        // Stat Cards
        HorizontalBox {
            spacing: 16px;

            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 180px;
                VerticalBox {
                    padding: 16px;
                    Text { text: "Active Agents"; color: #64748b; }
                    Text { text: active_agents_count; font-size: 32px; font-weight: 700; color: #a855f7; }
                }
            }
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 180px;
                VerticalBox {
                    padding: 16px;
                    Text { text: "Active Tasks"; color: #64748b; }
                    Text { text: active_tasks_count; font-size: 32px; font-weight: 700; color: #06b6d4; }
                }
            }
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 180px;
                VerticalBox {
                    padding: 16px;
                    Text { text: "Scheduled Calls"; color: #64748b; }
                    Text { text: scheduled_calls_count; font-size: 32px; font-weight: 700; color: #10b981; }
                }
            }
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 180px;
                VerticalBox {
                    padding: 16px;
                    Text { text: "Team Members"; color: #64748b; }
                    Text { text: team_members_count; font-size: 32px; font-weight: 700; color: #f59e0b; }
                }
            }
        }

        SwarmObservability {
            messages: mesh_messages;
        }

        // Company Structure
        Text { text: "Company Structure"; font-size: 20px; font-weight: 700; color: #1e293b; }
        
        VerticalBox {
            spacing: 10px;
            
            for role_count in role_counts : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 16px;
                    Text { text: role_count.role; font-weight: 700; color: #1e293b; horizontal-alignment: center; }
                    Rectangle {}
                    Button { text: "-"; }
                    Text { text: role_count.count; font-weight: 700; color: #1e293b; horizontal-alignment: center; }
                    Button { text: "+"; }
                }
            }
        }
    }
}
