import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { SwarmObservability, UiMeshMessage } from "swarm_observability.slint";

export struct UiRoleCount {
    role: string,
    count: int,
}

export component Dashboard inherits Window {
    min-width: 375px;
    preferred-width: 800px;
    height: 800px;
    title: "Dashboard";

    background: #f8fafc;

    in property <int> active_agents_count: 0;
    in property <int> active_tasks_count: 0;
    in property <int> scheduled_calls_count: 0;
    in property <int> team_members_count: 0;

    in property <[UiRoleCount]> role_counts;
    in property <[UiMeshMessage]> mesh_messages;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        // Header
        HorizontalBox {
            Text { text: "Dashboard"; font-size: 28px; font-weight: 700; color: #1e293b; font-family: "Outfit"; }
            Rectangle {}
            Button { text: "Billing & Credits"; height: 44px; }
        }

        // Stat Cards
        VerticalBox {
            spacing: 16px;

            HorizontalBox {
                spacing: 16px;
                Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;
                    width: 150px;
                    VerticalBox {
                        padding: 16px;
                        Text { text: "Today's Sales"; color: #64748b; font-family: "Inter"; }
                        Text { text: active_agents_count; font-size: 32px; font-weight: 700; color: #a855f7; font-family: "Outfit"; }
                    }
                }
                Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;
                    width: 150px;
                    VerticalBox {
                        padding: 16px;
                        Text { text: "Tasks"; color: #64748b; font-family: "Inter"; }
                        Text { text: active_tasks_count; font-size: 32px; font-weight: 700; color: #06b6d4; font-family: "Outfit"; }
                    }
                }
            }

            HorizontalBox {
                spacing: 16px;
                Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;
                    width: 150px;
                    VerticalBox {
                        padding: 16px;
                        Text { text: "Scheduled Calls"; color: #64748b; font-family: "Inter"; }
                        Text { text: scheduled_calls_count; font-size: 32px; font-weight: 700; color: #10b981; font-family: "Outfit"; }
                    }
                }
                Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;
                    width: 150px;
                    VerticalBox {
                        padding: 16px;
                        Text { text: "Team Members"; color: #64748b; font-family: "Inter"; }
                        Text { text: team_members_count; font-size: 32px; font-weight: 700; color: #f59e0b; font-family: "Outfit"; }
                    }
                }
            }
        }

        SwarmObservability {
            messages: mesh_messages;
        }

        // Company Structure
        Text { text: "Company Structure"; font-size: 20px; font-weight: 700; color: #1e293b; font-family: "Outfit"; }
        
        VerticalBox {
            spacing: 10px;
            
            for role_count in role_counts : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 16px;
                    Text { text: role_count.role; font-weight: 700; color: #1e293b; horizontal-alignment: center; }
                    Rectangle {}
                    Button { text: "-"; height: 44px; }
                    Text { text: role_count.count; font-weight: 700; color: #1e293b; horizontal-alignment: center; }
                    Button { text: "+"; height: 44px; }
                }
            }
        }
    }
}
