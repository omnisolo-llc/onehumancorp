import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { SwarmObservability, UiMeshMessage } from "swarm_observability.slint";

export struct UiRoleCount {
    role: string,
    count: int,
}

export component Dashboard inherits Window {
    width: 375px; // Mobile-first baseline
    height: 800px;
    title: "Dashboard";

    // Premium Design Tokens
    background: #f8fafc;

    in property <int> active_agents_count: 0;
    in property <int> active_tasks_count: 0;
    in property <int> scheduled_calls_count: 0;
    in property <int> team_members_count: 0;

    in property <[UiRoleCount]> role_counts;
    in property <[UiMeshMessage]> mesh_messages;

    ScrollView {
        VerticalBox {
            spacing: 20px;
            padding: 16px; // Tighter padding for mobile

            // Header
            HorizontalBox {
                Text { text: "Dashboard"; font-size: 24px; font-weight: 700; color: #1e293b; vertical-alignment: center; }
                Rectangle {}
                Button { text: "Billing"; height: 44px; }
            }

            // Stat Cards - Stacked vertically for mobile viewports
            VerticalBox {
                spacing: 12px;

                Rectangle {
                    // Glassmorphism effect via semi-transparent hex #ffffffaa
                    background: #ffffffaa;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 12px;

                    HorizontalBox {
                        padding: 16px;
                        Text { text: "Active Agents"; color: #64748b; vertical-alignment: center; }
                        Rectangle {}
                        Text { text: active_agents_count; font-size: 24px; font-weight: 700; color: #a855f7; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    background: #ffffffaa;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 12px;

                    HorizontalBox {
                        padding: 16px;
                        Text { text: "Active Tasks"; color: #64748b; vertical-alignment: center; }
                        Rectangle {}
                        Text { text: active_tasks_count; font-size: 24px; font-weight: 700; color: #06b6d4; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    background: #ffffffaa;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 12px;

                    HorizontalBox {
                        padding: 16px;
                        Text { text: "Scheduled Calls"; color: #64748b; vertical-alignment: center; }
                        Rectangle {}
                        Text { text: scheduled_calls_count; font-size: 24px; font-weight: 700; color: #10b981; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    background: #ffffffaa;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 12px;

                    HorizontalBox {
                        padding: 16px;
                        Text { text: "Team Members"; color: #64748b; vertical-alignment: center; }
                        Rectangle {}
                        Text { text: team_members_count; font-size: 24px; font-weight: 700; color: #f59e0b; vertical-alignment: center; }
                    }
                }
            }

            SwarmObservability {
                messages: mesh_messages;
            }

            // Company Structure
            Text { text: "Company Structure"; font-size: 20px; font-weight: 700; color: #1e293b; }
            
            VerticalBox {
                spacing: 10px;
                
                for role_count in role_counts : Rectangle {
                    background: #ffffffaa;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 12px;

                    HorizontalBox {
                        padding: 16px;
                        Text { text: role_count.role; font-weight: 700; color: #1e293b; vertical-alignment: center; }
                        Rectangle {}
                        Button { text: "-"; width: 44px; height: 44px; } // 44x44 constraint
                        Text { text: role_count.count; font-weight: 700; color: #1e293b; vertical-alignment: center; horizontal-alignment: center; width: 30px; }
                        Button { text: "+"; width: 44px; height: 44px; } // 44x44 constraint
                    }
                }
            }
        }
    }
}
