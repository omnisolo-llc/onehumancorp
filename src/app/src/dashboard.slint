import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { SwarmObservability, UiMeshMessage } from "swarm_observability.slint";

export struct UiRoleCount {
    role: string,
    count: int,
}

component StatCard inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <color> color;

    background: white.with-alpha(0.1);
    border-color: white.with-alpha(0.2);
    border-width: 1px;
    border-radius: 12px;
    width: 160px;
    height: 100px;

    VerticalBox {
        padding: 12px;
        alignment: space-between;
        Text {
            text: label;
            color: #a8b2c1;
            font-size: 14px;
            font-family: "Inter";
        }
        Text {
            text: value;
            font-size: 28px;
            font-weight: 700;
            color: color;
            font-family: "Outfit";
        }
    }
}

export component Dashboard inherits Rectangle {
    in property <int> active_agents_count: 0;
    in property <int> active_tasks_count: 0;
    in property <int> scheduled_calls_count: 0;
    in property <int> team_members_count: 0;

    in property <[UiRoleCount]> role_counts;
    in property <[UiMeshMessage]> mesh_messages;

    VerticalBox {
        spacing: 24px;
        padding: 20px;

        // Header
        HorizontalBox {
            Text {
                text: "Overview";
                font-size: 24px;
                font-weight: 700;
                color: white;
                font-family: "Outfit";
            }
            Rectangle {}
            Button { text: "Settings"; }
        }

        // Stat Grid (Mobile optimized)
        VerticalBox {
            spacing: 12px;
            HorizontalBox {
                spacing: 12px;
                StatCard {
                    label: "AI Helpers";
                    value: active_agents_count;
                    color: #a855f7;
                }
                StatCard {
                    label: "To-Do List";
                    value: active_tasks_count;
                    color: #06b6d4;
                }
            }
            HorizontalBox {
                spacing: 12px;
                StatCard {
                    label: "Bookings";
                    value: scheduled_calls_count;
                    color: #10b981;
                }
                StatCard {
                    label: "My Team";
                    value: team_members_count;
                    color: #f59e0b;
                }
            }
        }

        // Swarm Activity
        VerticalBox {
            spacing: 8px;
            Text {
                text: "Live Activity";
                font-size: 18px;
                font-weight: 700;
                color: white;
                font-family: "Outfit";
            }
            SwarmObservability {
                messages: mesh_messages;
                height: 200px;
            }
        }

        // Company Structure
        VerticalBox {
            spacing: 8px;
            Text {
                text: "My Swarm";
                font-size: 18px;
                font-weight: 700;
                color: white;
                font-family: "Outfit";
            }
            
            VerticalBox {
                spacing: 8px;
                for role_count in role_counts : Rectangle {
                    background: white.with-alpha(0.05);
                    border-color: white.with-alpha(0.1);
                    border-width: 1px;
                    border-radius: 8px;

                    HorizontalBox {
                        padding: 12px;
                        Text {
                            text: role_count.role;
                            font-weight: 700;
                            color: white;
                            font-family: "Inter";
                        }
                        Rectangle {}
                        Text {
                            text: role_count.count;
                            font-weight: 700;
                            color: #a855f7;
                            font-family: "Outfit";
                        }
                    }
                }
            }
        }
    }
}
