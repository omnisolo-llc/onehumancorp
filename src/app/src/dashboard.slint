import { Button, VerticalBox, HorizontalBox, ScrollView, GridBox } from "std-widgets.slint";
import { SwarmObservability, UiMeshMessage } from "swarm_observability.slint";

export struct UiRoleCount {
    role: string,
    count: int,
}

export component Dashboard inherits Window {
    width: 375px;
    height: 800px;
    title: "My Business";

    background: #f8fafc;

    in property <int> active_agents_count: 0;
    in property <int> active_tasks_count: 0;
    in property <int> scheduled_calls_count: 0;
    in property <int> team_members_count: 0;

    in property <[UiRoleCount]> role_counts;
    in property <[UiMeshMessage]> mesh_messages;

    ScrollView {
        VerticalBox {
            spacing: 20px;
            padding: 16px;

            // Header
            HorizontalBox {
                alignment: space-between;
                Text { text: "My Business"; font-size: 28px; font-weight: 700; color: #1e293b; vertical-alignment: center; }
                Button { text: "My Account"; width: 120px; height: 44px; }
            }

            // Stat Cards - using VerticalBox for mobile
            VerticalBox {
                spacing: 16px;

                Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;
                    VerticalBox {
                        padding: 16px;
                        Text { text: "Tasks in Progress"; color: #64748b; font-size: 16px; }
                        Text { text: active_tasks_count; font-size: 32px; font-weight: 700; color: #06b6d4; }
                    }
                }

                Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;
                    VerticalBox {
                        padding: 16px;
                        Text { text: "Active AI Helpers"; color: #64748b; font-size: 16px; }
                        Text { text: active_agents_count; font-size: 32px; font-weight: 700; color: #a855f7; }
                    }
                }

                Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;
                    VerticalBox {
                        padding: 16px;
                        Text { text: "Upcoming Meetings"; color: #64748b; font-size: 16px; }
                        Text { text: scheduled_calls_count; font-size: 32px; font-weight: 700; color: #10b981; }
                    }
                }
                Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;
                    VerticalBox {
                        padding: 16px;
                        Text { text: "My Team"; color: #64748b; font-size: 16px; }
                        Text { text: team_members_count; font-size: 32px; font-weight: 700; color: #f59e0b; }
                    }
                }
            }

            SwarmObservability {
                messages: mesh_messages;
            }

            // Company Structure
            Text { text: "Team Roles"; font-size: 20px; font-weight: 700; color: #1e293b; }
            
            VerticalBox {
                spacing: 10px;
                
                for role_count in role_counts : Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;

                    HorizontalBox {
                        padding: 16px;
                        spacing: 8px;
                        Text { text: role_count.role; font-weight: 700; color: #1e293b; vertical-alignment: center; }
                        Rectangle {} // Spacer
                        Button { text: "-"; width: 44px; height: 44px; }
                        Text { text: role_count.count; font-weight: 700; color: #1e293b; vertical-alignment: center; }
                        Button { text: "+"; width: 44px; height: 44px; }
                    }
                }
            }
        }
    }
}
