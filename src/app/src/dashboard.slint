import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { SwarmObservability, UiMeshMessage } from "swarm_observability.slint";
import { Tooltip } from "tooltip.slint";

export struct UiRoleCount {
    role: string,
    count: int,
}

export component Dashboard inherits Window {
    width: 375px;
    height: 800px;
    title: "Dashboard";

    background: #f8fafc;

    in property <int> active_agents_count: 0;
    in property <int> active_tasks_count: 0;
    in property <int> scheduled_calls_count: 0;
    in property <int> team_members_count: 0;

    in property <[UiRoleCount]> role_counts;
    in property <[UiMeshMessage]> mesh_messages;

    in property <string> tt_active_agents: "";
    in property <string> tt_active_tasks: "";
    in property <string> tt_scheduled_calls: "";
    in property <string> tt_team_members: "";

    callback open_help_center();
    callback open_ai_chat();
    callback open_release_notes();
    callback start_walkthrough();

    Flickable {
    VerticalBox {
        spacing: 20px;
        padding: 24px;

        // Header
        VerticalBox {
            spacing: 16px;
            HorizontalBox {
                alignment: space-between;
                Text { text: "Dashboard"; font-size: 28px; font-weight: 700; color: #1e293b; }
                Button { text: "✨ What's New"; clicked => { open_release_notes(); } }
            }
            Rectangle {}
            Button { text: "Ask anything"; clicked => { open_ai_chat(); } }
            Button { text: "?"; clicked => { open_help_center(); } }
            Button { text: "Take a Tour 🏁"; clicked => { start_walkthrough(); } }
            Button { text: "Billing & Credits"; }
        }

        // Stat Cards
        VerticalBox {
            spacing: 16px;

            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 100%;

                touch-agents := TouchArea {
                    width: 100%;
                    height: 100%;
                    VerticalBox {
                        padding: 16px;
                        Text { text: "Agents Working Now"; color: #64748b; }
                        Text { text: active_agents_count; font-size: 32px; font-weight: 700; color: #a855f7; }
                    }
                }
                Tooltip {
                    text: tt_active_agents;
                    show: touch-agents.has-hover;
                    x: parent.width / 2;
                    y: parent.height;
                }
            }
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 100%;

                touch-tasks := TouchArea {
                    width: 100%;
                    height: 100%;
                    VerticalBox {
                        padding: 16px;
                        Text { text: "Tasks in Progress"; color: #64748b; }
                        Text { text: active_tasks_count; font-size: 32px; font-weight: 700; color: #06b6d4; }
                    }
                }
                Tooltip {
                    text: tt_active_tasks;
                    show: touch-tasks.has-hover;
                    x: parent.width / 2;
                    y: parent.height;
                }
            }
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 100%;

                touch-calls := TouchArea {
                    width: 100%;
                    height: 100%;
                    VerticalBox {
                        padding: 16px;
                        Text { text: "Upcoming Calls"; color: #64748b; }
                        Text { text: scheduled_calls_count; font-size: 32px; font-weight: 700; color: #10b981; }
                    }
                }
                Tooltip {
                    text: tt_scheduled_calls;
                    show: touch-calls.has-hover;
                    x: parent.width / 2;
                    y: parent.height;
                }
            }
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 100%;

                touch-team := TouchArea {
                    width: 100%;
                    height: 100%;
                    VerticalBox {
                        padding: 16px;
                        Text { text: "My Team"; color: #64748b; }
                        Text { text: team_members_count; font-size: 32px; font-weight: 700; color: #f59e0b; }
                    }
                }
                Tooltip {
                    text: tt_team_members;
                    show: touch-team.has-hover;
                    x: parent.width / 2;
                    y: parent.height;
                }
            }
        }

        SwarmObservability {
            messages: mesh_messages;
        }

        // Company Structure
        Text { text: "Company Structure"; font-size: 20px; font-weight: 700; color: #1e293b; }
        
        VerticalBox {
            spacing: 10px;
            
            for role_count in role_counts : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 16px;
                    Text { text: role_count.role; font-weight: 700; color: #1e293b; horizontal-alignment: center; }
                    Rectangle {}
                    Button { text: "-"; width: 44px; height: 44px; }
                    Text { text: role_count.count; font-weight: 700; color: #1e293b; horizontal-alignment: center; }
                    Button { text: "+"; width: 44px; height: 44px; }
                }
            }
        }
    }
}
}
