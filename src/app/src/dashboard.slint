import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { SwarmObservability, UiMeshMessage } from "swarm_observability.slint";

export struct UiRoleCount {
    role: string,
    count: int,
}

export component Dashboard inherits Window {
    width: 375px;
    height: 812px;
    title: "Dashboard";

    background: #f8fafc;

    in property <int> active_agents_count: 0;
    in property <int> active_tasks_count: 0;
    in property <int> scheduled_calls_count: 0;
    in property <int> team_members_count: 0;

    in property <[UiRoleCount]> role_counts;
    in property <[UiMeshMessage]> mesh_messages;
    in property <string> company_name: "Maya's Bakery";

    callback add_product();

    VerticalBox {
        spacing: 20px;
        padding: 24px;
        alignment: start;

        // Header
        HorizontalBox {
            Text {
                text: company_name;
                font-size: 24px;
                font-weight: 700;
                color: #1e293b;
                font-family: "Outfit";
            }
            Rectangle {}
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: #e2e8f0;
                Text {
                    text: "👤";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 20px;
                }
            }
        }

        // Morning Briefing Card (Advisory Agent)
        Rectangle {
            background: #ffffff;
            border-radius: 16px;
            border-width: 1px;
            border-color: #e2e8f0;
            // Simulated Glassmorphism approach in Slint where no blur is available
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000010;
            drop-shadow-offset-y: 4px;

            VerticalBox {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: "🌅 Morning Briefing";
                    font-size: 18px;
                    font-weight: 700;
                    color: #a855f7;
                    font-family: "Outfit";
                }

                Text {
                    text: "Good morning! The Promoter finished designing your storefront. You are ready to start selling. Let's add your first product to get started!";
                    font-size: 16px;
                    color: #475569;
                    wrap: word-wrap;
                    font-family: "Inter";
                    line-height: 1.5;
                }
            }
        }

        Rectangle { height: 10px; }

        // Primary Action
        Button {
            text: "Add your first product";
            height: 56px;
            clicked => { add_product(); }
        }

        Rectangle { height: 20px; }

        Text {
            text: "Agent Activity";
            font-size: 20px;
            font-weight: 700;
            color: #1e293b;
            font-family: "Outfit";
        }

        SwarmObservability {
            messages: mesh_messages;
        }
    }
}
