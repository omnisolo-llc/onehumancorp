import { Button, VerticalBox, HorizontalBox, CheckBox } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component AgentConfig inherits Window {
    width: 600px;
    height: 500px;
    title: "Configure AI Agent";

    callback activate_agent(string, bool, bool, string);

    property <int> step: 0;
    property <string> selected_agent: "";
    property <bool> can_reply: false;
    property <bool> can_social: false;
    property <string> frequency: "Daily";

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    GlassCard {
        VerticalBox {
            spacing: 20px;
            padding: 24px;

        Text { text: "Configure AI Agent"; font-size: 24px; font-weight: 700; color: white; font-family: "Outfit"; }

        // Step 0: Choose Agent
        if (step == 0) : VerticalBox {
            spacing: 10px;
            Text { text: "Choose an agent to add to your team"; color: white; font-family: "Outfit"; }
            
            HorizontalBox {
                spacing: 10px;
                Button { text: "Customer Support"; clicked => { selected_agent = "Customer Support"; } }
                Button { text: "Social Media Manager"; clicked => { selected_agent = "Social Media Manager"; } }
            }
            Text { text: "Selected: " + selected_agent; color: #a855f7; }
        }

        // Step 1: Capabilities
        if (step == 1) : VerticalBox {
            spacing: 10px;
            Text { text: "What should this agent do?"; color: white; font-family: "Outfit"; }
            
            HorizontalBox {
                Text { text: "Reply to customer messages"; color: white; font-family: "Outfit"; }
                CheckBox { checked: can_reply; toggled => { can_reply = !can_reply; } }
            }
            HorizontalBox {
                Text { text: "Post to Instagram & Facebook"; color: white; font-family: "Outfit"; }
                CheckBox { checked: can_social; toggled => { can_social = !can_social; } }
            }
        }

        // Step 2: Frequency
        if (step == 2) : VerticalBox {
            spacing: 10px;
            Text { text: "How often should this agent work?"; color: white; font-family: "Outfit"; }
            Text { text: frequency; font-size: 24px; color: #a855f7; horizontal-alignment: center; }
            
            HorizontalBox {
                alignment: center;
                Button { text: "Weekly"; clicked => { frequency = "Weekly"; } }
                Button { text: "Daily"; clicked => { frequency = "Daily"; } }
                Button { text: "Hourly"; clicked => { frequency = "Hourly"; } }
            }
        }

        // Step 3: Review
        if (step == 3) : VerticalBox {
            spacing: 10px;
            Text { text: "Review & Activate"; color: white; font-family: "Outfit"; }
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    Text { text: "Agent: " + selected_agent; color: white; font-family: "Outfit"; }
                    Text { text: "Reply: " + (can_reply ? "Yes" : "No"); color: white; font-family: "Outfit"; }
                    Text { text: "Social: " + (can_social ? "Yes" : "No"); color: white; font-family: "Outfit"; }
                    Text { text: "Schedule: " + frequency; color: white; font-family: "Outfit"; }
                }
            }
        }

        Rectangle {} // Spacer

        // Navigation
        HorizontalBox {
            if (step > 0) : Button {
                text: "Back";
                clicked => { step = step - 1; }
            }
            Rectangle {} // Spacer
            Button {
                text: step == 3 ? "Activate" : "Next";
                clicked => {
                    if (step < 3) {
                        step = step + 1;
                    } else {
                        // Handle activation
                        activate_agent(selected_agent, can_reply, can_social, frequency);
                    }
                }
            }
        }
        }
    }
}
