import { Button, VerticalBox, HorizontalBox, Switch, Slider } from "std-widgets.slint";

export component AgentCard inherits Rectangle {
    in property <string> role_name;
    in property <string> description;
    in property <bool> active;
    callback toggle;

    background: white;
    border-color: active ? #a855f7 : #e2e8f0;
    border-width: 2px;
    border-radius: 16px;
    height: 140px;

    VerticalBox {
        padding: 20px;
        spacing: 8px;
        HorizontalBox {
            Text { text: root.role_name; font-size: 18px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            Switch { checked: root.active; changed => { root.toggle(); } }
        }
        Text { text: root.description; color: #64748b; font-size: 14px; wrap: word-wrap; }
    }
}

export component AgentGallery inherits Window {
    width: 800px;
    height: 600px;
    title: "Your AI Team";

    property <bool> show_config: false;
    property <string> selected_role: "";

    background: #f8fafc;

    VerticalBox {
        spacing: 24px;
        padding: 32px;

        Text { text: "Manage Your AI Team"; font-size: 28px; font-weight: 800; color: #1e293b; }
        Text { text: "Turn on the departments you need. They work in the background 24/7."; color: #64748b; }

        if (!show_config) : VerticalBox {
            spacing: 16px;
            HorizontalBox {
                spacing: 16px;
                AgentCard { role_name: "Customer Success"; description: "Replies to messages and handles support while you sleep."; active: true; toggle => { selected_role = "Customer Success"; show_config = true; } }
                AgentCard { role_name: "Marketing"; description: "Creates social posts and optimizes your SEO."; active: false; toggle => { selected_role = "Marketing"; show_config = true; } }
            }
            HorizontalBox {
                spacing: 16px;
                AgentCard { role_name: "Operations"; description: "Manages orders, inventory, and bookings."; active: true; toggle => { selected_role = "Operations"; show_config = true; } }
                AgentCard { role_name: "Finance"; description: "Tracks sales, costs, and sends plain-language reports."; active: false; toggle => { selected_role = "Finance"; show_config = true; } }
            }
        }

        if (show_config) : VerticalBox {
            spacing: 24px;
            HorizontalBox {
                Button { text: "← Back"; clicked => { show_config = false; } }
                Text { text: "Configure " + selected_role; font-size: 20px; font-weight: 700; vertical-alignment: center; }
            }

            Rectangle {
                background: white;
                border-radius: 16px;
                padding: 24px;
                VerticalBox {
                    spacing: 20px;
                    Text { text: "What should this agent do?"; font-weight: 600; }
                    HorizontalBox { Text { text: "Reply to customer messages"; } Rectangle {} Switch { checked: true; } }
                    HorizontalBox { Text { text: "Draft order confirmations"; } Rectangle {} Switch { checked: true; } }
                    HorizontalBox { Text { text: "Ask for reviews"; } Rectangle {} Switch { checked: false; } }

                    Text { text: "Work Frequency"; font-weight: 600; }
                    HorizontalBox {
                        Text { text: "Quiet"; color: #64748b; }
                        Slider { minimum: 0; maximum: 100; value: 50; }
                        Text { text: "Always On"; color: #a855f7; font-weight: 600; }
                    }
                }
            }

            Button { text: "Save Changes"; clicked => { show_config = false; } }
        }
    }
}
