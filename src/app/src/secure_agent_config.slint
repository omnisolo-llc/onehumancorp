import { Button, VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";

export component SecureAgentConfig inherits Window {
    width: 400px;
    height: 400px;
    title: "Secure Agent Config";

    callback save_config(string);

    property <string> token: "";
    property <string> error_text: "";

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 32px;
        alignment: center;

        Text { text: "Agent Configuration"; font-size: 24px; font-weight: 700; color: #1e293b; }
        
        Text {
            text: "Enter your Agent Activation Code to connect your helper.";
            color: #64748b;
            wrap: word-wrap;
        }

        LineEdit {
            placeholder-text: "activation-code-1234";
            text: token;
        }
        
        if (error_text != "") : Text { text: error_text; color: #ef4444; }

        Button {
            text: "Save Configuration";
            enabled: token != "" && error_text == "";
            clicked => { save_config(token); }
        }
    }
}
