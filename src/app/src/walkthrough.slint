import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Walkthrough inherits Window {
    width: 600px;
    height: 500px;
    title: "AutoDream Sync Walkthrough";

    property <int> current_step: 0;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;
        alignment: center;

        Text { text: "Interactive Guide: Sync Lifecycle"; font-size: 24px; font-weight: 700; color: #1e293b; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 16px;
            width: 500px;
            
            VerticalBox {
                padding: 32px;
                spacing: 16px;
                
                Text {
                    text: current_step == 0 ? "1. Create New Memory" :
                          current_step == 1 ? "2. Check for Unsaved Memories" :
                          current_step == 2 ? "3. Gather New Memories" :
                          current_step == 3 ? "4. Securely Upload to Cloud" :
                          current_step == 4 ? "5. Save in Cloud Storage" :
                          current_step == 5 ? "6. Confirm Upload" :
                          "7. Mark as Saved";
                    font-size: 20px;
                    font-weight: 700;
                    color: #0284c7;
                }
                
                Text {
                    text: current_step == 0 ? "Worker learns something new and saves it locally, marking it as ready to upload." :
                          current_step == 1 ? "The background helper periodically checks the local app for any new memories to upload." :
                          current_step == 2 ? "The local app hands over all the new, unsaved memories to the background helper." :
                          current_step == 3 ? "The background helper securely uploads the memories to the cloud." :
                          current_step == 4 ? "The cloud safely stores the new memories so they are backed up." :
                          current_step == 5 ? "The cloud confirms back that everything was saved correctly." :
                          "The background helper marks the local memories as securely saved.";
                    color: #1e293b;
                    wrap: word-wrap;
                }
                
                Rectangle {
                    background: #f1f5f9;
                    border-radius: 8px;
                    
                    HorizontalBox {
                        padding: 12px;
                        spacing: 12px;
                        Text { text: "🔄"; color: #0284c7; }
                        Text {
                            text: current_step == 0 ? "Local Worker -> Local Storage" :
                                  current_step == 1 ? "Background Helper -> Local Storage" :
                                  current_step == 2 ? "Local Storage -> Background Helper" :
                                  current_step == 3 ? "Background Helper -> Cloud Server" :
                                  current_step == 4 ? "Cloud Server -> Cloud Storage" :
                                  current_step == 5 ? "Cloud Server -> Background Helper" :
                                  "Background Helper -> Local Storage";
                            color: #0284c7;
                            wrap: word-wrap;
                        }
                    }
                }
                
                HorizontalBox {
                    alignment: center;
                    spacing: 20px;
                    
                    Button {
                        text: "Previous Step";
                        enabled: current_step > 0;
                        clicked => { current_step = current_step - 1; }
                    }
                    
                    Text {
                        text: "Step " + (current_step + 1) + " of 7";
                        color: #9ca3af;
                        horizontal-alignment: center;
                    }
                    
                    Button {
                        text: "Next Step";
                        enabled: current_step < 6;
                        clicked => { current_step = current_step + 1; }
                    }
                }
            }
        }
    }
}
