import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Walkthrough inherits Window {
    width: 600px;
    height: 500px;
    title: "Background Sync Walkthrough";

    property <int> current_step: 0;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;
        alignment: center;

        Text { text: "Interactive Guide: Sync Lifecycle"; font-size: 24px; font-weight: 700; color: #1e293b; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 16px;
            width: 500px;
            
            VerticalBox {
                padding: 32px;
                spacing: 16px;
                
                Text {
                    text: current_step == 0 ? "1. Generate & Save Memory" :
                          current_step == 1 ? "2. Check for Pending Updates" :
                          current_step == 2 ? "3. Collect Pending Updates" :
                          current_step == 3 ? "4. Securely upload to the cloud" :
                          current_step == 4 ? "5. Store in Global Cloud" :
                          current_step == 5 ? "6. Confirm Success" :
                          "7. Mark as Synced";
                    font-size: 20px;
                    font-weight: 700;
                    color: #0284c7;
                }
                
                Text {
                    text: current_step == 0 ? "The worker generates a memory update and saves it to local storage to be synced later." :
                          current_step == 1 ? "The sync manager checks local storage for any memory updates waiting to be uploaded." :
                          current_step == 2 ? "Local storage hands over the pending updates to the sync manager." :
                          current_step == 3 ? "The sync manager securely uploads the memory updates to the cloud." :
                          current_step == 4 ? "The cloud safely stores the memory updates in the global cloud storage." :
                          current_step == 5 ? "The cloud sends a success message back to the sync manager." :
                          "The sync manager marks the local updates as successfully synced.";
                    color: #1e293b;
                    wrap: word-wrap;
                }
                
                Rectangle {
                    background: #f1f5f9;
                    border-radius: 8px;
                    
                    HorizontalBox {
                        padding: 12px;
                        spacing: 12px;
                        Text { text: "🔄"; color: #0284c7; }
                        Text {
                            text: current_step == 0 ? "Background Worker -> Local Storage" :
                                  current_step == 1 ? "Sync Manager -> Local Storage" :
                                  current_step == 2 ? "Local Storage -> Sync Manager" :
                                  current_step == 3 ? "Sync Manager -> Secure Cloud" :
                                  current_step == 4 ? "Secure Cloud -> Global Cloud Storage" :
                                  current_step == 5 ? "Secure Cloud -> Sync Manager" :
                                  "Sync Manager -> Local Storage";
                            color: #0284c7;
                            wrap: word-wrap;
                        }
                    }
                }
                
                HorizontalBox {
                    alignment: center;
                    spacing: 20px;
                    
                    Button {
                        text: "Previous Step";
                        enabled: current_step > 0;
                        clicked => { current_step = current_step - 1; }
                    }
                    
                    Text {
                        text: "Step " + (current_step + 1) + " of 7";
                        color: #9ca3af;
                        horizontal-alignment: center;
                    }
                    
                    Button {
                        text: "Next Step";
                        enabled: current_step < 6;
                        clicked => { current_step = current_step + 1; }
                    }
                }
            }
        }
    }
}
