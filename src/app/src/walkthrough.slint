import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Walkthrough inherits Window {
    width: 600px;
    height: 500px;
    title: "Automatic Task Sync Walkthrough";

    property <int> current_step: 0;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;
        alignment: center;

        Text { text: "Interactive Guide: Sync Lifecycle"; font-size: 24px; font-weight: 700; color: #1e293b; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 16px;
            width: 500px;
            
            VerticalBox {
                padding: 32px;
                spacing: 16px;
                
                Text {
                    text: current_step == 0 ? "1. Create & Save Memory" :
                          current_step == 1 ? "2. Check Pending Memories" :
                          current_step == 2 ? "3. Return Batched Memories" :
                          current_step == 3 ? "4. Securely Send to Cloud" :
                          current_step == 4 ? "5. Save to Global Cloud" :
                          current_step == 5 ? "6. Acknowledge Success" :
                          "7. Update Sync Status";
                    font-size: 20px;
                    font-weight: 700;
                    color: #0284c7;
                }
                
                Text {
                    text: current_step == 0 ? "Worker creates a memory and saves it locally, marking it as pending." :
                          current_step == 1 ? "Automatic Sync Task checks the Local Business Memory for any new memories to sync." :
                          current_step == 2 ? "Local Business Memory provides the new memories to the Automatic Sync Task." :
                          current_step == 3 ? "Automatic Sync Task securely sends the new memories to the Global Cloud Server." :
                          current_step == 4 ? "Global Cloud Server securely stores the memories in the Global Cloud Server." :
                          current_step == 5 ? "Global Cloud Server confirms the memories are saved to the Automatic Sync Task." :
                          "Automatic Sync Task updates the local records, marking them as fully synced.";
                    color: #1e293b;
                    wrap: word-wrap;
                }
                
                Rectangle {
                    background: #f1f5f9;
                    border-radius: 8px;
                    
                    HorizontalBox {
                        padding: 12px;
                        spacing: 12px;
                        Text { text: "🔄"; color: #0284c7; }
                        Text {
                            text: current_step == 0 ? "Standalone Automatic Worker -> Local Business Memory" :
                                  current_step == 1 ? "Automatic Sync Task -> Local Business Memory" :
                                  current_step == 2 ? "Local Business Memory -> Automatic Sync Task" :
                                  current_step == 3 ? "Automatic Sync Task -> Global Cloud Server" :
                                  current_step == 4 ? "Global Cloud Server -> Global Cloud Server" :
                                  current_step == 5 ? "Global Cloud Server -> Automatic Sync Task" :
                                  "Automatic Sync Task -> Local Business Memory";
                            color: #0284c7;
                            wrap: word-wrap;
                        }
                    }
                }
                
                HorizontalBox {
                    alignment: center;
                    spacing: 20px;
                    
                    Button {
                        text: "Previous Step";
                        enabled: current_step > 0;
                        clicked => { current_step = current_step - 1; }
                    }
                    
                    Text {
                        text: "Step " + (current_step + 1) + " of 7";
                        color: #9ca3af;
                        horizontal-alignment: center;
                    }
                    
                    Button {
                        text: "Next Step";
                        enabled: current_step < 6;
                        clicked => { current_step = current_step + 1; }
                    }
                }
            }
        }
    }
}
