import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Walkthrough inherits Window {
    width: 600px;
    height: 500px;
    title: "Automatic Tasks Sync Walkthrough";

    property <int> current_step: 0;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;
        alignment: center;

        Text { text: "Interactive Guide: Sync Lifecycle"; font-size: 24px; font-weight: 700; color: #1e293b; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 16px;
            width: 500px;
            
            VerticalBox {
                padding: 32px;
                spacing: 16px;
                
                Text {
                    text: current_step == 0 ? "1. Generate & Insert Data" :
                          current_step == 1 ? "2. Query Pending Data" :
                          current_step == 2 ? "3. Return Batched Data" :
                          current_step == 3 ? "4. Secure Push" :
                          current_step == 4 ? "5. Save to Cloud" :
                          current_step == 5 ? "6. Acknowledge Success" :
                          "7. Update sync_status";
                    font-size: 20px;
                    font-weight: 700;
                    color: #0284c7;
                }
                
                Text {
                    text: current_step == 0 ? "Worker generates business data and inserts it into Local Storage with status='waiting'." :
                          current_step == 1 ? "Sync Tool periodically queries the Local Storage for any data pending synchronization." :
                          current_step == 2 ? "Local Storage returns the pending business data in a batch format to the Sync Tool." :
                          current_step == 3 ? "Sync Tool securely pushes the batched data to the Cloud Server." :
                          current_step == 4 ? "Cloud Server upserts the received data into the Global Cloud Storage." :
                          current_step == 5 ? "Cloud Server sends an acknowledgment of successful storage back to the Sync Tool." :
                          "Sync Tool updates the local records, marking them as status='complete'.";
                    color: #1e293b;
                    wrap: word-wrap;
                }
                
                Rectangle {
                    background: #f1f5f9;
                    border-radius: 8px;
                    
                    HorizontalBox {
                        padding: 12px;
                        spacing: 12px;
                        Text { text: "🔄"; color: #0284c7; }
                        Text {
                            text: current_step == 0 ? "Local Task Worker -> Local Storage" :
                                  current_step == 1 ? "Sync Tool -> Local Storage" :
                                  current_step == 2 ? "Local Storage -> Sync Tool" :
                                  current_step == 3 ? "Sync Tool -> Cloud Server" :
                                  current_step == 4 ? "Cloud Server -> Cloud Storage" :
                                  current_step == 5 ? "Cloud Server -> Sync Tool" :
                                  "Sync Tool -> Local Storage";
                            color: #0284c7;
                            wrap: word-wrap;
                        }
                    }
                }
                
                HorizontalBox {
                    alignment: center;
                    spacing: 20px;
                    
                    Button {
                        text: "Previous Step";
                        enabled: current_step > 0;
                        clicked => { current_step = current_step - 1; }
                    }
                    
                    Text {
                        text: "Step " + (current_step + 1) + " of 7";
                        color: #9ca3af;
                        horizontal-alignment: center;
                    }
                    
                    Button {
                        text: "Next Step";
                        enabled: current_step < 6;
                        clicked => { current_step = current_step + 1; }
                    }
                }
            }
        }
    }
}
