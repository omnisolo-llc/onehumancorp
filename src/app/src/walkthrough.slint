import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Walkthrough inherits Window {
    width: 600px;
    height: 500px;
    title: "Automatic Tasks Sync Walkthrough";

    property <int> current_step: 0;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;
        alignment: center;

        Text { text: "Interactive Guide: How your tasks are saved"; font-size: 24px; font-weight: 700; color: #1e293b; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 16px;
            width: 500px;
            
            VerticalBox {
                padding: 32px;
                spacing: 16px;
                
                Text {
                    text: current_step == 0 ? "1. Save task details locally" :
                          current_step == 1 ? "2. Check for unsynced tasks" :
                          current_step == 2 ? "3. Prepare tasks for upload" :
                          current_step == 3 ? "4. Securely upload to the cloud" :
                          current_step == 4 ? "5. Save to your secure account" :
                          current_step == 5 ? "6. Confirm everything is saved" :
                          "7. Mark tasks as synced";
                    font-size: 20px;
                    font-weight: 700;
                    color: #0284c7;
                }
                
                Text {
                    text: current_step == 0 ? "Your app saves new task details to your phone so they are never lost." :
                          current_step == 1 ? "The app checks your phone for tasks that need to be backed up to the cloud." :
                          current_step == 2 ? "The app gathers all unsynced tasks together so they can be uploaded at once." :
                          current_step == 3 ? "The app securely sends your tasks over a protected connection to our servers." :
                          current_step == 4 ? "Our servers safely store your tasks in your secure account." :
                          current_step == 5 ? "Our servers send a confirmation message back to your phone." :
                          "Your app marks the tasks as successfully backed up.";
                    color: #1e293b;
                    wrap: word-wrap;
                }
                
                Rectangle {
                    background: #f1f5f9;
                    border-radius: 8px;
                    
                    HorizontalBox {
                        padding: 12px;
                        spacing: 12px;
                        Text { text: "🔄"; color: #0284c7; }
                        Text {
                            text: current_step == 0 ? "App -> Phone Storage" :
                                  current_step == 1 ? "Background Process -> Phone Storage" :
                                  current_step == 2 ? "Phone Storage -> Background Process" :
                                  current_step == 3 ? "Background Process -> Cloud Servers" :
                                  current_step == 4 ? "Cloud Servers -> Secure Account" :
                                  current_step == 5 ? "Cloud Servers -> Background Process" :
                                  "Background Process -> Phone Storage";
                            color: #0284c7;
                            wrap: word-wrap;
                        }
                    }
                }
                
                HorizontalBox {
                    alignment: center;
                    spacing: 20px;
                    
                    Button {
                        text: "Previous Step";
                        enabled: current_step > 0;
                        clicked => { current_step = current_step - 1; }
                    }
                    
                    Text {
                        text: "Step " + (current_step + 1) + " of 7";
                        color: #9ca3af;
                        horizontal-alignment: center;
                    }
                    
                    Button {
                        text: "Next Step";
                        enabled: current_step < 6;
                        clicked => { current_step = current_step + 1; }
                    }
                }
            }
        }
    }
}
