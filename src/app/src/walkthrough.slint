import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Walkthrough inherits Window {
    width: 600px;
    height: 500px;
    title: "Automatic Tasks Sync Walkthrough";

    property <int> current_step: 0;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;
        alignment: center;

        Text { text: "Interactive Guide: Sync Lifecycle"; font-size: 24px; font-weight: 700; color: #1e293b; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 16px;
            width: 500px;
            
            VerticalBox {
                padding: 32px;
                spacing: 16px;
                
                Text {
                    text: current_step == 0 ? "1. Generate & Insert learning piece" :
                          current_step == 1 ? "2. Query Pending learning pieces" :
                          current_step == 2 ? "3. Return grouped learning pieces" :
                          current_step == 3 ? "4. Push securely" :
                          current_step == 4 ? "5. Save to Global Memory" :
                          current_step == 5 ? "6. Acknowledge Success" :
                          "7. Update status";
                    font-size: 20px;
                    font-weight: 700;
                    color: #0284c7;
                }
                
                Text {
                    text: current_step == 0 ? "Worker generates a business learning piece and inserts it into Local App Data with status='waiting to sync'." :
                          current_step == 1 ? "Background Helper periodically queries the Local App Data for any learning pieces pending synchronization." :
                          current_step == 2 ? "Local App Data returns the pending business learning pieces in a batch format to the Background Helper." :
                          current_step == 3 ? "Background Helper securely pushes the grouped learning pieces to the Cloud Hub using secure encrypted connection." :
                          current_step == 4 ? "Cloud Hub saves the received learning pieces into the Global Business Memory." :
                          current_step == 5 ? "Cloud Hub sends an acknowledgment of successful storage back to the Background Helper." :
                          "Background Helper updates the local records, marking them as status='synced'.";
                    color: #1e293b;
                    wrap: word-wrap;
                }
                
                Rectangle {
                    background: #f1f5f9;
                    border-radius: 8px;
                    
                    HorizontalBox {
                        padding: 12px;
                        spacing: 12px;
                        Text { text: "🔄"; color: #0284c7; }
                        Text {
                            text: current_step == 0 ? "Standalone Automatic Tasks Worker -> Local App Data" :
                                  current_step == 1 ? "Background Helper -> Local App Data" :
                                  current_step == 2 ? "Local App Data -> Background Helper" :
                                  current_step == 3 ? "Background Helper -> Cloud Hub" :
                                  current_step == 4 ? "Cloud Hub -> Global Business Database" :
                                  current_step == 5 ? "Cloud Hub -> Background Helper" :
                                  "Background Helper -> Local App Data";
                            color: #0284c7;
                            wrap: word-wrap;
                        }
                    }
                }
                
                HorizontalBox {
                    alignment: center;
                    spacing: 20px;
                    
                    Button {
                        text: "Previous Step";
                        enabled: current_step > 0;
                        clicked => { current_step = current_step - 1; }
                    }
                    
                    Text {
                        text: "Step " + (current_step + 1) + " of 7";
                        color: #9ca3af;
                        horizontal-alignment: center;
                    }
                    
                    Button {
                        text: "Next Step";
                        enabled: current_step < 6;
                        clicked => { current_step = current_step + 1; }
                    }
                }
            }
        }
    }
}
