import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Walkthrough inherits Window {
    width: 600px;
    height: 500px;
    title: "AutoDream Sync Walkthrough";

    property <int> current_step: 0;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;
        alignment: center;

        Text { text: "Interactive Guide: How Your AI Remembers"; font-size: 24px; font-weight: 700; color: #1e293b; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 16px;
            width: 500px;
            
            VerticalBox {
                padding: 32px;
                spacing: 16px;
                
                Text {
                    text: current_step == 0 ? "1. Learn a New Detail" :
                          current_step == 1 ? "2. Check for New Memories" :
                          current_step == 2 ? "3. Gather New Memories" :
                          current_step == 3 ? "4. Securely Upload to the Cloud" :
                          current_step == 4 ? "5. Store in Global Memory" :
                          current_step == 5 ? "6. Confirm Safe Storage" :
                          "7. Mark as Saved";
                    font-size: 20px;
                    font-weight: 700;
                    color: #0284c7;
                }
                
                Text {
                    text: current_step == 0 ? "Your AutoDreamWorker learns a new detail and safely writes it down on your device." :
                          current_step == 1 ? "The background helper periodically checks your device for new memories that need to be backed up." :
                          current_step == 2 ? "Your device gathers all the recent memories together so the helper can upload them." :
                          current_step == 3 ? "The background helper securely uploads these memories to the cloud." :
                          current_step == 4 ? "The cloud carefully organizes and files away the new memories." :
                          current_step == 5 ? "The cloud confirms back to your device that everything was saved safely." :
                          "Your device marks the memories as safely backed up, finishing the process.";
                    color: #1e293b;
                    wrap: word-wrap;
                }
                
                Rectangle {
                    background: #f1f5f9;
                    border-radius: 8px;
                    
                    HorizontalBox {
                        padding: 12px;
                        spacing: 12px;
                        Text { text: "🔄"; color: #0284c7; }
                        Text {
                            text: current_step == 0 ? "AutoDreamWorker -> Your Device" :
                                  current_step == 1 ? "Background Helper -> Your Device" :
                                  current_step == 2 ? "Your Device -> Background Helper" :
                                  current_step == 3 ? "Background Helper -> Cloud" :
                                  current_step == 4 ? "Cloud -> Global Memory" :
                                  current_step == 5 ? "Cloud -> Background Helper" :
                                  "Background Helper -> Your Device";
                            color: #0284c7;
                            wrap: word-wrap;
                        }
                    }
                }
                
                HorizontalBox {
                    alignment: center;
                    spacing: 20px;
                    
                    Button {
                        text: "Previous Step";
                        enabled: current_step > 0;
                        clicked => { current_step = current_step - 1; }
                    }
                    
                    Text {
                        text: "Step " + (current_step + 1) + " of 7";
                        color: #9ca3af;
                        horizontal-alignment: center;
                    }
                    
                    Button {
                        text: "Next Step";
                        enabled: current_step < 6;
                        clicked => { current_step = current_step + 1; }
                    }
                }
            }
        }
    }
}
