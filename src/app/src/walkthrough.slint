import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Walkthrough inherits Window {
    width: 600px;
    height: 500px;
    title: "Automated Goals Sync Guide";

    property <int> current_step: 0;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;
        alignment: center;

        Text { text: "Interactive Guide: Sync Lifecycle"; font-size: 24px; font-weight: 700; color: #1e293b; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 16px;
            width: 500px;
            
            VerticalBox {
                padding: 32px;
                spacing: 16px;
                
                Text {
                    text: current_step == 0 ? "1. Generate & Save Memory" :
                          current_step == 1 ? "2. Check Unsaved Memories" :
                          current_step == 2 ? "3. Return Unsaved Memories" :
                          current_step == 3 ? "4. Secure Cloud Backup" :
                          current_step == 4 ? "5. Save to Cloud" :
                          current_step == 5 ? "6. Acknowledge Success" :
                          "7. Mark as Saved";
                    font-size: 20px;
                    font-weight: 700;
                    color: #0284c7;
                }
                
                Text {
                    text: current_step == 0 ? "Worker creates a memory piece and saves it locally as unsaved." :
                          current_step == 1 ? "System periodically checks locally for any unsaved memory pieces." :
                          current_step == 2 ? "Local storage returns the unsaved memory pieces together to the system." :
                          current_step == 3 ? "System securely backs up grouped memories to the cloud." :
                          current_step == 4 ? "Cloud receives and saves the memories for your business." :
                          current_step == 5 ? "Cloud confirms the memories are safely stored." :
                          "System updates the local records, marking them as saved.";
                    color: #1e293b;
                    wrap: word-wrap;
                }
                
                Rectangle {
                    background: #f1f5f9;
                    border-radius: 8px;
                    
                    HorizontalBox {
                        padding: 12px;
                        spacing: 12px;
                        Text { text: "🔄"; color: #0284c7; }
                        Text {
                            text: current_step == 0 ? "AutomatedGoalWorker -> Local Storage" :
                                  current_step == 1 ? "System -> Local Storage" :
                                  current_step == 2 ? "Local Storage -> System" :
                                  current_step == 3 ? "System -> Cloud Backup" :
                                  current_step == 4 ? "Cloud Backup -> Database" :
                                  current_step == 5 ? "Cloud Backup -> System" :
                                  "System -> Local Storage";
                            color: #0284c7;
                            wrap: word-wrap;
                        }
                    }
                }
                
                HorizontalBox {
                    alignment: center;
                    spacing: 20px;
                    
                    Button {
                        text: "Previous Step";
                        enabled: current_step > 0;
                        clicked => { current_step = current_step - 1; }
                    }
                    
                    Text {
                        text: "Step " + (current_step + 1) + " of 7";
                        color: #9ca3af;
                        horizontal-alignment: center;
                    }
                    
                    Button {
                        text: "Next Step";
                        enabled: current_step < 6;
                        clicked => { current_step = current_step + 1; }
                    }
                }
            }
        }
    }
}
