import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Walkthrough inherits Window {
    width: 600px;
    height: 500px;
    title: "Automatic Backup Guide";

    property <int> current_step: 0;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;
        alignment: center;

        Text { text: "Interactive Guide: Backup Process"; font-size: 24px; font-weight: 700; color: #1e293b; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 16px;
            width: 500px;
            
            VerticalBox {
                padding: 32px;
                spacing: 16px;
                
                Text {
                    text: current_step == 0 ? "1. Save New Information" :
                          current_step == 1 ? "2. Check for Unsaved Changes" :
                          current_step == 2 ? "3. Gather New Information" :
                          current_step == 3 ? "4. Securely Upload to Cloud" :
                          current_step == 4 ? "5. Save to Global Storage" :
                          current_step == 5 ? "6. Confirm Successful Save" :
                          "7. Mark as Saved Locally";
                    font-size: 20px;
                    font-weight: 700;
                    color: #0284c7;
                }
                
                Text {
                    text: current_step == 0 ? "The Assistant learns new information and saves it securely on your device, marking it as ready for backup." :
                          current_step == 1 ? "The Background Backup System automatically checks your device for any new information that needs to be backed up." :
                          current_step == 2 ? "Your device gathers all the new information and prepares it for the backup process." :
                          current_step == 3 ? "The Backup System securely uploads your new information to the cloud, ensuring only authorized access." :
                          current_step == 4 ? "The Cloud System safely stores your new information in your global account so it can be accessed from anywhere." :
                          current_step == 5 ? "The Cloud System confirms that your information was successfully and securely saved." :
                          "The Backup System updates your device, noting that the information is safely backed up.";
                    color: #1e293b;
                    wrap: word-wrap;
                }
                
                Rectangle {
                    background: #f1f5f9;
                    border-radius: 8px;
                    
                    HorizontalBox {
                        padding: 12px;
                        spacing: 12px;
                        Text { text: "🔄"; color: #0284c7; }
                        Text {
                            text: current_step == 0 ? "Assistant -> Your Device" :
                                  current_step == 1 ? "Backup System -> Your Device" :
                                  current_step == 2 ? "Your Device -> Backup System" :
                                  current_step == 3 ? "Backup System -> Cloud System" :
                                  current_step == 4 ? "Cloud System -> Global Storage" :
                                  current_step == 5 ? "Cloud System -> Backup System" :
                                  "Backup System -> Your Device";
                            color: #0284c7;
                            wrap: word-wrap;
                        }
                    }
                }
                
                HorizontalBox {
                    alignment: center;
                    spacing: 20px;
                    
                    Button {
                        text: "Previous Step";
                        enabled: current_step > 0;
                        clicked => { current_step = current_step - 1; }
                    }
                    
                    Text {
                        text: "Step " + (current_step + 1) + " of 7";
                        color: #9ca3af;
                        horizontal-alignment: center;
                    }
                    
                    Button {
                        text: "Next Step";
                        enabled: current_step < 6;
                        clicked => { current_step = current_step + 1; }
                    }
                }
            }
        }
    }
}
