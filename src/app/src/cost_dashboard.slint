                    }
                    Rectangle {
                        height: 8px;
                        background: #e2e8f0;
                        border-radius: 4px;
                        HorizontalBox {
                            alignment: start;
                            Rectangle { width: 100px; background: #a855f7; border-radius: 4px; }
                        }
                    }
                }
                VerticalBox {
                    spacing: 4px;
                    HorizontalBox {
                        Text { text: "Bob (SWE)"; color: #1e293b; }
