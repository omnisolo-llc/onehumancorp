                        Text { text: "$74.50"; color: #1e293b; }
                    }
                    Rectangle {
                        height: 8px;
                        background: #e2e8f0;
                        border-radius: 4px;
                        HorizontalBox {
                            alignment: start;
                            Rectangle { width: 150px; background: #06b6d4; border-radius: 4px; }
                        }
                    }
                }
            }
