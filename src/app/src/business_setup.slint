import { Button, VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component BusinessSetup inherits Window {
    width: 600px;
    height: 600px;
    title: "Business Setup";

    in-out property <int> step: 0;
    in-out property <string> business_type: "";
    in-out property <string> company_name: "";
    in-out property <string> products_services: "";
    in-out property <string> payment_pref: "stripe";
    in-out property <string> template_id: "modern";
    in-out property <string> first_product_name: "";
    in-out property <string> first_product_desc: "";
    in-out property <string> first_product_price: "";
    in-out property <string> domain_name: "";

    callback launch();

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        alignment: center;
        spacing: 20px;
        padding: 32px;

        GlassCard {
            VerticalBox {
                spacing: 20px;
                padding: 24px;

                Text {
                    text: "Business Setup";
                    font-size: 28px;
                    font-weight: 700;
                    color: white;
                    font-family: "Outfit";
                    horizontal-alignment: center;
                }

                // Step 0: Welcome
                if (step == 0) : VerticalBox {
                    spacing: 16px;
                    Text {
                        text: "Welcome! Your AI team, ready in minutes.";
                        color: #a8b2c1;
                        font-family: "Inter";
                        horizontal-alignment: center;
                    }
                }

                // Step 1: Type & Name
                if (step == 1) : VerticalBox {
                    spacing: 16px;
                    LineEdit {
                        placeholder-text: "Business Type (e.g. Baker, Handyman)";
                        text <=> business_type;
                        height: 44px;
                    }
                    LineEdit {
                        placeholder-text: "Company Name";
                        text <=> company_name;
                        height: 44px;
                    }
                }

                // Step 2: Products & Payment
                if (step == 2) : VerticalBox {
                    spacing: 16px;
                    LineEdit {
                        placeholder-text: "What do you sell?";
                        text <=> products_services;
                        height: 44px;
                    }
                    Text {
                        text: "Payment Preference: " + payment_pref;
                        color: white;
                        font-family: "Inter";
                    }
                    HorizontalBox {
                        spacing: 10px;
                        Button { text: "Stripe"; height: 44px; clicked => { payment_pref = "stripe"; } }
                        Button { text: "PayPal"; height: 44px; clicked => { payment_pref = "paypal"; } }
                    }
                }

                // Step 3: Template
                if (step == 3) : VerticalBox {
                    spacing: 16px;
                    Text {
                        text: "Template Selection: " + template_id;
                        color: white;
                        font-family: "Inter";
                    }
                    HorizontalBox {
                        spacing: 10px;
                        Button { text: "Modern"; height: 44px; clicked => { template_id = "modern"; } }
                        Button { text: "Classic"; height: 44px; clicked => { template_id = "classic"; } }
                        Button { text: "Bold"; height: 44px; clicked => { template_id = "bold"; } }
                    }
                }

                // Step 4: First Product
                if (step == 4) : VerticalBox {
                    spacing: 16px;
                    LineEdit { placeholder-text: "First Product Name"; text <=> first_product_name; height: 44px; }
                    LineEdit { placeholder-text: "Product Description"; text <=> first_product_desc; height: 44px; }
                    LineEdit { placeholder-text: "Price"; text <=> first_product_price; height: 44px; }
                }

                // Step 5: Domain
                if (step == 5) : VerticalBox {
                    spacing: 16px;
                    HorizontalBox {
                        spacing: 10px;
                        LineEdit { placeholder-text: "Domain Name"; text <=> domain_name; height: 44px; }
                        Text { text: ".ohc.app"; color: #a8b2c1; horizontal-alignment: center; vertical-alignment: center; font-family: "Inter"; }
                    }
                }

                Rectangle {} // Spacer

                // Navigation
                HorizontalBox {
                    spacing: 10px;
                    if (step > 0) : Button {
                        text: "Back";
                        height: 44px;
                        clicked => { step = step - 1; }
                    }
                    Rectangle {} // Spacer
                    Button {
                        text: step == 5 ? "Launch My AI Team" : "Next";
                        height: 44px;
                        clicked => {
                            if (step < 5) {
                                step = step + 1;
                            } else {
                                launch();
                            }
                        }
                    }
                }
            }
        }
    }
}
