import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export component BusinessSetup inherits Window {
    width: 375px;
    height: 812px;
    title: "Business Setup";
    background: #f8fafc;

    in-out property <int> step: 0;

    // Business Type
    in-out property <string> business_type: "";
    // Name & Desc
    in-out property <string> company_name: "";
    in-out property <string> company_desc: "";
    // Sell Multi-select (comma separated for simplicity in mock)
    in-out property <string> what_to_sell: "";
    // Payment
    in-out property <string> payment_pref: "";
    // Admin
    in-out property <string> admin_name: "";
    in-out property <string> admin_email: "";
    in-out property <string> admin_password: "";

    callback launch();

    ScrollView {
        VerticalBox {
            padding: 24px;
            spacing: 24px;

            Text {
                text: "Business Setup";
                font-size: 24px;
                font-weight: 700;
                color: #1e293b;
                horizontal-alignment: center;
            }

            // Step 0: Welcome
            if (step == 0) : VerticalBox {
                spacing: 16px;
                Text {
                    text: "Your business, live in minutes.";
                    font-size: 20px;
                    font-weight: 600;
                    color: #3b82f6;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: "Our AI team will build everything for you. Let's get started.";
                    font-size: 16px;
                    color: #64748b;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Step 1: Business Type
            if (step == 1) : VerticalBox {
                spacing: 16px;
                Text { text: "What kind of business?"; font-size: 18px; font-weight: 600; color: #1e293b; }

                Button { text: "Online Store"; clicked => { business_type = "Online Store"; } }
                Button { text: "Service Business"; clicked => { business_type = "Service Business"; } }
                Button { text: "Restaurant / Food"; clicked => { business_type = "Restaurant / Food"; } }
                Button { text: "Creative / Portfolio"; clicked => { business_type = "Creative / Portfolio"; } }
                Button { text: "Local Business"; clicked => { business_type = "Local Business"; } }
                Button { text: "Other"; clicked => { business_type = "Other"; } }

                Text { text: "Selected: " + business_type; color: #3b82f6; font-weight: 600; }
            }

            // Step 2: Name & Description
            if (step == 2) : VerticalBox {
                spacing: 16px;
                Text { text: "Tell us about it"; font-size: 18px; font-weight: 600; color: #1e293b; }
                LineEdit { placeholder-text: "Business Name"; text <=> company_name; }
                LineEdit { placeholder-text: "Short Description"; text <=> company_desc; }
                Text { text: "AI can refine this later!"; color: #64748b; font-size: 12px; }
            }

            // Step 3: What do you sell?
            if (step == 3) : VerticalBox {
                spacing: 16px;
                Text { text: "What do you sell?"; font-size: 18px; font-weight: 600; color: #1e293b; }
                Button { text: "Physical products"; clicked => { what_to_sell += (what_to_sell == "" ? "" : ", ") + "Physical products"; } }
                Button { text: "Digital downloads"; clicked => { what_to_sell += (what_to_sell == "" ? "" : ", ") + "Digital downloads"; } }
                Button { text: "Services / appointments"; clicked => { what_to_sell += (what_to_sell == "" ? "" : ", ") + "Services / appointments"; } }
                Button { text: "Food & beverages"; clicked => { what_to_sell += (what_to_sell == "" ? "" : ", ") + "Food & beverages"; } }
                Button { text: "Subscriptions"; clicked => { what_to_sell += (what_to_sell == "" ? "" : ", ") + "Subscriptions"; } }
                Text { text: "Selected: " + what_to_sell; color: #3b82f6; font-weight: 600; wrap: word-wrap; }
                Button { text: "Clear Selection"; clicked => { what_to_sell = ""; } }
            }

            // Step 4: Payments
            if (step == 4) : VerticalBox {
                spacing: 16px;
                Text { text: "How to get paid?"; font-size: 18px; font-weight: 600; color: #1e293b; }
                Button { text: "Online only (Stripe)"; clicked => { payment_pref = "Online only"; } }
                Button { text: "In-person (POS)"; clicked => { payment_pref = "In-person (POS)"; } }
                Button { text: "Both"; clicked => { payment_pref = "Both"; } }
                Button { text: "Skip for now"; clicked => { payment_pref = "Skip for now"; } }
                Text { text: "Selected: " + payment_pref; color: #3b82f6; font-weight: 600; }
            }

            // Step 5: Administrator
            if (step == 5) : VerticalBox {
                spacing: 16px;
                Text { text: "Create Admin Account"; font-size: 18px; font-weight: 600; color: #1e293b; }
                LineEdit { placeholder-text: "Your Name"; text <=> admin_name; }
                LineEdit { placeholder-text: "Email Address"; text <=> admin_email; }
                LineEdit { placeholder-text: "Password"; input-type: password; text <=> admin_password; }
            }

            // Step 6: Review & Launch
            if (step == 6) : VerticalBox {
                spacing: 16px;
                Text { text: "Review & Launch"; font-size: 18px; font-weight: 600; color: #1e293b; }
                Text { text: "Name: " + company_name; color: #64748b; }
                Text { text: "Type: " + business_type; color: #64748b; }
                Text { text: "Selling: " + what_to_sell; color: #64748b; wrap: word-wrap; }
                Text { text: "Payments: " + payment_pref; color: #64748b; }
            }

            Rectangle { height: 20px; } // Spacer

            // Navigation
            HorizontalBox {
                if (step > 0) : Button {
                    text: "Back";
                    clicked => { step = step - 1; }
                }
                Rectangle {} // Flexible Spacer
                Button {
                    text: step == 6 ? "Launch My Business ->" : "Next";
                    // Only allow next if valid in some steps
                    enabled:
                        (step == 0) ||
                        (step == 1 && business_type != "") ||
                        (step == 2 && company_name != "") ||
                        (step == 3 && what_to_sell != "") ||
                        (step == 4 && payment_pref != "") ||
                        (step == 5 && admin_name != "" && admin_email != "" && admin_password != "") ||
                        (step == 6);
                    clicked => {
                        if (step < 6) {
                            step = step + 1;
                        } else {
                            launch();
                        }
                    }
                }
            }
        }
    }
}
