import { Button, VerticalBox, HorizontalBox, LineEdit, CheckBox } from "std-widgets.slint";

export component BusinessSetup inherits Window {
    width: 600px;
    height: 500px;
    title: "Business Setup";

    in-out property <int> step: 0;

    // Properties for all steps
    in-out property <string> business_type: "";

    in-out property <string> company_name: "";
    in-out property <string> company_description: "";

    in-out property <bool> sells_physical: false;
    in-out property <bool> sells_digital: false;
    in-out property <bool> sells_services: false;
    in-out property <bool> sells_food: false;
    in-out property <bool> sells_subscriptions: false;

    in-out property <string> payment_pref: "";

    in-out property <string> admin_name: "";
    in-out property <string> admin_email: "";
    in-out property <string> admin_password: "";

    callback launch();

    // Glassmorphism UI approximation for std-widgets
    background: #ffffff;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        Text { text: "Business Setup"; font-size: 24px; font-weight: 700; color: #1e293b; }

        // Step 0: Welcome
        if (step == 0) : VerticalBox {
            spacing: 10px;
            Text { text: "Welcome!"; font-size: 32px; font-weight: 700; color: #1e293b; }
            Text { text: "Your business, live in minutes."; font-size: 18px; color: #64748b; }
        }

        // Step 1: Type
        if (step == 1) : VerticalBox {
            spacing: 10px;
            Text { text: "What kind of business are you building?"; color: #1e293b; }
            HorizontalBox {
                spacing: 10px;
                Button { text: "🛒 Online Store"; clicked => { business_type = "Online Store"; step = step + 1; } }
                Button { text: "🔧 Service Business"; clicked => { business_type = "Service Business"; step = step + 1; } }
                Button { text: "🍔 Restaurant / Food"; clicked => { business_type = "Restaurant / Food"; step = step + 1; } }
            }
            HorizontalBox {
                spacing: 10px;
                Button { text: "🎨 Creative / Portfolio"; clicked => { business_type = "Creative / Portfolio"; step = step + 1; } }
                Button { text: "🏪 Local Business"; clicked => { business_type = "Local Business"; step = step + 1; } }
                Button { text: "✨ Other"; clicked => { business_type = "Other"; step = step + 1; } }
            }
            Text { text: "Selected: " + business_type; color: #a855f7; }
        }

        // Step 2: Name & Description
        if (step == 2) : VerticalBox {
            spacing: 10px;
            Text { text: "Tell us about " + business_type; color: #1e293b; }
            LineEdit {
                placeholder-text: "Company Name";
                text <=> company_name;
            }
            LineEdit {
                placeholder-text: "Company Description (AI will auto-suggest if blank)";
                text <=> company_description;
            }
        }

        // Step 3: What do you sell?
        if (step == 3) : VerticalBox {
            spacing: 10px;
            Text { text: "What do you sell?"; color: #1e293b; }

            CheckBox { text: "Physical products"; checked <=> sells_physical; }
            CheckBox { text: "Digital downloads"; checked <=> sells_digital; }
            CheckBox { text: "Services / appointments"; checked <=> sells_services; }
            CheckBox { text: "Food & beverages"; checked <=> sells_food; }
            CheckBox { text: "Subscriptions"; checked <=> sells_subscriptions; }
        }

        // Step 4: Payments
        if (step == 4) : VerticalBox {
            spacing: 10px;
            Text { text: "How do you want to receive payments?"; color: #1e293b; }

            HorizontalBox {
                spacing: 10px;
                Button { text: "Online only\n(~2 mins setup)"; clicked => { payment_pref = "Online only"; step = step + 1; } }
                Button { text: "In-person (POS)\n(~5 mins setup)"; clicked => { payment_pref = "In-person (POS)"; step = step + 1; } }
            }
            HorizontalBox {
                spacing: 10px;
                Button { text: "Both\n(~5 mins setup)"; clicked => { payment_pref = "Both"; step = step + 1; } }
                Button { text: "Skip for now"; clicked => { payment_pref = "Skip for now"; step = step + 1; } }
            }
            Text { text: "Selected: " + payment_pref; color: #a855f7; }
        }

        // Step 5: Administrator account
        if (step == 5) : VerticalBox {
            spacing: 10px;
            Text { text: "Create Administrator Account"; color: #1e293b; }

            LineEdit { placeholder-text: "Name"; text <=> admin_name; }
            LineEdit { placeholder-text: "Email"; text <=> admin_email; }
            LineEdit { placeholder-text: "Password"; text <=> admin_password; input-type: password; }

            Text { text: "OR"; horizontal-alignment: center; color: #64748b; }

            Button { text: "Sign in with Google / Apple"; }
        }

        // Step 6: Review & Launch
        if (step == 6) : VerticalBox {
            spacing: 10px;
            Text { text: "Review & Launch"; font-size: 20px; font-weight: 700; color: #1e293b; }

            Rectangle {
                background: #f8fafc;
                border-radius: 8px;
                border-width: 1px;
                border-color: #e2e8f0;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "Business: " + company_name + " (" + business_type + ")"; color: #1e293b; }
                    Text { text: "Admin: " + admin_name + " (" + admin_email + ")"; color: #1e293b; }
                    Text { text: "Payments: " + payment_pref; color: #1e293b; }
                }
            }

            Text { text: "Your AI agents are ready to set up your store, design your website, and configure your payment processing."; color: #64748b; wrap: word-wrap; }
        }

        Rectangle {} // Spacer

        // Navigation
        HorizontalBox {
            if (step > 0 && step != 1 && step != 4) : Button {
                text: "Back";
                clicked => { step = step - 1; }
            }
            if (step == 1 || step == 4) : Button {
                text: "Back";
                clicked => { step = step - 1; }
            }
            Rectangle {} // Spacer
            if (step != 1 && step != 4) : Button {
                text: step == 6 ? "Launch My Business ->" : "Next";
                clicked => {
                    if (step < 6) {
                        step = step + 1;
                    } else {
                        launch();
                    }
                }
            }
        }
    }
}
