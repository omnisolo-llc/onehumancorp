import { Button, VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";

export component BusinessSetup inherits Window {
    width: 375px;
    height: 812px;
    title: "Start Business";

    in-out property <int> step: 0;
    in-out property <string> business_type: "";
    in-out property <string> company_name: "";

    callback launch();

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;
        alignment: center;

        // Step 0: Welcome / The Promise Landing
        if (step == 0) : VerticalBox {
            spacing: 24px;
            alignment: center;

            Text {
                text: "Launch your business in 5 minutes";
                font-size: 28px;
                font-weight: 700;
                color: #1e293b;
                horizontal-alignment: center;
                wrap: word-wrap;
                font-family: "Outfit";
            }
            Text {
                text: "No code. No servers. No jargon.";
                font-size: 16px;
                color: #64748b;
                horizontal-alignment: center;
                font-family: "Inter";
            }
            Rectangle {
                height: 40px;
            }
            Button {
                text: "Start Business";
                height: 44px;
                clicked => { step = 1; }
            }
        }

        // Step 1: Type & Name
        if (step == 1) : VerticalBox {
            spacing: 24px;
            alignment: start;

            Text { text: "What do you sell?"; font-size: 24px; font-weight: 700; color: #1e293b; font-family: "Outfit"; }

            LineEdit {
                placeholder-text: "Products / Services / Food";
                text <=> business_type;
                height: 44px;
                font-family: "Inter";
                font-size: 16px;
            }

            Text { text: "What's your business name?"; font-size: 24px; font-weight: 700; color: #1e293b; font-family: "Outfit"; }

            LineEdit {
                placeholder-text: "Company Name";
                text <=> company_name;
                height: 44px;
                font-family: "Inter";
                font-size: 16px;
            }

            Rectangle { height: 20px; }

            HorizontalBox {
                Button {
                    text: "Back";
                    height: 44px;
                    clicked => { step = 0; }
                }
                Rectangle {}
                Button {
                    text: "Next";
                    height: 44px;
                    clicked => { step = 2; }
                }
            }
        }

        // Step 2: AI Magic State
        if (step == 2) : VerticalBox {
            spacing: 24px;
            alignment: center;

            Text {
                text: "✨";
                font-size: 64px;
                horizontal-alignment: center;
            }
            Text {
                text: "The Promoter is designing your storefront...";
                font-size: 20px;
                font-weight: 700;
                color: #a855f7;
                horizontal-alignment: center;
                wrap: word-wrap;
                font-family: "Outfit";
            }

            Rectangle { height: 40px; }

            Button {
                text: "Continue to Dashboard";
                height: 44px;
                clicked => { launch(); }
            }
        }
    }
}
