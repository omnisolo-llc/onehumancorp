    width: 375px; // mobile-first
    height: 812px;
    background: #f8fafc;

    VerticalBox {
        padding: 20px;
        spacing: 15px;
        Text { text: "Help Center"; font-size: 24px; font-weight: 700; color: #1e293b; }
