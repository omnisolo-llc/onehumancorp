                Text { text: "Payments"; font-size: 18px; font-weight: 600; color: #334155; }
                Text { text: "AI Agents"; font-size: 18px; font-weight: 600; color: #334155; }
                Text { text: "Marketing"; font-size: 18px; font-weight: 600; color: #334155; }
                Text { text: "Account & Billing"; font-size: 18px; font-weight: 600; color: #334155; }
            }
