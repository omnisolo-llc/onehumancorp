import { Button, VerticalBox, HorizontalBox, CheckBox, LineEdit } from "std-widgets.slint";

export component GrowBusiness inherits Window {
    width: 500px;
    height: 500px;
    title: "Grow My Business";

    in-out property <int> step: 0;
    in-out property <string> selected_strategy: "";
    in-out property <bool> is_advanced: false;
    callback execute(string);

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Growth Strategies"; font-size: 24px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            CheckBox {
                text: "Expert Mode";
                checked: is_advanced;
                toggled => { is_advanced = !is_advanced; }
            }
        }

        // Step 0: Select Strategy
        if (step == 0) : VerticalBox {
            spacing: 10px;
            Text { text: "Select a next step to grow your business"; color: #1e293b; }
            
            Button { text: "Add 5 more products"; clicked => { selected_strategy = "Add 5 more products"; } }
            Button { text: "Connect Instagram"; clicked => { selected_strategy = "Connect Instagram"; } }
            Button { text: "Run your first email campaign"; clicked => { selected_strategy = "Run your first email campaign"; } }
            
            Text { text: "Selected: " + selected_strategy; color: #a855f7; }
        }

        // Step 1: Confirm
        if (step == 1) : VerticalBox {
            spacing: 10px;
            Text { text: "Confirm Action"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Text { text: "You are about to start: " + selected_strategy; color: #1e293b; }

            if (selected_strategy == "Connect Instagram") : VerticalBox {
                spacing: 8px;
                Text { text: "AI Agent Social Media Auto-Posting"; font-weight: 700; color: #a855f7; }
                Text { text: "Your AI agent will automatically generate and schedule posts for new products, sales, or milestones. You can approve posts from your phone with one tap."; color: #64748b; wrap: word-wrap; }
                Button { text: "Authorize Instagram Connect"; }
            }

            if (selected_strategy == "Run your first email campaign") : VerticalBox {
                spacing: 8px;
                Text { text: "AI Agent Email Marketing"; font-weight: 700; color: #a855f7; }
                Text { text: "Select an AI-generated template below to engage your contacts."; color: #64748b; wrap: word-wrap; }
                HorizontalBox {
                    spacing: 8px;
                    Button { text: "New Arrivals"; }
                    Button { text: "Flash Sale"; }
                    Button { text: "Thank You"; }
                }
                LineEdit { placeholder-text: "Customize Email Subject"; }
            }

            Text { text: "Your AI agents will be instructed to begin this growth strategy immediately."; color: #64748b; wrap: word-wrap; }
            
            if (is_advanced) : VerticalBox {
                spacing: 8px;
                Text { text: "Advanced Target KPIs"; font-weight: 700; color: #1e293b; }
                LineEdit {
                    placeholder-text: "Conversion Target (%)";
                }
            }
        }

        Rectangle {} // Spacer

        // Navigation
        HorizontalBox {
            if (step > 0) : Button {
                text: "Back";
                clicked => { step = step - 1; }
            }
            Rectangle {} // Spacer
            Button {
                text: step == 1 ? "Execute" : "Next";
                clicked => {
                    if (step < 1) {
                        step = step + 1;
                    } else {
                        execute(selected_strategy);
                    }
                }
            }
        }
    }
}
