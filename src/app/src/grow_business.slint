import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component GrowBusiness inherits Window {
    width: 500px;
    height: 500px;
    title: "Grow My Business";

    property <int> step: 0;
    property <string> selected_strategy: "";

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        Text { text: "Growth Strategies"; font-size: 24px; font-weight: 700; color: #1e293b; }

        // Step 0: Select Strategy
        if (step == 0) : VerticalBox {
            spacing: 10px;
            Text { text: "Select a next step to grow your business"; color: #1e293b; }
            
            Button { text: "Add 5 more products"; clicked => { selected_strategy = "Add 5 more products"; } }
            Button { text: "Connect Instagram"; clicked => { selected_strategy = "Connect Instagram"; } }
            Button { text: "Run your first email campaign"; clicked => { selected_strategy = "Run your first email campaign"; } }
            
            Text { text: "Selected: " + selected_strategy; color: #a855f7; }
        }

        // Step 1: Confirm
        if (step == 1) : VerticalBox {
            spacing: 10px;
            Text { text: "Confirm Action"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Text { text: "You are about to start: " + selected_strategy; color: #1e293b; }
            Text { text: "Your AI agents will be instructed to begin this growth strategy immediately."; color: #64748b; wrap: word-wrap; }
        }

        Rectangle {} // Spacer

        // Navigation
        HorizontalBox {
            if (step > 0) : Button {
                text: "Back";
                clicked => { step = step - 1; }
            }
            Rectangle {} // Spacer
            Button {
                text: step == 1 ? "Execute" : "Next";
                clicked => {
                    if (step < 1) {
                        step = step + 1;
                    } else {
                        // Handle execution
                    }
                }
            }
        }
    }
}
