import { Button, VerticalBox, HorizontalBox, Switch } from "std-widgets.slint";

export component Settings inherits Window {
    width: 600px;
    height: 500px;
    title: "Settings";

    property <bool> advanced_mode: false;

    background: #f8fafc;

    VerticalBox {
        spacing: 24px;
        padding: 32px;

        Text { text: "Settings"; font-size: 28px; font-weight: 800; color: #1e293b; }

        Rectangle {
            background: white;
            border-radius: 16px;
            padding: 24px;
            VerticalBox {
                spacing: 20px;
                
                HorizontalBox {
                    VerticalBox {
                        spacing: 4px;
                        Text { text: "Advanced Mode"; font-weight: 700; color: #1e293b; }
                        Text { text: "Show technical fields and raw configurations."; color: #64748b; font-size: 14px; }
                    }
                    Rectangle {}
                    Switch { checked: advanced_mode; changed => { advanced_mode = self.checked; } }
                }

                Rectangle { height: 1px; background: #e2e8f0; }

                HorizontalBox {
                    Text { text: "Language"; vertical-alignment: center; }
                    Rectangle {}
                    Text { text: "English (US)"; color: #64748b; vertical-alignment: center; }
                }
            }
        }

        if (advanced_mode) : VerticalBox {
            spacing: 12px;
            Text { text: "Expert Settings"; font-weight: 700; color: #a855f7; }
            Rectangle {
                background: #fef2f2;
                border-radius: 8px;
                padding: 12px;
                Text { text: "Careful: Changes here can affect agent stability."; color: #b91c1c; font-size: 12px; }
            }
            HorizontalBox {
                Text { text: "Developer Mode"; }
                Rectangle {}
                Switch { checked: false; }
            }
        }
    }
}
