import { VerticalBox, LineEdit, ScrollView, HorizontalBox, Button } from "std-widgets.slint";

export component ApiDocs inherits Window {
    width: 375px;
    height: 812px;
    background: #f8fafc;

    VerticalBox {
        padding: 20px;
