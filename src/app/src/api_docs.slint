import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component ApiDocs inherits Window {
    width: 375px;
    height: 812px;
    title: "API Reference (Advanced)";
    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        padding: 16px;
        spacing: 20px;

        Text {
            text: "Developer API";
            font-size: 24px;
            font-weight: 700;
            color: white;
            font-family: "Outfit";
        }

        Text {
            text: "For advanced users only. Connect custom checkouts or external tools.";
            color: #a8b2c1;
            wrap: word-wrap;
            font-family: "Inter";
        }

        ScrollView {
            VerticalBox {
                spacing: 16px;

                GlassCard {
                    VerticalBox {
                        padding: 16px; spacing: 8px;
                        Text { text: "GET /api/v1/products"; font-weight: 700; color: #a855f7; font-family: "Inter"; }
                        Text { text: "List all products in your store."; color: white; font-family: "Inter"; }
                        Text { text: "Returns a JSON array of product objects."; color: #a8b2c1; wrap: word-wrap; font-family: "Inter"; }
                    }
                }

                GlassCard {
                    VerticalBox {
                        padding: 16px; spacing: 8px;
                        Text { text: "POST /api/v1/orders"; font-weight: 700; color: #10b981; font-family: "Inter"; }
                        Text { text: "Create a new order."; color: white; font-family: "Inter"; }
                        Text { text: "Requires customer details and product IDs."; color: #a8b2c1; wrap: word-wrap; font-family: "Inter"; }
                    }
                }
            }
        }
    }
}
