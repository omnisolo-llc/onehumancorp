export component SwarmVelocityWindow inherits Window {
    width: 500px;
    height: 200px;
    title: "Swarm Velocity Test";
    
    in-out property <string> completion_rate <=> sv.completion_rate;
    in-out property <string> avg_latency <=> sv.avg_latency;
    in-out property <int> active_threads <=> sv.active_threads;

    sv := SwarmVelocity {}
}

export component SwarmObservabilityWindow inherits Window {
    width: 500px;
    height: 350px;
    title: "Swarm Observability Test";
    
    in-out property <[UiMeshMessage]> messages <=> so.messages;

    so := SwarmObservability {}
}

export component AgentStatusIndicatorWindow inherits Window {
    width: 100px;
    height: 100px;
    title: "Agent Status Indicator Test";
    
    in-out property <bool> is_active <=> asi.is_active;

    asi := AgentStatusIndicator {}
}
export { GrowBusiness } from "./grow_business.slint";
export { Meetings, UiMeeting } from "./meetings.slint";
export { Skills, UiSkill } from "./skills.slint";

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked;

    VerticalBox {
        spacing: 4px;
        alignment: center;
        Text {
            text: icon;
            font-size: 24px;
            horizontal-alignment: center;
            color: active ? #a855f7 : #a8b2c1;
        }
        Text {
            text: label;
            font-size: 12px;
            font-family: "Inter";
            horizontal-alignment: center;
            color: active ? #a855f7 : #a8b2c1;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    width: 375px;
    height: 812px;
    title: "OneHumanCorp";
    background: #0D0D1A;

    in-out property <int> active_tab: 0;

    // Dashboard data forwarding
    in property <int> active_agents_count: 0;
    in property <int> active_tasks_count: 0;
    in property <int> scheduled_calls_count: 0;
    in property <int> team_members_count: 0;
    in property <[UiRoleCount]> role_counts;
    in property <[UiMeshMessage]> mesh_messages;

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Content Area
        Rectangle {
            background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

            if (active_tab == 0) : Dashboard {
                active_agents_count: root.active_agents_count;
                active_tasks_count: root.active_tasks_count;
                scheduled_calls_count: root.scheduled_calls_count;
                team_members_count: root.team_members_count;
                role_counts: root.role_counts;
                mesh_messages: root.mesh_messages;
            }
            if (active_tab == 1) : Agents {}
            if (active_tab == 2) : WebsiteBuilder {}
            if (active_tab == 3) : TaskList {}
            if (active_tab == 4) : Settings {}
        }

        // Bottom Navigation Bar (Glassmorphism simulation)
        Rectangle {
            height: 90px;
            background: white.with-alpha(0.05);

            // Border Top
            Rectangle {
                height: 1px;
                background: white.with-alpha(0.1);
                y: 0;
            }

            HorizontalBox {
                padding: 10px;
                padding-bottom: 25px; // For safe area on mobile
                alignment: space-around;

                NavItem {
                    icon: "🏠";
                    label: "Home";
                    active: active_tab == 0;
                    clicked => { active_tab = 0; }
                }
                NavItem {
                    icon: "🤖";
                    label: "Helpers";
                    active: active_tab == 1;
                    clicked => { active_tab = 1; }
                }
                NavItem {
                    icon: "🌐";
                    label: "Store";
                    active: active_tab == 2;
                    clicked => { active_tab = 2; }
                }
                NavItem {
                    icon: "✅";
                    label: "Tasks";
                    active: active_tab == 3;
                    clicked => { active_tab = 3; }
                }
                NavItem {
                    icon: "⚙️";
                    label: "Settings";
                    active: active_tab == 4;
                    clicked => { active_tab = 4; }
                }
            }
        }
    }
}
