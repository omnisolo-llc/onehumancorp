export component SwarmVelocityWindow inherits Window {
    width: 500px;
    height: 200px;
    title: "Swarm Velocity Test";
    
    in-out property <string> completion_rate <=> sv.completion_rate;
    in-out property <string> avg_latency <=> sv.avg_latency;
    in-out property <int> active_threads <=> sv.active_threads;

    sv := SwarmVelocity {}
}

export component SwarmObservabilityWindow inherits Window {
    width: 500px;
    height: 350px;
    title: "Swarm Observability Test";
    
    in-out property <[UiMeshMessage]> messages <=> so.messages;

    so := SwarmObservability {}
}

export component AgentStatusIndicatorWindow inherits Window {
    width: 100px;
    height: 100px;
    title: "Agent Status Indicator Test";
    
    in-out property <bool> is_active <=> asi.is_active;

    asi := AgentStatusIndicator {}
}
export { GrowBusiness } from "./grow_business.slint";
export { Meetings, UiMeeting } from "./meetings.slint";
export { Skills, UiSkill } from "./skills.slint";

export component AppWindow inherits Window {
    width: 400px;
    height: 300px;
    title: "New Rust + Slint App";

    VerticalBox {
        alignment: center;
        spacing: 20px;
        Text {
            text: "Hello from Slint!";
            horizontal-alignment: center;
            font-size: 20px;
        }
        Button {
            text: "Click me";
        }
    }
}
