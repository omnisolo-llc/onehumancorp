
export component Tooltip inherits Rectangle {
    in-out property <string> text;
    in-out property <bool> show: false;

    background: #1e293b;
    border-radius: 6px;
    visible: show;

    Text {
        text: root.text;
        color: white;
        font-size: 12px;
        padding: 8px;
        wrap: word-wrap;
    }
}
