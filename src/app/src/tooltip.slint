
export component Tooltip inherits Rectangle {
    in property <string> text;
    in property <bool> show: false;

    background: #1e293b;
    border-radius: 6px;
    visible: show;

    HorizontalLayout {
        padding: 8px;
        Text {
            text: root.text;
            color: white;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
