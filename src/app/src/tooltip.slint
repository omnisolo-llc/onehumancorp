import { Rectangle, Text } from "std-widgets.slint";

export component Tooltip inherits Rectangle {
    in property <string> text;
    in property <bool> show: false;

    background: #1e293b;
    border-radius: 6px;
    visible: show;

    Text {
        text: root.text;
        color: white;
        font-size: 12px;
        padding: 8px;
        wrap: word-wrap;
    }
}
