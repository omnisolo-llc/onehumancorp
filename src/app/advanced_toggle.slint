import { HorizontalBox } from "std-widgets.slint";

export component AdvancedToggle inherits HorizontalBox {
    in-out property <bool> is_advanced: false;
    callback toggled();

    spacing: 8px;
    alignment: end;

    Text { text: "Advanced"; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
    TouchArea {
        width: 20px;
        height: 20px;
        clicked => { is_advanced = !is_advanced; toggled(); }
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 4px;
            border-color: #a855f7;
            border-width: 1px;
            background: root.is_advanced ? #a855f7 : transparent;
            Text { text: root.is_advanced ? "✓" : ""; color: white; horizontal-alignment: center; }
        }
    }
}
