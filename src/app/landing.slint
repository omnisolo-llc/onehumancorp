import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Landing inherits Window {
    width: 800px;
    height: 600px;
    title: "OneHumanCorp";
    out property <string> test_title: root.title;

    in-out property <bool> is_variant_b: false;

    callback start_business_setup();
    callback continue_to_dashboard();
    callback download(string);

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 32px;
        alignment: center;

        // Header
        Text { text: "OneHumanCorp"; font-size: 32px; font-weight: 700; color: #1e293b; horizontal-alignment: center; }
        
        Text { 
            text: is_variant_b ? "The Cloud Helper System" : "The Flexible Helper System";
            font-size: 24px; 
            color: #a855f7; 
            horizontal-alignment: center; 
        }

        Text {
            text: is_variant_b ? 
                "Grow your business with seamless cloud convenience. Collaborate instantly with your team from anywhere in the world." :
                "Grow your business while keeping your ideas safe. Experience the gold standard for privacy with our local desktop app.";
            color: #64748b;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        // Value Props
        HorizontalBox {
            spacing: 20px;
            alignment: center;
            
            if (is_variant_b) : Rectangle {
                background: white; border-radius: 8px; width: 220px; height: 150px;
                VerticalBox {
                    padding: 16px;
                    Text { text: "Always Online"; font-weight: 700; }
                    Text { text: "Your helpers are always awake, replying to customers and taking orders while you sleep."; color: #64748b; wrap: word-wrap; }
                }
            }
            if (is_variant_b) : Rectangle {
                background: white; border-radius: 8px; width: 220px; height: 150px;
                VerticalBox {
                    padding: 16px;
                    Text { text: "Instant Collaboration"; font-weight: 700; }
                    Text { text: "Invite helpers instantly. Shared intelligence across your entire organization."; color: #64748b; wrap: word-wrap; }
                }
            }
            
            if (!is_variant_b) : Rectangle {
                background: white; border-radius: 8px; width: 220px; height: 150px;
                VerticalBox {
                    padding: 16px;
                    Text { text: "Complete Privacy"; font-weight: 700; }
                    Text { text: "All helpers run entirely on your computer. Your business data never leaves your device."; color: #64748b; wrap: word-wrap; }
                }
            }
            if (!is_variant_b) : Rectangle {
                background: white; border-radius: 8px; width: 220px; height: 150px;
                VerticalBox {
                    padding: 16px;
                    Text { text: "Works Offline"; font-weight: 700; }
                    Text { text: "No internet? No problem. Continue managing your business without a connection."; color: #64748b; wrap: word-wrap; }
                }
            }
        }

        // Downloads
        HorizontalBox {
            spacing: 10px;
            alignment: center;
            Button { text: "Download for Mac"; clicked => { download("Mac"); } }
            Button { text: "Download for Windows"; clicked => { download("Windows"); } }
            Button { text: "Download for Linux"; clicked => { download("Linux"); } }
        }

        // Navigation
        Button { text: "Start Business Setup"; clicked => { start_business_setup(); } }
        Button { text: "Or continue to Cloud Dashboard"; clicked => { continue_to_dashboard(); } }

        // Debug toggle
        HorizontalBox {
            alignment: center;
            Text { text: "Debug: Switch Variant"; }
            Button { text: "Toggle"; clicked => { is_variant_b = !is_variant_b; } }
        }
    }
}
