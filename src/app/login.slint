import { PasswordInput } from "password_input.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component Login inherits Window {
    min-width: 375px;
    preferred-width: 400px;
    height: 600px;
    title: "One Human Corp - Login";

    in-out property <bool> loading: false;
    in-out property <bool> is_sign_up: false;
    in-out property <string> error_message: "";
    in-out property <bool> show_verification: false;
    in-out property <string> verification_message: "";

    in-out property <string> username: "";
    in-out property <string> password: "";

    callback login(string, string);
    callback oauth_login(string);
    callback open_settings();
    callback resend_verification(string);
    callback start_setup_wizard();

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        alignment: center;
        spacing: 20px;
        padding: 32px;

        GlassCard {
            VerticalBox {
                spacing: 16px;
                padding: 24px;

                Text {
                    text: "✨";
                    font-size: 64px;
                    horizontal-alignment: center;
                    color: #a855f7;
                }

                Text {
                    text: "One Human Corp";
                    font-size: 28px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    color: white;
                    font-family: "Outfit";
                }

                Text {
                    text: is_sign_up ? "Create an account to start your business" : "Sign in to manage your business";
                    font-size: 14px;
                    horizontal-alignment: center;
                    color: #a8b2c1;
                    font-family: "Inter";
                }

                LineEdit {
                    height: 44px;
                    placeholder-text: "Your Email";
                    text <=> username;
                }

                PasswordInput {
                    placeholder-text: "Password";
                    text <=> password;
                }

                if (show_verification) : VerticalBox {
                    spacing: 8px;
                    alignment: center;
                    Text { text: verification_message; color: #10b981; horizontal-alignment: center; font-family: "Inter"; }
                    Button {
                        height: 44px;
                        text: "Resend Verification Email";
                        clicked => { resend_verification(username); }
                    }
                }

                if (error_message != "") : Text {
                    text: error_message;
                    color: #ef4444;
                    horizontal-alignment: center;
                    font-family: "Inter";
                    wrap: word-wrap;
                }

                Button {
                    height: 44px;
                    text: is_sign_up ? "Sign Up" : "Sign In";
                    clicked => { login(username, password); }
                }

                Button {
                    height: 44px;
                    text: is_sign_up ? "I already have an account" : "I need to create an account";
                    clicked => {
                        is_sign_up = !is_sign_up;
                    }
                }

                HorizontalBox {
                    alignment: center;
                    Text { text: "OR"; color: #9ca3af; font-weight: 700; }
                }

                Button {
                    height: 44px;
                    text: "Sign in with Google or Apple";
                    clicked => { oauth_login("SSO"); }
                }
                
                Button {
                    height: 44px;
                    text: "🚀 Start New Business";
                    clicked => { start_setup_wizard(); }
                }

                Button {
                    height: 44px;
                    text: "⚙ Advanced Options";
                    clicked => { open_settings(); }
                }
            }
        }
    }
}
