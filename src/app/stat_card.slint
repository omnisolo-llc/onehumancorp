import { GlassCard } from "glass_card.slint";
import { VerticalBox } from "std-widgets.slint";

export component StatCard inherits GlassCard {
    in property <string> label;
    in property <string> value;
    in property <color> value_color: #a855f7;
    in property <bool> is_loading: false;

    border-color: #e2e8f0;
    border-width: 1px;
    border-radius: 8px;
    width: 100%;
    min-height: 88px;

    TouchArea {
        width: 100%;
        height: 100%;
        VerticalBox {
            padding: 16px;
            Text {
                text: label;
                color: #94a3b8;
                font-family: "Inter";
                font-size: 14px;
            }
            if (!is_loading) : Text {
                text: value;
                font-size: 32px;
                font-family: "Outfit";
                font-weight: 700;
                color: value_color;
            }
            if (is_loading) : GlassCard {
                height: 32px;
                width: 60%;
                border-radius: 6px;
                background: rgba(255, 255, 255, 0.1);
                opacity: abs(mod(animation-tick(), 1.5s) / 1.5s - 0.5) * 0.5 + 0.3;
            }
        }
    }
}
