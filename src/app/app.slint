import { StatCard } from "./stat_card.slint";



export component StatCardWindow inherits Window {
    width: 200px;
    height: 100px;
    in-out property <string> label <=> sc.label;
    in-out property <string> value <=> sc.value;
    sc := StatCard {}
}

export component AgentStatusIndicatorWindow inherits Window {
    width: 100px;
    height: 100px;
    title: "Agent Status Indicator Test";
    
    in-out property <bool> is_active <=> asi.is_active;
    in-out property <string> status_text <=> asi.status_text;
    in-out property <string> status_color <=> asi.status_color;

    asi := AgentStatusIndicator {}
}
