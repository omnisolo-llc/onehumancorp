export component StatCardWindow inherits Window {
    in property <string> label;
    in property <string> value;
    StatCard {
        label: label;
        value: value;
    }
}

export component HelperStatusIndicatorWindow inherits Window {
    width: 200px;
    height: 100px;
    title: "Helper Status Indicator Test";

    in-out property <bool> is_active <=> asi.is_active;
    in-out property <string> status_text <=> asi.status_text;
    in-out property <string> status_color <=> asi.status_color;

    asi := HelperStatusIndicator {}

    public function set_status(status: string, is_running: bool) {
        asi.status_text = status;
        asi.is_active = is_running;
    }
}

export { Landing, Login, SetupWizard }
