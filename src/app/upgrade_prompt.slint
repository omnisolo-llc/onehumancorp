import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component UpgradePrompt inherits Rectangle {
    width: 100%;
    height: 100%;
    z: 100;

    in property <string> message: "You've reached a limit on your current plan.";

    callback action_upgrade();
    callback action_dismiss();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.action_dismiss(); }
    }

    Rectangle {
        y: root.height - self.height;
        width: root.width;

        GlassCard {
            border-radius: 20px;
            border-color: rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.05);
            width: 100%;

            VerticalBox {
                padding: 24px;
                spacing: 16px;

                HorizontalBox {
                    alignment: space-between;
                    Text {
                        text: "Scale Up Your Team";
                        font-size: 24px;
                        font-weight: 700;
                        font-family: "Outfit";
                        color: white;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "✕";
                        width: 32px;
                        height: 32px;
                        clicked => { root.action_dismiss(); }
                    }
                }

                Text {
                    text: root.message;
                    color: #cbd5e1;
                    font-size: 16px;
                    wrap: word-wrap;
                }

                HorizontalBox {
                    alignment: end;
                    Button {
                        text: "Upgrade to Pro - $29/mo";
                        height: 48px;
                        clicked => { root.action_upgrade(); }
                    }
                }
            }
        }
    }
}
