import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component UpgradePrompt inherits Rectangle {
    background: rgba(240, 171, 252, 0.1);
    border-color: #f0abfc;
    border-width: 1px;
    border-radius: 8px;

    in property <string> message: "You've reached a limit on your current plan.";

    callback action_upgrade();
    callback action_dismiss();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        HorizontalBox {
            alignment: space-between;
            Text {
                text: "Upgrade to unlock more!";
                font-size: 18px;
                font-weight: 700;
                color: #a21caf;
                vertical-alignment: center;
            }
            Button {
                text: "✕";
                width: 32px;
                height: 32px;
                clicked => { root.action_dismiss(); }
            }
        }

        Text {
            text: root.message;
            color: #86198f;
            wrap: word-wrap;
        }

        HorizontalBox {
            alignment: end;
            Button {
                text: "Upgrade Now";
                height: 40px;
                clicked => { root.action_upgrade(); }
            }
        }
    }
}
