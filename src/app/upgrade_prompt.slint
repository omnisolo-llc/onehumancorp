import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component UpgradePrompt inherits Rectangle {
    in-out property <bool> is_paying: false;
    in-out property <bool> is_success: false;
    callback native_pay();

    native_pay => {
        is_paying = true;
        // Simulating the native pay delay
        // in real life it triggers the native wrapper logic
    }

    width: 100%;
    height: 100%;
    z: 100;

    in property <string> message: "You've reached a limit on your current plan.";

    callback action_upgrade();
    callback action_dismiss();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.action_dismiss(); }
    }

    Rectangle {
        y: root.height - self.height;
        width: root.width;

        GlassCard {
            border-radius: 20px;
            border-color: rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.05);
            width: 100%;

            VerticalBox {
                padding: 24px;
                spacing: 16px;

                HorizontalBox {
                    alignment: space-between;
                    Text {
                        text: "Scale Up Your Team";
                        font-size: 24px;
                        font-weight: 700;
                        font-family: "Outfit";
                        color: white;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "✕";
                        width: 32px;
                        height: 32px;
                        clicked => { root.action_dismiss(); }
                    }
                }

                Text {
                    text: root.message;
                    color: #cbd5e1;
                    font-size: 16px;
                    wrap: word-wrap;
                }


                if (root.is_success) : VerticalBox {
                    alignment: center;
                    spacing: 16px;
                    Text { text: "✅ Payment Successful!"; font-size: 20px; font-weight: 700; color: #4ade80; horizontal-alignment: center; }
                    Text { text: "Congratulations! Your new limits are now active."; color: white; horizontal-alignment: center; wrap: word-wrap; }
                    Button { text: "Continue"; height: 48px; clicked => { root.action_upgrade(); } }
                }

                if (!root.is_success) : HorizontalBox {
                    alignment: end;
                    if (!root.is_paying) : Button {
                        text: "Upgrade Now";
                        height: 48px;
                        clicked => { root.native_pay(); }
                    }
                    if (root.is_paying) : Rectangle {
                        background: black; border-radius: 12px; height: 180px; width: 100%;
                        VerticalBox {
                            padding: 16px; spacing: 12px; alignment: center;
                            Text { text: "Apple Pay"; font-size: 20px; font-weight: 700; color: white; horizontal-alignment: center; }
                            Text { text: "Subscription Upgrade"; color: #cbd5e1; horizontal-alignment: center; }
                            Button { text: "Double Click to Pay"; height: 48px; clicked => { root.is_success = true; } }
                        }
                    }
                }

            }
        }
    }
}
