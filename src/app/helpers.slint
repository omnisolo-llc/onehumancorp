import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";
import { UpgradePrompt } from "./upgrade_prompt.slint";

export struct UiHelper {
    id: string,
    name: string,
    role: string,
    status: string,
    is_running: bool,
    svid_verified: bool,
    is_new: bool,
}

export component Helpers inherits Window {
    width: 500px;
    height: 600px;
    title: "Helpers";

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    in property <[UiHelper]> helpers;

    in-out property <bool> show_upgrade_prompt: false;
    in-out property <string> upgrade_prompt_message: "";

    callback hire_helper();
    callback fix_helper(string);

    if (show_upgrade_prompt) : UpgradePrompt {
        message: root.upgrade_prompt_message;
        action_dismiss => { root.show_upgrade_prompt = false; }
    }

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Helpers"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; }
            Rectangle {}
            Button { text: "Hire Helper"; clicked => { hire_helper(); } }
        }

        VerticalBox {
            spacing: 10px;
            
            for helper in helpers : GlassCard {
                
                if (helper.is_new) : Rectangle {
                    background: transparent;
                    border-radius: 12px;
                    border-width: 2px;
                    border-color: #10b981;
                    property <bool> is_bright: true;
                    opacity: is_bright ? 1.0 : 0.2;
                    animate opacity { duration: 1000ms; easing: ease-in-out; }
                    Timer {
                        interval: 1000ms;
                        running: true;
                        triggered => { is_bright = !is_bright; }
                    }
                }
                HorizontalBox {
                    padding: 16px;
                    Text { text: "🤖"; font-size: 32px; horizontal-alignment: center; }
                    VerticalBox {
                        Text { text: helper.name; font-family: "Inter"; font-weight: 700; color: white; }
                        Text { text: helper.role; font-family: "Inter"; color: #94a3b8; }
                    }
                    Rectangle {} 
                    VerticalBox {
                        Text { 
                            text: helper.status;
                            font-family: "Inter";
                            color: helper.is_running ? #10b981 : #ef4444;
                            horizontal-alignment: center; 
                        }
                        if (!helper.is_running) : Button { text: "Help me fix this"; clicked => { fix_helper(helper.id); } }
                    }
                }
            }
        }
    }
}
