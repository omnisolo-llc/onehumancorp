import { Button, VerticalBox, HorizontalBox, CheckBox } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component WelcomeChecklist inherits Window {
    min-width: 375px;
    preferred-width: 600px;
    height: 400px;
    title: "Welcome Checklist";

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    callback go_to_dashboard();
    callback go_to_add_products();
    callback go_to_connect_instagram();
    callback go_to_share_link();
    callback save_progress(bool, bool, bool, bool);

    in-out property <bool> task1_done: true;
    in-out property <bool> task2_done: false;
    in-out property <bool> task3_done: false;
    in-out property <bool> task4_done: false;

    in-out property <int> progress: 0;
    in-out property <bool> is_completed: false;

    VerticalBox {
        alignment: center;
        spacing: 20px;
        padding: 24px;

        GlassCard {
            VerticalBox {
                spacing: 16px;
                padding: 24px;

                Text {
                    text: "You're set up! Here's what to do next:";
                    font-size: 24px;
                    font-weight: 700;
                    color: white;
                    wrap: word-wrap;
                    font-family: "Outfit";
                }

                Text {
                    text: "Progress: " + progress + "% ( " + (progress / 25) + " of 4 )";
                    color: #94a3b8;
                    font-size: 14px;
                    font-family: "Inter";
                }

                HorizontalBox {
                    spacing: 10px;
                    alignment: start;
                    CheckBox {
                        min-width: 44px;
                        min-height: 44px;
                        checked: task1_done;
                        toggled => { task1_done = self.checked; root.progress = (task1_done?25:0) + (task2_done?25:0) + (task3_done?25:0) + (task4_done?25:0); root.is_completed = task1_done && task2_done && task3_done && task4_done; root.save_progress(task1_done, task2_done, task3_done, task4_done); }
                    }
                    TouchArea {
                        width: 100%;
                        min-height: 44px;
                        VerticalBox {
                            alignment: center;
                            Text { text: "Business live"; color: white; font-family: "Inter"; }
                        }
                    }
                }
                HorizontalBox {
                    spacing: 10px;
                    alignment: start;
                    CheckBox {
                        min-width: 44px;
                        min-height: 44px;
                        checked: task2_done;
                        toggled => { task2_done = self.checked; root.progress = (task1_done?25:0) + (task2_done?25:0) + (task3_done?25:0) + (task4_done?25:0); root.is_completed = task1_done && task2_done && task3_done && task4_done; root.save_progress(task1_done, task2_done, task3_done, task4_done); }
                    }
                    TouchArea {
                        width: 100%;
                        min-height: 44px;
                        clicked => { root.go_to_add_products(); }
                        VerticalBox {
                            alignment: center;
                            Text { text: "Add 3 more products"; color: white; font-family: "Inter"; }
                        }
                    }
                }
                HorizontalBox {
                    spacing: 10px;
                    alignment: start;
                    CheckBox {
                        min-width: 44px;
                        min-height: 44px;
                        checked: task3_done;
                        toggled => { task3_done = self.checked; root.progress = (task1_done?25:0) + (task2_done?25:0) + (task3_done?25:0) + (task4_done?25:0); root.is_completed = task1_done && task2_done && task3_done && task4_done; root.save_progress(task1_done, task2_done, task3_done, task4_done); }
                    }
                    TouchArea {
                        width: 100%;
                        min-height: 44px;
                        clicked => { root.go_to_connect_instagram(); }
                        VerticalBox {
                            alignment: center;
                            Text { text: "Connect Instagram"; color: white; font-family: "Inter"; }
                        }
                    }
                }
                HorizontalBox {
                    spacing: 10px;
                    alignment: start;
                    CheckBox {
                        min-width: 44px;
                        min-height: 44px;
                        checked: task4_done;
                        toggled => { task4_done = self.checked; root.progress = (task1_done?25:0) + (task2_done?25:0) + (task3_done?25:0) + (task4_done?25:0); root.is_completed = task1_done && task2_done && task3_done && task4_done; root.save_progress(task1_done, task2_done, task3_done, task4_done); }
                    }
                    TouchArea {
                        width: 100%;
                        min-height: 44px;
                        clicked => { root.go_to_share_link(); }
                        VerticalBox {
                            alignment: center;
                            Text { text: "Share your link with a friend"; color: white; font-family: "Inter"; }
                        }
                    }
                }

                if is_completed : Text {
                    text: "Congratulations! You have completed all setup tasks. Awesome job!";
                    color: #10b981;
                    font-size: 16px;
                    font-weight: 700;
                    font-family: "Inter";
                    wrap: word-wrap;
                }

                Button {
                    text: "Go to Dashboard";
                    height: 44px;
                    clicked => {
                        root.go_to_dashboard();
                    }
                }

                HorizontalBox {
                    spacing: 15px;
                    alignment: center;
                    TouchArea { clicked => {} Text { text: "Documentation"; color: #a855f7; font-size: 14px; font-family: "Inter"; } }
                    Text { text: "|"; color: #475569; font-size: 14px; }
                    TouchArea { clicked => {} Text { text: "Video Tutorials"; color: #a855f7; font-size: 14px; font-family: "Inter"; } }
                    Text { text: "|"; color: #475569; font-size: 14px; }
                    TouchArea { clicked => {} Text { text: "Contact Support"; color: #a855f7; font-size: 14px; font-family: "Inter"; } }
                }
            }
        }
    }
}
