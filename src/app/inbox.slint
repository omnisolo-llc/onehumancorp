import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export struct UiInboxMessage {
    id: string,
    customer_name: string,
    customer_message: string,
    ai_draft: string,
    is_ai_drafted: bool,
}

export component Inbox inherits Window {
    width: 375px;
    height: 800px;
    title: "Inbox";

    in property <[UiInboxMessage]> messages;
    callback send_reply(string);
    callback edit_reply(string);
    callback auto_handle(string);

    background: #f8fafc;

    VerticalBox {
        spacing: 16px;
        padding: 16px;

        HorizontalBox {
            Text { text: "Inbox"; font-size: 24px; font-weight: 700; color: #1e293b; }
        }

        VerticalBox {
            spacing: 16px;

            for msg in messages : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 12px;

                VerticalBox {
                    padding: 16px;
                    spacing: 12px;

                    // Customer Message
                    VerticalBox {
                        spacing: 4px;
                        Text { text: msg.customer_name; font-weight: 700; color: #1e293b; }
                        Text { text: msg.customer_message; color: #475569; wrap: word-wrap; }
                    }

                    // AI Draft
                    if (msg.is_ai_drafted) : Rectangle {
                        background: #fdf4ff; // Light purple indicating AI
                        border-color: #d8b4fe;
                        border-width: 1px;
                        border-radius: 8px;

                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalBox {
                                Text { text: "✨ AI Drafted Reply"; font-size: 12px; font-weight: 700; color: #9333ea; }
                            }

                            Text { text: msg.ai_draft; color: #1e293b; wrap: word-wrap; }

                            HorizontalBox {
                                spacing: 8px;
                                alignment: end;

                                Button {
                                    text: "Auto-handle similar";
                                    height: 44px;
                                    clicked => { auto_handle(msg.id); }
                                }
                                Button {
                                    text: "Edit";
                                    height: 44px;
                                    clicked => { edit_reply(msg.id); }
                                }
                                Button {
                                    text: "Send";
                                    height: 44px;
                                    primary: true;
                                    clicked => { send_reply(msg.id); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
