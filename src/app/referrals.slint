import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export struct UiReferral {
    referral_code: string,
    user_id: string,
    clicks: int,
    conversions: int,
    created_at: string,
}

export component Referrals inherits Window {
    width: 500px;
    height: 600px;
    title: "Referral Dashboard";

    background: #f8fafc;

    in property <[UiReferral]> referrals;
    in property <string> my_referral_link: "ohc://join?ref=DEFAULT";
    in property <int> total_referrals: 0;
    in property <int> click_count: 0;
    in property <float> conversion_rate: 0.0;
    in property <string> reward_balance: "$0.00";
    in property <int> bonus_credit: 0;
    in property <float> viral_coefficient: 0.0;
    in property <int> download_count: 0;
    in property <int> waitlist_position: 0;
    in-out property <string> invite_copy_status: "";
    in-out property <string> link_copy_status: "";

    callback refresh();
    callback share_link(string);
    callback generate_new_link();
    callback copy_link();
    callback export_data();
    callback view_history();
    callback send_invite_message(string);

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Referral Dashboard"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            Button { 
                text: "Refresh"; 
                clicked => { refresh(); }
            }
        }

        GlassCard {
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text { text: "Your Referral Link"; font-weight: 700; color: #1e293b; }
                Text { text: my_referral_link; color: #64748b; font-size: 14px; }
                HorizontalBox {
                    Button {
                        text: "Copy";
                        primary: true;
                        clicked => { copy_link(); }
                    }
                    Button {
                        text: "Share";
                        primary: true;
                        clicked => { share_link(my_referral_link); }
                    }
                    Button {
                        text: "New Link";
                        clicked => { generate_new_link(); }
                    }
                    Button {
                        text: "Copy Invite Message";
                        primary: true;
                        clicked => { send_invite_message(my_referral_link); }
                    }
                }
                if (invite_copy_status != "") : Text {
                    text: invite_copy_status;
                    color: #10b981;
                    font-size: 14px;
                }
                if (link_copy_status != "") : Text {
                    text: link_copy_status;
                    color: #10b981;
                    font-size: 14px;
                }
            }
        }

        GlassCard {
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text { text: "Referral Statistics"; font-weight: 700; color: #1e293b; }
                HorizontalBox {
                    Text { text: "Total Referrals: " + total_referrals; color: #64748b; font-size: 14px; }
                    Text { text: "Click Count: " + click_count; color: #64748b; font-size: 14px; }
                    Text { text: "Conversion Rate: " + conversion_rate + "%"; color: #64748b; font-size: 14px; }
                }
                HorizontalBox {
                    Text { text: "Reward Balance: " + reward_balance; color: #64748b; font-size: 14px; }
                    Text { text: "Bonus Credit: " + bonus_credit; color: #64748b; font-size: 14px; }
                }
                HorizontalBox {
                    Text { text: "Viral Coefficient: " + viral_coefficient; color: #64748b; font-size: 14px; }
                    Text { text: "Download Count: " + download_count; color: #64748b; font-size: 14px; }
                    Text { text: "Waitlist Position: " + waitlist_position; color: #64748b; font-size: 14px; }
                }
                HorizontalBox {
                    Button {
                        text: "History";
                        clicked => { view_history(); }
                    }
                    Button {
                        text: "Export";
                        clicked => { export_data(); }
                    }
                }
                Text { text: "Recent Activity"; font-weight: 700; color: #1e293b; }
            }
        }

        GlassCard {
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text { text: "Referral Program Admin"; font-weight: 700; color: #1e293b; }
                Text { text: "Settings Configure"; font-weight: 700; color: #1e293b; }
                HorizontalBox {
                    Text { text: "Reward Amount:"; vertical-alignment: center; }
                    TextInput { text: "25"; width: 100px; height: 32px; }
                }
                HorizontalBox {
                    Text { text: "Program Enabled"; vertical-alignment: center; }
                    Rectangle {
                        width: 40px; height: 20px; border-radius: 10px; background: #a855f7;
                        Rectangle { width: 16px; height: 16px; border-radius: 8px; background: white; x: 22px; y: 2px; }
                    }
                }
                Text { text: "Leaderboard Rank: #1"; color: #64748b; font-size: 14px; }
                Text { text: "Top Award: Platinum Level"; color: #64748b; font-size: 14px; }
            }
        }

        VerticalBox {
            spacing: 16px;
            for r in referrals : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    
                    HorizontalBox {
                        Text { text: "Ref: " + r.referral_code; font-weight: 700; color: #1e293b; }
                        Rectangle {}
                        Text { text: "👥"; font-size: 20px; }
                    }
                    
                    Text { text: "User: " + r.user_id; color: #64748b; }
                    
                    HorizontalBox {
                        alignment: space-around;
                        VerticalBox {
                            alignment: center;
                            Text { text: r.clicks; font-size: 24px; font-weight: 700; color: #a855f7; }
                            Text { text: "Clicks"; color: #64748b; font-size: 12px; }
                        }
                        VerticalBox {
                            alignment: center;
                            Text { text: r.conversions; font-size: 24px; font-weight: 700; color: #a855f7; }
                            Text { text: "Conversions"; color: #64748b; font-size: 12px; }
                        }
                    }
                    
                    Text { text: "Created: " + r.created_at; color: #64748b; font-size: 12px; }
                }
            }
        }
    }
}
