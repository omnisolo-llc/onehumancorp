import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export struct UiReferral {
    referral_code: string,
    user_id: string,
    clicks: int,
    conversions: int,
    created_at: string,
}

export component Referrals inherits Window {
    width: 600px;
    height: 800px;
    title: "Referral Dashboard";

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    in property <[UiReferral]> referrals;
    in property <string> my_referral_link: "ohc://join?ref=DEFAULT";
    in property <int> total_referrals: 0;
    in property <int> click_count: 0;
    in property <float> conversion_rate: 0.0;
    in property <string> reward_balance: "$0.00";
    in property <int> bonus_credit: 0;
    in property <float> viral_coefficient: 0.0;
    in property <int> download_count: 0;
    in property <int> waitlist_position: 0;
    in-out property <string> invite_copy_status: "";
    in-out property <string> link_copy_status: "";

    callback refresh();
    callback share_link(string);
    callback generate_new_link();
    callback copy_link();
    callback export_data();
    callback view_history();
    callback send_invite_message(string);

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Referral Program"; font-size: 28px; font-family: "Outfit"; font-weight: 700; color: white; vertical-alignment: center; }
            Rectangle {}
            Button { 
                text: "Refresh"; 
                height: 40px;
                clicked => { refresh(); }
            }
        }

        ScrollView {
            VerticalBox {
                spacing: 20px;

                GlassCard {
                    VerticalBox {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: "🎁 Share the Love, Get Pro"; font-weight: 700; color: white; font-size: 18px; font-family: "Outfit"; }
                        Text { text: "Invite a friend to OHC. When they start a business, you BOTH get 1 month of Pro for free!"; color: #94a3b8; font-size: 14px; font-family: "Inter"; wrap: word-wrap; }

                        Rectangle {
                            height: 44px;
                            background: rgba(255, 255, 255, 0.05);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: rgba(255, 255, 255, 0.1);
                            HorizontalBox {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text { text: my_referral_link; color: #a855f7; vertical-alignment: center; font-family: "Inter"; font-size: 12px; }
                                Rectangle {}
                                Button {
                                    text: "Copy";
                                    height: 32px;
                                    clicked => { copy_link(); }
                                }
                            }
                        }

                        HorizontalBox {
                            spacing: 12px;
                            Button {
                                text: "📷 Share to Instagram";
                                primary: true;
                                height: 48px;
                                clicked => { share_link(my_referral_link); }
                            }
                            Button {
                                text: "💬 Copy Invite Message";
                                height: 48px;
                                clicked => { send_invite_message(my_referral_link); }
                            }
                        }

                        if (invite_copy_status != "") : Text {
                            text: invite_copy_status;
                            color: #10b981;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }
                    }
                }

                GlassCard {
                    VerticalBox {
                        padding: 16px;
                        spacing: 16px;
                        Text { text: "Your Stats"; font-weight: 700; color: white; font-size: 18px; font-family: "Outfit"; }

                        HorizontalBox {
                            spacing: 12px;
                            VerticalBox {
                                alignment: center;
                                Text { text: total_referrals; font-size: 24px; font-weight: 700; color: #a855f7; horizontal-alignment: center; font-family: "Outfit"; }
                                Text { text: "Invites"; color: #94a3b8; font-size: 12px; horizontal-alignment: center; font-family: "Inter"; }
                            }
                            Rectangle { width: 1px; background: rgba(255, 255, 255, 0.1); height: 40px; }
                            VerticalBox {
                                alignment: center;
                                Text { text: click_count; font-size: 24px; font-weight: 700; color: #06b6d4; horizontal-alignment: center; font-family: "Outfit"; }
                                Text { text: "Clicks"; color: #94a3b8; font-size: 12px; horizontal-alignment: center; font-family: "Inter"; }
                            }
                            Rectangle { width: 1px; background: rgba(255, 255, 255, 0.1); height: 40px; }
                            VerticalBox {
                                alignment: center;
                                Text { text: reward_balance; font-size: 24px; font-weight: 700; color: #10b981; horizontal-alignment: center; font-family: "Outfit"; }
                                Text { text: "Earned"; color: #94a3b8; font-size: 12px; horizontal-alignment: center; font-family: "Inter"; }
                            }
                        }

                        HorizontalBox {
                            alignment: space-between;
                            Button { text: "📜 View History"; clicked => { view_history(); } }
                            Button { text: "📤 Export Data"; clicked => { export_data(); } }
                        }
                    }
                }

                Text { text: "Recent Referrals"; font-weight: 700; color: white; font-size: 18px; font-family: "Outfit"; }

                for r in referrals : GlassCard {
                    background: rgba(255, 255, 255, 0.03);
                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;

                        HorizontalBox {
                            Text { text: "Code: " + r.referral_code; font-weight: 700; color: white; font-family: "Outfit"; }
                            Rectangle {}
                            Text { text: r.conversions > 0 ? "✅ Joined" : "⏳ Pending"; color: r.conversions > 0 ? #10b981 : #f59e0b; font-size: 12px; font-family: "Inter"; }
                        }

                        Text { text: "Referree ID: " + r.user_id; color: #94a3b8; font-size: 12px; font-family: "Inter"; }

                        HorizontalBox {
                            spacing: 20px;
                            Text { text: "Clicks: " + r.clicks; color: #cbd5e1; font-size: 12px; font-family: "Inter"; }
                            Text { text: "Joined: " + r.created_at; color: #cbd5e1; font-size: 12px; font-family: "Inter"; }
                        }
                    }
                }
            }
        }
    }
}
