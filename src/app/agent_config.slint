import { Button, VerticalBox, HorizontalBox, CheckBox, LineEdit, Slider, ScrollView } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component AgentConfig inherits Window {
    width: 600px;
    height: 500px;
    title: "Configure Helper";

    callback activate_agent(string, bool, bool, bool, bool, string);
    callback next_step();
    callback save_state();

    in-out property <int> step: 0;
    in-out property <string> selected_agent: "";
    in-out property <string> selected_agent_display: "";
    in-out property <bool> can_reply: false;
    in-out property <bool> can_social: false;
    in-out property <bool> can_write_descriptions: false;
    in-out property <bool> can_send_updates: false;
    in-out property <float> frequency_value: 2.0;
    in-out property <string> frequency: round(frequency_value) == 0 ? "Real-time" : (round(frequency_value) == 1 ? "Hourly" : (round(frequency_value) == 2 ? "Daily" : "Weekly"));
    in-out property <bool> is_advanced: false;
    in-out property <bool> show_toast: false;

    next_step => { step = step + 1; }

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Configure Helper"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; }
            Rectangle {}
            HorizontalBox {
                spacing: 8px;
                alignment: end;
                Text { text: "Advanced"; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
                TouchArea {
                    width: 20px;
                    height: 20px;
                    clicked => { is_advanced = !is_advanced; save_state(); }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 4px;
                        border-color: #a855f7;
                        border-width: 1px;
                        background: is_advanced ? #a855f7 : transparent;
                        Text { text: is_advanced ? "✓" : ""; color: white; horizontal-alignment: center; }
                    }
                }
            }
        }

        // Step 0: Choose Agent
        if (step == 0) : VerticalBox {
            if (is_advanced) : VerticalBox {
                spacing: 8px;
                Text { text: "Developer: Raw Config Override"; font-family: "Inter"; font-size: 14px; color: #94a3b8; }
                LineEdit { placeholder-text: "{ \"agent_id\": \"override-123\" }"; }
            }
            spacing: 20px;
            Text { text: "Choose a helper to add to your team"; font-family: "Inter"; color: white; }

            ScrollView {
                height: 300px;
                VerticalBox {
                    spacing: 12px;
                    GlassCard {
                        height: 90px;
                        background: selected_agent == "CustomerSuccess" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        HorizontalBox {
                            padding: 16px; spacing: 16px; alignment: center;
                            Text { text: "🎧"; font-size: 32px; }
                            VerticalBox {
                                alignment: center;
                                Text { text: "Customer Support"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                                Text { text: "Keeps customers happy"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                            }
                            Rectangle { width: 10px; }
                            Rectangle { height: 32px; background: selected_agent == "CustomerSuccess" ? #10b981 : rgba(255,255,255,0.1); border-radius: 16px; width: 32px; Text { text: selected_agent == "CustomerSuccess" ? "✓" : "+"; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                        }
                        TouchArea { clicked => { selected_agent = "CustomerSuccess"; selected_agent_display = "Customer Support"; } }
                    }
                    GlassCard {
                        height: 90px;
                        background: selected_agent == "Marketing" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        HorizontalBox {
                            padding: 16px; spacing: 16px; alignment: center;
                            Text { text: "📱"; font-size: 32px; }
                            VerticalBox {
                                alignment: center;
                                Text { text: "Social Media Manager"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                                Text { text: "Gets the word out"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                            }
                            Rectangle { width: 10px; }
                            Rectangle { height: 32px; background: selected_agent == "Marketing" ? #10b981 : rgba(255,255,255,0.1); border-radius: 16px; width: 32px; Text { text: selected_agent == "Marketing" ? "✓" : "+"; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                        }
                        TouchArea { clicked => { selected_agent = "Marketing"; selected_agent_display = "Social Media Manager"; } }
                    }
                    GlassCard {
                        height: 90px;
                        background: selected_agent == "Sales" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        HorizontalBox {
                            padding: 16px; spacing: 16px; alignment: center;
                            Text { text: "📈"; font-size: 32px; }
                            VerticalBox {
                                alignment: center;
                                Text { text: "SEO Booster"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                                Text { text: "Finds and wins customers"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                            }
                            Rectangle { width: 10px; }
                            Rectangle { height: 32px; background: selected_agent == "Sales" ? #10b981 : rgba(255,255,255,0.1); border-radius: 16px; width: 32px; Text { text: selected_agent == "Sales" ? "✓" : "+"; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                        }
                        TouchArea { clicked => { selected_agent = "Sales"; selected_agent_display = "SEO Booster"; } }
                    }
                    GlassCard {
                        height: 90px;
                        background: selected_agent == "Operations" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        HorizontalBox {
                            padding: 16px; spacing: 16px; alignment: center;
                            Text { text: "📦"; font-size: 32px; }
                            VerticalBox {
                                alignment: center;
                                Text { text: "Order Manager"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                                Text { text: "Handles daily operations"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                            }
                            Rectangle { width: 10px; }
                            Rectangle { height: 32px; background: selected_agent == "Operations" ? #10b981 : rgba(255,255,255,0.1); border-radius: 16px; width: 32px; Text { text: selected_agent == "Operations" ? "✓" : "+"; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                        }
                        TouchArea { clicked => { selected_agent = "Operations"; selected_agent_display = "Order Manager"; } }
                    }
                    GlassCard {
                        height: 90px;
                        background: selected_agent == "Finance" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        HorizontalBox {
                            padding: 16px; spacing: 16px; alignment: center;
                            Text { text: "📧"; font-size: 32px; }
                            VerticalBox {
                                alignment: center;
                                Text { text: "Email Marketer"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                                Text { text: "Makes sure money flows"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                            }
                            Rectangle { width: 10px; }
                            Rectangle { height: 32px; background: selected_agent == "Finance" ? #10b981 : rgba(255,255,255,0.1); border-radius: 16px; width: 32px; Text { text: selected_agent == "Finance" ? "✓" : "+"; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                        }
                        TouchArea { clicked => { selected_agent = "Finance"; selected_agent_display = "Email Marketer"; } }
                    }
                }
            }
            Text { text: "Selected: " + selected_agent_display; color: #a855f7; font-family: "Inter"; font-weight: 700; }
        }

        // Step 1: Capabilities
        if (step == 1) : VerticalBox {
            spacing: 16px;
            Text { text: "What should this helper do?"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }
            
            GlassCard {
                height: 60px;
                background: can_reply ? rgba(16, 185, 129, 0.2) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                HorizontalBox {
                    padding: 16px; alignment: space-between;
                    Text { text: "Reply to customer messages"; color: white; font-family: "Inter"; font-weight: 700; vertical-alignment: center;}
                    CheckBox { checked: can_reply; toggled => { can_reply = !can_reply; } }
                }
            }
            GlassCard {
                height: 60px;
                background: can_social ? rgba(16, 185, 129, 0.2) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                HorizontalBox {
                    padding: 16px; alignment: space-between;
                    Text { text: "Post to Instagram & Facebook"; color: white; font-family: "Inter"; font-weight: 700; vertical-alignment: center;}
                    CheckBox { checked: can_social; toggled => { can_social = !can_social; } }
                }
            }
            GlassCard {
                height: 60px;
                background: can_write_descriptions ? rgba(16, 185, 129, 0.2) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                HorizontalBox {
                    padding: 16px; alignment: space-between;
                    Text { text: "Write product descriptions"; color: white; font-family: "Inter"; font-weight: 700; vertical-alignment: center;}
                    CheckBox { checked: can_write_descriptions; toggled => { can_write_descriptions = !can_write_descriptions; } }
                }
            }
            GlassCard {
                height: 60px;
                background: can_send_updates ? rgba(16, 185, 129, 0.2) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                HorizontalBox {
                    padding: 16px; alignment: space-between;
                    Text { text: "Send order updates"; color: white; font-family: "Inter"; font-weight: 700; vertical-alignment: center;}
                    CheckBox { checked: can_send_updates; toggled => { can_send_updates = !can_send_updates; } }
                }
            }
        }

        // Step 2: Frequency
        if (step == 2) : VerticalBox {
            spacing: 20px;
            Text { text: "How often should this helper work?"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }
            
            GlassCard {
                height: 120px;
                VerticalBox {
                    padding: 24px;
                    spacing: 24px;
                    HorizontalBox {
                        spacing: 10px;
                        Slider {
                            minimum: 0.0;
                            maximum: 3.0;
                            value <=> frequency_value;
                            width: 100%;
                        }
                    }
                    Text { text: "Schedule: " + frequency; color: #a855f7; horizontal-alignment: center; font-family: "Inter"; font-size: 18px; font-weight: 700; }
                }
            }
        }

        // Step 3: Review
        if (step == 3) : VerticalBox {
            spacing: 16px;
            Text { text: "Review & Activate"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }
            GlassCard {
                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "Helper: " + selected_agent_display; color: white; font-family: "Inter"; font-weight: 700; }
                    Text { text: "Reply: " + (can_reply ? "Yes" : "No"); color: #94a3b8; font-family: "Inter"; }
                    Text { text: "Social: " + (can_social ? "Yes" : "No"); color: #94a3b8; font-family: "Inter"; }
                    Text { text: "Write Descriptions: " + (can_write_descriptions ? "Yes" : "No"); color: #94a3b8; font-family: "Inter"; }
                    Text { text: "Send Updates: " + (can_send_updates ? "Yes" : "No"); color: #94a3b8; font-family: "Inter"; }
                    Text { text: "Schedule: " + frequency; color: #94a3b8; font-family: "Inter"; }
                }
            }
        }

        Rectangle {} // Spacer

        // Navigation
        HorizontalBox {
            if (step > 0) : GlassCard {
                width: 80px;
                height: 44px;
                VerticalBox { alignment: center; Text { text: "Back"; font-family: "Inter"; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { step = step - 1; } }
            }
            if (step == 0) : Rectangle { width: 80px; } // spacer
            Rectangle {} // Spacer
            GlassCard {
                width: 120px;
                height: 44px;
                background: step == 3 ? rgba(16, 185, 129, 0.8) : rgba(168, 85, 247, 0.8);
                VerticalBox { alignment: center; Text { text: step == 3 ? "Activate ✓" : "Next →"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea {
                    clicked => {
                        if (step < 3) {
                            next_step();
                        } else {
                            show_toast = true;
                            activate_agent(selected_agent, can_reply, can_social, can_write_descriptions, can_send_updates, frequency);
                        }
                    }
                }
            }
        }
    }

    if (show_toast) : GlassCard {
        width: 300px;
        height: 60px;
        x: (parent.width - self.width) / 2;
        y: parent.height - 100px;
        background: rgba(16, 185, 129, 0.9); // Green background
        VerticalBox {
            alignment: center;
            Text {
                text: "Helper Activated ✓";
                font-family: "Outfit";
                font-size: 16px;
                font-weight: 700;
                color: white;
                horizontal-alignment: center;
            }
        }
        TouchArea { clicked => { show_toast = false; } }
    }
}
