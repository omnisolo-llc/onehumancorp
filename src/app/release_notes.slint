import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export component ReleaseNotes inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "What's New";
    background: #0f172a;
    in-out property <string> current_version: "v0.4.39";
    in-out property <bool> show_latest_only: false;

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            padding: 16px;
            spacing: 20px;

            Text {
                text: "What's New in OHC";
                font-size: 24px;
                font-weight: 700;
                color: white;
            }

            ScrollView {
                VerticalBox {
                    spacing: 24px;
                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.4.39"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "Faster App Experience"; color: #38bdf8; font-weight: 600; }
                                Text { text: "- We made the app load much faster when you first open it."; color: #94a3b8; wrap: word-wrap; }
                                Text { text: "Works Without Internet"; color: #34d399; font-weight: 600; }
                                Text { text: "- You can now use the setup checklist even if your internet connection drops."; color: #94a3b8; wrap: word-wrap; }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.4.32"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "⚡ Handle More Customers Easily"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "We improved the app so it runs smoothly even when thousands of people visit your store at the same time, while keeping your business data fully private."; color: white; wrap: word-wrap; }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.3.4"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "🎉 Better Team Collaboration & Offline Reliability"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "Your agents can now work together much faster. And if you are using the app offline on your own device, it will keep running smoothly even if you lose your internet connection."; color: white; wrap: word-wrap; }
                                Rectangle {
                                    height: 150px;
                                    background: #1e293b;
                                    border-radius: 8px;
                                    Text { text: "📸 Screenshot: Agents collaborating offline"; horizontal-alignment: center; vertical-alignment: center; color: #94a3b8; }
                                }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.3.2"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "🚀 Enhanced Privacy & New Walkthrough"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "We have strengthened the way we store your business data to keep it completely private. We also added your task list directly to the main dashboard and included a new guide to help you build your website."; color: white; wrap: word-wrap; }
                                Rectangle {
                                    height: 150px;
                                    background: #1e293b;
                                    border-radius: 8px;
                                    Text { text: "📸 Screenshot: New Task List UI"; horizontal-alignment: center; vertical-alignment: center; color: #94a3b8; }
                                }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.3.1"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "🔍 Smarter Document Search"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "Your AI agents can now search and read your business documents much faster to answer questions. This even works if you are running the app fully offline on your own device."; color: white; wrap: word-wrap; }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.3.0"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "🔗 Faster Team Communication"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "We upgraded the behind-the-scenes system that lets your AI agents talk to each other in real-time. If you use the standalone app, they can now chat together seamlessly without needing an internet connection."; color: white; wrap: word-wrap; }
                            }
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 44px;
                        Text {
                            text: "Read the full update list on our website →";
                            color: #0ea5e9;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
