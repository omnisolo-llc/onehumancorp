import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export component ReleaseNotes inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "What's New";
    background: #0f172a;
    in-out property <string> current_version: "v0.4.32";
    in-out property <bool> show_latest_only: false;

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            padding: 16px;
            spacing: 20px;

            Text {
                text: "What's New in OHC";
                font-size: 24px;
                font-weight: 700;
                color: white;
            }

            ScrollView {
                VerticalBox {
                    spacing: 24px;

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.4.32 (Cloud) / v0.4.32+1 (Standalone)"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "⚡ Scale to the Moon & Protect Your Data"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "Your store can now handle thousands of visitors at once without slowing down, while keeping all your business data completely private and secure on your own device."; color: white; wrap: word-wrap; }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.3.4 (Cloud) / v0.3.4+1 (Standalone)"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "🎉 Better Team Collaboration & Offline Reliability"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "Your AI helpers can now work together much faster. And if you are using the app on your own device, it will keep running smoothly even if you lose your internet connection."; color: white; wrap: word-wrap; }
                                Rectangle {
                                    height: 150px;
                                    background: #1e293b;
                                    border-radius: 8px;
                                    Text { text: "📸 Screenshot: Agents collaborating offline"; horizontal-alignment: center; vertical-alignment: center; color: #94a3b8; }
                                }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.3.2 (Cloud) / v0.3.2+1 (Standalone)"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "🚀 Enhanced Privacy & New Walkthrough"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "We have strengthened the way we store your business data to keep it completely private. We also added your task list directly to the main dashboard and included a new guide to help you automatically build your website."; color: white; wrap: word-wrap; }
                                Rectangle {
                                    height: 150px;
                                    background: #1e293b;
                                    border-radius: 8px;
                                    Text { text: "📸 Screenshot: New Task List UI"; horizontal-alignment: center; vertical-alignment: center; color: #94a3b8; }
                                }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.3.1 (Cloud) / v0.3.1+1 (Standalone)"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "🔍 Smarter Knowledge Retrieval"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "Your AI helpers can now search and read your business documents much faster to answer questions. This even works if you are running the app fully on your own device."; color: white; wrap: word-wrap; }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.3.0 (Cloud) / v0.3.0+1 (Standalone)"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "🔗 Faster Team Communication"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "We upgraded the behind-the-scenes system that lets your AI helpers talk to each other in real-time. If you use the app on your computer, they can now chat together seamlessly without needing an external internet connection."; color: white; wrap: word-wrap; }
                            }
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 44px;
                        Text {
                            text: "Read the full changelog on the website →";
                            color: #0ea5e9;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
