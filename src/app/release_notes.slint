import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export component ReleaseNotes inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "What's New";
    background: #0f172a;
    in-out property <string> current_version: "v0.4.39";
    in-out property <bool> show_latest_only: false;

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            padding: 16px;
            spacing: 20px;

            Text {
                text: "What's New in OHC";
                font-family: "Outfit";
                font-size: 24px;
                font-weight: 700;
                color: white;
            }

            ScrollView {
                VerticalBox {
                    spacing: 24px;
                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.4.39 (Cloud) / v0.4.39+1 (Standalone)"; font-family: "Outfit"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "Cloud Scaling Improvements"; font-family: "Outfit"; color: #38bdf8; font-weight: 600; }
                                Text { text: "- Enhance multi-tenant onboarding flow tests for the Welcome Checklist to ensure reliable scaling."; font-family: "Inter"; color: #94a3b8; wrap: word-wrap; }
                                Text { text: "Privacy/Offline Improvements"; font-family: "Outfit"; color: #34d399; font-weight: 600; }
                                Text { text: "- Bolster Standalone Wizard state test coverage for improved offline reliability and progressive disclosure validation."; font-family: "Inter"; color: #94a3b8; wrap: word-wrap; }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.4.32 (Cloud) / v0.4.33+1 (Standalone)"; font-family: "Outfit"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "⚡ Scale to the Moon & Protect Your Data"; font-family: "Outfit"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "We have upgraded the backend architecture to support massive scaling for multi-tenant cloud deployments while continuing to guarantee your privacy and local capability in standalone mode."; font-family: "Inter"; color: white; wrap: word-wrap; }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.3.4 (Cloud) / v0.3.4+1 (Standalone)"; font-family: "Outfit"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "🎉 Better Team Collaboration & Offline Reliability"; font-family: "Outfit"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "Your agents can now work together much faster. And if you are using the app offline on your own device, it will keep running smoothly even if you lose your internet connection."; font-family: "Inter"; color: white; wrap: word-wrap; }
                                Rectangle {
                                    height: 150px;
                                    background: #1e293b;
                                    border-radius: 8px;
                                    Text { text: "📸 Screenshot: Agents collaborating offline"; font-family: "Inter"; horizontal-alignment: center; vertical-alignment: center; color: #94a3b8; }
                                }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.3.2 (Cloud) / v0.3.2+1 (Standalone)"; font-family: "Outfit"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "🚀 Enhanced Privacy & New Walkthrough"; font-family: "Outfit"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "We have strengthened the way we store your business data to keep it completely private. We also added your task list directly to the main dashboard and included a new guide to help you sync your website with AutoDream."; font-family: "Inter"; color: white; wrap: word-wrap; }
                                Rectangle {
                                    height: 150px;
                                    background: #1e293b;
                                    border-radius: 8px;
                                    Text { text: "📸 Screenshot: New Task List UI"; font-family: "Inter"; horizontal-alignment: center; vertical-alignment: center; color: #94a3b8; }
                                }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.3.1 (Cloud) / v0.3.1+1 (Standalone)"; font-family: "Outfit"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "🔍 Smarter Knowledge Retrieval"; font-family: "Outfit"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "Your AI agents can now search and read your business documents much faster to answer questions. This even works if you are running the app fully offline on your own device."; font-family: "Inter"; color: white; wrap: word-wrap; }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Version 0.3.0 (Cloud) / v0.3.0+1 (Standalone)"; font-family: "Outfit"; font-weight: 700; font-size: 14px; color: white; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "🔗 Faster Team Communication"; font-family: "Outfit"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "We upgraded the behind-the-scenes system that lets your AI agents talk to each other in real-time. If you use the standalone app, they can now chat together seamlessly without needing an external internet server."; font-family: "Inter"; color: white; wrap: word-wrap; }
                            }
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 44px;
                        Text {
                            text: "Read the full changelog on the website →";
                            font-family: "Inter";
                            color: #0ea5e9;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
