import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export struct ReleaseEntry {
    version: string,
    standalone_version: string,
    title: string,
    description: string,
    emoji: string,
}

export component ReleaseNotes inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "What's New";
    background: #f8fafc;
    in-out property <string> current_version: "v0.3.4";
    in-out property <bool> show_latest_only: false;

    in property <[ReleaseEntry]> releases: [
        { version: "v0.3.4", standalone_version: "v0.3.4+1", title: "Better Team Collaboration & Offline Reliability", description: "Your helpers can now work together much faster. And if you are using the app offline on your own device, it will keep running smoothly even if you lose your internet connection.", emoji: "🎉" },
        { version: "v0.3.2", standalone_version: "v0.3.2+1", title: "Enhanced Privacy & New App Tour", description: "We have strengthened the way we store your business records to keep them completely private. We also added a new guide to help you sync your website with AutoDream.", emoji: "🚀" },
        { version: "v0.3.1", standalone_version: "v0.3.1+1", title: "Smarter Knowledge Retrieval", description: "Your AI helpers can now search and read your business records much faster to answer questions. This even works if you are running the app fully offline.", emoji: "🔍" },
        { version: "v0.3.0", standalone_version: "v0.3.0+1", title: "Faster Team Communication", description: "We upgraded the behind-the-scenes system that lets your AI helpers talk to each other in real-time without needing an external internet server.", emoji: "🔗" }
    ];

    VerticalBox {
        padding: 16px;
        spacing: 20px;

        Text {
            text: "What's New in OHC";
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
            font-family: "Outfit";
        }

        ScrollView {
            VerticalBox {
                spacing: 24px;

                for release in releases : VerticalBox {
                    spacing: 8px;

                    Text {
                        text: "Version " + release.version + " (Cloud) / " + release.standalone_version + " (Standalone)";
                        font-weight: 700;
                        font-size: 12px;
                        color: #64748b;
                        font-family: "Inter";
                    }

                    Rectangle {
                        background: white;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #e2e8f0;

                        VerticalBox {
                            padding: 16px; spacing: 12px;

                            HorizontalBox {
                                spacing: 8px;
                                alignment: start;
                                Text { text: release.emoji; font-size: 20px; vertical-alignment: center; }
                                Text { text: release.title; font-weight: 700; font-size: 18px; color: #0f172a; font-family: "Outfit"; wrap: word-wrap; }
                            }

                            Text { text: release.description; color: #475569; wrap: word-wrap; font-family: "Inter"; font-size: 14px; }
                        }
                    }
                }
            }
        }

        Button {
            text: "Close";
            height: 44px;
            clicked => { root.visible = false; }
        }
    }
}
