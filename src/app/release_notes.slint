import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component ReleaseNotes inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "What's New";
    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
    in-out property <string> current_version: "v0.4.0";
    in-out property <bool> show_latest_only: false;

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            padding: 24px;
            spacing: 20px;

            Text {
                text: "What's New in OHC";
                font-family: "Outfit";
                font-size: 28px;
                font-weight: 700;
                color: white;
            }

            ScrollView {
                VerticalBox {
                    spacing: 32px;

                    VerticalBox {
                        spacing: 12px;
                        Text { text: "Version 0.4.0 (Cloud) / v0.4.0+1 (Standalone)"; font-weight: 700; font-size: 14px; color: #a855f7; font-family: "Inter"; }
                        GlassCard {
                            border-color: #6366f1;
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "✨ RADICAL SIMPLICITY UPDATE"; font-family: "Outfit"; font-weight: 700; font-size: 20px; color: white; }
                                Text { text: "We've completely redesigned the dashboard to focus on what matters most: your sales and your team. AI Helpers now have clearer roles, and navigation is faster than ever."; font-family: "Inter"; color: #cbd5e1; wrap: word-wrap; }
                                Rectangle {
                                    height: 150px;
                                    background: #1e293b;
                                    border-radius: 8px;
                                    Text { text: "[ Screenshot of New Dashboard ]"; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 12px;
                        Text { text: "Version 0.3.4 (Cloud) / v0.3.4+1 (Standalone)"; font-weight: 700; font-size: 14px; color: #94a3b8; font-family: "Inter"; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "🎉 Better Team Collaboration"; font-family: "Outfit"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "Your agents can now work together much faster. And if you are using the app offline on your own device, it will keep running smoothly."; font-family: "Inter"; color: #cbd5e1; wrap: word-wrap; }
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 12px;
                        Text { text: "Version 0.3.2 (Cloud) / v0.3.2+1 (Standalone)"; font-weight: 700; font-size: 14px; color: #94a3b8; font-family: "Inter"; }
                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                Text { text: "🚀 Enhanced Privacy"; font-family: "Outfit"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "We have strengthened the way we store your business data to keep it completely private. We also added your task list directly to the main dashboard."; font-family: "Inter"; color: #cbd5e1; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
        }
    }
}
