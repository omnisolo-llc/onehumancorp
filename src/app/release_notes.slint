import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component ReleaseNotes inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "What's New";
    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
    in-out property <string> current_version: "v0.3.4";
    in-out property <bool> show_latest_only: false;

    VerticalBox {
        padding: 24px;
        spacing: 24px;

        Text {
            text: "What's New in OHC";
            font-size: 32px;
            font-family: "Outfit";
            font-weight: 700;
            color: white;
            horizontal-alignment: center;
        }

        ScrollView {
            VerticalBox {
                spacing: 24px;

                VerticalBox {
                    spacing: 12px;
                    Text {
                        text: "Version 0.3.4 (Cloud) / v0.3.4+1 (Standalone)";
                        font-family: "Outfit";
                        font-weight: 700;
                        font-size: 16px;
                        color: #a855f7;
                    }
                    GlassCard {
                        VerticalBox {
                            padding: 20px;
                            spacing: 12px;
                            Text {
                                text: "🎉 Better Team Collaboration & Offline Reliability";
                                font-family: "Outfit";
                                font-weight: 700;
                                font-size: 20px;
                                color: white;
                            }
                            Text {
                                text: "Your helpers can now work together much faster. And if you are using the app offline on your own device, it will keep running smoothly even if you lose your internet connection.";
                                font-family: "Inter";
                                color: #94a3b8;
                                wrap: word-wrap;
                                font-size: 15px;
                            }
                        }
                    }
                }
            }
        }

        HorizontalBox {
            alignment: center;
            Button {
                text: "Got it!";
                height: 48px;
                width: 120px;
                clicked => { root.visible = false; }
            }
        }
    }
}
