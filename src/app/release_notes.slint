import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component ReleaseNotes inherits Window {
    width: 375px;
    height: 800px;
    title: "What's New";
    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
    in-out property <string> current_version: "v0.3.5";
    in-out property <bool> show_latest_only: false;

    VerticalBox {
        padding: 24px;
        spacing: 20px;

        Text {
            text: "What's New in OHC";
            font-size: 28px;
            font-family: "Outfit";
            font-weight: 700;
            color: white;
        }

        ScrollView {
            VerticalBox {
                spacing: 24px;

                // Version 0.3.5
                VerticalBox {
                    spacing: 8px;
                    Text { text: "Version 0.3.5 (Latest)"; font-weight: 700; font-size: 14px; color: #a855f7; font-family: "Inter"; }
                    GlassCard {
                        VerticalBox {
                            padding: 16px; spacing: 12px;
                            Text { text: "✍️ Integrated Help & Guides"; font-weight: 700; font-size: 18px; color: white; font-family: "Outfit"; }
                            Text { text: "We've added a beautiful new Help Center, interactive tours, and an AI Help Assistant to guide you every step of the way."; color: #94a3b8; wrap: word-wrap; font-family: "Inter"; }
                        }
                    }
                }

                // Version 0.3.4
                VerticalBox {
                    spacing: 8px;
                    Text { text: "Version 0.3.4"; font-weight: 700; font-size: 14px; color: #64748b; font-family: "Inter"; }
                    GlassCard {
                        VerticalBox {
                            padding: 16px; spacing: 12px;
                            Text { text: "🎉 Better Team Collaboration"; font-weight: 700; font-size: 18px; color: white; font-family: "Outfit"; }
                            Text { text: "Your agents can now work together much faster to manage your store and marketing."; color: #94a3b8; wrap: word-wrap; font-family: "Inter"; }
                        }
                    }
                }
            }
        }

        Button {
            text: "Got it!";
            height: 44px;
            primary: true;
            clicked => { root.visible = false; }
        }
    }
}
