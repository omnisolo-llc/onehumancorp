import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export component ReleaseNotes inherits Window {
    min-width: 375px; max-width: 1440px; preferred-width: 600px;
    height: 800px;
    title: "What's New";
    background: #f8fafc;
    in-out property <string> current_version: "v0.3.4";
    in-out property <bool> show_latest_only: false;

    VerticalBox {
        padding: 16px;
        spacing: 20px;

        Text {
            text: "What's New in OHC";
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
        }

        Text { text: "Read full changelog at ohc.io/changelog"; color: #2563eb; }

        ScrollView {
            VerticalBox {
                spacing: 24px;

                VerticalBox {
                    spacing: 8px;
                    Text { text: "Version 0.3.4"; font-weight: 700; font-size: 14px; color: #64748b; }
                    Rectangle {
                        background: white; border-radius: 8px;
                        VerticalBox {
                            padding: 16px; spacing: 12px;
                            Text { text: "🎉 Better Team Collaboration"; font-weight: 700; font-size: 18px; color: #0f172a; }
                            Text { text: "Your agents can now work together much faster. And if you are using the app offline on your own device, it will keep running smoothly even if you lose your internet connection."; color: #475569; wrap: word-wrap; }
                            Rectangle { height: 150px; background: #e2e8f0; border-radius: 4px; Text { text: "[Screenshot of new feature]"; horizontal-alignment: center; vertical-alignment: center; color: #94a3b8; } }
                        }
                    }
                }

                if (!root.show_latest_only) : VerticalBox {
                    spacing: 8px;
                    Text { text: "Version 0.3.2"; font-weight: 700; font-size: 14px; color: #64748b; }
                    Rectangle {
                        background: white; border-radius: 8px;
                        VerticalBox {
                            padding: 16px; spacing: 12px;
                            Text { text: "🚀 Enhanced Privacy"; font-weight: 700; font-size: 18px; color: #0f172a; }
                            Text { text: "We have strengthened the way we store your business data to keep it completely private."; color: #475569; wrap: word-wrap; }
                            Rectangle { height: 150px; background: #e2e8f0; border-radius: 4px; Text { text: "[Screenshot of new privacy controls]"; horizontal-alignment: center; vertical-alignment: center; color: #94a3b8; } }
                        }
                    }
                }
            }
        }
    }
}
