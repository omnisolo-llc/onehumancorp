import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export struct UiDepartment {
    id: string,
    name: string,
    description: string,
    is_active: bool,
    icon: string,
}

export component Agents inherits Window {
    width: 375px;
    height: 800px;
    title: "Your Team";

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    in property <[UiDepartment]> departments;

    callback open_department(string);
    callback close_team();

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            alignment: start;
            Text { text: "Your Team"; font-size: 28px; font-family: "Outfit"; font-weight: 700; color: white; vertical-alignment: center; }
            Rectangle {}
            Button { text: "Close"; clicked => { close_team(); } }
        }

        Text { text: "Tap a department to configure your AI helpers."; color: #cbd5e1; font-family: "Inter"; font-size: 14px; wrap: word-wrap; }

        ScrollView {
            VerticalBox {
                spacing: 16px;

                for dept in departments : GlassCard {
                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalBox {
                            Text { text: dept.icon; font-size: 32px; vertical-alignment: center; }
                            Rectangle { width: 12px; }
                            VerticalBox {
                                Text { text: dept.name; font-family: "Outfit"; font-weight: 700; font-size: 18px; color: white; }
                                Text { text: "Status: " + (dept.is_active ? "Active" : "Inactive"); font-family: "Inter"; font-size: 12px; color: dept.is_active ? #10b981 : #94a3b8; }
                            }
                        }

                        Text { text: dept.description; font-family: "Inter"; font-size: 14px; color: #cbd5e1; wrap: word-wrap; }
                    }
                    TouchArea { clicked => { open_department(dept.id); } }
                }
            }
        }
    }
}
