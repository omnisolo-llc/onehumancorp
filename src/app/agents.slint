import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";
import { UpgradePrompt } from "./upgrade_prompt.slint";

export struct UiAgent {
    id: string,
    name: string,
    role: string,
    status: string,
    is_running: bool,
    svid_verified: bool,
    is_new: bool,
}

export component Agents inherits Window {
    width: 500px;
    height: 600px;
    title: "Helpers";

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    in property <[UiAgent]> agents;

    in-out property <bool> show_upgrade_prompt: false;
    in-out property <string> upgrade_prompt_message: "";
    in-out property <bool> is_advanced: false;

    callback hire_agent();
    callback fix_agent(string);
    callback toggle_advanced();

    toggle_advanced => { is_advanced = !is_advanced; }

    if (show_upgrade_prompt) : UpgradePrompt {
        message: root.upgrade_prompt_message;
        action_dismiss => { root.show_upgrade_prompt = false; }
    }

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Helpers"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; }
            Rectangle {}
            HorizontalBox {
                spacing: 8px;
                alignment: end;
                Text { text: "Expert Mode"; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
                TouchArea {
                    width: 20px;
                    height: 20px;
                    clicked => { toggle_advanced(); }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 4px;
                        border-color: #a855f7;
                        border-width: 1px;
                        background: is_advanced ? #a855f7 : transparent;
                        Text { text: is_advanced ? "✓" : ""; color: white; horizontal-alignment: center; }
                    }
                }
            }
            Rectangle { width: 16px; }
            Button { text: "Hire Helper"; clicked => { hire_agent(); } }
        }

        VerticalBox {
            spacing: 10px;
            
            for agent in agents : GlassCard {
                
                if (agent.is_new) : Rectangle {
                    background: transparent;
                    border-radius: 12px;
                    border-width: 2px;
                    border-color: #10b981;
                    property <bool> is_bright: true;
                    opacity: is_bright ? 1.0 : 0.2;
                    animate opacity { duration: 1000ms; easing: ease-in-out; }
                    Timer {
                        interval: 1000ms;
                        running: true;
                        triggered => { is_bright = !is_bright; }
                    }
                }
                HorizontalBox {
                    padding: 16px;
                    Text { text: "🤖"; font-size: 32px; horizontal-alignment: center; }
                    VerticalBox {
                        Text { text: agent.name; font-family: "Inter"; font-weight: 700; color: white; }
                        Text { text: agent.role; font-family: "Inter"; color: #94a3b8; }
                        if (is_advanced) : Text { text: "ID: " + agent.id; font-family: "Inter"; font-size: 12px; color: #a855f7; }
                    }
                    Rectangle {} 
                    VerticalBox {
                        Text { 
                            text: agent.status; 
                            font-family: "Inter";
                            color: agent.is_running ? #10b981 : #ef4444; 
                            horizontal-alignment: center; 
                        }
                        if (!agent.is_running) : Button { text: "Help me fix this"; clicked => { fix_agent(agent.id); } }
                    }
                }
            }
        }
    }
}
