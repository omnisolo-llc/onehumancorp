import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct UiAiConfigProvider {
    id: string,
    name: string,
    base_url: string,
    is_official: bool,
    models: [string],
}

export component AiConfig inherits Window {
    min-width: 375px;
    preferred-width: 500px;
    height: 600px;
    title: "AI Providers";
    out property <string> test_title: root.title;

    background: #f8fafc;

    in property <[UiAiConfigProvider]> providers;
    in-out property <bool> is_advanced: false;

    callback add_provider();
    callback edit_provider(string);
    callback toggle_advanced();

    toggle_advanced => { is_advanced = !is_advanced; }

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "AI Providers"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            HorizontalBox {
                spacing: 8px;
                alignment: end;
                Text { text: "Advanced Mode"; color: #94a3b8; font-size: 14px; }
                TouchArea {
                    preferred-width: 20px;
                    height: 20px;
                    clicked => { toggle_advanced(); }
                    Rectangle {
                        preferred-width: 100%;
                        height: 100%;
                        border-radius: 4px;
                        border-color: #a855f7;
                        border-width: 1px;
                        background: is_advanced ? #a855f7 : transparent;
                        Text { text: is_advanced ? "✓" : ""; color: white; horizontal-alignment: center; }
                    }
                }
            }
            if (is_advanced) : Button {
                text: "Add Provider"; 
                clicked => { add_provider(); }
            }
        }

        VerticalBox {
            spacing: 10px;
            
            for p in providers : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalBox {
                        Text { text: "🧠 " + p.name; font-weight: 700; color: #1e293b; horizontal-alignment: center; }
                        Rectangle {}
                        if (p.is_official) : Text { text: "Official"; color: #a855f7; horizontal-alignment: center; }
                        Button { 
                            text: "Edit"; 
                            clicked => { edit_provider(p.id); }
                        }
                    }
                    if (is_advanced) : Text { text: p.base_url; color: #64748b; }
                    if (is_advanced) : HorizontalBox {
                        spacing: 5px;
                        for model in p.models : Rectangle { 
                            background: #e2e8f0; 
                            border-radius: 4px; 
                            HorizontalBox { padding: 4px; Text { text: model; color: #1e293b; } } 
                        }
                    }
                }
            }
        }
    }
}
