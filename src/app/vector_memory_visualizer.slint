import { VerticalBox, HorizontalBox } from "std-widgets.slint";

export component VectorMemoryVisualizer inherits Window {
    background: rgba(255, 255, 255, 0.03);
    padding: 16px;

    in-out property <int> memories_saved: 0;
    in-out property <int> memories_searched: 0;

    VerticalBox {
        spacing: 16px;

        Text {
            text: "Memory Processing Engine";
            font-size: 18px;
            font-weight: 700;
            color: white;
            font-family: "Outfit";
        }

        HorizontalBox {
            spacing: 20px;

            // Left Side: Memories being saved
            Rectangle {
                background: rgba(0, 0, 0, 0.2);
                border-radius: 8px;
                padding: 12px;

                VerticalBox {
                    spacing: 8px;
                    Text {
                        text: "Memories Saved";
                        font-size: 14px;
                        color: #94a3b8;
                        font-family: "Inter";
                    }
                    Text {
                        text: memories_saved;
                        font-size: 32px;
                        font-weight: 700;
                        color: #10b981; // Green for saved
                        font-family: "Inter";
                    }
                    Text {
                        text: "Consolidating past tasks...";
                        font-size: 12px;
                        color: #64748b;
                        font-family: "Inter";
                    }
                }
            }

            // Right Side: Memories being searched
            Rectangle {
                background: rgba(0, 0, 0, 0.2);
                border-radius: 8px;
                padding: 12px;

                VerticalBox {
                    spacing: 8px;
                    Text {
                        text: "Memories Searched";
                        font-size: 14px;
                        color: #94a3b8;
                        font-family: "Inter";
                    }
                    Text {
                        text: memories_searched;
                        font-size: 32px;
                        font-weight: 700;
                        color: #3b82f6; // Blue for searched
                        font-family: "Inter";
                    }
                    Text {
                        text: "Finding relevant context...";
                        font-size: 12px;
                        color: #64748b;
                        font-family: "Inter";
                    }
                }
            }
        }
    }
}
