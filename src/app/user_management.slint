import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";
import { Referrals } from "referrals.slint";

export struct UiUser {
    id: string,
    username: string,
    email: string,
    role: string,
    joined_at: string,
    avatar_letter: string,
}

export component GrowthReferralWidget inherits Rectangle {
    callback invite_user();

    background: ta.has-hover ? rgba(255, 255, 255, 0.05) : rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    drop-shadow-blur: ta.has-hover ? 25px : 20px;
    drop-shadow-color: rgba(0, 0, 0, 0.5);

    animate background { duration: 200ms; easing: ease-in-out; }
    animate drop-shadow-blur { duration: 200ms; easing: ease-in-out; }

    ta := TouchArea {}

    VerticalBox {
        padding: 16px;
        spacing: 10px;
        Text { text: "Referral Program"; font-family: "Outfit"; font-weight: 700; color: white; }
        Text { text: "Invite a collaborator to securely view agents in Cloud Mode"; font-family: "Inter"; color: #94a3b8; font-size: 14px; }
        Button { text: "Invite User"; clicked => { root.invite_user(); } }
    }
}

export component UserManagement inherits Window {
    width: 500px;
    height: 600px;
    title: "User Management";

    in property <[UiUser]> users;
    callback delete_user(string);
    callback invite_user();

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "User Management"; font-size: 20px; font-weight: 700; color: white; }
            Rectangle {}
            GrowthReferralWidget {
                invite_user => { root.invite_user(); }
            }
        }

        VerticalBox {
            spacing: 12px;
            
            for u in users : GlassCard {
                HorizontalBox {
                    padding: 16px;
                    Rectangle {
                        background: #a855f7;
                        border-radius: 16px;
                        width: 32px;
                        height: 32px;
                        HorizontalBox { padding: 2px; Text { text: u.avatar_letter; font-size: 16px; font-weight: 700; color: white; horizontal-alignment: center; } }
                    }
                    VerticalBox {
                        HorizontalBox {
                            Text { text: u.username; font-weight: 700; color: white; }
                            Rectangle { 
                                background: rgba(168, 85, 247, 0.2); 
                                border-radius: 4px; 
                                HorizontalBox {
                                    padding: 2px;
                                    Text { text: u.role; color: #a855f7; font-size: 10px; } 
                                }
                            }
                        }
                        Text { text: u.email; color: #94a3b8; }
                        Text { text: "Joined: " + u.joined_at; color: #9ca3af; font-size: 12px; }
                    }
                    Rectangle {} 
                    Button { text: "Delete"; clicked => { delete_user(u.id); } }
                }
            }
        }
    }
}
