import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export struct UiMcpTool {
    id: string,
    name: string,
    description: string,
}

export component Integrations inherits Window {
    width: 500px;
    height: 600px;
    title: "Integrations & Tools";
    out property <string> test_title: root.title;

    background: #f8fafc;

    in property <[UiMcpTool]> tools;
    callback configure_integration(string);
    callback invoke_tool(string);

    ScrollView {
        VerticalBox {
            spacing: 20px;
            padding: 24px;

        Text { text: "External Channels"; font-size: 20px; font-weight: 700; color: #1e293b; }

        HorizontalBox {
            spacing: 16px;
            
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "✈️ Telegram"; font-weight: 700; color: #1e293b; }
                    Text { text: "Get mobile alerts"; color: #64748b; wrap: word-wrap; }
                    Button { 
                        text: "Configure"; 
                        clicked => { configure_integration("Telegram"); }
                    }
                }
            }
            
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "👾 Discord"; font-weight: 700; color: #1e293b; }
                    Text { text: "Send messages to your team"; color: #64748b; wrap: word-wrap; }
                    Button { 
                        text: "Configure"; 
                        clicked => { configure_integration("Discord"); }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 16px;

            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "💬 Twilio"; font-weight: 700; color: #1e293b; }
                    Text { text: "Send text messages to customers"; color: #64748b; wrap: word-wrap; }
                    Button {
                        text: "Configure";
                        clicked => { configure_integration("Twilio"); }
                    }
                }
            }

            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "📅 Cal.com"; font-weight: 700; color: #1e293b; }
                    Text { text: "Automated appointment booking"; color: #64748b; wrap: word-wrap; }
                    Button {
                        text: "Configure";
                        clicked => { configure_integration("Cal.com"); }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 16px;

            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "💬 ManyChat"; font-weight: 700; color: #1e293b; }
                    Text { text: "Manage social media messages"; color: #64748b; wrap: word-wrap; }
                    Button {
                        text: "Configure";
                        clicked => { configure_integration("ManyChat"); }
                    }
                }
            }
        }


        HorizontalBox {
            spacing: 16px;

            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "📧 Resend"; font-weight: 700; color: #1e293b; }
                    Text { text: "Send email marketing campaigns"; color: #64748b; wrap: word-wrap; }
                    Button {
                        text: "Configure";
                        clicked => { configure_integration("Resend"); }
                    }
                }
            }

            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "📦 Shippo"; font-weight: 700; color: #1e293b; }
                    Text { text: "Buy shipping labels"; color: #64748b; wrap: word-wrap; }
                    Button {
                        text: "Configure";
                        clicked => { configure_integration("Shippo"); }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 16px;

            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "💳 Mercado Pago"; font-weight: 700; color: #1e293b; }
                    Text { text: "Local Payment Methods (LATAM)"; color: #64748b; wrap: word-wrap; }
                    Button {
                        text: "Configure";
                        clicked => { configure_integration("Mercado Pago"); }
                    }
                }
            }

            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "💳 Razorpay"; font-weight: 700; color: #1e293b; }
                    Text { text: "Local Payment Methods (India)"; color: #64748b; wrap: word-wrap; }
                    Button {
                        text: "Configure";
                        clicked => { configure_integration("Razorpay"); }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 16px;

            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "📹 Zoom"; font-weight: 700; color: #1e293b; }
                    Text { text: "Create video meetings"; color: #64748b; wrap: word-wrap; }
                    Button {
                        text: "Configure";
                        clicked => { configure_integration("Zoom"); }
                    }
                }
            }
        }

        Text { text: "Advanced Tool Connections"; font-size: 20px; font-weight: 700; color: #1e293b; }
        Text { text: "Manually trigger advanced connected tools for your business."; color: #64748b; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 8px;
            
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                
                for tool in tools : HorizontalBox {
                    Text { text: "🛠️ " + tool.name; font-weight: 700; color: #1e293b; horizontal-alignment: center; }
                    Rectangle {} 
                    Button { 
                        text: "Run Tool";
                        clicked => { invoke_tool(tool.id); }
                    }
                }
            }
          }
    }
    }
}
