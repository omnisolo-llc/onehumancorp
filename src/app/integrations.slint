import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export struct UiMcpTool {
    id: string,
    name: string,
    description: string,
}

export component Integrations inherits Window {
    width: 500px;
    height: 600px;
    title: "Integrations & Tools";
    out property <string> test_title: root.title;

    background: #f8fafc;

    in property <[UiMcpTool]> tools;
    callback configure_integration(string);
    callback invoke_tool(string);

    ScrollView {
        VerticalBox {
            spacing: 20px;
            padding: 24px;

            Text { text: "External Channels"; font-size: 20px; font-weight: 700; color: #1e293b; font-family: "Outfit"; }

            VerticalBox {
                spacing: 16px;

                // 1. Social Media Integration
                Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;

                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        Text { text: "💬 Meta Graph API"; font-weight: 700; color: #1e293b; font-family: "Outfit"; }
                        Text { text: "Unified Social Media DMs (Instagram, Facebook, WhatsApp)"; color: #64748b; wrap: word-wrap; font-family: "Inter"; }
                        Button {
                            text: "Connect";
                            clicked => { configure_integration("Meta Graph API"); }
                        }
                    }
                }

                // 2. Calendar & Scheduling
                Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;

                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        Text { text: "📅 Cal.com"; font-weight: 700; color: #1e293b; font-family: "Outfit"; }
                        Text { text: "Automated appointment booking"; color: #64748b; wrap: word-wrap; font-family: "Inter"; }
                        Button {
                            text: "Configure";
                            clicked => { configure_integration("Cal.com"); }
                        }
                    }
                }

                // 3. Email Marketing
                Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;

                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        Text { text: "📧 Resend"; font-weight: 700; color: #1e293b; font-family: "Outfit"; }
                        Text { text: "Native Email Campaign Manager"; color: #64748b; wrap: word-wrap; font-family: "Inter"; }
                        Button {
                            text: "Configure";
                            clicked => { configure_integration("Resend"); }
                        }
                    }
                }

                // 4. Payment Processing (LATAM Focus)
                Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;

                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        Text { text: "💳 Mercado Pago"; font-weight: 700; color: #1e293b; font-family: "Outfit"; }
                        Text { text: "Local Payment Methods (LATAM)"; color: #64748b; wrap: word-wrap; font-family: "Inter"; }
                        Button {
                            text: "Configure";
                            clicked => { configure_integration("Mercado Pago"); }
                        }
                    }
                }

                // 5. Shipping & Logistics
                Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;

                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        Text { text: "📦 Shippo"; font-weight: 700; color: #1e293b; font-family: "Outfit"; }
                        Text { text: "Shipping Rate & Label Generation"; color: #64748b; wrap: word-wrap; font-family: "Inter"; }
                        Button {
                            text: "Configure";
                            clicked => { configure_integration("Shippo"); }
                        }
                    }
                }

                // 6. SMS & Notifications
                Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;

                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        Text { text: "📱 Twilio"; font-weight: 700; color: #1e293b; font-family: "Outfit"; }
                        Text { text: "Send SMS alerts to customers"; color: #64748b; wrap: word-wrap; font-family: "Inter"; }
                        Button {
                            text: "Configure";
                            clicked => { configure_integration("Twilio"); }
                        }
                    }
                }

                // 7. Video Conferencing
                Rectangle {
                    background: white;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    border-radius: 8px;

                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        Text { text: "📹 Zoom"; font-weight: 700; color: #1e293b; font-family: "Outfit"; }
                        Text { text: "Native Link Generation for Appointments"; color: #64748b; wrap: word-wrap; font-family: "Inter"; }
                        Button {
                            text: "Configure";
                            clicked => { configure_integration("Zoom"); }
                        }
                    }
                }
            }

            Text { text: "Advanced Tool Connections"; font-size: 20px; font-weight: 700; color: #1e293b; font-family: "Outfit"; }
            Text { text: "Manually trigger advanced connected tools for your business."; color: #64748b; font-family: "Inter"; }

            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;

                VerticalBox {
                    padding: 16px;
                    spacing: 10px;

                    for tool in tools : HorizontalBox {
                        Text { text: "🛠️ " + tool.name; font-weight: 700; color: #1e293b; horizontal-alignment: center; font-family: "Outfit"; }
                        Rectangle {}
                        Button {
                            text: "Invoke";
                            clicked => { invoke_tool(tool.id); }
                        }
                    }
                }
            }
        }
    }
}
