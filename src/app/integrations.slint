import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct UiMcpTool {
    id: string,
    name: string,
    description: string,
}

export component Integrations inherits Window {
    width: 500px;
    height: 600px;
    title: "Integrations & Tools";

    background: #f8fafc;

    in property <[UiMcpTool]> tools;
    callback configure_integration(string);
    callback invoke_tool(string);

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        Text { text: "External Channels"; font-size: 20px; font-weight: 700; color: #1e293b; }

        HorizontalBox {
            spacing: 16px;
            
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "✈️ Telegram"; font-weight: 700; color: #1e293b; }
                    Text { text: "Connect your bot for mobile alerts"; color: #64748b; wrap: word-wrap; }
                    Button { 
                        text: "Configure"; 
                        clicked => { configure_integration("Telegram"); }
                    }
                }
            }
            
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "👾 Discord"; font-weight: 700; color: #1e293b; }
                    Text { text: "Stream agent logs to a channel"; color: #64748b; wrap: word-wrap; }
                    Button { 
                        text: "Configure"; 
                        clicked => { configure_integration("Discord"); }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 16px;

            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "💬 Twilio"; font-weight: 700; color: #1e293b; }
                    Text { text: "Send SMS alerts to customers"; color: #64748b; wrap: word-wrap; }
                    Button {
                        text: "Configure";
                        clicked => { configure_integration("Twilio"); }
                    }
                }
            }
        }

        Text { text: "Advanced Tool Connections"; font-size: 20px; font-weight: 700; color: #1e293b; }
        Text { text: "Manually trigger advanced connected tools for your business."; color: #64748b; }

        Rectangle {
            background: white;
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 8px;
            
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                
                for tool in tools : HorizontalBox {
                    Text { text: "🛠️ " + tool.name; font-weight: 700; color: #1e293b; horizontal-alignment: center; }
                    Rectangle {} 
                    Button { 
                        text: "Invoke"; 
                        clicked => { invoke_tool(tool.id); }
                    }
                }
            }
        }
    }
}
