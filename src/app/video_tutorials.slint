import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export struct VideoMetadata {
    title: string,
    description: string,
    duration_sec: int,
    url: string,
    thumbnail_url: string,
}

export component VideoTutorials inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "Video Tutorials";
    background: #0f172a;
    in-out property <string> selected_video_title: "";
    in-out property <bool> is_playing: false;
    in-out property <[VideoMetadata]> videos: [];

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            padding: 16px;
            spacing: 20px;

            Text {
                text: "Watch & Learn";
                font-size: 24px;
                font-weight: 700;
                color: white;
            }

            ScrollView {
                VerticalBox {
                    spacing: 24px;

                    for video in videos : GlassCard {
                        VerticalBox {
                            padding: 16px; spacing: 12px;

                            // Portrait-optimized mobile player logic
                            Rectangle {
                                width: 100%;
                                // Portrait optimized player for mobile (375px viewport), otherwise standard 16:9 ratio.
                                height: root.width <= 400px ? 450px : 200px;
                                background: #0f172a;
                                border-radius: 8px;

                                TouchArea {
                                    clicked => {
                                        root.selected_video_title = video.title;
                                        root.is_playing = true;
                                    }
                                }

                                if (root.selected_video_title == video.title && root.is_playing): Text {
                                    text: "■ Playing Video...";
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    font-weight: 700;
                                    color: #10b981;
                                }

                                if (root.selected_video_title != video.title || !root.is_playing): Text {
                                    text: "▶ Play Video (" + video.duration_sec + "s)";
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    font-weight: 700;
                                    color: white;
                                }
                            }
                            Text { text: video.title; font-weight: 700; font-size: 18px; color: white; }
                            Text { text: video.description; color: white; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
    }
}
