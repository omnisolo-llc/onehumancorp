import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export struct VideoMetadata {
    title: string,
    description: string,
    duration_sec: int,
    url: string,
    thumbnail_url: string,
}

export component VideoTutorials inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "Video Tutorials";
    out property <string> test_title: root.title;
    background: #0f172a;
    in-out property <string> selected_video_title: "";
    in-out property <bool> is_playing: false;
    in-out property <[VideoMetadata]> videos: [];

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            padding: 16px;
            spacing: 20px;

            Text {
                text: "Watch & Learn";
                font-size: 24px;
                font-weight: 700;
                color: white;
            }

            ScrollView {
                VerticalBox {
                    spacing: 24px;

                    for video in videos : GlassCard {
                        VerticalBox {
                            padding: 16px; spacing: 12px;
                            Rectangle {
                                height: 200px;
                                background: #0f172a;
                                border-radius: 8px;
                                Text { text: "▶ Play Video"; horizontal-alignment: center; vertical-alignment: center; font-weight: 700; color: white; }
                            }
                            Text { text: video.title; font-weight: 700; font-size: 18px; color: white; }
                            Text { text: video.description; color: white; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
    }
}
