import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component VideoTutorials inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "Watch & Learn";
    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
    in-out property <string> selected_video_title: "";
    in-out property <bool> is_playing: false;

    VerticalBox {
        padding: 24px;
        spacing: 24px;

        Text {
            text: "Watch & Learn";
            font-size: 32px;
            font-family: "Outfit";
            font-weight: 700;
            color: white;
            horizontal-alignment: center;
        }

        ScrollView {
            VerticalBox {
                spacing: 24px;

                GlassCard {
                    VerticalBox {
                        padding: 16px;
                        spacing: 16px;
                        Rectangle {
                            height: 200px;
                            background: rgba(255, 255, 255, 0.05);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: rgba(255, 255, 255, 0.1);

                            Text {
                                text: "▶ Play Video";
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                font-family: "Outfit";
                                font-weight: 700;
                                color: #a855f7;
                                font-size: 20px;
                            }
                        }
                        VerticalBox {
                            spacing: 4px;
                            Text {
                                text: "How to add your first product";
                                font-family: "Outfit";
                                font-weight: 700;
                                font-size: 20px;
                                color: white;
                            }
                            Text {
                                text: "A quick 60-second guide to listing items in your store.";
                                font-family: "Inter";
                                color: #94a3b8;
                                wrap: word-wrap;
                                font-size: 14px;
                            }
                        }

                        HorizontalBox {
                            alignment: end;
                            Button {
                                text: "Watch Now";
                                height: 44px;
                                clicked => {
                                    selected_video_title = "How to add your first product";
                                    is_playing = true;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
