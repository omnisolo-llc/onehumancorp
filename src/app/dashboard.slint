import { TooltipElement } from "tooltip_element.slint";
import {  Button, VerticalBox, HorizontalBox, ScrollView  } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";
import { SwarmObservability, UiMeshMessage } from "swarm_observability.slint";

export struct UiPendingApproval {
    task_id: string,
    title: string,
    proposed_content: string,
}

export struct UiRoleCount {
    role: string,
    count: int,
}

export component Dashboard inherits Window {
    width: 375px;
    height: 800px;
    title: "Dashboard";

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    in property <string> todays_sales: "$0.00";
    in property <int> new_orders_count: 0;
    in property <int> active_helpers_count: 0;
    in property <int> tasks_in_progress_count: 0;

    in property <[UiPendingApproval]> pending_approvals;
    in property <[UiRoleCount]> swarm_roles;
    in property <string> current_view: "dashboard";
    in property <int> open_threads: 0;
    in property <[UiMeshMessage]> mesh_messages;
    in property <bool> is_offline: false;
    in property <string> system_status: "Online";

    in-out property <bool> show_menu: false;
    in-out property <bool> show_milestone: false;
    in-out property <bool> show_quick_actions_hint: false;
    in property <string> milestone_title: "";
    in property <string> milestone_message: "";

    callback action_view_orders();
    callback action_check_messages();
    callback action_add_product();
    callback action_share_store();
    callback action_see_analytics();
    callback action_open_referrals();
    callback approve_task(string);
    callback reject_task(string);
    callback dismiss_milestone();

    // Feature handlers
    callback open_agents();
    callback open_website_builder();
    callback open_ai_config();
    callback open_my_plan();
    callback open_cost_dashboard();
    callback open_help_center();
    callback open_video_tutorials();
    callback open_interactive_walkthrough();
    callback open_ai_chat();
    callback open_api_docs();
    callback open_release_notes();
    callback open_handoffs();
    callback open_billing();

    VerticalBox {
        padding: 20px;
        spacing: 16px;

        // Top Navigation
        HorizontalBox {
            alignment: space-between;
            Text {
                text: "My Store";
                font-family: "Outfit";
                font-weight: 700;
                font-size: 24px;
                color: white;
                vertical-alignment: center;
            }
            HorizontalBox {
                spacing: 8px;
                TooltipElement { tooltip_id: "ask_ai"; Button { text: "Ask AI"; height: 44px; clicked => { open_ai_chat(); } } }
                TooltipElement { tooltip_id: "menu"; Button { text: "Menu"; height: 44px; clicked => { show_menu = !show_menu; } } }
            }
        }

        if (show_menu) : Rectangle {
            background: #1A1A33;
            border-radius: 8px;
            padding: 12px;
            VerticalBox {
                spacing: 8px;
                Button { text: "Help Center"; height: 44px; clicked => { open_help_center(); show_menu = false; } }
                Button { text: "Docs"; height: 44px; clicked => { open_api_docs(); show_menu = false; } }
                Button { text: "API Docs"; height: 44px; clicked => { open_api_docs(); show_menu = false; } }
                Button { text: "Video Tutorials"; height: 44px; clicked => { open_video_tutorials(); show_menu = false; } }
                Button { text: "Videos"; height: 44px; clicked => { open_video_tutorials(); show_menu = false; } }
                Button { text: "App Tour"; height: 44px; clicked => { open_interactive_walkthrough(); show_menu = false; } }
                Button { text: "What's New"; height: 44px; clicked => { open_release_notes(); show_menu = false; } }
                Button { text: "Settings"; height: 44px; clicked => { show_menu = false; } }
                Button { text: "Billing"; height: 44px; clicked => { open_billing(); show_menu = false; } }
                Button { text: "Handoffs"; height: 44px; clicked => { open_handoffs(); show_menu = false; } }
            }
        }

        if (is_offline) : Rectangle {
            height: 32px;
            background: #f59e0b;
            border-radius: 4px;
            Text {
                text: "⚠️ Offline Mode - Changes will sync when online";
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 12px;
            }
        }

        if (!is_offline) : Rectangle {
            height: 32px;
            background: #10b981;
            border-radius: 4px;
            Text {
                text: "✓ " + system_status;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 12px;
            }
        }

        ScrollView {
            VerticalBox {
                spacing: 20px;

                if (show_milestone) : GlassCard {
                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        Text { text: milestone_title; color: white; font-weight: 700; font-size: 18px; }
                        Text { text: milestone_message; color: white; wrap: word-wrap; }
                        HorizontalBox {
                            alignment: end;
                            Button { text: "Dismiss"; clicked => { dismiss_milestone(); show_milestone = false; } }
                        }
                    }
                }

                // Today's Sales
                GlassCard {
                    height: 120px;
                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "Today's Sales";
                            color: #94a3b8;
                            font-family: "Inter";
                            font-size: 14px;
                        }
                        Text {
                            text: todays_sales;
                            color: white;
                            font-family: "Outfit";
                            font-size: 36px;
                            font-weight: 700;
                        }
                    }
                }

                // AI Agents Overview
                GlassCard {
                    VerticalBox {
                        padding: 16px;
                        spacing: 16px;

                        HorizontalBox {
                            alignment: space-between;
                            Text {
                                text: "AI Assistants";
                                color: white;
                                font-family: "Outfit";
                                font-weight: 700;
                                font-size: 18px;
                            }
                            Button {
                                text: "Manage";
                                clicked => { open_agents(); }
                            }
                        }

                        HorizontalBox {
                            spacing: 12px;

                            Rectangle {
                                background: #ffffff10;
                                border-radius: 8px;
                                height: 80px;
                                VerticalBox {
                                    alignment: center;
                                    Text {
                                        text: active_helpers_count;
                                        color: #0ea5e9;
                                        font-size: 24px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Active";
                                        color: #94a3b8;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                background: #ffffff10;
                                border-radius: 8px;
                                height: 80px;
                                VerticalBox {
                                    alignment: center;
                                    Text {
                                        text: tasks_in_progress_count;
                                        color: #10b981;
                                        font-size: 24px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Working";
                                        color: #94a3b8;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                if (pending_approvals.length > 0) : GlassCard {
                    VerticalBox {
                        padding: 16px;
                        spacing: 16px;
                        Text {
                            text: "Needs Your Approval";
                            color: #f59e0b;
                            font-family: "Outfit";
                            font-weight: 700;
                            font-size: 18px;
                        }

                        for approval in pending_approvals: Rectangle {
                            background: #ffffff05;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #ffffff10;

                            VerticalBox {
                                padding: 12px;
                                spacing: 8px;
                                Text {
                                    text: approval.title;
                                    color: white;
                                    font-weight: 700;
                                }
                                Text {
                                    text: approval.proposed_content;
                                    color: #94a3b8;
                                    wrap: word-wrap;
                                }
                                HorizontalBox {
                                    spacing: 8px;
                                    alignment: end;
                                    Button {
                                        text: "Reject";
                                        clicked => { reject_task(approval.task_id); }
                                    }
                                    Button {
                                        text: "Approve";
                                        clicked => { approve_task(approval.task_id); }
                                    }
                                }
                            }
                        }
                    }
                }

                // Swarm Observability (New section)
                SwarmObservability {
                    messages: root.mesh_messages;
                }

                if (show_quick_actions_hint) : Rectangle {
                    height: 32px;
                    background: #f59e0b;
                    border-radius: 4px;
                    Text { text: "Quick actions enabled"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                }

                // Quick Actions
                HorizontalBox {
                    spacing: 12px;
                    TooltipElement { tooltip_id: "add_product"; Button { text: "Add Product"; height: 44px; clicked => { action_add_product(); } } }
                    TooltipElement { tooltip_id: "view_orders"; Button { text: "View Orders"; height: 44px; clicked => { action_view_orders(); } } }
                    TooltipElement { tooltip_id: "messages"; Button { text: "Messages"; height: 44px; clicked => { action_check_messages(); } } }
                    TooltipElement { tooltip_id: "referrals"; Button { text: "Referrals"; height: 44px; clicked => { action_open_referrals(); } } }
                }

                HorizontalBox {
                    spacing: 12px;
                    Button { text: "Website"; height: 44px; clicked => { open_website_builder(); } }
                    Button { text: "My Plan"; height: 44px; clicked => { open_my_plan(); } }
                    Button { text: "Costs"; height: 44px; clicked => { open_cost_dashboard(); } }
                    Button { text: "AI Settings"; height: 44px; clicked => { open_ai_config(); } }
                    Button { text: "Share Store"; height: 44px; clicked => { action_share_store(); } }
                    Button { text: "Analytics"; height: 44px; clicked => { action_see_analytics(); } }
                }

            }
        }
    }
}
