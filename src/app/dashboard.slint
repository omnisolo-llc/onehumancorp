import { TooltipElement } from "tooltip_element.slint";
import {  Button, VerticalBox, HorizontalBox  } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";
import { SwarmObservability, UiMeshMessage } from "swarm_observability.slint";


export struct UiPendingApproval {
    task_id: string,
    title: string,
    proposed_content: string,
}

export struct UiRoleCount {
    role: string,
    count: int,
}

component StatCard inherits GlassCard {
    in property <string> label;
    in property <string> value;
    in property <color> value-color;

    border-color: #e2e8f0;
    border-width: 1px;
    border-radius: 12px;
    width: 100%;
    min-height: 88px;

    TouchArea {
        width: 100%;
        height: 100%;
        VerticalBox {
            padding: 16px;
            Text { text: label; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
            Text { text: value; font-size: 32px; font-family: "Outfit"; font-weight: 700; color: value-color; }
        }
    }
}

export component Dashboard inherits Window {
    width: 375px;
    height: 800px;
    title: "Dashboard";

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    in property <string> todays_sales: "$0.00";
    in-out property <int> orders_to_ship_count: 0;
    in property <int> active_helpers_count: 0;
    in-out property <int> current_tasks_count: 0;

    // Backward compatibility for old names if needed by Rust, but better to update Rust too
    in-out property <int> new_orders_count <=> orders_to_ship_count;
    in-out property <int> tasks_in_progress_count <=> current_tasks_count;

    in property <[UiPendingApproval]> pending_approvals;
    in property <[UiRoleCount]> role_counts;
    in property <[UiMeshMessage]> mesh_messages;

    in-out property <bool> show_milestone: false;
    in property <string> milestone_title: "";
    in property <string> milestone_message: "";
    callback dismiss_milestone();

    callback open_help_center();
    callback open_ai_chat();
    callback open_interactive_walkthrough();
    callback open_video_tutorials();
    callback open_release_notes();
    callback open_api_docs();
    callback approve_task(string);
    callback open_billing();

    callback action_add_product();
    callback action_view_orders();
    callback action_check_messages();
    callback action_see_analytics();
    callback action_share_store();
    callback action_open_referrals();
    callback action_grow_business();

    in-out property <bool> show_quick_actions_hint: false;
    in-out property <bool> show_menu: false;
    in-out property <bool> is_loading: false;

    Flickable {
    VerticalBox {
        spacing: 20px;
        padding: 24px;

        // Header
        HorizontalBox {
            spacing: 16px;
            Text { text: "My Business"; font-size: 28px; font-family: "Outfit"; font-weight: 700; color: white; vertical-alignment: center; }
            if (is_loading) : Rectangle {
                width: 12px;
                height: 12px;
                background: #a855f7;
                border-radius: 6px;
            }
            Rectangle {} // Spacer
            TooltipElement { tooltip_id: "ask_ai"; Button { text: "Ask AI"; height: 44px; clicked => { open_ai_chat(); } } }
            TooltipElement { tooltip_id: "menu"; Button { text: "Menu"; height: 44px; clicked => { show_menu = !show_menu; } } }
        }

        if (show_menu) : GlassCard {
            border-color: rgba(255, 255, 255, 0.2);
            border-width: 1px;
            VerticalBox {
                padding: 16px;
                spacing: 12px;
                Button { text: "👂 Help Center"; height: 48px; clicked => { open_help_center(); show_menu = false; } }
                Button { text: "💳 Billing & Plan"; height: 48px; clicked => { open_billing(); show_menu = false; } }
                Button { text: "📚 API Docs"; height: 48px; clicked => { open_api_docs(); show_menu = false; } }
                Button { text: "🎥 Video Tutorials"; height: 48px; clicked => { open_video_tutorials(); show_menu = false; } }
                Button { text: "🚀 App Tour"; height: 48px; clicked => { open_interactive_walkthrough(); show_menu = false; } }
                Button { text: "🔔 What's New"; height: 48px; clicked => { open_release_notes(); show_menu = false; } }
            }
        }

        if (show_milestone) : GlassCard {
            border-color: #f59e0b;
            border-width: 1px;
            background: rgba(245, 158, 11, 0.1);

            HorizontalBox {
                padding: 16px;
                spacing: 12px;
                alignment: start;

                Text { text: "🎉"; font-size: 32px; vertical-alignment: center; }

                VerticalBox {
                    spacing: 4px;
                    Text { text: milestone_title; font-weight: 700; font-size: 18px; color: white; }
                    Text { text: milestone_message; color: #cbd5e1; font-size: 14px; wrap: word-wrap; }
                }

                Rectangle {}

                Button {
                    text: "Dismiss";
                    height: 44px;
                    clicked => { dismiss_milestone(); }
                }
            }
        }

        // Stat Cards
        if (root.width > 768px) : VerticalBox {
            spacing: 16px;
            HorizontalBox {
                spacing: 16px;
                StatCard { label: "Today's Sales"; value: todays_sales; value-color: #a855f7; }
                StatCard { label: "Orders to Ship"; value: orders_to_ship_count; value-color: #06b6d4; }
            }
            HorizontalBox {
                spacing: 16px;
                StatCard { label: "Active Helpers"; value: active_helpers_count; value-color: #10b981; }
                StatCard { label: "Current Tasks"; value: current_tasks_count; value-color: #f59e0b; }
            }
        }
        if (root.width <= 768px) : VerticalBox {
            spacing: 16px;
            StatCard { label: "Today's Sales"; value: todays_sales; value-color: #a855f7; }
            StatCard { label: "Orders to Ship"; value: orders_to_ship_count; value-color: #06b6d4; }
            StatCard { label: "Active Helpers"; value: active_helpers_count; value-color: #10b981; }
            StatCard { label: "Current Tasks"; value: current_tasks_count; value-color: #f59e0b; }
        }

        // Quick Actions Navigation
        VerticalBox {
            spacing: 12px;
            HorizontalBox {
                alignment: start;
                spacing: 8px;
                Text { text: "Quick Actions"; font-size: 20px; font-family: "Outfit"; font-weight: 700; color: white; vertical-alignment: center; }
                Button { text: "?"; width: 44px; height: 44px; clicked => { show_quick_actions_hint = !show_quick_actions_hint; } }
            }
            if (show_quick_actions_hint) : GlassCard {
                background: rgba(255, 255, 255, 0.05);
                padding: 12px;
                Text { text: "These buttons are shortcuts to your most common daily tasks. Tap them to jump straight to work!"; color: #cbd5e1; font-size: 14px; wrap: word-wrap; font-family: "Inter"; }
            }
            HorizontalBox {
                spacing: 8px;
                TooltipElement { tooltip_id: "add_product"; Button { text: "📦 Add Product"; height: 48px; clicked => { action_add_product(); } } }
                TooltipElement { tooltip_id: "view_orders"; Button { text: "🚚 Orders"; height: 48px; clicked => { action_view_orders(); } } }
                TooltipElement { tooltip_id: "messages"; Button { text: "💬 Messages"; height: 48px; clicked => { action_check_messages(); } } }
            }
            HorizontalBox {
                spacing: 8px;
                Button { text: "📈 Analytics"; height: 48px; clicked => { action_see_analytics(); } }
                Button { text: "🔗 Share Store"; height: 48px; clicked => { action_share_store(); } }
                Button { text: "🤝 Referrals"; height: 48px; clicked => { action_open_referrals(); } }
            }
            HorizontalBox {
                spacing: 8px;
                Button { text: "🚀 Grow Business"; height: 48px; clicked => { action_grow_business(); } }
            }
        }
        if (pending_approvals.length > 0) : VerticalBox {
            spacing: 16px;
            Text { text: "Drafts Ready for Review"; font-size: 20px; font-weight: 700; color: #b91c1c; }

            for approval in pending_approvals : Rectangle {
                background: #fef2f2;
                border-color: #fca5a5;
                border-width: 1px;
                border-radius: 8px;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;

                    Text { text: approval.title; font-weight: 700; color: #991b1b; }
                    Text { text: approval.proposed_content; color: #7f1d1d; wrap: word-wrap; }

                    HorizontalBox {
                        alignment: end;
                        spacing: 10px;
                        Button { text: "Edit"; height: 44px; }
                        Button {
                            text: "Approve";
                            height: 44px;
                            clicked => { approve_task(approval.task_id); }
                        }
                    }
                }
            }
        }

        SwarmObservability {
            messages: mesh_messages;
        }

        // My Team
        in-out property <bool> show_team_hint: false;
        VerticalBox {
            spacing: 12px;
            HorizontalBox {
                alignment: start;
                spacing: 8px;
                Text { text: "My Team"; font-size: 20px; font-family: "Outfit"; font-weight: 700; color: white; vertical-alignment: center; }
                Button { text: "?"; width: 44px; height: 44px; clicked => { show_team_hint = !show_team_hint; } }
            }
            if (show_team_hint) : GlassCard {
                background: rgba(255, 255, 255, 0.05);
                padding: 12px;
                Text { text: "These are your AI helpers and human teammates. You can adjust how many agents are working for you here."; color: #cbd5e1; font-size: 14px; wrap: word-wrap; font-family: "Inter"; }
            }
        }
        
        VerticalBox {
            spacing: 10px;
            
            for role_count in role_counts : GlassCard {
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 16px;
                    Text { text: role_count.role; font-weight: 700; color: white; horizontal-alignment: center; }
                    Rectangle {}
                    Button { text: "-"; width: 44px; height: 44px; }
                    Text { text: role_count.count; font-weight: 700; color: white; horizontal-alignment: center; }
                    Button { text: "+"; width: 44px; height: 44px; }
                }
            }
        }
    }
}
}
