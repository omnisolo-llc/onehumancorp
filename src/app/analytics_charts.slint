import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export struct UiDataPoint {
    label: string,
    value: float,
    display_value: string,
}

export struct UiChartData {
    title: string,
    points: [UiDataPoint],
}

export component AnalyticsCharts inherits Window {
    out property <string> test_title: root.title;

    width: 800px;
    height: 600px;
    title: "Business Analytics";

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    in property <[UiChartData]> charts;

    callback close();

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Business Analytics"; font-size: 28px; font-family: "Outfit"; font-weight: 700; color: white; vertical-alignment: center; }
            Rectangle {}
            Button { text: "Close"; height: 44px; clicked => { close(); } }
        }

        ScrollView {
            VerticalBox {
                spacing: 24px;

                for chart in charts : GlassCard {
                    border-color: rgba(255, 255, 255, 0.1);
                    border-width: 1px;
                    border-radius: 12px;
                    drop-shadow-blur: 20px;
                    drop-shadow-color: rgba(0, 0, 0, 0.5);

                    VerticalBox {
                        padding: 24px;
                        spacing: 24px;

                        Text { text: chart.title; font-size: 20px; font-weight: 700; font-family: "Outfit"; color: white; }

                        HorizontalBox {
                            spacing: 8px;
                            alignment: space-around;

                            for point in chart.points : VerticalBox {
                                alignment: end;
                                spacing: 8px;

                                Text { text: point.display_value; font-size: 14px; font-weight: 700; font-family: "Inter"; color: #34d399; horizontal-alignment: center; }

                                Rectangle {
                                    width: 40px;
                                    height: point.value * 1px;
                                    background: @linear-gradient(180deg, #a855f7 0%, #3b82f6 100%);
                                    border-radius: 4px;

                                    // Add a shimmer effect for the chart bars
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        background: @linear-gradient(180deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 100%);
                                        border-radius: 4px;
                                    }
                                }

                                Text { text: point.label; font-size: 12px; font-family: "Inter"; color: #cbd5e1; horizontal-alignment: center; }
                            }
                        }
                    }
                }
            }
        }
    }
}
