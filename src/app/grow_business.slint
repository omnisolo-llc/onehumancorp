import { TooltipElement } from "tooltip_element.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component GrowBusiness inherits Window {
    preferred-width: 500px;
    min-width: 375px;
    height: 600px;
    title: "Grow My Business";

    in-out property <int> step: 0;
    in-out property <string> selected_strategy: "";
    in-out property <bool> is_advanced: false;
    in-out property <bool> execution_started: false;
    in-out property <string> kpi_target: "";

    callback execute(string, string);
    callback save_state();
    callback next_step();
    callback prev_step();
    callback select_strategy(string);
    callback toggle_advanced();
    callback return_to_dashboard();
    callback open_help();

    next_step => { step = step + 1; }
    prev_step => { step = step - 1; }
    select_strategy(s) => { selected_strategy = s; }
    toggle_advanced => { is_advanced = !is_advanced; save_state(); }
    return_to_dashboard => {
        step = 0;
        selected_strategy = "";
        execution_started = false;
        kpi_target = "";
    }

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Growth Strategies"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; }
            Rectangle {}
            Button { text: "?"; width: 44px; height: 44px; clicked => { open_help(); } }
            HorizontalBox {
                spacing: 8px;
                alignment: end;
                TooltipElement { tooltip_id: "expert_mode"; Text { text: "Expert Mode"; color: #94a3b8; font-family: "Inter"; font-size: 14px; } }
                TouchArea {
                    width: 20px;
                    height: 20px;
                    clicked => { toggle_advanced(); }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 4px;
                        border-color: #a855f7;
                        border-width: 1px;
                        background: is_advanced ? #a855f7 : transparent;
                        Text { text: is_advanced ? "✓" : ""; color: white; horizontal-alignment: center; }
                    }
                }
            }
        }

        // Step 0: Select Strategy
        if (step == 0) : VerticalBox {
            spacing: 16px;
            TooltipElement { tooltip_id: "growth_strategy"; Text { text: "Select a next step to grow your business"; color: #94a3b8; font-family: "Inter"; font-size: 14px; } }
            
            ScrollView {
                VerticalBox {
                    spacing: 12px;

                    GlassCard {
                        height: 70px;
                        background: selected_strategy == "Add 5 more products" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        VerticalBox { alignment: center; padding: 12px;
                            Text { text: "📦 Add 5 more products"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                            Text { text: "Expand your catalog to increase sales"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                        }
                        TouchArea { clicked => { select_strategy("Add 5 more products"); } }
                    }

                    GlassCard {
                        height: 70px;
                        background: selected_strategy == "Connect Instagram" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        VerticalBox { alignment: center; padding: 12px;
                            Text { text: "📸 Connect Instagram"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                            Text { text: "Auto-post your products to your followers"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                        }
                        TouchArea { clicked => { select_strategy("Connect Instagram"); } }
                    }

                    GlassCard {
                        height: 70px;
                        background: selected_strategy == "Run your first email campaign" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        VerticalBox { alignment: center; padding: 12px;
                            Text { text: "✉️ Run your first email campaign"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                            Text { text: "Engage customers and bring them back"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                        }
                        TouchArea { clicked => { select_strategy("Run your first email campaign"); } }
                    }
                }
            }
        }

        // Step 1: Confirm
        if (step == 1) : VerticalBox {
            spacing: 16px;
            Text { text: "Confirm Action"; font-size: 20px; font-family: "Outfit"; font-weight: 700; color: white; }

            GlassCard {
                height: 100px;
                background: rgba(168, 85, 247, 0.2);
                VerticalBox { alignment: center; padding: 16px; spacing: 8px;
                    Text { text: "Target Strategy:"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                    Text { text: selected_strategy; font-family: "Outfit"; font-size: 18px; color: white; font-weight: 700; }
                }
            }

            Text { text: "Your AI agents will be instructed to begin this growth strategy immediately."; color: #94a3b8; font-family: "Inter"; font-size: 14px; wrap: word-wrap; }
            
            if (is_advanced) : VerticalBox {
                spacing: 8px;
                Text { text: "Advanced Target KPIs"; font-family: "Inter"; font-size: 14px; color: #94a3b8; }
                LineEdit {
                    text <=> kpi_target;
                    placeholder-text: "Conversion Target (%)";
                    height: 44px;
                }
            }
        }

        // Step 2: Success
        if (step == 2) : VerticalBox {
            alignment: center;
            spacing: 24px;
            Text { text: "🚀 Agents Engaged!"; font-size: 32px; font-family: "Outfit"; font-weight: 700; color: #10b981; horizontal-alignment: center; }
            Text { text: "Your growth strategy is now active."; font-size: 16px; font-family: "Inter"; color: white; horizontal-alignment: center; }

            GlassCard {
                height: 100px;
                background: rgba(16, 185, 129, 0.2);
                VerticalBox { alignment: center; padding: 16px; spacing: 8px;
                    Text { text: "Strategy: " + selected_strategy; font-family: "Inter"; font-size: 14px; color: white; horizontal-alignment: center; }
                    Text { text: "AI is analyzing and executing steps automatically."; font-family: "Inter"; font-size: 12px; color: #94a3b8; horizontal-alignment: center; }
                }
            }
        }

        Rectangle {} // Spacer

        // Navigation
        HorizontalBox {
            if (step > 0 && step < 2) : GlassCard {
                width: 100px;
                height: 44px;
                VerticalBox { alignment: center; Text { text: "Back"; font-family: "Inter"; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { prev_step(); } }
            }
            if (step == 0) : Rectangle { width: 100px; } // spacer
            if (step == 2) : Rectangle {} // push to center/right

            Rectangle {} // Center spacer

            if (step == 0) : GlassCard {
                width: 120px;
                height: 44px;
                background: selected_strategy != "" ? rgba(168, 85, 247, 0.8) : rgba(100, 116, 139, 0.4);
                VerticalBox { alignment: center; Text { text: "Next →"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea {
                    enabled: selected_strategy != "";
                    clicked => { next_step(); }
                }
            }

            if (step == 1) : GlassCard {
                width: 160px;
                height: 44px;
                background: rgba(168, 85, 247, 1.0);
                VerticalBox { alignment: center; Text { text: "Launch Strategy"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea {
                    clicked => {
                        execution_started = true;
                        execute(selected_strategy, kpi_target);
                        next_step();
                    }
                }
            }

            if (step == 2) : GlassCard {
                width: 180px;
                height: 44px;
                background: rgba(16, 185, 129, 0.8);
                VerticalBox { alignment: center; Text { text: "Return to Dashboard"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea {
                    clicked => {
                        return_to_dashboard();
                    }
                }
            }
        }
    }
}
