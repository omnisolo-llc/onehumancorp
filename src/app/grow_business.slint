import { Button, VerticalBox, HorizontalBox, CheckBox, LineEdit } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component GrowBusiness inherits Window {
    width: 500px;
    height: 500px;
    title: "Grow My Business";

    in-out property <int> step: 0;
    in-out property <string> selected_strategy: "";
    in-out property <bool> is_advanced: false;
    callback execute(string);

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Growth Strategies"; font-size: 24px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            CheckBox {
                text: "Expert Mode";
                checked: is_advanced;
                toggled => { is_advanced = !is_advanced; }
            }
        }

        // Step 0: Select Strategy
        if (step == 0) : VerticalBox {
            spacing: 10px;
            Text { text: "Select a next step to grow your business"; color: #1e293b; }
            
            FocusScope { key-pressed(e) => { if (e.text == " " || e.text == "\n") { selected_strategy = "Add 5 more products"; return accept; } return reject; } GlassCard { height: 60px; accessible-role: button; accessible-action-default => { selected_strategy = "Add 5 more products"; } background: selected_strategy == "Add 5 more products" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%); VerticalBox { alignment: center; padding: 12px; Text { text: "Add 5 more products"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; horizontal-alignment: center; } } TouchArea { clicked => { selected_strategy = "Add 5 more products"; } } } }
            FocusScope { key-pressed(e) => { if (e.text == " " || e.text == "\n") { selected_strategy = "Connect Instagram"; return accept; } return reject; } GlassCard { height: 60px; accessible-role: button; accessible-action-default => { selected_strategy = "Connect Instagram"; } background: selected_strategy == "Connect Instagram" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%); VerticalBox { alignment: center; padding: 12px; Text { text: "Connect Instagram"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; horizontal-alignment: center; } } TouchArea { clicked => { selected_strategy = "Connect Instagram"; } } } }
            FocusScope { key-pressed(e) => { if (e.text == " " || e.text == "\n") { selected_strategy = "Run your first email campaign"; return accept; } return reject; } GlassCard { height: 60px; accessible-role: button; accessible-action-default => { selected_strategy = "Run your first email campaign"; } background: selected_strategy == "Run your first email campaign" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%); VerticalBox { alignment: center; padding: 12px; Text { text: "Run your first email campaign"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; horizontal-alignment: center; } } TouchArea { clicked => { selected_strategy = "Run your first email campaign"; } } } }
            
            Text { text: "Selected: " + selected_strategy; color: #a855f7; }
        }

        // Step 1: Confirm
        if (step == 1) : VerticalBox {
            spacing: 10px;
            Text { text: "Confirm Action"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Text { text: "You are about to start: " + selected_strategy; color: #1e293b; }
            Text { text: "Your AI agents will be instructed to begin this growth strategy immediately."; color: #64748b; wrap: word-wrap; }
            
            if (is_advanced) : VerticalBox {
                spacing: 8px;
                Text { text: "Advanced Target KPIs"; font-weight: 700; color: #1e293b; }
                LineEdit {
                    placeholder-text: "Conversion Target (%)";
                }
            }
        }

        Rectangle {} // Spacer

        // Navigation
        HorizontalBox {
            if (step > 0) : Button {
                text: "Back";
                clicked => { step = step - 1; }
            }
            Rectangle {} // Spacer
            Button {
                text: step == 1 ? "Execute" : "Next";
                clicked => {
                    if (step < 1) {
                        step = step + 1;
                    } else {
                        execute(selected_strategy);
                    }
                }
            }
        }
    }
}
