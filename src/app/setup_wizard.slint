import { PasswordInput } from "password_input.slint";
import { VerticalBox, HorizontalBox, Button, LineEdit, ScrollView, CheckBox } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component SetupWizard inherits Window {
    min-width: 375px;
    preferred-width: 400px;
    height: 800px;
    title: "Setup Wizard";

    in-out property <int> step: 0;

    // State
    in-out property <string> business_type: "";
    in-out property <string> company_name: "";
    in-out property <string> company_description: "";

    // Multi-select for what they sell
    in-out property <bool> sell_physical: false;
    in-out property <bool> sell_digital: false;
    in-out property <bool> sell_services: false;
    in-out property <bool> sell_food: false;
    in-out property <bool> sell_subscriptions: false;

    // Payments
    in-out property <string> payment_pref: "";

    // Admin
    in-out property <string> admin_name: "";
    in-out property <string> admin_email: "";
    in-out property <string> admin_password: "";

    in-out property <bool> is_advanced: false;

    // Additional Properties for Launch compat
    in-out property <string> website_template: "";
    in-out property <string> product_name: "";
    in-out property <string> product_description: "";
    in-out property <string> product_price: "";
    in-out property <string> price_type: "fixed"; // fixed, starting_at, request_quote
    in-out property <string> product_sku: "";
    in-out property <string> product_inventory: "";
    in-out property <string> domain_choice: "";
    in-out property <string> custom_dns_target: "";

    in-out property <bool> launching: false;
    in-out property <bool> is_instant_build: false;
    in-out property <string> instant_bio: "";
    in-out property <bool> is_generating_instant_preview: false;
    in-out property <bool> is_generating_company_description: false;
    in-out property <bool> is_generating_product_description: false;

    in-out property <bool> launch_success: false;
    in-out property <string> launch_status: "";
    in-out property <string> launch_details: "";
    in-out property <string> shareable_link: "";
    in-out property <string> company_id: "";

    callback next_step();
    callback prev_step();
    callback save_state();
    callback select_business_type(string);
    callback select_payment_pref(string);
    callback toggle_advanced();

    // Callbacks for testing backward compat
    callback toggle_sell_food();
    callback toggle_sell_physical();
    callback invoke_toggle_sell_physical();
    callback invoke_toggle_sell_food();
    callback invoke_select_template(string);
    callback invoke_select_domain(string);

    // The single big launch callback
    callback launch(string, string, string, string, string, string, string, string, string, string, string);

    // After success actions
    callback copy_link(string);
    callback go_to_dashboard();
    callback go_to_add_products();
    callback go_to_connect_instagram();
    callback go_to_share_link();

    // Instant Build
    callback generate_instant_preview();
    callback generate_company_description(string, string);
    callback generate_product_description(string);

    next_step => { step = step + 1; save_state(); }
    prev_step => { step = step - 1; save_state(); }
    select_business_type(t) => { business_type = t; next_step(); }
    select_payment_pref(p) => { payment_pref = p; next_step(); }
    toggle_sell_food => { sell_food = !sell_food; }
    invoke_toggle_sell_food => { sell_food = !sell_food; }
    toggle_sell_physical => { sell_physical = !sell_physical; }
    invoke_toggle_sell_physical => { sell_physical = !sell_physical; }
    invoke_select_template(t) => { website_template = t; }
    invoke_select_domain(d) => { domain_choice = d; }
    toggle_advanced => { is_advanced = !is_advanced; }

    property <float> pulse_scale: 1.0;
    animate pulse_scale { duration: 1500ms; easing: ease-in-out; iteration-count: -1; }

    // Background
    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        padding: 24px;
        spacing: 24px;

        if (step > 0 && step < 10) : HorizontalBox {
            alignment: space-between;
            Text { text: "Setup"; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
            Text { text: step + " / 6"; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
        }

        ScrollView {
            height: 600px;

            // Step 0: Welcome
            if (step == 0) : VerticalBox {
                alignment: center;
                spacing: 24px;

                Text { text: "🚀"; font-size: 64px; horizontal-alignment: center; }

                Text {
                    text: "Your business,\nlive in minutes";
                    font-size: 32px;
                    font-weight: 700;
                    font-family: "Outfit";
                    color: white;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Text {
                    text: "No code. No servers. No jargon.\nJust a beautiful, guided experience.";
                    font-size: 16px;
                    font-family: "Inter";
                    color: #cbd5e1;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Step 1: Business Type
            if (step == 1) : VerticalBox {
                spacing: 16px;
                Text { text: "What kind of business are you building?"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }

                VerticalBox {
                    spacing: 12px;

                    GlassCard {
                        height: 70px;
                        background: business_type == "Online Store" ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.05);
                        HorizontalBox { padding: 16px; spacing: 16px; alignment: start; Text { text: "🛍️"; font-size: 24px; } VerticalBox { alignment: center; Text { text: "Online Store"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; } } }
                        TouchArea { clicked => { select_business_type("Online Store"); } }
                    }
                    GlassCard {
                        height: 70px;
                        background: business_type == "Service Business" ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.05);
                        HorizontalBox { padding: 16px; spacing: 16px; alignment: start; Text { text: "🔧"; font-size: 24px; } VerticalBox { alignment: center; Text { text: "Service Business"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; } } }
                        TouchArea { clicked => { select_business_type("Service Business"); } }
                    }
                    GlassCard {
                        height: 70px;
                        background: business_type == "Restaurant / Food" ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.05);
                        HorizontalBox { padding: 16px; spacing: 16px; alignment: start; Text { text: "🍔"; font-size: 24px; } VerticalBox { alignment: center; Text { text: "Restaurant / Food"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; } } }
                        TouchArea { clicked => { select_business_type("Restaurant / Food"); } }
                    }
                    GlassCard {
                        height: 70px;
                        background: business_type == "Creative / Portfolio" ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.05);
                        HorizontalBox { padding: 16px; spacing: 16px; alignment: start; Text { text: "🎨"; font-size: 24px; } VerticalBox { alignment: center; Text { text: "Creative / Portfolio"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; } } }
                        TouchArea { clicked => { select_business_type("Creative / Portfolio"); } }
                    }
                    GlassCard {
                        height: 70px;
                        background: business_type == "Local Business" ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.05);
                        HorizontalBox { padding: 16px; spacing: 16px; alignment: start; Text { text: "🏪"; font-size: 24px; } VerticalBox { alignment: center; Text { text: "Local Business"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; } } }
                        TouchArea { clicked => { select_business_type("Local Business"); } }
                    }
                    GlassCard {
                        height: 70px;
                        background: business_type == "Other" ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.05);
                        HorizontalBox { padding: 16px; spacing: 16px; alignment: start; Text { text: "✨"; font-size: 24px; } VerticalBox { alignment: center; Text { text: "Other"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; } } }
                        TouchArea { clicked => { select_business_type("Other"); } }
                    }
                }
            }

            // Step 2: Business Name & Description
            if (step == 2) : VerticalBox {
                spacing: 24px;
                Text { text: "Name & Description"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }

                VerticalBox {
                    spacing: 8px;
                    Text { text: "Business Name"; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
                    LineEdit { text <=> company_name; placeholder-text: "e.g. Maya's Custom Cakes"; height: 50px; font-size: 16px; }
                }

                VerticalBox {
                    spacing: 8px;
                    HorizontalBox {
                        Text { text: "Short Description"; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
                        Rectangle {}
                        TouchArea {
                            clicked => { generate_company_description(company_name, business_type); is_generating_company_description = true; }
                            Text { text: "✨ Auto-suggest"; color: #a855f7; font-family: "Inter"; font-size: 14px; }
                        }
                    }

                    if (is_generating_company_description) : GlassCard {
                        height: 100px;
                        background: rgba(168, 85, 247, 0.2);
                        VerticalBox { alignment: center; Text { text: "AI is thinking..."; color: white; horizontal-alignment: center; } }
                    }

                    if (!is_generating_company_description) : LineEdit {
                        text <=> company_description;
                        placeholder-text: "We bake the best vegan cakes in town...";
                        height: 100px;
                    }
                }
            }

            // Step 3: What do you sell?
            if (step == 3) : VerticalBox {
                spacing: 24px;
                Text { text: "What do you sell?"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }
                Text { text: "Select all that apply."; font-size: 14px; font-family: "Inter"; color: #94a3b8; }

                VerticalBox {
                    spacing: 12px;
                    GlassCard {
                        height: 60px;
                        background: sell_physical ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.05);
                        HorizontalBox { padding: 16px; spacing: 16px; alignment: start; CheckBox { checked <=> sell_physical; } VerticalBox { alignment: center; Text { text: "Physical products"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; } } }
                        TouchArea { clicked => { sell_physical = !sell_physical; } }
                    }
                    GlassCard {
                        height: 60px;
                        background: sell_digital ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.05);
                        HorizontalBox { padding: 16px; spacing: 16px; alignment: start; CheckBox { checked <=> sell_digital; } VerticalBox { alignment: center; Text { text: "Digital downloads"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; } } }
                        TouchArea { clicked => { sell_digital = !sell_digital; } }
                    }
                    GlassCard {
                        height: 60px;
                        background: sell_services ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.05);
                        HorizontalBox { padding: 16px; spacing: 16px; alignment: start; CheckBox { checked <=> sell_services; } VerticalBox { alignment: center; Text { text: "Services / appointments"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; } } }
                        TouchArea { clicked => { sell_services = !sell_services; } }
                    }
                    GlassCard {
                        height: 60px;
                        background: sell_food ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.05);
                        HorizontalBox { padding: 16px; spacing: 16px; alignment: start; CheckBox { checked <=> sell_food; } VerticalBox { alignment: center; Text { text: "Food & beverages"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; } } }
                        TouchArea { clicked => { toggle_sell_food(); } }
                    }
                    GlassCard {
                        height: 60px;
                        background: sell_subscriptions ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.05);
                        HorizontalBox { padding: 16px; spacing: 16px; alignment: start; CheckBox { checked <=> sell_subscriptions; } VerticalBox { alignment: center; Text { text: "Subscriptions"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; } } }
                        TouchArea { clicked => { sell_subscriptions = !sell_subscriptions; } }
                    }
                }
            }

            // Step 4: Payments
            if (step == 4) : VerticalBox {
                spacing: 16px;
                Text { text: "How do you want to receive payments?"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }

                VerticalBox {
                    spacing: 12px;

                    GlassCard {
                        height: 80px;
                        background: payment_pref == "online" ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.05);
                        HorizontalBox { padding: 16px; spacing: 16px; alignment: start; Text { text: "💳"; font-size: 24px; } VerticalBox { alignment: center; Text { text: "Online only"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; } Text { text: "Accept cards & Apple Pay"; color: #94a3b8; font-size: 12px; font-family: "Inter"; } } }
                        TouchArea { clicked => { select_payment_pref("online"); } }
                    }
                    GlassCard {
                        height: 80px;
                        background: payment_pref == "pos" ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.05);
                        HorizontalBox { padding: 16px; spacing: 16px; alignment: start; Text { text: "📱"; font-size: 24px; } VerticalBox { alignment: center; Text { text: "In-person (POS)"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; } Text { text: "Tap to pay on phone"; color: #94a3b8; font-size: 12px; font-family: "Inter"; } } }
                        TouchArea { clicked => { select_payment_pref("pos"); } }
                    }
                    GlassCard {
                        height: 80px;
                        background: payment_pref == "both" ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.05);
                        HorizontalBox { padding: 16px; spacing: 16px; alignment: start; Text { text: "🔄"; font-size: 24px; } VerticalBox { alignment: center; Text { text: "Both"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; } Text { text: "Online & in-person"; color: #94a3b8; font-size: 12px; font-family: "Inter"; } } }
                        TouchArea { clicked => { select_payment_pref("both"); } }
                    }
                    GlassCard {
                        height: 80px;
                        background: payment_pref == "skip" ? rgba(168, 85, 247, 0.4) : rgba(255, 255, 255, 0.05);
                        HorizontalBox { padding: 16px; spacing: 16px; alignment: start; Text { text: "⏭️"; font-size: 24px; } VerticalBox { alignment: center; Text { text: "Skip for now"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; } Text { text: "Set up later"; color: #94a3b8; font-size: 12px; font-family: "Inter"; } } }
                        TouchArea { clicked => { select_payment_pref("skip"); } }
                    }
                }
            }

            // Step 5: Admin Account
            if (step == 5) : VerticalBox {
                spacing: 24px;
                Text { text: "Administrator Account"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }

                VerticalBox {
                    spacing: 8px;
                    Text { text: "Name"; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
                    LineEdit { text <=> admin_name; placeholder-text: "Your full name"; height: 50px; font-size: 16px; }
                }

                VerticalBox {
                    spacing: 8px;
                    Text { text: "Email"; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
                    LineEdit { text <=> admin_email; placeholder-text: "you@example.com"; height: 50px; font-size: 16px; }
                }

                VerticalBox {
                    spacing: 8px;
                    Text { text: "Password"; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
                    PasswordInput { text <=> admin_password; }
                    HorizontalBox {
                        spacing: 4px;
                        Rectangle { height: 4px; width: 25%; background: admin_password != "" ? (admin_password == "1234" ? red : (admin_password == "1234567" ? yellow : green)) : #334155; border-radius: 2px; }
                        Rectangle { height: 4px; width: 25%; background: admin_password != "1234" ? (admin_password == "1234567" ? yellow : green) : #334155; border-radius: 2px; }
                        Rectangle { height: 4px; width: 25%; background: admin_password != "1234567" ? green : #334155; border-radius: 2px; }
                        Rectangle { height: 4px; width: 25%; background: admin_password == "123456789012" ? green : #334155; border-radius: 2px; }
                    }
                    Text {
                        text: admin_password == "" ? "" : (admin_password == "1234" ? "Weak" : (admin_password == "1234567" ? "Fair" : (admin_password != "123456789012" ? "Good" : "Strong")));
                        color: admin_password == "1234" ? red : (admin_password == "1234567" ? yellow : green);
                        font-size: 12px; font-family: "Inter";
                    }
                }

                HorizontalBox {
                    alignment: center;
                    Text { text: "or sign up with"; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
                }

                HorizontalBox {
                    spacing: 16px;
                    GlassCard {
                        height: 50px;
                        background: rgba(255, 255, 255, 0.05);
                        VerticalBox { alignment: center; Text { text: "Google"; color: white; font-family: "Inter"; font-weight: 700; horizontal-alignment: center; } }
                    }
                    GlassCard {
                        height: 50px;
                        background: rgba(255, 255, 255, 0.05);
                        VerticalBox { alignment: center; Text { text: "Apple"; color: white; font-family: "Inter"; font-weight: 700; horizontal-alignment: center; } }
                    }
                }
            }

            // Step 6: Review & Launch
            if (step == 6) : VerticalBox {
                spacing: 24px;
                Text { text: "Review & Launch"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }

                GlassCard {
                    background: rgba(255, 255, 255, 0.05);
                    VerticalBox {
                        padding: 24px;
                        spacing: 16px;

                        VerticalBox {
                            Text { text: "Business"; color: #94a3b8; font-size: 12px; font-family: "Inter"; }
                            Text { text: company_name != "" ? company_name : "Unnamed Business"; color: white; font-size: 16px; font-weight: 700; font-family: "Inter"; }
                            Text { text: business_type; color: #cbd5e1; font-size: 14px; font-family: "Inter"; }
                        }

                        Rectangle { height: 1px; background: rgba(255, 255, 255, 0.1); }

                        VerticalBox {
                            Text { text: "Selling"; color: #94a3b8; font-size: 12px; font-family: "Inter"; }
                            HorizontalBox {
                                spacing: 4px;
                                if (sell_physical) : Text { text: "Physical"; color: white; font-size: 14px; font-family: "Inter"; }
                                if (sell_digital) : Text { text: "Digital"; color: white; font-size: 14px; font-family: "Inter"; }
                                if (sell_services) : Text { text: "Services"; color: white; font-size: 14px; font-family: "Inter"; }
                                if (sell_food) : Text { text: "Food"; color: white; font-size: 14px; font-family: "Inter"; }
                                if (sell_subscriptions) : Text { text: "Subscriptions"; color: white; font-size: 14px; font-family: "Inter"; }
                            }
                        }

                        Rectangle { height: 1px; background: rgba(255, 255, 255, 0.1); }

                        VerticalBox {
                            Text { text: "Admin"; color: #94a3b8; font-size: 12px; font-family: "Inter"; }
                            Text { text: admin_email; color: white; font-size: 14px; font-family: "Inter"; }
                        }
                    }
                }

                if (launching && !launch_success) : GlassCard {
                    height: 80px;
                    background: rgba(168, 85, 247, 0.2);
                    VerticalBox {
                        alignment: center;
                        padding: 16px;
                        Text { text: "Your business is setting up..."; color: white; font-size: 18px; font-weight: 700; font-family: "Outfit"; horizontal-alignment: center; }
                        Text { text: "AI agents are being provisioned."; color: #cbd5e1; font-size: 14px; font-family: "Inter"; horizontal-alignment: center; }
                    }
                }

                if (launch_success) : GlassCard {
                    height: 120px;
                    background: rgba(16, 185, 129, 0.2);
                    VerticalBox {
                        alignment: center;
                        padding: 16px;
                        spacing: 8px;
                        Text { text: "✅ Ready to Go!"; color: #10b981; font-size: 24px; font-weight: 700; font-family: "Outfit"; horizontal-alignment: center; }
                        Text { text: "Your business is live."; color: white; font-size: 16px; font-family: "Inter"; horizontal-alignment: center; }
                        Button {
                            text: "Go to Dashboard";
                            clicked => { go_to_dashboard(); }
                        }
                    }
                }
            }
        }

        // Navigation Footer
        HorizontalBox {
            alignment: space-between;

            // Back button
            if (step > 0 && step < 6 && !launching) : GlassCard {
                height: 54px;
                width: 100px;
                background: rgba(255, 255, 255, 0.1);
                VerticalBox { alignment: center; Text { text: "Back"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { prev_step(); } }
            }
            if (step == 0 || step == 6) : Rectangle { width: 100px; } // spacer

            // Next button
            if (step == 0 || step == 2 || step == 3 || step == 5) : GlassCard {
                height: 54px;
                width: 140px;
                background: rgba(168, 85, 247, 0.8);
                VerticalBox { alignment: center; Text { text: step == 0 ? "Get Started →" : "Next →"; font-family: "Inter"; font-size: 16px; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { next_step(); } }
            }

            // Launch button
            if (step == 6 && !launching) : GlassCard {
                height: 60px;
                width: 220px;
                background: rgba(168, 85, 247, 1.0);

                // Pulsing animation manually simulated here via pulse_scale opacity
                opacity: pulse_scale < 1.0 ? 1.0 : (2.0 - pulse_scale);

                VerticalBox { alignment: center; Text { text: "Launch My Business →"; font-family: "Inter"; font-size: 16px; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => {
                    launching = true;
                    launch(business_type, company_name, company_description, payment_pref, admin_email, website_template, product_name, product_price, domain_choice, admin_name, admin_password);
                } }
            }
        }
    }
}
