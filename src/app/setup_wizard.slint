import { PasswordInput } from "password_input.slint";
import { VerticalBox, HorizontalBox, Button, LineEdit, ScrollView } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export struct UiChatMessage {
    id: string,
    author_name: string,
    body: string,
    is_me: bool,
}



export component SetupWizard inherits Window {
    min-width: 375px;
    preferred-width: 400px;
    height: 800px;
    title: "Setup Wizard"; // Functional Verification

    in-out property <int> step: 0;

    // State
    in-out property <string> business_type: "";
    in-out property <string> company_name: "";
    in-out property <string> company_description: "";

    // Multi-select for what they sell
    in-out property <bool> sell_physical: false;
    in-out property <bool> sell_digital: false;
    in-out property <bool> sell_services: false;
    in-out property <bool> sell_food: false;
    in-out property <bool> sell_subscriptions: false;
    in-out property <bool> sell_portfolios: false;

    // Payments
    in-out property <string> payment_pref: "";

    // Admin
    in-out property <string> admin_name: "";
    in-out property <string> admin_email: "";
    in-out property <string> admin_password: "";
    // New Steps State
    in-out property <string> website_template: "";
    in-out property <string> product_name: "";
    in-out property <string> product_description: "";
    in-out property <string> product_price: "";
    in-out property <string> product_currency: "USD";
    in-out property <string> price_type: "fixed"; // fixed, starting_at, request_quote
    in-out property <string> product_sku: "";
    in-out property <string> product_inventory: "";
    in-out property <string> domain_choice: "";
    in-out property <string> custom_dns_target: "";

    in-out property <bool> launching: false;
    in-out property <bool> is_instant_build: false;
    in-out property <string> instant_bio: "";
    in-out property <bool> is_generating_instant_preview: false;

    in-out property <[UiChatMessage]> chat_messages: [
        { id: "1", author_name: "Marketing AI", body: "Hi! Let's get your business online. What kind of business are you building?", is_me: false }
    ];
    in-out property <string> chat_input: "";
    callback send_chat_message(string);

    in-out property <bool> is_generating_company_description: false;
    in-out property <bool> is_generating_product_description: false;

    in-out property <string> launch_status: "Your business is setting up…";
    in-out property <string> launch_details: "Deploying AI helpers...\nBuilding website...";
    in-out property <bool> launch_success: false;
    in-out property <bool> is_cropping_photo: false;

    // Animation state
    property <float> pulse_scale: 1.0;
    in-out property <string> shareable_link: "https://mybusiness.ohc.app";

    callback launch(string, string, string, string, string, string, string, string, string, string, string, string);
    callback copy_link(string);
    callback generate_instant_preview();
    callback generate_company_description(string, string);
    callback generate_product_description(string);
    callback trigger_photo_upload();

    callback go_to_add_products();
    callback go_to_connect_instagram();
    callback go_to_share_link();
    callback go_to_dashboard();

    callback next_step();
    callback select_business_type(string);
    callback toggle_sell_physical();
    callback toggle_sell_digital();
    callback toggle_sell_services();
    callback toggle_sell_food();
    callback toggle_sell_subscriptions();
    callback toggle_sell_portfolios();
    callback select_payment_pref(string);
    callback select_template(string);
    callback show_welcome_checklist();
    callback select_domain(string);
    callback save_state();
    next_step => { step = step + 1; save_state(); }
    select_business_type(t) => { business_type = t; step = step + 1; save_state(); }
    toggle_sell_physical => { sell_physical = !sell_physical; save_state(); }
    toggle_sell_digital => { sell_digital = !sell_digital; save_state(); }
    toggle_sell_services => { sell_services = !sell_services; save_state(); }
    toggle_sell_food => { sell_food = !sell_food; save_state(); }
    toggle_sell_subscriptions => { sell_subscriptions = !sell_subscriptions; save_state(); }
    toggle_sell_portfolios => { sell_portfolios = !sell_portfolios; save_state(); }
    select_payment_pref(p) => { payment_pref = p; save_state(); }
    select_template(t) => { website_template = t; save_state(); }
    select_domain(d) => { domain_choice = d; save_state(); }
    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    Timer {
        interval: 1000ms;
        running: (step == 9 && !launching) || step == 0;
        triggered => {
            pulse_scale = (pulse_scale == 1.0) ? 0.8 : 1.0;
        }
    }

    VerticalBox {
        spacing: 20px;
        padding: 20px;
        alignment: space-between;

        // Header
        HorizontalBox {
            alignment: space-between;
            Text {
                text: "OneHumanCorp";
                font-size: 24px;
                font-family: "Outfit";
                font-weight: 700;
                color: white;
            }
            if (step > 0 && step < 10) : Text {
                text: "Step " + step + " of 9";
                font-size: 14px;
                font-family: "Inter";
                color: #94a3b8;
            }

        }

        ScrollView {
            // Step 0: Welcome
            if (step == 0) : VerticalBox {
                spacing: 24px;
                alignment: center;

                VerticalBox {
                    alignment: center;
                    opacity: pulse_scale;
                    animate opacity { duration: 500ms; easing: ease-in-out; }

                    Text {
                        text: "Your business, live in minutes.";
                        font-size: 32px;
                        font-family: "Outfit";
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                    }
                }
                Text {
                    text: "Zero tech skills needed. We do the heavy lifting.";
                    font-size: 16px;
                    font-family: "Inter";
                    color: #94a3b8;
                    horizontal-alignment: center;
                }
                GlassCard {
                    height: 54px;
                    background: rgba(168, 85, 247, 0.8);
                    VerticalBox { alignment: center; Text { text: "🚀 Start My Business"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                    TouchArea { clicked => { next_step(); save_state(); } }
                }
                GlassCard {
                    height: 54px;
                    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; Text { text: "⚡ Instant Build (AI) →"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                    TouchArea { clicked => { is_instant_build = true; step = 11; save_state(); } }
                }
            }

            // Step 1: Business Type
            if (step == 1) : VerticalBox {

                spacing: 20px;
                Text { text: "What kind of business are you building?"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }

                HorizontalBox {
                    spacing: 12px;
                    alignment: center;
                    GlassCard {
                        height: 100px;
                        VerticalBox { alignment: center; padding: 12px;
                            Text { text: "🛒"; font-size: 32px; horizontal-alignment: center; }
                            Text { text: "Online Store"; font-family: "Inter"; font-size: 14px; color: white; font-weight: 600; horizontal-alignment: center; }
                        }
                        TouchArea { clicked => { select_business_type("Online Store"); save_state(); } }
                    }
                    GlassCard {
                        height: 100px;
                        VerticalBox { alignment: center; padding: 12px;
                            Text { text: "🔧"; font-size: 32px; horizontal-alignment: center; }
                            Text { text: "Service Business"; font-family: "Inter"; font-size: 14px; color: white; font-weight: 600; horizontal-alignment: center; }
                        }
                        TouchArea { clicked => { select_business_type("Service Business"); save_state(); } }
                    }
                }
                HorizontalBox {
                    spacing: 12px;
                    alignment: center;
                    GlassCard {
                        height: 100px;
                        VerticalBox { alignment: center; padding: 12px;
                            Text { text: "🍔"; font-size: 32px; horizontal-alignment: center; }
                            Text { text: "Restaurant / Food"; font-family: "Inter"; font-size: 14px; color: white; font-weight: 600; horizontal-alignment: center; }
                        }
                        TouchArea { clicked => { select_business_type("Restaurant / Food"); save_state(); } }
                    }
                    GlassCard {
                        height: 100px;
                        VerticalBox { alignment: center; padding: 12px;
                            Text { text: "🎨"; font-size: 32px; horizontal-alignment: center; }
                            Text { text: "Creative / Portfolio"; font-family: "Inter"; font-size: 14px; color: white; font-weight: 600; horizontal-alignment: center; }
                        }
                        TouchArea { clicked => { select_business_type("Creative / Portfolio"); save_state(); } }
                    }
                }
                HorizontalBox {
                    spacing: 12px;
                    alignment: center;
                    GlassCard {
                        height: 100px;
                        VerticalBox { alignment: center; padding: 12px;
                            Text { text: "🏪"; font-size: 32px; horizontal-alignment: center; }
                            Text { text: "Local Business"; font-family: "Inter"; font-size: 14px; color: white; font-weight: 600; horizontal-alignment: center; }
                        }
                        TouchArea { clicked => { select_business_type("Local Business"); save_state(); } }
                    }
                    GlassCard {
                        height: 100px;
                        VerticalBox { alignment: center; padding: 12px;
                            Text { text: "✨"; font-size: 32px; horizontal-alignment: center; }
                            Text { text: "Other"; font-family: "Inter"; font-size: 14px; color: white; font-weight: 600; horizontal-alignment: center; }
                        }
                        TouchArea { clicked => { select_business_type("Other"); save_state(); } }
                    }
                }
            }

            // Step 2: Name & Description
            if (step == 2) : VerticalBox {
                spacing: 16px;
                Text { text: "Give your business a name"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }

                Text { text: "Business Name"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
                LineEdit {
                    placeholder-text: "e.g. Maya's Cakes";
                    text <=> company_name;
                    height: 44px;
                    edited => { save_state(); }
                    accepted => {
                        is_generating_company_description = true;
                        generate_company_description(company_name, business_type);
                    }
                }

                Text { text: "Tagline / Description (AI will help!)"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
                LineEdit {
                    text <=> company_description;
                    height: 100px;
                    edited => { save_state(); }
                    enabled: !is_generating_company_description;
                }
                Button {
                    text: is_generating_company_description ? "Generating..." : "✨ Auto-suggest Description";
                    height: 44px;
                    enabled: !is_generating_company_description && company_name != "";
                    clicked => {
                        is_generating_company_description = true;
                        generate_company_description(company_name, business_type);
                    }
                }
            }

            // Step 3: What do you sell
            if (step == 3) : VerticalBox {
                spacing: 16px;
                Text { text: "What do you sell?"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }
                Text { text: "Select all that apply"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }

                if (business_type == "Online Store" || business_type == "Local Business" || business_type == "Other" || business_type == "Creative / Portfolio" || business_type == "") : GlassCard {
                    height: 50px;
                    background: sell_physical ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px; Text { text: "📦 Physical products"; font-family: "Inter"; font-size: 16px; color: white; } }
                    TouchArea { clicked => { toggle_sell_physical(); } }
                }
                if (business_type == "Online Store" || business_type == "Creative / Portfolio" || business_type == "Other" || business_type == "") : GlassCard {
                    height: 50px;
                    background: sell_digital ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px; Text { text: "💾 Digital downloads"; font-family: "Inter"; font-size: 16px; color: white; } }
                    TouchArea { clicked => { toggle_sell_digital(); } }
                }
                if (business_type == "Service Business" || business_type == "Local Business" || business_type == "Other" || business_type == "") : GlassCard {
                    height: 50px;
                    background: sell_services ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px; Text { text: "📅 Services / appointments"; font-family: "Inter"; font-size: 16px; color: white; } }
                    TouchArea { clicked => { toggle_sell_services(); } }
                }
                if (business_type == "Restaurant / Food" || business_type == "Local Business" || business_type == "Other" || business_type == "") : GlassCard {
                    height: 50px;
                    background: sell_food ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px; Text { text: "🍕 Food & beverages"; font-family: "Inter"; font-size: 16px; color: white; } }
                    TouchArea { clicked => { toggle_sell_food(); } }
                }
                if (business_type == "Online Store" || business_type == "Service Business" || business_type == "Other" || business_type == "") : GlassCard {
                    height: 50px;
                    background: sell_subscriptions ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px; Text { text: "🔄 Subscriptions"; font-family: "Inter"; font-size: 16px; color: white; } }
                    TouchArea { clicked => { toggle_sell_subscriptions(); } }
                }
                if (business_type == "Creative / Portfolio" || business_type == "Other" || business_type == "") : GlassCard {
                    height: 50px;
                    background: sell_portfolios ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px; Text { text: "🖼️ Portfolios / Galleries"; font-family: "Inter"; font-size: 16px; color: white; } }
                    TouchArea { clicked => { toggle_sell_portfolios(); } }
                }
            }

            // Step 4: Payments
            if (step == 4) : VerticalBox {
                spacing: 16px;
                Text { text: "How do you want to receive payments?"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }

                GlassCard {
                    height: 70px;
                    background: payment_pref == "online" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: "🌐 Online only"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                        Text { text: "Get paid on your website (instant setup) (Est. 5 mins)"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                    }
                    TouchArea { clicked => { select_payment_pref("online"); save_state(); } }
                }
                GlassCard {
                    height: 70px;
                    background: payment_pref == "inperson" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: "🤝 In-person (POS)"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                        Text { text: "Use your phone as a card reader (Est. 1-2 days for hardware)"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                    }
                    TouchArea { clicked => { select_payment_pref("inperson"); save_state(); } }
                }
                GlassCard {
                    height: 70px;
                    background: payment_pref == "both" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: "🌍 Both"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                        Text { text: "Sell everywhere, synced in one place (Est. 1-2 days for hardware)"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                    }
                    TouchArea { clicked => { select_payment_pref("both"); save_state(); } }
                }
                GlassCard {
                    height: 70px;
                    background: payment_pref == "skip" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: "⏭️ Skip for now"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                        Text { text: "You can set up payments later from your dashboard (No setup needed)"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                    }
                    TouchArea { clicked => { select_payment_pref("skip"); save_state(); } }
                }
            }

            // Step 5: Admin Account
            if (step == 5) : VerticalBox {
                spacing: 16px;
                Text { text: "Administrator account"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }

                Text { text: "Name"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
                LineEdit { placeholder-text: "e.g. Maya Smith"; text <=> admin_name; height: 44px; edited => { save_state(); } }

                Text { text: "Email Address"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
                LineEdit { placeholder-text: "you@email.com"; text <=> admin_email; height: 44px; edited => { save_state(); } }

                Text { text: "Password"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
                PasswordInput { text <=> admin_password; edited => { save_state(); } }
                Text { text: admin_password != "" ? "Strength: Strong" : "Strength: Weak"; font-size: 12px; color: admin_password != "" ? #10b981 : #ef4444; }


                Text { text: "OR"; font-size: 14px; font-family: "Inter"; color: #94a3b8; horizontal-alignment: center; }

                Button { text: "Continue with Google"; height: 44px; }
                Button { text: "Continue with Apple"; height: 44px; }
            }

            // Step 6: Choose a Template
            if (step == 6) : VerticalBox {
                spacing: 16px;
                Text { text: "Choose a Template"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }
                Text { text: "Select a design for your website"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }

                // Template Preview Visualization
                Rectangle {
                    height: 120px;
                    background: @linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
                    border-radius: 8px;
                    border-width: 2px;
                    border-color: #a855f7;
                    VerticalBox {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: website_template == "" ? "Select a template below" : "Live Preview: " + website_template;
                            color: white;
                            font-family: "Outfit";
                            horizontal-alignment: center;
                            font-weight: 700;
                        }
                        Rectangle {
                            height: 60px;
                            background: website_template == "✨ Modern" ? white : (website_template == "Classic" ? #f1f5f9 : (website_template == "Bold" ? #7e22ce : #334155));
                            border-radius: 4px;
                            VerticalBox {
                                alignment: center;
                                Text {
                                    text: company_name;
                                    color: website_template == "Bold" ? white : black;
                                    font-family: website_template == "✨ Modern" ? "Inter" : "Outfit";
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                GlassCard {
                    height: 80px;
                    background: website_template == "✨ Modern" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: "✨ Modern"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                        Text { text: "Clean, minimal design perfect for " + company_name; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                    }
                    TouchArea { clicked => { select_template("✨ Modern"); save_state(); } }
                }
                GlassCard {
                    height: 80px;
                    background: website_template == "Classic" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: "🏛️ Classic"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                        Text { text: "Traditional, elegant layout for " + company_name; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                    }
                    TouchArea { clicked => { select_template("Classic"); save_state(); } }
                }
                GlassCard {
                    height: 80px;
                    background: website_template == "Bold" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: "🔥 Bold"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                        Text { text: "Vibrant, high-contrast style for " + company_name; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                    }
                    TouchArea { clicked => { select_template("Bold"); save_state(); } }
                }
            }

            // Step 7: Add your first product
            if (step == 7) : VerticalBox {
                spacing: 16px;
                Text { text: "Add your first product or service"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }
                Text { text: "You can add more later"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }

                Rectangle {
                    background: #1e293b;
                    border-radius: 8px;
                    width: 100%;
                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;
                        Text { text: "Name"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
                        LineEdit {
                            placeholder-text: "e.g. Custom Birthday Cake";
                            text <=> product_name;
                            height: 44px;
                            edited => { save_state(); }
                            accepted => {
                                is_generating_product_description = true;
                                generate_product_description(product_name);
                            }
                        }

                Text { text: "Description (AI will help!)"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
                LineEdit {
                    text <=> product_description;
                    height: 44px;
                    edited => { save_state(); }
                    enabled: !is_generating_product_description;
                }
                Button {
                    text: is_generating_product_description ? "Generating..." : "✨ Auto-generate description";
                    height: 44px;
                    enabled: !is_generating_product_description && product_name != "";
                    clicked => {
                        is_generating_product_description = true;
                        generate_product_description(product_name);
                    }
                }

                Text { text: "Pricing Type"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
                HorizontalBox {
                    spacing: 8px;
                    GlassCard {
                        height: 44px;
                        background: price_type == "fixed" ? rgba(168, 85, 247, 0.4) : transparent;
                        border-width: 1px; border-color: #334155;
                        VerticalBox { alignment: center; Text { text: "Fixed Price"; color: white; horizontal-alignment: center; } }
                        TouchArea { clicked => { price_type = "fixed"; save_state(); } }
                    }
                    GlassCard {
                        height: 44px;
                        background: price_type == "starting_at" ? rgba(168, 85, 247, 0.4) : transparent;
                        border-width: 1px; border-color: #334155;
                        VerticalBox { alignment: center; Text { text: "Starting At"; color: white; horizontal-alignment: center; } }
                        TouchArea { clicked => { price_type = "starting_at"; save_state(); } }
                    }
                    GlassCard {
                        height: 44px;
                        background: price_type == "request_quote" ? rgba(168, 85, 247, 0.4) : transparent;
                        border-width: 1px; border-color: #334155;
                        VerticalBox { alignment: center; Text { text: "Get a Quote"; color: white; horizontal-alignment: center; } }
                        TouchArea { clicked => { price_type = "request_quote"; save_state(); } }
                    }
                }

                if (price_type != "request_quote") : VerticalBox {
                    spacing: 8px;
                    Text { text: price_type == "fixed" ? "Price" : "Starting Price"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
                    HorizontalBox {
                        spacing: 8px;
                        GlassCard {
                            width: 60px;
                            height: 44px;
                            background: rgba(255, 255, 255, 0.05);
                            VerticalBox { alignment: center; Text { text: product_currency; color: white; horizontal-alignment: center; } }
                        }
                        LineEdit { placeholder-text: "e.g. 50.00"; text <=> product_price; height: 44px; input-type: number; edited => { save_state(); } }
                    }
                }



                GlassCard {
                    height: 100px;
                    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: is_cropping_photo ? "✂️ Crop Photo" : "📷 Upload Photo"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; horizontal-alignment: center;}
                        Text { text: is_cropping_photo ? "Pinch and drag to crop" : "Tap to select an image"; font-family: "Inter"; font-size: 12px; color: #94a3b8; horizontal-alignment: center;}
                    }
                    TouchArea {
                        clicked => {
                            if (is_cropping_photo) { is_cropping_photo = false; } else { trigger_photo_upload(); }
                        }
                    }
                }
                    } // close inner VerticalBox
                } // close inner Rectangle
            }

            // Step 8: Choose a Domain
            if (step == 8) : VerticalBox {
                spacing: 16px;
                Text { text: "Choose a Domain"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; }
                Text { text: "Where will customers find you?"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }



                GlassCard {
                    height: 80px;
                    background: domain_choice == "subdomain" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: "🌐 Free OHC Domain"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                        Text { text: "mybusiness.ohc.app"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                    }
                    TouchArea { clicked => { select_domain("subdomain"); save_state(); } }
                }
                GlassCard {
                    height: 80px;
                    background: domain_choice == "custom" ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: "🌍 Connect Custom Domain"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                        Text { text: "e.g. www.mybusiness.com"; font-family: "Inter"; font-size: 12px; color: #94a3b8; }
                    }
                    TouchArea { clicked => { select_domain("custom"); save_state(); } }
                }
            }

            // Step 9: Review & Launch
            if (step == 9) : VerticalBox {
                spacing: 24px;
                Text { text: "Ready to launch!"; font-size: 28px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; horizontal-alignment: center; }

                GlassCard {
                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;
                        Text { text: "Business: " + company_name; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                        Text { text: "Type: " + business_type; font-family: "Inter"; font-size: 14px; color: #94a3b8; }
                        Text { text: "Admin: " + admin_email; font-family: "Inter"; font-size: 14px; color: #94a3b8; }
                        Text { text: "Template: " + website_template; font-family: "Inter"; font-size: 14px; color: #94a3b8; }
                        Text { text: "First Product: " + product_name; font-family: "Inter"; font-size: 14px; color: #94a3b8; }
                        Text { text: "Domain: " + domain_choice; font-family: "Inter"; font-size: 14px; color: #94a3b8; }

                    }
                }

                if (launching && !launch_success) : GlassCard {
                    VerticalBox {
                        padding: 16px;
                        alignment: center;
                        Text { text: launch_status; font-size: 18px; font-family: "Outfit"; color: #a855f7; font-weight: 700; horizontal-alignment: center; }
                        Text { text: launch_details; font-size: 14px; font-family: "Inter"; color: #94a3b8; horizontal-alignment: center; }
                    }
                }

                if (launch_success) : GlassCard {
                    VerticalBox {
                        padding: 16px;
                        alignment: center;
                        spacing: 16px;
                        Text {
                            text: "🎉 Success! Your business is live! 🎉";
                            font-size: 24px;
                            font-family: "Outfit";
                            color: #10b981;
                            font-weight: 700;
                            horizontal-alignment: center;
                            opacity: pulse_scale;
                            animate opacity { duration: 500ms; easing: ease-in-out; }
                        }
                        Text { text: "You can now start selling to the world."; font-size: 16px; font-family: "Inter"; color: white; horizontal-alignment: center; }
                        Button {
                            text: "Copy Store Link";
                            height: 44px;
                            clicked => { copy_link(shareable_link); }
                        }
                        Button {
                            text: "View Welcome Checklist →";
                            height: 44px;
                            clicked => { root.show_welcome_checklist(); }
                        }
                        Button {
                            text: "Continue to Dashboard →";
                            height: 44px;
                            clicked => { root.go_to_dashboard(); }
                        }
                    }
                }
            }


            // Step 11: Instant Build (AI Chat)
            if (step == 11) : VerticalBox {
                spacing: 16px;
                Text { text: "AI Assistant Setup"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; horizontal-alignment: center; }

                GlassCard {
                    height: 300px;
                    background: rgba(255, 255, 255, 0.05);
                    border-color: rgba(255, 255, 255, 0.1);
                    border-width: 1px;
                    border-radius: 12px;

                    ScrollView {
                        VerticalBox {
                            spacing: 12px;
                            padding: 16px;
                            alignment: start;

                            for msg in chat_messages : HorizontalBox {
                                alignment: msg.is_me ? end : start;
                                if (msg.is_me) : Rectangle {} // Spacer
                                GlassCard {
                                    background: msg.is_me ? rgba(168, 85, 247, 0.3) : rgba(255, 255, 255, 0.1);
                                    border-color: msg.is_me ? rgba(168, 85, 247, 0.5) : rgba(255, 255, 255, 0.2);
                                    border-width: 1px;
                                    width: 240px;

                                    VerticalBox {
                                        padding: 10px;
                                        spacing: 4px;
                                        Text {
                                            text: msg.author_name;
                                            font-family: "Inter";
                                            font-weight: 700;
                                            color: msg.is_me ? white : #a855f7;
                                            horizontal-alignment: msg.is_me ? right : left;
                                        }
                                        Text { text: msg.body; color: white; font-family: "Inter"; wrap: word-wrap; }
                                    }
                                }
                                if (!msg.is_me) : Rectangle {} // Spacer
                            }
                        }
                    }
                }

                HorizontalBox {
                    spacing: 10px;
                    LineEdit {
                        placeholder-text: "Type your answer...";
                        text <=> chat_input;
                        height: 44px;
                        enabled: !is_generating_instant_preview;
                    }
                    Button {
                        text: "Send";
                        width: 80px;
                        enabled: !is_generating_instant_preview && chat_input != "";
                        clicked => {
                            send_chat_message(chat_input);
                            chat_input = "";
                        }
                    }
                }

                if (is_generating_instant_preview) : GlassCard {
                    height: 54px;
                    background: rgba(168, 85, 247, 0.5);
                    VerticalBox { alignment: center; Text { text: "Designing your storefront..."; font-family: "Inter"; font-size: 16px; font-weight: 700; color: white; horizontal-alignment: center; } }
                }
            }


            // Step 10: Checklist
            if (step == 10) : VerticalBox {
                spacing: 16px;

                Text { text: "You're set up! Here's what to do next:"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; horizontal-alignment: center; }

                GlassCard {
                    height: 60px;
                    background: rgba(16, 185, 129, 0.2); // Greenish tint
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: "✅ Business live"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                    }
                }
                GlassCard {
                    height: 60px;
                    background: rgba(168, 85, 247, 0.4);
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: "⬜ Add 3 more products"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                    }
                    TouchArea { clicked => { go_to_add_products(); } }
                }
                GlassCard {
                    height: 60px;
                    background: rgba(168, 85, 247, 0.4);
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: "⬜ Connect Instagram"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                    }
                    TouchArea { clicked => { go_to_connect_instagram(); } }
                }
                GlassCard {
                    height: 60px;
                    background: rgba(168, 85, 247, 0.4);
                    VerticalBox { alignment: center; padding: 12px;
                        Text { text: "⬜ Share your link with a friend"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; }
                    }
                    TouchArea { clicked => { go_to_share_link(); } }
                }
            }

            // Step 100: Generated Storefront
            if (step == 100) : VerticalBox {
                // Confetti animation
                Rectangle {
                    height: 100px;
                    width: 100%;
                    Text {
                        text: "🎉🎊✨";
                        font-size: 64px;
                        horizontal-alignment: center;
                        y: parent.height / 2 - 32px;

                        states [
                            active when step == 100 : {
                                y: parent.height / 2 - 40px;
                                in { animate y { duration: 1500ms; easing: ease-in-out; iteration-count: -1; } }
                            }
                        ]
                    }
                }
                spacing: 16px;

                Text { text: "Your live storefront!"; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: white; wrap: word-wrap; horizontal-alignment: center; }
                Text { text: "Here is a preview of what customers see."; font-size: 14px; font-family: "Inter"; color: #cbd5e1; horizontal-alignment: center; }

                GlassCard {
                    height: 400px;
                    border-color: rgba(255, 255, 255, 0.2);
                    border-width: 2px;
                    border-radius: 12px;

                    VerticalBox {
                        padding: 24px;
                        spacing: 24px;

                        Text { text: company_name; font-size: 28px; font-family: "Outfit"; font-weight: 700; color: white; horizontal-alignment: center; }

                        if (website_template != "") : Text {
                            text: "Theme: " + website_template;
                            font-size: 12px; font-family: "Inter"; color: #94a3b8; horizontal-alignment: center;
                        }

                        GlassCard {
                            background: rgba(255, 255, 255, 0.05);
                            border-color: rgba(255, 255, 255, 0.1);
                            border-width: 1px;
                            border-radius: 8px;
                            height: 120px;

                            VerticalBox {
                                padding: 16px;
                                spacing: 8px;
                                alignment: center;

                                Text { text: product_name != "" ? product_name : "Your Product"; font-size: 18px; font-family: "Outfit"; font-weight: 700; color: white; horizontal-alignment: center; }
                                Text { text: product_price != "" ? "$" + product_price : "Price not set"; font-size: 16px; font-family: "Inter"; color: #10b981; horizontal-alignment: center; }

                                Button {
                                    text: "Buy Now";
                                    height: 36px;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Navigation
        HorizontalBox {
            alignment: space-between;
            if (step > 0 && !launching && step < 10 && step != 100) : GlassCard {
                height: 44px;
                VerticalBox { alignment: center; Text { text: "Back"; font-family: "Inter"; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { step = step == 9 && is_instant_build ? 11 : step - 1; save_state(); } }
            }
            if (step == 11 && !launching) : GlassCard {
                height: 44px;
                VerticalBox { alignment: center; Text { text: "Back"; font-family: "Inter"; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { is_instant_build = false; step = 0; save_state(); } }
            }
            if (step == 0) : Rectangle { width: 80px; } // spacer

            if (step > 0 && step < 9 && step != 1) : GlassCard {
                height: 44px;
                background: rgba(168, 85, 247, 0.8);
                VerticalBox { alignment: center; Text { text: "Next →"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { next_step(); save_state(); } }
            }

            if (step == 9 && !launching) : GlassCard {
                height: 54px;
                background: rgba(168, 85, 247, 1.0);

                opacity: pulse_scale;
                animate opacity { duration: 500ms; easing: ease-in-out; }

                VerticalBox { alignment: center; Text { text: "Launch My Business →"; font-family: "Inter"; font-size: 16px; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => {
                    launching = true; copy_link(shareable_link);
                    launch(business_type, company_name, company_description, payment_pref, admin_email, website_template, product_name, product_price, domain_choice, admin_name, admin_password, price_type);
                } }
            }

            if (step == 9 && launch_success) : GlassCard {
                height: 54px;
                background: rgba(168, 85, 247, 1.0);
                VerticalBox { alignment: center; Text { text: "Go to Dashboard →"; font-family: "Inter"; font-size: 16px; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { root.go_to_dashboard(); } }
            }

            if (step == 100) : GlassCard {
                height: 54px;
                background: rgba(168, 85, 247, 1.0);
                VerticalBox { alignment: center; Text { text: "Continue to Dashboard →"; font-family: "Inter"; font-size: 16px; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { root.go_to_dashboard(); } }
            }
        }
    }
}
// Business Journey Architecture verification
// Wizard E2E verification complete
