import { Button, VerticalBox, HorizontalBox, CheckBox } from "std-widgets.slint";

export struct UiSkill {
    name: string,
    version: string,
    description: string,
    category: string,
    installed: bool,
    enabled: bool,
}

export component Skills inherits Window {
    min-width: 375px;
    preferred-width: 500px;
    height: 600px;
    title: "Skills & Plugins";
    out property <string> test_title: root.title;

    in-out property <string> selected_category: "all";
    in-out property <[UiSkill]> skills;
    
    callback install_skill(string);
    callback uninstall_skill(string);
    callback set_skill_enabled(string, bool);

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        Text { text: "Skills & Plugins"; font-size: 20px; font-weight: 700; color: #1e293b; }

        HorizontalBox {
            spacing: 10px;
            Button { text: "All"; clicked => { selected_category = "all"; } }
            Button { text: "Builtin"; clicked => { selected_category = "builtin"; } }
            Button { text: "Official"; clicked => { selected_category = "official"; } }
        }

        VerticalBox {
            spacing: 12px;
            
            for s in skills : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalBox {
                        Text { text: "🛠️ " + s.name; font-weight: 700; color: #1e293b; horizontal-alignment: center; }
                        Rectangle {}
                        Text { text: "v" + s.version; color: #64748b; horizontal-alignment: center; }
                        if (s.installed) : CheckBox { 
                            checked: s.enabled; 
                            toggled => { set_skill_enabled(s.name, !s.enabled); }
                        }
                        if (s.installed) : Button { 
                            text: "Remove"; 
                            clicked => { uninstall_skill(s.name); }
                        }
                        if (!s.installed) : Button { 
                            text: "Install"; 
                            clicked => { install_skill(s.name); }
                        }
                    }
                    Text { text: s.description; color: #64748b; wrap: word-wrap; }
                }
            }
        }
    }
}
