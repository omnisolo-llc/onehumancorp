import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { AdvancedToggle } from "advanced_toggle.slint";
import { GlassCard } from "glass_card.slint";

export component FixAgent inherits Window {
    preferred-width: 500px;
    min-width: 375px;
    height: 600px;
    title: "Help Me Fix This";
    out property <string> test_title: root.title;

    in-out property <int> step: 0;
    in-out property <bool> is_applying: false;
    in-out property <bool> is_advanced: false;

    callback apply_fix();
    callback return_to_agents();
    callback save_state();

    callback next_step();
    callback prev_step();

    next_step => { step = step + 1; }
    prev_step => { step = step - 1; }

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Help me fix this"; font-size: 24px; font-weight: 700; color: white; font-family: "Outfit"; }
            Rectangle {}
            AdvancedToggle {
                is_advanced <=> root.is_advanced;
                toggled => { save_state(); }
            }
        }

        HorizontalBox {
            spacing: 10px;
            alignment: center;

            Rectangle {
                background: step >= 0 ? #ef4444 : rgba(255, 255, 255, 0.1);
                border-radius: 12px;
                width: 24px;
                height: 24px;
                drop-shadow-blur: 20px;
                drop-shadow-color: rgba(0,0,0,0.5);
                HorizontalBox {
                    padding: 2px;
                    Text { text: "1"; font-family: "Inter"; font-weight: 700; font-size: 14px; color: white; horizontal-alignment: center; }
                }
            }
            Text { text: "Understand"; font-family: "Inter"; font-weight: 700; font-size: 14px; color: step == 0 ? white : #94a3b8; }

            Rectangle {
                background: step >= 1 ? #f59e0b : rgba(255, 255, 255, 0.1);
                border-radius: 12px;
                width: 24px;
                height: 24px;
                drop-shadow-blur: 20px;
                drop-shadow-color: rgba(0,0,0,0.5);
                HorizontalBox {
                    padding: 2px;
                    Text { text: "2"; font-family: "Inter"; font-weight: 700; font-size: 14px; color: white; horizontal-alignment: center; }
                }
            }
            Text { text: "Review"; font-family: "Inter"; font-weight: 700; font-size: 14px; color: step == 1 ? white : #94a3b8; }

            Rectangle {
                background: step >= 2 ? #10b981 : rgba(255, 255, 255, 0.1);
                border-radius: 12px;
                width: 24px;
                height: 24px;
                drop-shadow-blur: 20px;
                drop-shadow-color: rgba(0,0,0,0.5);
                HorizontalBox {
                    padding: 2px;
                    Text { text: "3"; font-family: "Inter"; font-weight: 700; font-size: 14px; color: white; horizontal-alignment: center; }
                }
            }
            Text { text: "Resolve"; font-family: "Inter"; font-weight: 700; font-size: 14px; color: step == 2 ? white : #94a3b8; }
        }

        if (is_advanced) : GlassCard {
            background: rgba(0, 0, 0, 0.5);
            border-color: rgba(168, 85, 247, 0.5);
            VerticalBox {
                padding: 16px;
                Text { text: "Technical Details:"; font-family: "Inter"; font-size: 14px; color: #94a3b8; }
                Text { text: "The connection to the database timed out after 5 seconds."; font-family: "Inter"; font-size: 12px; color: #10b981; }
            }
        }

        if (step == 0) : VerticalBox {
            spacing: 16px;
            Text { text: "Something went wrong"; font-family: "Outfit"; font-size: 20px; font-weight: 700; color: white; }

            GlassCard {
                background: rgba(239, 68, 68, 0.1);
                border-color: rgba(239, 68, 68, 0.3);
                VerticalBox {
                    padding: 16px;
                    spacing: 12px;
                    Text { text: "⚠️ Connection Lost"; font-family: "Inter"; font-size: 16px; font-weight: 700; color: #ef4444; }
                    Text { text: "We lost connection to your business records, and your helper needs a quick hand to get back to work."; font-family: "Inter"; font-size: 14px; color: #cbd5e1; wrap: word-wrap; }
                }
            }

            Text { text: "Don't worry, AI has prepared a fix for this. Proceed to the next step to review it."; font-family: "Inter"; font-size: 14px; color: #94a3b8; wrap: word-wrap; }
        }

        if (step == 1) : VerticalBox {
            spacing: 16px;
            Text { text: "Don't worry!"; font-family: "Outfit"; font-size: 20px; font-weight: 700; color: white; }

            GlassCard {
                background: rgba(245, 158, 11, 0.1);
                border-color: rgba(245, 158, 11, 0.3);
                VerticalBox {
                    padding: 16px;
                    spacing: 12px;
                    Text { text: "🔧 Refreshing the connection"; font-family: "Inter"; font-size: 16px; font-weight: 700; color: #f59e0b; }
                    Text { text: "We can usually fix this by refreshing the connection. This won't delete any of your data."; font-family: "Inter"; font-size: 14px; color: #cbd5e1; wrap: word-wrap; }
                }
            }
        }

        if (step == 2) : VerticalBox {
            spacing: 16px;
            Text { text: "Fix applied successfully"; font-family: "Outfit"; font-size: 20px; font-weight: 700; color: white; }

            GlassCard {
                background: rgba(16, 185, 129, 0.1);
                border-color: rgba(16, 185, 129, 0.3);
                VerticalBox {
                    padding: 16px;
                    spacing: 12px;
                    Text { text: "✅ Ready to fix"; font-family: "Inter"; font-size: 16px; font-weight: 700; color: #10b981; }
                    Text { text: "The agent is healthy again."; font-family: "Inter"; font-size: 14px; color: #cbd5e1; wrap: word-wrap; }
                }
            }
        }

        Rectangle {} // Spacer

        HorizontalBox {
            if (step > 0) : GlassCard {
                width: 100px;
                height: 44px;
                VerticalBox { alignment: center; Text { text: "Back"; font-family: "Inter"; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { prev_step(); } }
            }
            if (step == 0) : Rectangle { width: 100px; } // spacer

            Rectangle {} // Center spacer

            if (step == 0) : GlassCard {
                width: 180px;
                height: 44px;
                background: rgba(168, 85, 247, 0.8);
                VerticalBox { alignment: center; Text { text: "View Suggested Fix"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { next_step(); } }
            }
            if (step == 1) : GlassCard {
                width: 180px;
                height: 44px;
                background: rgba(16, 185, 129, 0.8);
                VerticalBox { alignment: center; Text { text: "Refresh & Reconnect"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { is_applying = true; apply_fix(); step = 2; is_applying = false; } }
            }
            if (step == 2) : GlassCard {
                width: 180px;
                height: 44px;
                background: rgba(16, 185, 129, 0.8);
                VerticalBox { alignment: center; Text { text: "Return to Helpers"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { return_to_agents(); } }
            }
        }
    }
}

export component Upgrade inherits Window {
    preferred-width: 400px;
    min-width: 375px;
    height: 600px;
    title: "Platform Upgrade";
    out property <string> test_title: root.title;

    in-out property <int> progress: 0;
    in-out property <bool> is_upgrading: false;
    in-out property <bool> done: false;
    in-out property <bool> is_advanced: false;

    callback save_state();

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 32px;
        alignment: center;

        HorizontalBox {
            Text { text: "Upgrade to v2.4 ✨"; font-size: 24px; font-weight: 700; color: white; font-family: "Outfit"; }
            Rectangle {}
            AdvancedToggle {
                is_advanced <=> root.is_advanced;
                toggled => { save_state(); }
            }
        }

        if (!is_upgrading && !done) : VerticalBox {
            spacing: 16px;
            GlassCard {
                VerticalBox {
                    padding: 16px;
                    Text { text: "What's new:\n• Improved agent reasoning\n• 2x faster orchestration\n• New performance tracking"; color: white; font-family: "Inter"; font-size: 14px; }
                }
            }
            Button { text: "Upgrade in 1 click"; clicked => { is_upgrading = true; /* simulate */ done = true; is_upgrading = false; } }
        }

        if (is_upgrading) : VerticalBox {
            spacing: 16px;
            GlassCard {
                VerticalBox {
                    padding: 32px;
                    spacing: 16px;
                    Text { text: "Upgrading..."; color: white; horizontal-alignment: center; font-family: "Inter"; }
                    // Progress bar placeholder
                    Rectangle {
                        height: 8px;
                        background: #e2e8f0;
                        HorizontalBox {
                            alignment: start;
                            Rectangle { width: 100px; background: #a855f7; }
                        }
                    }
                    if (is_advanced) : VerticalBox {
                        Rectangle { height: 16px; }
                        Text { text: "> Restarting services to apply the new version..."; color: #a855f7; font-family: "Inter"; font-size: 12px; }
                        Text { text: "> Updating your data format securely..."; color: #a855f7; font-family: "Inter"; font-size: 12px; }
                    }
                }
            }
        }

        if (done) : VerticalBox {
            spacing: 16px;
            GlassCard {
                VerticalBox {
                    padding: 32px;
                    spacing: 16px;
                    Text { text: "🎉"; font-size: 48px; horizontal-alignment: center; }
                    Text { text: "Upgrade complete!"; font-size: 18px; font-weight: 700; color: white; horizontal-alignment: center; font-family: "Inter"; }
                }
            }
            Button { text: "Go to Dashboard"; }
        }
    }
}

export component Billing inherits Window {
    preferred-width: 400px;
    min-width: 375px;
    height: 600px;
    title: "Billing & Credits";

    in-out property <bool> is_advanced: false;
    in-out property <int> step: 0;
    callback save_state();

    callback add_credits();
    callback switch_plan();
    callback return_to_dashboard();

    callback next_step();
    callback prev_step();
    next_step => { step = step + 1; }
    prev_step => { step = step - 1; }

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 32px;
        alignment: center;

        HorizontalBox {
            Text { text: "What does this cost?"; font-size: 24px; font-weight: 700; color: white; font-family: "Outfit"; }
            Rectangle {}
            AdvancedToggle {
                is_advanced <=> root.is_advanced;
                toggled => { save_state(); }
            }
        }

        if (step == 0) : VerticalBox {
            spacing: 20px;
            GlassCard {
                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    alignment: center;
                    Text { text: "Current Usage"; color: white; font-family: "Inter"; font-size: 14px; }
                    Text { text: "$42.50"; font-size: 32px; font-weight: 700; color: #a855f7; font-family: "Outfit"; }
                    Text { text: "Projected monthly cost: $85.00"; color: #94a3b8; font-size: 12px; font-family: "Inter"; }

                    if (is_advanced) : VerticalBox {
                        Rectangle { height: 16px; }
                        Text { text: "Word Usage Breakdown:"; color: white; font-family: "Inter"; font-size: 12px; }
                        Text { text: "• OpenAI Helper: 1,245,000 words processed"; color: #94a3b8; font-family: "Inter"; font-size: 12px; }
                        Text { text: "• Google Helper: 450,000 words processed"; color: #94a3b8; font-family: "Inter"; font-size: 12px; }
                    }
                }
            }
            Text { text: "Your current plan includes 1000 AI tasks per day. You have used 450 today."; color: white; wrap: word-wrap; font-family: "Inter"; font-size: 14px; }
        }

        if (step == 1) : VerticalBox {
            spacing: 20px;
            GlassCard {
                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "Choose an Action"; color: white; font-family: "Outfit"; font-size: 20px; font-weight: 700; }
                    Text { text: "You can either add credits to your balance for immediate usage or switch to a higher-tier plan for consistent volume."; color: #cbd5e1; wrap: word-wrap; font-family: "Inter"; font-size: 14px; }
                }
            }
            HorizontalBox {
                spacing: 16px;
                GlassCard {
                    height: 80px;
                    background: rgba(168, 85, 247, 0.4);
                    VerticalBox { alignment: center; padding: 12px; Text { text: "💳"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; horizontal-alignment: center; } Text { text: "Add Credits"; font-family: "Inter"; font-size: 14px; color: white; font-weight: 700; horizontal-alignment: center; } }
                    TouchArea { clicked => { step = 2; } }
                }
                GlassCard {
                    height: 80px;
                    background: rgba(16, 185, 129, 0.4);
                    VerticalBox { alignment: center; padding: 12px; Text { text: "⬆️"; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; horizontal-alignment: center; } Text { text: "Switch Plan"; font-family: "Inter"; font-size: 14px; color: white; font-weight: 700; horizontal-alignment: center; } }
                    TouchArea { clicked => { switch_plan(); step = 3; } }
                }
            }
        }

        if (step == 2) : VerticalBox {
            spacing: 20px;
            GlassCard {
                VerticalBox {
                    padding: 32px;
                    spacing: 16px;
                    alignment: center;
                    Text { text: "✓"; font-size: 48px; color: #10b981; horizontal-alignment: center; }
                    Text { text: "Credits Added Successfully!"; color: white; horizontal-alignment: center; font-family: "Inter"; font-size: 16px; font-weight: 700; }
                    Text { text: "Your new balance is $92.50."; color: #cbd5e1; horizontal-alignment: center; font-family: "Inter"; font-size: 14px; }
                }
            }
        }

        if (step == 3) : VerticalBox {
            spacing: 20px;
            GlassCard {
                VerticalBox {
                    padding: 32px;
                    spacing: 16px;
                    alignment: center;
                    Text { text: "✓"; font-size: 48px; color: #10b981; horizontal-alignment: center; }
                    Text { text: "Plan Switched Successfully!"; color: white; horizontal-alignment: center; font-family: "Inter"; font-size: 16px; font-weight: 700; }
                }
            }
        }


        Rectangle {} // Spacer

        HorizontalBox {
            if (step > 0 && step < 2) : GlassCard {
                width: 100px;
                height: 44px;
                VerticalBox { alignment: center; Text { text: "Back"; font-family: "Inter"; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { prev_step(); } }
            }
            if (step == 0) : Rectangle { width: 100px; } // spacer
            if (step >= 2) : Rectangle {} // push right

            Rectangle {} // Center spacer

            if (step == 0) : GlassCard {
                width: 140px;
                height: 44px;
                background: rgba(168, 85, 247, 0.8);
                VerticalBox { alignment: center; Text { text: "Manage Usage →"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { next_step(); } }
            }

            if (step == 2) : GlassCard {
                width: 140px;
                height: 44px;
                background: rgba(16, 185, 129, 0.8);
                VerticalBox { alignment: center; Text { text: "Finish"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { add_credits(); return_to_dashboard(); } }
            }

            if (step == 3) : GlassCard {
                width: 140px;
                height: 44px;
                background: rgba(16, 185, 129, 0.8);
                VerticalBox { alignment: center; Text { text: "Finish"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { return_to_dashboard(); } }
            }
        }
    }
}
