import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component FixHelper inherits Window {
    width: 500px;
    height: 400px;
    title: "Helper Diagnostics";

    in-out property <int> step: 0;
    in-out property <bool> is_applying: false;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 32px;
        alignment: center;

        Text { text: "Help me fix this"; font-size: 24px; font-weight: 700; color: #1e293b; }

        if (step == 0) : VerticalBox {
            spacing: 10px;
            Text { text: "We detected a connection timeout with the business records storage. The helper was unable to read the required state."; color: #1e293b; wrap: word-wrap; }
            Button { text: "View Suggested Fix"; clicked => { step = 1; } }
        }

        if (step == 1) : VerticalBox {
            spacing: 10px;
            Text { text: "Suggested fix: Restart the helper process and refresh memory to reconnect."; color: #1e293b; wrap: word-wrap; }
            Button {
                text: "Apply Fix";
                clicked => {
                    is_applying = true;
                    // Simulate delay or just transition
                    step = 2;
                    is_applying = false;
                }
            }
        }

        if (step == 2) : VerticalBox {
            spacing: 10px;
            Text { text: "✓"; font-size: 48px; color: #10b981; horizontal-alignment: center; }
            Text { text: "Fix applied successfully! The helper is healthy again."; color: #1e293b; horizontal-alignment: center; }
            Button { text: "Return to Helpers"; }
        }
    }
}

export component Upgrade inherits Window {
    width: 500px;
    height: 400px;
    title: "Platform Upgrade";

    in-out property <int> progress: 0;
    in-out property <bool> is_upgrading: false;
    in-out property <bool> done: false;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 32px;
        alignment: center;

        Text { text: "Upgrade to v2.4 ✨"; font-size: 24px; font-weight: 700; color: #1e293b; }

        if (!is_upgrading && !done) : VerticalBox {
            spacing: 10px;
            Text { text: "What's new:\n• Improved helper reasoning\n• 2x faster orchestration\n• New performance tracking"; color: #1e293b; }
            Button { text: "Upgrade in 1 click"; clicked => { is_upgrading = true; /* simulate */ done = true; is_upgrading = false; } }
        }

        if (is_upgrading) : VerticalBox {
            spacing: 10px;
            Text { text: "Upgrading..."; color: #1e293b; horizontal-alignment: center; }
            // Progress bar placeholder
            Rectangle { 
                height: 8px; 
                background: #e2e8f0; 
                HorizontalBox {
                    alignment: start;
                    Rectangle { width: 100px; background: #a855f7; } 
                }
            }
        }

        if (done) : VerticalBox {
            spacing: 10px;
            Text { text: "🎉"; font-size: 48px; horizontal-alignment: center; }
            Text { text: "Upgrade complete!"; font-size: 18px; font-weight: 700; color: #1e293b; horizontal-alignment: center; }
            Button { text: "Go to Dashboard"; }
        }
    }
}

export component Billing inherits Window {
    width: 500px;
    height: 400px;
    title: "Billing & Credits";

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 32px;
        alignment: center;

        Text { text: "How much does this cost?"; font-size: 24px; font-weight: 700; color: #1e293b; }

        Rectangle {
            background: #e0f2fe;
            border-radius: 12px;
            border-color: #bae6fd;
            border-width: 1px;
            
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                alignment: center;
                Text { text: "Current Usage"; color: #0369a1; }
                Text { text: "$42.50"; font-size: 32px; font-weight: 700; color: #0c4a6e; }
                Text { text: "Projected monthly cost: $85.00"; color: #0369a1; font-size: 12px; }
            }
        }

        Text { text: "Your current plan includes 1000 AI tasks per day. You have used 450 today."; color: #1e293b; wrap: word-wrap; }

        HorizontalBox {
            spacing: 10px;
            alignment: center;
            Button { text: "Add Credits"; }
            Button { text: "Switch Plan"; }
        }
    }
}
