import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { AdvancedToggle } from "advanced_toggle.slint";
import { GlassCard } from "glass_card.slint";

export component FixAgent inherits Window {
    preferred-width: 400px;
    min-width: 375px;
    height: 600px;
    title: "Help Me Fix This";
    out property <string> test_title: root.title;

    in-out property <int> step: 0;
    in-out property <bool> is_applying: false;
    in-out property <bool> is_advanced: false;

    callback apply_fix();
    callback return_to_agents();
    callback save_state();

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 32px;
        alignment: center;

        HorizontalBox {
            Text { text: "Help me fix this"; font-size: 24px; font-weight: 700; color: white; font-family: "Outfit"; }
            Rectangle {}
            AdvancedToggle {
                is_advanced <=> root.is_advanced;
                toggled => { save_state(); }
            }
        }

        if (step == 0) : VerticalBox {
            spacing: 16px;
            GlassCard {
                VerticalBox {
                    padding: 16px;
                    Text { text: "Something went wrong. We lost connection to your business records, and your helper needs a quick hand to get back to work."; color: white; wrap: word-wrap; font-family: "Inter"; font-size: 14px; }

                    if (is_advanced) : VerticalBox {
                        spacing: 8px;
                        Rectangle { height: 16px; }
                        Text { text: "Technical Details:"; color: #94a3b8; font-family: "Inter"; font-size: 12px; }
                        Rectangle {
                            background: rgba(0,0,0,0.5);
                            border-radius: 4px;
                            HorizontalLayout {
                                padding: 8px;
                                Text { text: "The connection to the database timed out after 5 seconds."; color: #a855f7; font-family: "Inter"; font-size: 12px; }
                            }
                        }
                    }
                }
            }
            Button { text: "View Suggested Fix"; clicked => { step = 1; } }
        }

        if (step == 1) : VerticalBox {
            spacing: 16px;
            GlassCard {
                VerticalBox {
                    padding: 16px;
                    Text { text: "Don't worry! We can usually fix this by refreshing the connection. This won't delete any of your data."; color: white; wrap: word-wrap; font-family: "Inter"; font-size: 14px; }

                    if (is_advanced) : VerticalBox {
                        spacing: 8px;
                        Rectangle { height: 16px; }
                        Text { text: "Action to take:"; color: #94a3b8; font-family: "Inter"; font-size: 12px; }
                        Rectangle {
                            background: rgba(0,0,0,0.5);
                            border-radius: 4px;
                            HorizontalLayout {
                                padding: 8px;
                                Text { text: "Restarting the helper's connection..."; color: #a855f7; font-family: "Inter"; font-size: 12px; }
                            }
                        }
                    }
                }
            }
            Button {
                text: "Refresh & Reconnect";
                height: 44px;
                clicked => {
                    is_applying = true;
                    apply_fix();
                    step = 2;
                    is_applying = false;
                }
            }
        }

        if (step == 2) : VerticalBox {
            spacing: 16px;
            GlassCard {
                VerticalBox {
                    padding: 32px;
                    spacing: 16px;
                    alignment: center;
                    Text { text: "✓"; font-size: 48px; color: #10b981; horizontal-alignment: center; }
                    Text { text: "Fix applied successfully! The agent is healthy again."; color: white; horizontal-alignment: center; font-family: "Inter"; font-size: 16px; }
                }
            }
            Button { text: "Return to Helpers"; clicked => { return_to_agents(); } }
        }
    }
}

export component Upgrade inherits Window {
    preferred-width: 400px;
    min-width: 375px;
    height: 600px;
    title: "Platform Upgrade";
    out property <string> test_title: root.title;

    in-out property <int> progress: 0;
    in-out property <bool> is_upgrading: false;
    in-out property <bool> done: false;
    in-out property <bool> is_advanced: false;

    callback save_state();

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 32px;
        alignment: center;

        HorizontalBox {
            Text { text: "Upgrade to v2.4 ✨"; font-size: 24px; font-weight: 700; color: white; font-family: "Outfit"; }
            Rectangle {}
            AdvancedToggle {
                is_advanced <=> root.is_advanced;
                toggled => { save_state(); }
            }
        }

        if (!is_upgrading && !done) : VerticalBox {
            spacing: 16px;
            GlassCard {
                VerticalBox {
                    padding: 16px;
                    Text { text: "What's new:\n• Improved agent reasoning\n• 2x faster orchestration\n• New performance tracking"; color: white; font-family: "Inter"; font-size: 14px; }
                }
            }
            Button { text: "Upgrade in 1 click"; clicked => { is_upgrading = true; /* simulate */ done = true; is_upgrading = false; } }
        }

        if (is_upgrading) : VerticalBox {
            spacing: 16px;
            GlassCard {
                VerticalBox {
                    padding: 32px;
                    spacing: 16px;
                    Text { text: "Upgrading..."; color: white; horizontal-alignment: center; font-family: "Inter"; }
                    // Progress bar placeholder
                    Rectangle {
                        height: 8px;
                        background: #e2e8f0;
                        HorizontalBox {
                            alignment: start;
                            Rectangle { width: 100px; background: #a855f7; }
                        }
                    }
                    if (is_advanced) : VerticalBox {
                        Rectangle { height: 16px; }
                        Text { text: "> Restarting services to apply the new version..."; color: #a855f7; font-family: "Inter"; font-size: 12px; }
                        Text { text: "> Updating your data format securely..."; color: #a855f7; font-family: "Inter"; font-size: 12px; }
                    }
                }
            }
        }

        if (done) : VerticalBox {
            spacing: 16px;
            GlassCard {
                VerticalBox {
                    padding: 32px;
                    spacing: 16px;
                    Text { text: "🎉"; font-size: 48px; horizontal-alignment: center; }
                    Text { text: "Upgrade complete!"; font-size: 18px; font-weight: 700; color: white; horizontal-alignment: center; font-family: "Inter"; }
                }
            }
            Button { text: "Go to Dashboard"; }
        }
    }
}

export component Billing inherits Window {
    preferred-width: 400px;
    min-width: 375px;
    height: 600px;
    title: "Billing & Credits";

    in-out property <bool> is_advanced: false;
    callback save_state();

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 32px;
        alignment: center;

        HorizontalBox {
            Text { text: "How much does this cost?"; font-size: 24px; font-weight: 700; color: white; font-family: "Outfit"; }
            Rectangle {}
            AdvancedToggle {
                is_advanced <=> root.is_advanced;
                toggled => { save_state(); }
            }
        }

        GlassCard {
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                alignment: center;
                Text { text: "Current Usage"; color: white; font-family: "Inter"; font-size: 14px; }
                Text { text: "$42.50"; font-size: 32px; font-weight: 700; color: #a855f7; font-family: "Outfit"; }
                Text { text: "Projected monthly cost: $85.00"; color: #94a3b8; font-size: 12px; font-family: "Inter"; }

                if (is_advanced) : VerticalBox {
                    Rectangle { height: 16px; }
                    Text { text: "Word Usage Breakdown:"; color: white; font-family: "Inter"; font-size: 12px; }
                    Text { text: "• OpenAI Helper: 1,245,000 words processed"; color: #94a3b8; font-family: "Inter"; font-size: 12px; }
                    Text { text: "• Google Helper: 450,000 words processed"; color: #94a3b8; font-family: "Inter"; font-size: 12px; }
                }
            }
        }

        Text { text: "Your current plan includes 1000 AI tasks per day. You have used 450 today."; color: white; wrap: word-wrap; font-family: "Inter"; font-size: 14px; }

        HorizontalBox {
            spacing: 10px;
            alignment: center;
            Button { text: "Add Credits"; }
            Button { text: "Switch Plan"; }
        }
    }
}
