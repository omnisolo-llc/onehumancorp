import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component FixAgent inherits Window {
    width: 600px;
    height: 500px;
    title: "Agent Diagnostics";

    in-out property <int> step: 0;
    in-out property <bool> is_applying: false;
    in-out property <bool> is_advanced: false;

    callback apply_fix();
    callback return_to_agents();
    callback save_state();

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 32px;
        alignment: center;

        HorizontalBox {
            Text { text: "Help me fix this"; font-size: 24px; font-weight: 700; color: white; font-family: "Outfit"; }
            Rectangle {}
            HorizontalBox {
                spacing: 8px;
                alignment: end;
                Text { text: "Advanced"; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
                TouchArea {
                    width: 20px;
                    height: 20px;
                    clicked => { is_advanced = !is_advanced; save_state(); }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 4px;
                        border-color: #a855f7;
                        border-width: 1px;
                        background: is_advanced ? #a855f7 : transparent;
                        Text { text: is_advanced ? "✓" : ""; color: white; horizontal-alignment: center; }
                    }
                }
            }
        }

        if (step == 0) : VerticalBox {
            spacing: 16px;
            GlassCard {
                VerticalBox {
                    padding: 16px;
                    Text { text: "We detected a connection timeout with the business records storage. The agent was unable to read the required state."; color: white; wrap: word-wrap; font-family: "Inter"; font-size: 14px; }

                    if (is_advanced) : VerticalBox {
                        spacing: 8px;
                        Rectangle { height: 16px; }
                        Text { text: "Raw Error Log:"; color: #94a3b8; font-family: "Inter"; font-size: 12px; }
                        Rectangle {
                            background: rgba(0,0,0,0.5);
                            border-radius: 4px;
                            HorizontalLayout {
                                padding: 8px;
                                Text { text: "{\"error\": \"timeout\", \"service\": \"postgres\", \"latency_ms\": 5000}"; color: #a855f7; font-family: "Inter"; font-size: 12px; }
                            }
                        }
                    }
                }
            }
            Button { text: "View Suggested Fix"; clicked => { step = 1; } }
        }

        if (step == 1) : VerticalBox {
            spacing: 16px;
            GlassCard {
                VerticalBox {
                    padding: 16px;
                    Text { text: "Suggested fix: Restart the agent process and refresh memory to reconnect."; color: white; wrap: word-wrap; font-family: "Inter"; font-size: 14px; }

                    if (is_advanced) : VerticalBox {
                        spacing: 8px;
                        Rectangle { height: 16px; }
                        Text { text: "CLI Command:"; color: #94a3b8; font-family: "Inter"; font-size: 12px; }
                        Rectangle {
                            background: rgba(0,0,0,0.5);
                            border-radius: 4px;
                            HorizontalLayout {
                                padding: 8px;
                                Text { text: "$ kubectl rollout restart deploy/agent-worker"; color: #a855f7; font-family: "Inter"; font-size: 12px; }
                            }
                        }
                    }
                }
            }
            Button {
                text: "Apply Fix";
                clicked => {
                    is_applying = true;
                    apply_fix();
                    step = 2;
                    is_applying = false;
                }
            }
        }

        if (step == 2) : VerticalBox {
            spacing: 16px;
            GlassCard {
                VerticalBox {
                    padding: 32px;
                    spacing: 16px;
                    alignment: center;
                    Text { text: "✓"; font-size: 48px; color: #10b981; horizontal-alignment: center; }
                    Text { text: "Fix applied successfully! The agent is healthy again."; color: white; horizontal-alignment: center; font-family: "Inter"; font-size: 16px; }
                }
            }
            Button { text: "Return to Helpers"; clicked => { return_to_agents(); } }
        }
    }
}

export component Upgrade inherits Window {
    width: 600px;
    height: 500px;
    title: "Platform Upgrade";

    in-out property <int> progress: 0;
    in-out property <bool> is_upgrading: false;
    in-out property <bool> done: false;
    in-out property <bool> is_advanced: false;

    callback save_state();

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 32px;
        alignment: center;

        HorizontalBox {
            Text { text: "Upgrade to v2.4 ✨"; font-size: 24px; font-weight: 700; color: white; font-family: "Outfit"; }
            Rectangle {}
            HorizontalBox {
                spacing: 8px;
                alignment: end;
                Text { text: "Advanced"; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
                TouchArea {
                    width: 20px;
                    height: 20px;
                    clicked => { is_advanced = !is_advanced; save_state(); }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 4px;
                        border-color: #a855f7;
                        border-width: 1px;
                        background: is_advanced ? #a855f7 : transparent;
                        Text { text: is_advanced ? "✓" : ""; color: white; horizontal-alignment: center; }
                    }
                }
            }
        }

        if (!is_upgrading && !done) : VerticalBox {
            spacing: 16px;
            GlassCard {
                VerticalBox {
                    padding: 16px;
                    Text { text: "What's new:\n• Improved agent reasoning\n• 2x faster orchestration\n• New performance tracking"; color: white; font-family: "Inter"; font-size: 14px; }
                }
            }
            Button { text: "Upgrade in 1 click"; clicked => { is_upgrading = true; /* simulate */ done = true; is_upgrading = false; } }
        }

        if (is_upgrading) : VerticalBox {
            spacing: 16px;
            GlassCard {
                VerticalBox {
                    padding: 32px;
                    spacing: 16px;
                    Text { text: "Upgrading..."; color: white; horizontal-alignment: center; font-family: "Inter"; }
                    // Progress bar placeholder
                    Rectangle {
                        height: 8px;
                        background: #e2e8f0;
                        HorizontalBox {
                            alignment: start;
                            Rectangle { width: 100px; background: #a855f7; }
                        }
                    }
                    if (is_advanced) : VerticalBox {
                        Rectangle { height: 16px; }
                        Text { text: "> K8s pod rolling restart in progress..."; color: #a855f7; font-family: "Inter"; font-size: 12px; }
                        Text { text: "> Migrating schemas..."; color: #a855f7; font-family: "Inter"; font-size: 12px; }
                    }
                }
            }
        }

        if (done) : VerticalBox {
            spacing: 16px;
            GlassCard {
                VerticalBox {
                    padding: 32px;
                    spacing: 16px;
                    Text { text: "🎉"; font-size: 48px; horizontal-alignment: center; }
                    Text { text: "Upgrade complete!"; font-size: 18px; font-weight: 700; color: white; horizontal-alignment: center; font-family: "Inter"; }
                }
            }
            Button { text: "Go to Dashboard"; }
        }
    }
}

export component Billing inherits Window {
    width: 600px;
    height: 500px;
    title: "Billing & Credits";

    in-out property <bool> is_advanced: false;
    callback save_state();

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 32px;
        alignment: center;

        HorizontalBox {
            Text { text: "How much does this cost?"; font-size: 24px; font-weight: 700; color: white; font-family: "Outfit"; }
            Rectangle {}
            HorizontalBox {
                spacing: 8px;
                alignment: end;
                Text { text: "Advanced"; color: #94a3b8; font-family: "Inter"; font-size: 14px; }
                TouchArea {
                    width: 20px;
                    height: 20px;
                    clicked => { is_advanced = !is_advanced; save_state(); }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 4px;
                        border-color: #a855f7;
                        border-width: 1px;
                        background: is_advanced ? #a855f7 : transparent;
                        Text { text: is_advanced ? "✓" : ""; color: white; horizontal-alignment: center; }
                    }
                }
            }
        }

        GlassCard {
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                alignment: center;
                Text { text: "Current Usage"; color: white; font-family: "Inter"; font-size: 14px; }
                Text { text: "$42.50"; font-size: 32px; font-weight: 700; color: #a855f7; font-family: "Outfit"; }
                Text { text: "Projected monthly cost: $85.00"; color: #94a3b8; font-size: 12px; font-family: "Inter"; }

                if (is_advanced) : VerticalBox {
                    Rectangle { height: 16px; }
                    Text { text: "Token Usage Breakdown:"; color: white; font-family: "Inter"; font-size: 12px; }
                    Text { text: "• gpt-4o: 1,245,000 tokens"; color: #94a3b8; font-family: "Inter"; font-size: 12px; }
                    Text { text: "• gemini-pro: 450,000 tokens"; color: #94a3b8; font-family: "Inter"; font-size: 12px; }
                }
            }
        }

        Text { text: "Your current plan includes 1000 AI tasks per day. You have used 450 today."; color: white; wrap: word-wrap; font-family: "Inter"; font-size: 14px; }

        HorizontalBox {
            spacing: 10px;
            alignment: center;
            Button { text: "Add Credits"; }
            Button { text: "Switch Plan"; }
        }
    }
}
