import { VerticalBox } from "std-widgets.slint";

export component GlassCard inherits Rectangle {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);

    // Glassmorphism effect
    // Slint doesn't have a direct backdrop-filter property in its base Rectangle,
    // but we emulate the look with the semi-transparent background and border.

    @children
}
