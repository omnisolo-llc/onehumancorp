import { VerticalBox } from "std-widgets.slint"; export component GlassCard inherits Rectangle { background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%); border-radius: 12px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1); drop-shadow-blur: 20px; drop-shadow-color: rgba(255, 255, 255, 0.1); @children }
