import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Experiments inherits Window {
    min-width: 375px;
    preferred-width: 500px;
    height: 600px;
    title: "Growth Experiments";
    out property <string> test_title: root.title;

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Growth Experiments"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            Button { text: "New Experiment"; }
        }

        VerticalBox {
            spacing: 12px;
            
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 16px;
                    Text { text: "🔬"; font-size: 24px; horizontal-alignment: center; } 
                    VerticalBox {
                        Text { text: "Red Button Test"; font-weight: 700; color: #1e293b; }
                        Text { text: "Traffic Split: 50.0% | Status: running"; color: #64748b; }
                    }
                    Rectangle {} 
                    Rectangle { 
                        background: rgba(16, 185, 129, 0.2); 
                        border-radius: 4px; 
                        HorizontalBox {
                            padding: 4px;
                            Text { text: "Active"; color: #10b981; font-size: 12px; } 
                        }
                    }
                }
            }
            Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 16px;
                    Text { text: "🔬"; font-size: 24px; horizontal-alignment: center; } 
                    VerticalBox {
                        Text { text: "Discount Banner Test"; font-weight: 700; color: #1e293b; }
                        Text { text: "Traffic Split: 30.0% | Status: running"; color: #64748b; }
                    }
                    Rectangle {} 
                    Rectangle { 
                        background: rgba(16, 185, 129, 0.2); 
                        border-radius: 4px; 
                        HorizontalBox {
                            padding: 4px;
                            Text { text: "Active"; color: #10b981; font-size: 12px; } 
                        }
                    }
                }
            }
        }
    }
}
