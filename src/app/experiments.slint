import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export component Experiments inherits Window {
    width: 500px;
    height: 600px;
    title: "Growth Experiments";

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Growth Experiments"; font-size: 20px; font-weight: 700; color: white; }
            Rectangle {}
            Button { text: "New Experiment"; }
        }

        VerticalBox {
            spacing: 12px;
            
            GlassCard {
                HorizontalBox {
                    padding: 16px;
                    Text { text: "🔬"; font-size: 24px; horizontal-alignment: center; } 
                    VerticalBox {
                        Text { text: "Red Button Test"; font-weight: 700; color: white; }
                        Text { text: "Traffic Split: 50.0% | Status: running"; color: #94a3b8; }
                    }
                    Rectangle {} 
                    Rectangle { 
                        background: rgba(16, 185, 129, 0.2); 
                        border-radius: 4px; 
                        HorizontalBox {
                            padding: 4px;
                            Text { text: "Active"; color: #10b981; font-size: 12px; } 
                        }
                    }
                }
            }
            GlassCard {
                HorizontalBox {
                    padding: 16px;
                    Text { text: "🔬"; font-size: 24px; horizontal-alignment: center; } 
                    VerticalBox {
                        Text { text: "Discount Banner Test"; font-weight: 700; color: white; }
                        Text { text: "Traffic Split: 30.0% | Status: running"; color: #94a3b8; }
                    }
                    Rectangle {} 
                    Rectangle { 
                        background: rgba(16, 185, 129, 0.2); 
                        border-radius: 4px; 
                        HorizontalBox {
                            padding: 4px;
                            Text { text: "Active"; color: #10b981; font-size: 12px; } 
                        }
                    }
                }
            }
        }
    }
}
