import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct UiHandoff {
    id: string,
    intent: string,
    agent_name: string,
    description: string,
    date: string,
    status: string,
}

export component Handoffs inherits Window {
    min-width: 375px;
    preferred-width: 500px;
    height: 600px;
    title: "Handoffs & Escalations";
    out property <string> test_title: root.title;

    in property <[UiHandoff]> handoffs;
    callback resolve_handoff(string, string);

    background: #f8fafc;

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Handoffs & Escalations"; font-size: 20px; font-weight: 700; color: #1e293b; }
            Rectangle {}
            Button { text: "Refresh"; }
        }

        VerticalBox {
            spacing: 16px;
            
            for h in handoffs : Rectangle {
                background: white;
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                
                VerticalBox {
                    padding: 16px;
                    spacing: 12px;
                    
                    HorizontalBox {
                        Rectangle {
                            background: #a855f7;
                            border-radius: 4px;
                            
                            HorizontalBox {
                                padding: 4px;
                                Text { text: "Intent: " + h.intent; color: white; font-size: 10px; font-weight: 700; }
                            }
                        }
                        Rectangle {}
                        Text { text: h.date; color: #64748b; font-size: 12px; horizontal-alignment: center; }
                    }
                    
                    Text { text: "Escalated by Helper: " + h.agent_name; color: #1e293b; font-weight: 700; }
                    Text { text: h.description; color: #1e293b; wrap: word-wrap; }
                    
                    HorizontalBox {
                        spacing: 10px;
                        Button { text: "Reject"; clicked => { resolve_handoff(h.id, "reject"); } }
                        Button { text: "Approve"; clicked => { resolve_handoff(h.id, "approve"); } }
                    }
                }
            }
        }
    }
}
