import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component KairosOrchestrationWalkthrough inherits Window {
    min-width: 375px;
    preferred-width: 600px;
    height: 600px;
    title: "KAIROS Orchestration Walkthrough";
    out property <string> test_title: root.title;

    in-out property <int> current_step: 0;

    // Glassmorphism background
    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
    always-on-top: true;

    Rectangle {
        background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
        opacity: 0.5;
        preferred-width: parent.width;
        height: parent.height;
    }

    VerticalBox {
        spacing: 20px;
        padding: 24px;
        alignment: center;

        Text { text: "KAIROS Orchestration: Visual Walkthrough"; font-size: 24px; font-weight: 700; color: white; font-family: "Outfit"; }

        Rectangle {
            // Glassmorphism card
            background: rgba(255, 255, 255, 0.03);
            border-color: rgba(255, 255, 255, 0.1);
            border-width: 1px;
            border-radius: 12px;
            preferred-width: 500px;

            VerticalBox {
                padding: 32px;
                spacing: 16px;

                Text {
                    text: current_step == 0 ? "The KAIROS Triad" :
                          current_step == 1 ? "1. Shared Task List (The Brain)" :
                          current_step == 2 ? "2. Teammate Mesh (The Nerves)" :
                          "3. AutoDream (The Memory)";
                    font-size: 20px;
                    font-weight: 700;
                    color: white;
                    font-family: "Outfit";
                }

                Text {
                    text: current_step == 0 ? "The OHC Swarm Orchestration relies on a unified tri-layer architecture combining memory, messaging, and state." :
                          current_step == 1 ? "The Shared Task List operates as a robust State Machine. Cloud deployments leverage PostgreSQL with FOR UPDATE SKIP LOCKED for horizontal scalability. Standalone desktop deployments gracefully degrade to local SQLite mutexes." :
                          current_step == 2 ? "Powered by CentrifugeNode and Redis Pub/Sub, the Teammate Mesh streams events with sub-millisecond latency. This low-latency layer broadcasts capability advertisements and synchronous worker state transitions." :
                          "AutoDream continuously harvests ephemeral session logs, compresses context utilizing local LLMs, and stores dense vectors into a durable pgvector (or Standalone alternative) store. Swarm agents semantically query this database to maintain infinite long-term context.";
                    color: #94a3b8;
                    wrap: word-wrap;
                    font-family: "Inter";
                }

                HorizontalBox {
                    alignment: center;
                    spacing: 20px;

                    Button {
                        text: "Previous Step";
                        enabled: current_step > 0;
                        clicked => { current_step = current_step - 1; }
                    }

                    Text {
                        text: "Step " + (current_step + 1) + " of 4";
                        color: #9ca3af;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Button {
                        text: current_step < 3 ? "Next Step" : "Done";
                        clicked => {
                            if (current_step < 3) {
                                current_step = current_step + 1;
                            } else {
                                root.visible = false;
                            }
                        }
                    }
                }
            }
        }
    }
}
