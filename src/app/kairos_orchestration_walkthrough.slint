import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component KairosOrchestrationWalkthrough inherits Window {
    width: 600px;
    height: 600px;
    title: "How Your Helpers Work Together";
    out property <string> test_title: root.title;

    in-out property <int> current_step: 0;

    // Glassmorphism background
    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
    always-on-top: true;

    Rectangle {
        background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
        opacity: 0.5;
        width: parent.width;
        height: parent.height;
    }

    VerticalBox {
        spacing: 20px;
        padding: 24px;
        alignment: center;

        Text { text: "How Your Helpers Work Together"; font-size: 24px; font-weight: 700; color: white; font-family: "Outfit"; }

                Rectangle {
            // Glassmorphism card
            background: rgba(255, 255, 255, 0.03);
            border-color: rgba(255, 255, 255, 0.1);
            border-width: 1px;
            border-radius: 12px;
            width: 500px;

            VerticalBox {
                padding: 32px;
                spacing: 16px;

                Text {
                    text: current_step == 0 ? "The Helper System" :
                          current_step == 1 ? "1. Shared To-Do List" :
                          current_step == 2 ? "2. Instant Messaging" :
                          "3. Long-Term Memory";
                    font-size: 20px;
                    font-weight: 700;
                    color: white;
                    font-family: "Outfit";
                }

                Text {
                    text: current_step == 0 ? "Your helpers work together using a simple three-part system: memory, messaging, and a shared to-do list." :
                          current_step == 1 ? "The Shared To-Do List ensures that helpers don't step on each other's toes. Whether you're running a busy cloud store or managing everything on your local computer, tasks are organized and handled one at a time." :
                          current_step == 2 ? "The Teammate Mesh is how your helpers talk to each other instantly. When a new order arrives or a customer asks a question, the right helper is notified immediately so they can jump into action." :
                          "AutoDream is your business's long-term memory. It securely remembers past conversations, customer preferences, and completed tasks so your helpers get smarter over time without you having to repeat yourself.";
                    color: #94a3b8;
                    wrap: word-wrap;
                    font-family: "Inter";
                }

                HorizontalBox {
                    alignment: center;
                    spacing: 20px;

                    Button {
                        text: "Previous Step";
                        enabled: current_step > 0;
                        clicked => { current_step = current_step - 1; }
                    }

                    Text {
                        text: "Step " + (current_step + 1) + " of 4";
                        color: #9ca3af;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Button {
                        text: current_step < 3 ? "Next Step" : "Done";
                        clicked => {
                            if (current_step < 3) {
                                current_step = current_step + 1;
                            } else {
                                root.visible = false;
                            }
                        }
                    }
                }
            }
        }
    }
}
