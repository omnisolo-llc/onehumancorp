import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, ScrollView, CheckBox } from "std-widgets.slint";

export component ApiDocs inherits Window {
    preferred-width: 800px;
    preferred-height: 600px;
    min-width: 375px;
    title: "Connect Custom Software";
    out property <string> test_title: root.title;
    background: #0f172a;
    in-out property <string> api_key: "sk_live_...";
    in-out property <string> endpoint_url: "https://api.ohc.io";
    in-out property <bool> is_advanced: false;

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 800px;
            width: 100%;
            padding: 16px;
            spacing: 20px;

            Text {
                text: "Connect Other Apps";
                font-size: 24px;
                font-weight: 700;
                color: white;
            }

            Text {
                text: "You only need this if you are a programmer connecting our app to your own systems.";
                color: #ef4444; // red warning
                wrap: word-wrap;
            }

            CheckBox {
                text: "Show Programmer Details";
                checked <=> is_advanced;
            }

            if (is_advanced): ScrollView {
                VerticalBox {
                    spacing: 24px;

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Product Data Access"; font-weight: 700; font-size: 18px; color: white; }
                        GlassCard { // dark theme for code
                            VerticalBox {
                                padding: 16px; spacing: 8px;
                                Text { text: "Read Product List"; font-weight: 700; color: #10b981; } // green for GET
                                Text { text: "Returns a list of all products in your store."; color: white; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
        }
    }
}
