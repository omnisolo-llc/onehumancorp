import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export component ApiDocs inherits Window {
    preferred-width: 800px;
    preferred-height: 600px;
    min-width: 375px;
    title: "Connect Custom Software";
    background: #0f172a;
    in-out property <string> api_key: "sk_live_...";
    in-out property <string> endpoint_url: "https://api.ohc.io";

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 800px;
            width: 100%;
            padding: 16px;
            spacing: 20px;

            Text {
                text: "Custom Integration";
                font-size: 24px;
                font-weight: 700;
                color: white;
            }

            Text {
                text: "This section is for developers who want to connect OHC to custom software. If you don't write code, you don't need to use this page!";
                color: #ef4444; // red warning
                wrap: word-wrap;
            }

            ScrollView {
                VerticalBox {
                    spacing: 24px;

                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "Base URL: "; color: #94a3b8; vertical-alignment: center; }
                        Rectangle {
                            background: #1e293b;
                            border-radius: 4px;

                            Text { text: root.endpoint_url; color: white; font-family: "monospace"; }
                        }
                    }

                    VerticalBox {
                        spacing: 12px;
                        Text { text: "Product Data Access"; font-weight: 700; font-size: 18px; color: white; }

                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                HorizontalBox {
                                    spacing: 12px;
                                    Rectangle {
                                        width: 60px;
                                        height: 24px;
                                        background: #10b981;
                                        border-radius: 4px;
                                        Text { text: "GET"; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { text: "/v1/products"; color: white; font-family: "monospace"; vertical-alignment: center; font-weight: 700; }
                                }
                                Text { text: "Returns a list of all products in your store."; color: #94a3b8; wrap: word-wrap; }

                                Button {
                                    text: "Test Endpoint";
                                    clicked => { /* Trigger API Request */ }
                                }
                            }
                        }

                        GlassCard {
                            VerticalBox {
                                padding: 16px; spacing: 12px;
                                HorizontalBox {
                                    spacing: 12px;
                                    Rectangle {
                                        width: 60px;
                                        height: 24px;
                                        background: #3b82f6;
                                        border-radius: 4px;
                                        Text { text: "POST"; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { text: "/v1/products"; color: white; font-family: "monospace"; vertical-alignment: center; font-weight: 700; }
                                }
                                Text { text: "Creates a new product."; color: #94a3b8; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
        }
    }
}
