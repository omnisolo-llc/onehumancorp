import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, ScrollView, CheckBox } from "std-widgets.slint";
import { TooltipElement } from "tooltip_element.slint";

export struct ApiEndpoint {
    method: string,
    path: string,
    description: string,
}

export component ApiDocs inherits Window {
    preferred-width: 800px;
    preferred-height: 600px;
    min-width: 375px;
    title: "Connect Custom Software";
    out property <string> test_title: root.title;
    background: #0f172a;
    in-out property <string> api_key: "sk_live_...";
    in-out property <string> endpoint_url: "https://api.ohc.io";
    in-out property <bool> is_advanced: false;
    in property <[ApiEndpoint]> endpoints: [];
    in-out property <string> api_response: "";
    in-out property <string> active_endpoint: "";
    callback test_endpoint(string);

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 800px;
            width: 100%;
            padding: 16px;
            spacing: 20px;

            Text {
                text: "Custom Integration";
                font-size: 24px;
                font-weight: 700;
                color: white;
            }

            Text {
                text: "Connect other tools to your store. This is an advanced feature for software developers. If you are not a developer, you don't need to use this page.";
                color: #ef4444; // red warning
                wrap: word-wrap;
            }

            TooltipElement {
                tooltip_id: "api_docs_advanced";
                CheckBox {
                    text: "Show Advanced Developer Documentation";
                    checked <=> is_advanced;
                }
            }

            if (is_advanced): ScrollView {
                VerticalBox {
                    spacing: 24px;

                    for ep in endpoints: VerticalBox {
                        spacing: 8px;
                        GlassCard { // dark theme for code
                            VerticalBox {
                                padding: 16px; spacing: 8px;
                                HorizontalBox {
                                    spacing: 12px;
                                    Text {
                                        text: ep.method;
                                        font-weight: 700;
                                        color: ep.method == "GET" ? #10b981 : (ep.method == "POST" ? #3b82f6 : #f59e0b);
                                    }
                                    Text { text: ep.path; font-weight: 700; color: white; }
                                }
                                Text { text: ep.description; color: #cbd5e1; wrap: word-wrap; }
                                TooltipElement {
                                    tooltip_id: "api_test_button";
                                    Button {
                                        text: "Run Test";
                                        clicked => { root.test_endpoint(ep.path); root.active_endpoint = ep.path; }
                                    }
                                }
                                if (root.active_endpoint == ep.path && root.api_response != "") : Rectangle {
                                    background: #1e293b;
                                    border-radius: 4px;
                                    padding: 8px;
                                    Text {
                                        text: root.api_response;
                                        color: #a7f3d0;
                                        wrap: word-wrap;
                                        font-family: "monospace";
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
