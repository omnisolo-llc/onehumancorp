import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, ScrollView, CheckBox } from "std-widgets.slint";

export component ApiDocs inherits Window {
    preferred-width: 800px;
    preferred-height: 600px;
    min-width: 375px;
    title: "Connect Custom Software";
    out property <string> test_title: root.title;
    background: #0f172a;
    in-out property <string> api_key: "sk_live_...";
    in-out property <string> endpoint_url: "https://api.ohc.io";
    in-out property <bool> is_advanced: false;

    // Interactive properties
    in-out property <string> test_response: "";
    in-out property <bool> is_testing: false;
    callback test_endpoint();

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 800px;
            width: 100%;
            padding: 16px;
            spacing: 20px;

            Text {
                text: "Custom Integration";
                font-size: 24px;
                font-weight: 700;
                color: white;
            }

            Text {
                text: "This section is for developers who want to connect OHC to custom software. If you don't write code, you don't need to use this page!";
                color: #ef4444; // red warning
                wrap: word-wrap;
            }

            CheckBox {
                text: "Show Advanced Developer Documentation";
                checked <=> is_advanced;
            }

            if (is_advanced): ScrollView {
                VerticalBox {
                    spacing: 24px;

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Product Data Access"; font-weight: 700; font-size: 18px; color: white; }
                        GlassCard { // dark theme for code
                            VerticalBox {
                                padding: 16px; spacing: 8px;
                                Text { text: "Read Product List"; font-weight: 700; color: #10b981; } // green for GET
                                Text { text: "Returns a list of all products in your store."; color: white; wrap: word-wrap; }

                                // Interactive Try It Out section
                                VerticalBox {
                                    spacing: 8px;
                                    Text { text: "Try it out (Interactive Console):"; font-weight: 700; font-size: 14px; color: #94a3b8; }
                                    HorizontalBox {
                                        spacing: 8px;
                                        // LineEdit doesn't exist in all environments or can't evaluate correctly? wait, std-widgets has TextEdit or LineEdit
                                        // We will just use Text
                                        Text {
                                            text: "GET " + endpoint_url + "/v1/products";
                                            color: white;
                                        }
                                        Button {
                                            text: is_testing ? "Testing..." : "Send Request";
                                            clicked => { root.test_endpoint(); }
                                        }
                                    }
                                    if (test_response != ""): Rectangle {
                                        background: #1e293b;
                                        border-radius: 4px;
                                        padding: 12px;
                                        Text {
                                            text: test_response;
                                            color: #10b981;
                                            // font-family: "monospace";
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
