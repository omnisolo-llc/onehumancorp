import { VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct UiMeshMessage {
    id: string,
    content: string,
}

export component SwarmObservability {
    in-out property <[UiMeshMessage]> messages;

    VerticalBox {
        spacing: 16px;

        Text {
            text: "Agent Activity Feed";
            font-size: 20px;
            font-family: "Outfit";
            font-weight: 700;
            color: white;
        }

        if (messages.length == 0) : Rectangle {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.1);
            border-width: 1px;
            border-radius: 12px;
            HorizontalBox {
                padding: 16px;
                Text {
                    text: "Agents are idle.";
                    color: #94a3b8;
                    font-family: "Inter";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        for msg in messages : Rectangle {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.1);
            border-width: 1px;
            border-radius: 12px;

            HorizontalBox {
                padding: 16px;
                spacing: 12px;

                // Placeholder for an icon/avatar
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: #a855f7;
                    Text {
                        text: "🤖";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalBox {
                    spacing: 4px;
                    Text {
                        text: "Agent Activity";
                        font-size: 14px;
                        font-weight: 700;
                        color: #cbd5e1;
                        font-family: "Inter";
                    }
                    Text {
                        text: msg.content;
                        font-size: 16px;
                        color: white;
                        font-family: "Inter";
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
