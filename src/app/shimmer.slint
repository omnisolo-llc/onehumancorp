export component Shimmer inherits Rectangle {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    property <float> target_opacity: 0.2;
    opacity: target_opacity;
    init => {
        target_opacity = 0.8;
    }
    animate target_opacity {
        duration: 1500ms;
        iteration-count: -1;
        easing: ease-in-out;
    }
}
