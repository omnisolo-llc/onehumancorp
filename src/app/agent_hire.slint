import { Button, VerticalBox, HorizontalBox, CheckBox, LineEdit, ScrollView, Slider } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";
import { AdvancedToggle } from "advanced_toggle.slint";

export struct UiAgentProvider {
    type_: string,
    label: string,
    description: string,
}

export component AgentHire inherits Window {
    width: 600px;
    height: 700px;
    title: "Hire New Helper";

    in-out property <int> step: 0;
    in-out property <bool> is_advanced: false;
    callback toggle_advanced();
    toggle_advanced => { }
    in-out property <string> selected_role: "";
    in-out property <string> selected_provider: "";
    in-out property <string> agent_name: "";
    
    out property <bool> next_enabled: step != 0 || selected_role != "";
    
    in property <[string]> roles;
    in property <[UiAgentProvider]> providers;
    
    callback deploy_agent(string, string, string);
    property <bool> cap_email: false;
    property <bool> cap_message: false;
    in-out property <float> frequency_value: 2.0;

    callback next_step();
    callback prev_step();

    next_step => {
        if (!is_advanced && step == 0) {
            step = 2;
        } else if (!is_advanced && step == 2) {
            step = 4;
        } else {
            step = step + 1;
        }
    }

    prev_step => {
        if (!is_advanced && step == 2) {
            step = 0;
        } else if (!is_advanced && step == 4) {
            step = 2;
        } else {
            step = step - 1;
        }
    }

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 24px;


        HorizontalBox {
            Text { text: "Hire New Helper"; font-size: 24px; font-weight: 700; font-family: "Outfit"; color: white; }
            Rectangle {}
            AdvancedToggle {
                is_advanced <=> root.is_advanced;
                toggled => { toggle_advanced(); }
            }
        }

        // Step 0: Role
        if (step == 0) : VerticalBox {
            spacing: 16px;
            Text { text: "Select Helper Role"; font-size: 20px; font-weight: 700; font-family: "Outfit"; color: white; }
            Text { text: "What kind of helper do you need?"; font-family: "Inter"; font-size: 14px; color: #94a3b8; }
            
            ScrollView {
                height: 300px;
                VerticalBox {
                    spacing: 12px;
                    for role in roles : GlassCard {
                        height: 60px;
                        background: selected_role == role ? rgba(168, 85, 247, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        HorizontalBox {
                            alignment: start; padding: 12px; spacing: 16px;
                            Text { text: "🤖"; font-size: 24px; vertical-alignment: center; }
                            Text { text: role; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; vertical-alignment: center; }
                            Rectangle {}
                            if (selected_role == role) : Rectangle {
                                width: 80px;
                                background: rgba(16, 185, 129, 0.2);
                                border-radius: 4px;
                                Text { text: "Selected ✓"; font-family: "Inter"; font-size: 12px; color: #10b981; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            if (selected_role != role) : Rectangle {
                                width: 80px;
                                border-width: 1px;
                                border-color: rgba(255, 255, 255, 0.2);
                                border-radius: 4px;
                                Text { text: "Add to team"; font-family: "Inter"; font-size: 12px; color: white; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        TouchArea { clicked => { selected_role = role; agent_name = "Senior " + role; } }
                    }
                }
            }
        }


        // Step 1: Provider
        if (step == 1) : VerticalBox {
            spacing: 16px;
            if (is_advanced) : VerticalBox {
                spacing: 8px;
                Text { text: "Developer: Raw Provider Endpoints"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
                LineEdit { placeholder-text: "https://custom.api.endpoint"; height: 44px; }
            }
            Text { text: "Choose AI Provider"; font-size: 20px; font-weight: 700; font-family: "Outfit"; color: white; }
            
            ScrollView {
                height: 300px;
                VerticalBox {
                    spacing: 12px;
                    for p in providers : GlassCard {
                        height: 60px;
                        background: selected_provider == p.type_ ? rgba(16, 185, 129, 0.4) : @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);
                        VerticalBox {
                            alignment: center; padding: 12px;
                            Text { text: p.label; font-family: "Inter"; font-size: 16px; color: white; font-weight: 700; horizontal-alignment: center; }
                        }
                        TouchArea { clicked => { selected_provider = p.type_; } }
                    }
                }
            }
        }

        // Step 2: Details
        if (step == 2) : VerticalBox {
            spacing: 16px;
            Text { text: "Helper Details"; font-size: 20px; font-weight: 700; font-family: "Outfit"; color: white; }
            Text { text: "Give your helper a friendly name."; font-family: "Inter"; font-size: 14px; color: #94a3b8; }
            LineEdit {
                placeholder-text: "Helper Name";
                text <=> agent_name;
                height: 44px;
            }
        }

        // Step 3: Topology
        if (step == 3) : VerticalBox {
            spacing: 16px;
            Text { text: "Sub-helper Topology"; font-size: 20px; font-weight: 700; font-family: "Outfit"; color: white; }
            GlassCard {
                height: 200px;
                VerticalBox {
                    alignment: center; padding: 16px; spacing: 16px;

                    GlassCard {
                        width: 140px; height: 44px; background: rgba(168, 85, 247, 0.4);
                        VerticalBox { alignment: center; Text { text: "Orchestrator Agent"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                    }
                    Text { text: "↓"; font-size: 24px; color: white; horizontal-alignment: center; }
                    HorizontalBox {
                        spacing: 24px; alignment: center;
                        GlassCard {
                            width: 120px; height: 44px; background: rgba(16, 185, 129, 0.4);
                            VerticalBox { alignment: center; Text { text: "Tool Execution"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                        }
                        GlassCard {
                            width: 120px; height: 44px; background: rgba(59, 130, 246, 0.4);
                            VerticalBox { alignment: center; Text { text: "Web Search"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                        }
                    }
                }
            }
        }

        // Step 4: Capabilities
        if (step == 4) : VerticalBox {
            spacing: 16px;
            Text { text: "Select Capabilities"; font-size: 20px; font-weight: 700; font-family: "Outfit"; color: white; }
            Text { text: "What permissions do they have?"; font-family: "Inter"; font-size: 14px; color: #94a3b8; }

            GlassCard {
                height: 60px;
                HorizontalBox {
                    padding: 16px;
                    Text { text: "Read my emails"; color: white; font-family: "Inter"; vertical-alignment: center; }
                    Rectangle {}
                    CheckBox { checked: cap_email; toggled => { cap_email = !cap_email; } }
                }
            }
            GlassCard {
                height: 60px;
                HorizontalBox {
                    padding: 16px;
                    Text { text: "Send messages on my behalf"; color: white; font-family: "Inter"; vertical-alignment: center; }
                    Rectangle {}
                    CheckBox { checked: cap_message; toggled => { cap_message = !cap_message; } }
                }
            }
        }


        // Step 5: Limits / Schedule
        if (step == 5) : VerticalBox {
            spacing: 16px;
            if (is_advanced) : VerticalBox {
                spacing: 8px;
                Text { text: "Developer: Raw Rate Limit Config (JSON)"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
                LineEdit { placeholder-text: "{\"max_sessions_per_day\": 50}"; height: 44px; }
            }
            Text { text: "Schedule / Frequency"; font-size: 20px; font-weight: 700; font-family: "Outfit"; color: white; }
            Text { text: "How often should this agent work?"; color: white; font-family: "Inter"; }

            HorizontalBox {
                spacing: 10px;
                Slider {
                    minimum: 0.0;
                    maximum: 3.0;
                    value <=> frequency_value;
                    width: 100%;
                }
            }
            Text {
                text: "Schedule: " + (round(frequency_value) == 0 ? "Real-time" : (round(frequency_value) == 1 ? "Hourly" : (round(frequency_value) == 2 ? "Daily" : "Weekly")));
                color: #a855f7;
                horizontal-alignment: center;
                font-family: "Inter";
                font-weight: 700;
                font-size: 16px;
            }
        }


        // Step 6: Confirm
        if (step == 6) : VerticalBox {
            spacing: 16px;
            if (is_advanced) : VerticalBox {
                spacing: 8px;
                Text { text: "Developer: Raw JSON Deployment Payload"; font-size: 14px; font-family: "Inter"; color: #94a3b8; }
                LineEdit { placeholder-text: "{\"role\": \"Support\"}"; height: 60px; }
            }
            Text { text: "Review & Activate"; font-size: 20px; font-weight: 700; font-family: "Outfit"; color: white; }

            GlassCard {
                VerticalBox {
                    padding: 16px; spacing: 8px;
                    Text { text: "Name: " + agent_name; color: white; font-family: "Inter"; font-weight: 700; font-size: 16px; }
                    Text { text: "Role: " + selected_role; color: #cbd5e1; font-family: "Inter"; font-size: 14px; }
                    Text { text: "Schedule: " + (round(frequency_value) == 0 ? "Real-time" : (round(frequency_value) == 1 ? "Hourly" : (round(frequency_value) == 2 ? "Daily" : "Weekly"))); color: #cbd5e1; font-family: "Inter"; font-size: 14px; }
                    if (is_advanced) : Text { text: "Provider: " + selected_provider; color: #94a3b8; font-family: "Inter"; font-size: 12px; }
                }
            }
        }

        Rectangle {} // Spacer

        // Navigation
        HorizontalBox {
            if (step > 0) : GlassCard {
                width: 100px;
                height: 44px;
                VerticalBox { alignment: center; Text { text: "Back"; font-family: "Inter"; color: white; horizontal-alignment: center; } }
                TouchArea { clicked => { prev_step(); } }
            }
            if (step == 0) : Rectangle { width: 100px; } // spacer

            Rectangle {} // Center spacer

            if (step < 6) : GlassCard {
                width: 120px;
                height: 44px;
                background: next_enabled ? rgba(168, 85, 247, 0.8) : rgba(100, 116, 139, 0.4);
                VerticalBox { alignment: center; Text { text: "Next →"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea {
                    enabled: next_enabled;
                    clicked => { next_step(); }
                }
            }
            if (step == 6) : GlassCard {
                width: 160px;
                height: 44px;
                background: next_enabled ? rgba(16, 185, 129, 0.8) : rgba(100, 116, 139, 0.4);
                VerticalBox { alignment: center; Text { text: "Activate"; font-family: "Inter"; font-weight: 700; color: white; horizontal-alignment: center; } }
                TouchArea {
                    enabled: next_enabled;
                    clicked => { deploy_agent(agent_name, selected_role, selected_provider); }
                }
            }
        }
    }
}
