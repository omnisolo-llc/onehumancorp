import {  Button, VerticalBox, HorizontalBox  } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export struct UiAgentCost {
    name: string,
    cost: string,
    roi: string,
    efficiency: string,
    pct: float,
}

export component CostDashboard inherits Window {
    width: 500px;
    height: 600px;
    title: "Cost & Token Usage";

    in-out property <string> total_spend: "$0.00";
    in-out property <string> total_tokens: "0";
    in-out property <string> forecasted_cost: "$0.00";
    in-out property <string> budget_alert_threshold: "500";
    in-out property <[UiAgentCost]> agent_costs;

    callback set_budget_alert(string);

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Cost & Token Usage"; font-size: 20px; font-family: "Outfit"; font-weight: 700; color: white; }
            Rectangle {}
            Button { text: "Refresh"; }
        }

        // Summary Cards
        HorizontalBox {
            spacing: 16px;
            
            GlassCard {
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;
                
                VerticalBox {
                    padding: 16px;
                    Text { text: "Total Spend"; color: #94a3b8; }
                    Text { text: total_spend; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: #a855f7; }
                }
            }
            GlassCard {
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;
                
                VerticalBox {
                    padding: 16px;
                    Text { text: "Total Tokens"; color: #94a3b8; }
                    Text { text: total_tokens; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: #06b6d4; }
                }
            }
            GlassCard {
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                width: 220px;

                VerticalBox {
                    padding: 16px;
                    Text { text: "Forecasted Cost"; color: #94a3b8; }
                    Text { text: forecasted_cost; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: #ef4444; }
                }
            }
        }

        Text { text: "Usage per Agent"; font-size: 18px; font-family: "Outfit"; font-weight: 700; color: white; }

        HorizontalBox {
            Text { text: "Budget Alert Threshold ($):"; color: white; vertical-alignment: center; }
            TextInput {
                text <=> budget_alert_threshold;
                color: white;
                accepted => {
                    set_budget_alert(self.text);
                }
            }
            Button {
                text: "Set Alert";
                clicked => { set_budget_alert(budget_alert_threshold); }
            }
        }

        GlassCard {
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 8px;
            
            VerticalBox {
                padding: 16px;
                spacing: 12px;
                
                for ac in agent_costs : VerticalBox {
                    spacing: 4px;
                    HorizontalBox {
                        Text { text: ac.name; color: white; }
                        Rectangle {}
                        Text { text: ac.cost; color: white; }
                    }
                    HorizontalBox {
                        Text { text: "ROI: " + ac.roi; color: #64748b; font-size: 12px; }
                        Rectangle {}
                        Text { text: "Efficiency: " + ac.efficiency; color: #64748b; font-size: 12px; }
                    }
                    Rectangle {
                        height: 8px;
                        background: #e2e8f0;
                        border-radius: 4px;
                        HorizontalBox {
                            alignment: start;
                            Rectangle { 
                                width: ac.pct * 200px; // Fixed max width for simplicity
                                background: #a855f7; 
                                border-radius: 4px; 
                            }
                        }
                    }
                }
            }
        }
    }
}
