import {  Button, VerticalBox, HorizontalBox  } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export struct UiHelperCost {
    name: string,
    cost: string,
    roi: string,
    efficiency: string,
    pct: float,
}

export component CostDashboard inherits Window {
    preferred-width: 500px;
    min-width: 375px;
    height: 800px;
    title: "Cost & AI Usage";

    in-out property <string> total_spend: "$0.00";
    in-out property <string> total_ai_usage: "0";
    in-out property <[UiHelperCost]> helper_costs;

    callback refresh_data();

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        HorizontalBox {
            Text { text: "Cost & AI Usage"; font-size: 20px; font-family: "Outfit"; font-weight: 700; color: white; }
            Rectangle {}
            Button { text: "Refresh"; height: 44px; clicked => { refresh_data(); } }
        }

        // Summary Cards
        VerticalBox {
            visible: root.width <= 768px;
            spacing: 16px;

            GlassCard {
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;

                VerticalBox {
                    padding: 16px;
                    Text { text: "Total Spend"; color: #94a3b8; }
                    Text { text: total_spend; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: #a855f7; }
                }
            }
            GlassCard {
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;

                VerticalBox {
                    padding: 16px;
                    Text { text: "Total AI Usage"; color: #94a3b8; }
                    Text { text: total_ai_usage; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: #06b6d4; }
                }
            }
        }

        HorizontalBox {
            visible: root.width > 768px;
            spacing: 16px;

            GlassCard {
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                horizontal-stretch: 1;
                
                VerticalBox {
                    padding: 16px;
                    Text { text: "Total Spend"; color: #94a3b8; }
                    Text { text: total_spend; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: #a855f7; }
                }
            }
            GlassCard {
                border-color: #e2e8f0;
                border-width: 1px;
                border-radius: 8px;
                horizontal-stretch: 1;

                VerticalBox {
                    padding: 16px;
                    Text { text: "Total AI Usage"; color: #94a3b8; }
                    Text { text: total_ai_usage; font-size: 24px; font-family: "Outfit"; font-weight: 700; color: #06b6d4; }
                }
            }
        }

        Text { text: "Usage per Helper"; font-size: 18px; font-family: "Outfit"; font-weight: 700; color: white; }

        GlassCard {
            border-color: #e2e8f0;
            border-width: 1px;
            border-radius: 8px;
            
            VerticalBox {
                padding: 16px;
                spacing: 12px;
                
                for ac in helper_costs : VerticalBox {
                    spacing: 4px;
                    HorizontalBox {
                        Text { text: ac.name; color: white; }
                        Rectangle {}
                        Text { text: ac.cost; color: white; }
                    }
                    HorizontalBox {
                        Text { text: "ROI: " + ac.roi; color: #64748b; font-size: 12px; }
                        Rectangle {}
                        Text { text: "Efficiency: " + ac.efficiency; color: #64748b; font-size: 12px; }
                    }
                    Rectangle {
                        height: 8px;
                        background: #e2e8f0;
                        border-radius: 4px;
                        HorizontalBox {
                            alignment: start;
                            Rectangle { 
                                width: ac.pct * 200px; // Fixed max width for simplicity
                                background: #a855f7; 
                                border-radius: 4px; 
                            }
                        }
                    }
                }
            }
        }
    }
}
