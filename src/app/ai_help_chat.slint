import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";





export struct ChatMessage {
    text: string,
    is_user: bool,
    article_link: string,
}

export component AiHelpChat inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "AI Help Assistant";
    out property <string> test_title: root.title;
    background: #0f172a;


    in property <[ChatMessage]> messages;

    in-out property <string> user_input: "";
    callback send_message();
    callback append_message(ChatMessage);

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            padding: 16px;
            spacing: 16px;

            GlassCard {
                VerticalBox {
                    padding: 16px;
                    Text {
                        text: "Hi! I'm your OHC Help Assistant. I can answer any questions you have about using the app. What do you need help with today?";
                        color: white;
                        wrap: word-wrap;
                    }
                }
            }

            ScrollView {

                VerticalBox {
                    spacing: 12px;
                    for msg in messages : HorizontalBox {
                        alignment: msg.is_user ? end : start;
                        GlassCard {
                            width: msg.is_user ? 400px : 500px;
                            VerticalBox {
                                padding: 12px;
                                spacing: 8px;
                                Text {
                                    text: msg.text;
                                    color: white;
                                    wrap: word-wrap;
                                }
                                if msg.article_link != "" : HorizontalBox {
                                    alignment: start;
                                    Button {
                                        text: "Read the full article →";
                                    }
                                }
                            }
                        }
                    }
                }

            }

            HorizontalBox {
                spacing: 8px;
                LineEdit {
                    placeholder-text: "Type your question here...";
                    text <=> user_input;
                }
                Button {
                    text: "Send";
                    clicked => { send_message(); }
                }
            }
        }
    }
}
