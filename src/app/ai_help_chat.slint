import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";

export struct HelpMessage {
    text: string,
    is_user: bool,
}

export component AiHelpChat inherits Window {
    preferred-width: 450px;
    preferred-height: 600px;
    min-width: 375px;
    title: "AI Help Assistant";
    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    in-out property <string> user_input: "";

    callback send_message();

    VerticalBox {
        padding: 20px;
        spacing: 16px;

        Text {
            text: "Ask anything";
            font-size: 24px;
            font-family: "Outfit";
            font-weight: 700;
            color: white;
        }

        ScrollView {
            VerticalBox {
                spacing: 12px;
                padding: 4px;

                HorizontalBox {
                    alignment: start;

                    GlassCard {
                        width: 300px;
                        background: rgba(255, 255, 255, 0.05);
                        border-color: rgba(255, 255, 255, 0.1);

                        VerticalBox {
                            padding: 12px;
                            Text {
                                text: "Hi! I'm your OHC Help Assistant. How can I help you today?";
                                color: white;
                                font-family: "Inter";
                                wrap: word-wrap;
                                font-size: 14px;
                            }
                        }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 12px;
            height: 56px;

            LineEdit {
                placeholder-text: "Type your question...";
                text <=> user_input;
                height: 48px;
            }

            Button {
                text: "Send";
                width: 80px;
                height: 48px;
                clicked => {
                    if (user_input != "") {
                        root.send_message();
                    }
                }
            }
        }
    }
}
