import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";
import { TooltipElement } from "tooltip_element.slint";

export struct ChatMessage {
    sender: string,
    text: string,
    article_link: string,
}

export component AiHelpChat inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "AI Help Assistant";
    out property <string> test_title: root.title;
    background: transparent;

    in-out property <string> user_input: "";
    in property <[ChatMessage]> messages: [
        { sender: "AI", text: "Hi! I'm your OHC Help Assistant. I can answer any questions you have about using the app to grow your business. What do you need help with today?", article_link: "" }
    ];
    callback send_message();
    callback open_article(string);

    Rectangle {
        background: #0f172a.transparentize(20%);
        width: 100%;
        height: 100%;
        drop-shadow-blur: 20px;
    }

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            padding: 24px;
            spacing: 20px;

            Text {
                text: "Ask Anything";
                font-size: 28px;
                font-weight: 700;
                font-family: "Outfit";
                color: white;
            }

            ScrollView {
                VerticalBox {
                    spacing: 16px;
                    for msg in messages: HorizontalBox {
                        alignment: msg.sender == "User" ? end : start;
                        GlassCard {
                            width: 80%;
                            border-radius: 16px;
                            border-color: rgba(255, 255, 255, 0.1);
                            border-width: 1px;
                            background: msg.sender == "User" ? rgba(59, 130, 246, 0.2) : rgba(139, 92, 246, 0.2);
                            VerticalBox {
                                padding: 16px;
                                spacing: 8px;
                                Text {
                                    text: msg.sender == "User" ? "You" : "Support Helper";
                                    color: msg.sender == "User" ? #93c5fd : #c4b5fd;
                                    font-size: 14px;
                                    font-family: "Outfit";
                                    font-weight: 700;
                                }
                                Text {
                                    text: msg.text;
                                    color: white;
                                    wrap: word-wrap;
                                    font-family: "Inter";
                                    font-size: 15px;
                                }
                                if msg.article_link != "": TouchArea {
                                    clicked => { root.open_article(msg.article_link); }
                                    HorizontalBox {
                                        alignment: start;
                                        Rectangle {
                                            border-radius: 8px;
                                            background: #3b82f6;
                                            padding: 8px;
                                            Text {
                                                text: "Read the full article →";
                                                color: white;
                                                font-size: 14px;
                                                font-family: "Inter";
                                                font-weight: 700;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalBox {
                spacing: 12px;
                LineEdit {
                    placeholder-text: "Type your question here...";
                    text <=> user_input;
                    height: 48px;
                }
                TooltipElement {
                    tooltip_id: "ai_chat_send";
                    Button {
                        text: "Send Message";
                        height: 48px;
                        clicked => { send_message(); }
                    }
                }
            }
        }
    }
}
