import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export component AiHelpChat inherits Window {
    width: 600px;
    height: 800px;
    title: "AI Help Assistant";
    background: white;

    in-out property <string> user_input: "";
    in property <[string]> messages;
    callback send_message(string);

    VerticalBox {
        padding: 16px;
        spacing: 16px;

        Rectangle {
            background: #f1f5f9;
            border-radius: 8px;
            VerticalBox {
                padding: 16px;
                Text {
                    text: "Hi! I'm your OHC Help Assistant. I can answer any questions you have about using the app. What do you need help with today?";
                    color: #0f172a;
                    wrap: word-wrap;
                }
            }
        }

        ScrollView {
            VerticalBox {
                spacing: 8px;
                for msg in messages : Rectangle {
                    background: #f8fafc;
                    border-radius: 8px;
                    border-color: #e2e8f0;
                    border-width: 1px;
                    VerticalBox {
                        padding: 12px;
                        Text {
                            text: msg;
                            color: #334155;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            LineEdit {
                placeholder-text: "Type your question here...";
                text <=> user_input;
            }
            Button {
                text: "Send";
                clicked => {
                    if (user_input != "") {
                        send_message(user_input);
                        user_input = "";
                    }
                }
            }
        }
    }
}
