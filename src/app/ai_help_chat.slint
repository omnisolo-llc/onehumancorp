import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";
import { TooltipElement } from "tooltip_element.slint";

export struct ChatMessage {
    sender: string,
    text: string,
    article_link: string,
}

export component AiHelpChat inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "AI Help Assistant";
    out property <string> test_title: root.title;
    background: #0f172a;

    in-out property <string> user_input: "";
    in property <[ChatMessage]> messages: [
        { sender: "AI", text: "Hi! I'm your OHC Help Assistant. I can answer any questions you have about using the app. What do you need help with today?", article_link: "" }
    ];
    callback send_message();
    callback open_article(string);

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            padding: 16px;
            spacing: 16px;

            ScrollView {
                VerticalBox {
                    spacing: 12px;
                    for msg in messages: GlassCard {
                        background: msg.sender == "User" ? #1e293b : #334155;
                        VerticalBox {
                            padding: 16px;
                            spacing: 8px;
                            Text {
                                text: msg.sender == "User" ? "You" : "Helper";
                                font-family: "Outfit";
                                color: #94a3b8;
                                font-size: 12px;
                            }
                            Text {
                                text: msg.text;
                                font-family: "Inter";
                                color: white;
                                wrap: word-wrap;
                            }
                            if msg.article_link != "": TouchArea {
                                height: 44px;
                                clicked => { root.open_article(msg.article_link); }
                                Text {
                                    text: "Read the full article →";
                                    font-family: "Inter";
                                    color: #0ea5e9; // Action color
                                    font-size: 14px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            HorizontalBox {
                spacing: 8px;
                LineEdit {
                    height: 44px;
                    placeholder-text: "Type your question here...";
                    text <=> user_input;
                }
                TooltipElement {
                    tooltip_id: "ai_chat_send";
                    Button {
                        height: 44px;
                        text: "Send";
                        clicked => { send_message(); }
                    }
                }
            }
        }
    }
}
