import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export component AiHelpChat inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "AI Help Assistant";
    background: #0f172a;

    in-out property <string> user_input: "";
    callback send_message();

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            padding: 16px;
            spacing: 16px;

            GlassCard {
                VerticalBox {
                    padding: 16px;
                    Text {
                        text: "Hi! I'm your OHC Help Assistant. I can answer any questions you have about using the app. What do you need help with today?";
                        color: white;
                        wrap: word-wrap;
                    }
                }
            }

            ScrollView {
                VerticalBox {
                    spacing: 16px;

                    // Simulated history
                    HorizontalBox {
                        alignment: end;
                        GlassCard {
                            background: #0ea5e9;
                            VerticalBox {
                                padding: 12px;
                                Text { text: "How do I add a new product?"; color: white; wrap: word-wrap; }
                            }
                        }
                    }

                    HorizontalBox {
                        alignment: start;
                        GlassCard {
                            VerticalBox {
                                padding: 12px;
                                spacing: 8px;
                                Text { text: "To add a new product, go to the 'My Store' section from the main dashboard and click 'Add Product'. You can upload photos, set a price, and write a description."; color: white; wrap: word-wrap; }
                                HorizontalBox {
                                    alignment: start;
                                    Button {
                                        text: "Read the full article ->";
                                        clicked => { /* open article */ }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalBox {
                spacing: 8px;
                LineEdit {
                    placeholder-text: "Type your question here...";
                    text <=> user_input;
                }
                Button {
                    text: "Send";
                    clicked => { send_message(); }
                }
                Button {
                    text: "Clear";
                    clicked => { /* clear chat history */ }
                }
            }
        }
    }
}
