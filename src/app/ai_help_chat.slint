import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct ChatMessage {
    sender: string,
    text: string,
    article_link: string,
}

export component AiHelpChat inherits Window {
    min-width: 375px; max-width: 1440px; preferred-width: 600px;
    height: 800px;
    title: "AI Help Assistant";
    background: white;

    in-out property <string> user_input: "";
    in property <[ChatMessage]> messages: [];
    callback send_message();
    callback open_article(string);

    VerticalBox {
        padding: 16px;
        spacing: 16px;

        Rectangle {
            background: #f1f5f9;
            border-radius: 8px;
            VerticalBox {
                padding: 16px;
                Text {
                    text: "Hi! I'm your OHC Help Assistant. I can answer any questions you have about using the app. What do you need help with today?";
                    color: #0f172a;
                    wrap: word-wrap;
                }
            }
        }

        ScrollView {
            VerticalBox {
                spacing: 12px;
                for msg in messages : VerticalBox {
                    spacing: 4px;
                    Rectangle {
                        background: msg.sender == "user" ? #0ea5e9 : #e2e8f0;
                        border-radius: 8px;
                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;
                            Text {
                                text: msg.text;
                                color: msg.sender == "user" ? white : #0f172a;
                                wrap: word-wrap;
                            }
                            if (msg.article_link != "") : TouchArea {
                                width: 100%; height: 20px;
                                clicked => { open_article(msg.article_link); }
                                Text {
                                    text: "Read the full article →";
                                    color: #2563eb;
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            LineEdit {
                placeholder-text: "Type your question here...";
                text <=> user_input;
            }
            Button {
                text: "Send";
                clicked => { send_message(); }
            }
        }
    }
}
