import { GlassCard } from "glass_card.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

import { UiChatMessage } from "chat.slint";

export component AiHelpChat inherits Window {
    preferred-width: 600px;
    preferred-height: 800px;
    min-width: 375px;
    title: "AI Help Assistant";
    background: #0f172a;

    in-out property <string> user_input: "";
    in property <[UiChatMessage]> messages;
    callback send_message();

    HorizontalBox {
        alignment: center;
        VerticalBox {
            max-width: 600px;
            width: 100%;
            padding: 16px;
            spacing: 16px;

            GlassCard {
                VerticalBox {
                    padding: 16px;
                    Text {
                        text: "Hi! I'm your OHC Help Assistant. I can answer any questions you have about using the app. What do you need help with today?";
                        color: white;
                        wrap: word-wrap;
                    }
                }
            }

            ScrollView {
                VerticalBox {
                    spacing: 12px;
                    alignment: start;

                    for msg in messages : HorizontalBox {
                        alignment: msg.is_me ? end : start;
                        if (msg.is_me) : Rectangle {} // Spacer
                        GlassCard {
                            width: 300px;
                            VerticalBox {
                                padding: 10px;
                                spacing: 4px;
                                Text {
                                    text: msg.author_name;
                                    font-weight: 700;
                                    color: msg.is_me ? #38bdf8 : #a855f7;
                                    horizontal-alignment: msg.is_me ? right : left;
                                }
                                Text { text: msg.body; color: white; wrap: word-wrap; }
                            }
                        }
                        if (!msg.is_me) : Rectangle {} // Spacer
                    }
                }
            }

            HorizontalBox {
                spacing: 8px;
                LineEdit {
                    placeholder-text: "Type your question here...";
                    text <=> user_input;
                }
                Button {
                    text: "Send";
                    clicked => { send_message(); }
                }
            }
        }
    }
}
