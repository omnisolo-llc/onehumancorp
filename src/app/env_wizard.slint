import { Button, VerticalBox, HorizontalBox, ScrollView, LineEdit } from "std-widgets.slint";
import { GlassCard } from "glass_card.slint";
import { AdvancedToggle } from "advanced_toggle.slint";
import { PasswordInput } from "password_input.slint";

export component EnvWizard inherits Window {
    min-width: 375px;
    preferred-width: 500px;
    height: 600px;
    title: "Environment Wizard";

    in-out property <int> step: 0;

    in-out property <bool> is_advanced: false;

    // Day One Properties
    in-out property <string> log_level: "info";
    in-out property <string> port: "8080";
    in-out property <bool> multitenant: false;
    in-out property <string> openai_key: "";
    in-out property <string> anthropic_key: "";
    in-out property <string> db_url: "";
    in-out property <string> redis_url: "";
    in-out property <bool> mcp_enabled: false;

    callback next_step();
    callback prev_step();
    callback finish_setup();

    next_step => { step = step + 1; }
    prev_step => { step = step - 1; }

    background: @linear-gradient(135deg, #0D0D1A 0%, #1A1A33 100%);

    VerticalBox {
        spacing: 20px;
        padding: 24px;

        GlassCard {
            VerticalBox {
                spacing: 16px;
                padding: 24px;

                HorizontalBox {
                    alignment: space-between;
                    Text {
                        text: "Day One Environment Setup";
                        font-family: "Outfit";
                        font-size: 24px;
                        font-weight: 600;
                        color: white;
                    }
                    AdvancedToggle {
                        is_advanced <=> root.is_advanced;
                    }
                }

                if (step == 0) : VerticalBox {
                    spacing: 16px;
                    Text {
                        text: "Welcome! Let's get your OHC environment configured.";
                        font-family: "Inter";
                        font-size: 16px;
                        color: #94A3B8;
                        wrap: word-wrap;
                    }

                    if (is_advanced) : VerticalBox {
                        spacing: 12px;
                        Text { text: "Logging Level"; color: white; font-family: "Inter"; }
                        HorizontalBox {
                            spacing: 8px;
                            Button { text: "Info"; clicked => { log_level = "info"; } primary: log_level == "info"; }
                            Button { text: "Debug"; clicked => { log_level = "debug"; } primary: log_level == "debug"; }
                            Button { text: "Warn"; clicked => { log_level = "warn"; } primary: log_level == "warn"; }
                            Button { text: "Error"; clicked => { log_level = "error"; } primary: log_level == "error"; }
                        }

                        Text { text: "HTTP Server Port"; color: white; font-family: "Inter"; }
                        LineEdit {
                            text <=> port;
                            placeholder-text: "8080";
                        }
                    }
                }

                if (step == 1) : VerticalBox {
                    spacing: 16px;
                    Text {
                        text: "Environment Mode";
                        font-family: "Outfit";
                        font-size: 20px;
                        color: white;
                    }
                    Text {
                        text: "Do you want to run in Multi-tenant Cloud mode or Standalone mode?";
                        font-family: "Inter";
                        font-size: 16px;
                        color: #94A3B8;
                        wrap: word-wrap;
                    }

                    HorizontalBox {
                        spacing: 16px;
                        Button {
                            text: "Standalone Mode";
                            clicked => { multitenant = false; }
                            primary: !multitenant;
                        }
                        Button {
                            text: "Cloud Mode (Multi-tenant)";
                            clicked => { multitenant = true; }
                            primary: multitenant;
                        }
                    }
                }

                if (step == 2) : VerticalBox {
                    spacing: 16px;
                    Text {
                        text: "AI Provider Configuration";
                        font-family: "Outfit";
                        font-size: 20px;
                        color: white;
                    }
                    Text {
                        text: "Provide your API keys to enable AI agent features.";
                        font-family: "Inter";
                        font-size: 16px;
                        color: #94A3B8;
                        wrap: word-wrap;
                    }

                    Text { text: "OpenAI API Key (Optional)"; color: white; font-family: "Inter"; }
                    PasswordInput {
                        text <=> openai_key;
                        placeholder-text: "sk-...";
                    }

                    Text { text: "Anthropic API Key (Optional)"; color: white; font-family: "Inter"; }
                    PasswordInput {
                        text <=> anthropic_key;
                        placeholder-text: "sk-ant-...";
                    }
                }

                if (step == 3 && multitenant) : VerticalBox {
                    spacing: 16px;
                    Text {
                        text: "Database Configuration";
                        font-family: "Outfit";
                        font-size: 20px;
                        color: white;
                    }
                    Text {
                        text: "Configure external databases for Cloud Mode.";
                        font-family: "Inter";
                        font-size: 16px;
                        color: #94A3B8;
                        wrap: word-wrap;
                    }

                    Text { text: "PostgreSQL Database URL (Optional)"; color: white; font-family: "Inter"; }
                    LineEdit {
                        text <=> db_url;
                        placeholder-text: "postgres://user:pass@host/db";
                    }

                    Text { text: "Redis URL (Optional)"; color: white; font-family: "Inter"; }
                    LineEdit {
                        text <=> redis_url;
                        placeholder-text: "redis://host:port";
                    }
                }

                if (step == 3 && !multitenant) : VerticalBox {
                    spacing: 16px;
                    Text {
                        text: "Advanced Features";
                        font-family: "Outfit";
                        font-size: 20px;
                        color: white;
                    }

                    Text { text: "Enable Model Context Protocol (MCP)"; color: white; font-family: "Inter"; }
                    HorizontalBox {
                        spacing: 16px;
                        Button {
                            text: "Off";
                            clicked => { mcp_enabled = false; }
                            primary: !mcp_enabled;
                        }
                        Button {
                            text: "On";
                            clicked => { mcp_enabled = true; }
                            primary: mcp_enabled;
                        }
                    }
                }

                if (step == 4 && multitenant) : VerticalBox {
                    spacing: 16px;
                    Text {
                        text: "Advanced Features";
                        font-family: "Outfit";
                        font-size: 20px;
                        color: white;
                    }

                    Text { text: "Enable Model Context Protocol (MCP)"; color: white; font-family: "Inter"; }
                    HorizontalBox {
                        spacing: 16px;
                        Button {
                            text: "Off";
                            clicked => { mcp_enabled = false; }
                            primary: !mcp_enabled;
                        }
                        Button {
                            text: "On";
                            clicked => { mcp_enabled = true; }
                            primary: mcp_enabled;
                        }
                    }
                }

                if ((step == 4 && !multitenant) || (step == 5 && multitenant)) : VerticalBox {
                    spacing: 16px;
                    Text {
                        text: "Setup Complete!";
                        font-family: "Outfit";
                        font-size: 20px;
                        color: white;
                    }
                    Text {
                        text: "Your environment is fully configured and ready to go.";
                        font-family: "Inter";
                        font-size: 16px;
                        color: #10B981;
                        wrap: word-wrap;
                    }
                }

                HorizontalBox {
                    alignment: space-between;
                    padding-top: 24px;
                    Button {
                        text: "Back";
                        clicked => { prev_step(); }
                        enabled: step > 0;
                    }
                    Button {
                        text: ((step == 4 && !multitenant) || (step == 5 && multitenant)) ? "Finish" : "Next";
                        primary: true;
                        clicked => {
                            if ((step == 4 && !multitenant) || (step == 5 && multitenant)) {
                                finish_setup();
                            } else {
                                next_step();
                            }
                        }
                    }
                }
            }
        }
    }
}
