"""E2E tests for the OHC platform using Vitest and Playwright."""

# Test source files
_TEST_SRCS = glob([
    "*.test.ts",
    "test-utils.ts",
], exclude = ["e2e.slint.web.test.ts"])

# All TypeScript test files
filegroup(
    name = "test_sources",
    srcs = _TEST_SRCS + [
        "vitest.config.ts",
    ],
)

# Export node_modules for running tests locally
exports_files(
    [
        "vitest.config.ts",
        "package.json",
    ],
    visibility = ["//visibility:public"],
)

# Wrapper script for running E2E tests
filegroup(
    name = "runner",
    srcs = ["run_e2e.sh"],
)

# Individual E2E tests using Vitest
[
    sh_test(
        name = src.replace(".test.ts", "_test"),
        srcs = ["run_e2e.sh"],
        args = [src],
        data = [
            src,
            "test-utils.ts",
            "vitest.config.ts",
            "//src/server:server-rust",
            "//src/server:server_test", # Includes migrations
            "//:node_modules",
        ],
        tags = ["e2e", "exclusive"], # exclusive because they all bind to port 18080
    )
    for src in _TEST_SRCS if src.startswith("e2e.")
]

# Playwright Slint Web Test
sh_test(
    name = "e2e_slint_web_test",
    srcs = ["run_playwright.sh"],
    args = ["deploy/tests/e2e.slint.web.test.ts"],
    data = [
        "e2e.slint.web.test.ts",
        "playwright.config.ts",
        "run_playwright.sh",
        "//src/app:app-wasm",  # This ensures WASM is built before test runs
        "//:node_modules",
    ],
    tags = ["e2e", "exclusive"],
)

# Test suite for all e2e tests
test_suite(
    name = "e2e_tests",
    tests = [src.replace(".test.ts", "_test") for src in _TEST_SRCS if src.startswith("e2e.")] + [":e2e_slint_web_test"],
    tags = ["e2e"],
    visibility = ["//visibility:public"],
)
