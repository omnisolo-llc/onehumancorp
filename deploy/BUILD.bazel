# End-to-end smoke test against the Docker Compose container stack.
# Requires docker and curl on PATH.
# Run with: bazel test //deploy:docker_compose_e2e_test
sh_test(
    name = "docker_compose_e2e_test",
    size = "large",
    timeout = "long",
    srcs = ["tests/docker_compose_e2e_test.sh"],
    data = [
        "docker-compose.yml",
        "docker-compose.override.yml",
        "docker/postgres/init-multiple-databases.sh",
    ] + [
        ":load_all_images",
        "//src/server",
    ],
    tags = [
        "e2e",
        "large",
        "local",
        "manual",
        "no-remote-exec",
        "no-sandbox",
        "requires-docker",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

