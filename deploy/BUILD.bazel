# End-to-end smoke test against the Docker Compose container stack.
# Requires docker and curl on PATH.
# Run with: bazel test //deploy:docker_compose_e2e_test
sh_test(
    name = "e2e_ci_execution_contract_test",
    srcs = ["tests/e2e_ci_execution_contract_test.sh"],
    args = [
        "$(rootpath :tests/kind_e2e_test.sh)",
        "$(rootpath :tests/docker_compose_e2e_test.sh)",
        "$(rootpath :helm/omnisolo/templates/backend-deployment.yaml)",
        "$(rootpath :helm/omnisolo/values.yaml)",
        "$(rootpath :docker/server-init/bootstrap-admin.sh)",
        "$(rootpath :docker-compose.yml)",
    ],
    data = [
        "helm/omnisolo/templates/backend-deployment.yaml",
        "helm/omnisolo/templates/default-deny-network-policy.yaml",
        "helm/omnisolo/templates/prometheusrule.yaml",
        "helm/omnisolo/values.yaml",
        "docker/server-init/bootstrap-admin.sh",
        "docker-compose.yml",
        "tests/kind_e2e_test.sh",
        "tests/docker_compose_e2e_test.sh",
    ],
    tags = ["lint"],
)

sh_test(
    name = "operational_api_contract_test",
    srcs = ["tests/operational_api_contract_test.sh"],
    args = [
        "$(rootpath //deploy/scripts:omnisolo-agent-wizard.sh)",
        "$(rootpath //deploy/scripts:omnisolo-seed-data.sh)",
    ],
    data = [
        "//deploy/scripts:omnisolo-agent-wizard.sh",
        "//deploy/scripts:omnisolo-seed-data.sh",
    ],
    tags = ["lint"],
)

