load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:pkg.bzl", "pkg_tar")

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files([
    "deploy_dev.sh",
    "docker-compose.yml",
    "docker-compose.e2e.yml",
    "setup_k8s.sh",
])


# ── server image (onehumancorp/server) ────────────────────────────────────────
filegroup(
    name = "hybrid_telemetry_dashboard_mirrors",
    srcs = glob([
        "grafana/dashboards/*.json",
        "docker/grafana/provisioning/dashboards/*.json",
        "helm/ohc/dashboards/*.json",
    ]),
    visibility = ["//visibility:public"],
)


# Package backend binary
pkg_tar(
    name = "backend_pkg",
    srcs = [
        "//src/agents/builtin:ohc-builtin-agent",
        "//src/server",
    ],
    package_dir = "/usr/local/bin",
)

pkg_tar(
    name = "server_migrations_pkg",
    srcs = ["//src/server/migrations"],
    package_dir = "/src/server/migrations",
    strip_prefix = "src/server/migrations",
)

# Published as onehumancorp/server – the single canonical image.
# Serves both the API and the Flutter web UI (static assets).
oci_image(
    name = "server_image",
    base = "@distroless_cc",
    entrypoint = ["/usr/local/bin/server"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    tars = [
        ":backend_pkg",
        ":server_migrations_pkg",
    ],
)

oci_load(
    name = "server_load",
    image = ":server_image",
    repo_tags = ["onehumancorp/server:latest"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)
oci_load(
    name = "mono_core_load",
    image = ":server_image",
    repo_tags = ["onehumancorp/mono-core:latest"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)


oci_load(
    name = "server_web_image_tarball",
    image = ":server_image",
    repo_tags = [
        "onehumancorp/server:latest",
        "onehumancorp/server-web:latest",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

filegroup(
    name = "server_web_image_tar",
    srcs = [":server_web_image_tarball"],
    output_group = "tarball",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

oci_push(
    name = "server_push_ghcr",
    image = ":server_image",
    repository = "ghcr.io/onehumancorp/server",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

oci_push(
    name = "server_push_dockerhub",
    image = ":server_image",
    repository = "index.docker.io/onehumancorp/server",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

# ── agent image (onehumancorp/agent) ──────────────────────────────────────────
# Cluster agents run as their own binary. Standalone desktop keeps the agent
# in-process inside //src/server:server instead.

pkg_tar(
    name = "agent_pkg",
    srcs = [
        "//src/agents/builtin:ohc-builtin-agent",
    ],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "agent_image",
    base = "@distroless_cc",
    entrypoint = ["/usr/local/bin/ohc-builtin-agent"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    tars = [
        ":agent_pkg",
    ],
)

oci_load(
    name = "agent_load",
    image = ":agent_image",
    repo_tags = ["onehumancorp/agent:bazel"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

oci_image(
    name = "default_agent_image",
    base = "@distroless_cc",
    entrypoint = ["/usr/local/bin/ohc-builtin-agent"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    tars = [
        ":agent_pkg",
    ],
)

oci_load(
    name = "default_agent_load",
    image = ":default_agent_image",
    repo_tags = ["onehumancorp/internal-default-agent:bazel"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

oci_push(
    name = "agent_push_ghcr",
    image = ":agent_image",
    repository = "ghcr.io/onehumancorp/agent",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

oci_push(
    name = "agent_push_dockerhub",
    image = ":agent_image",
    repository = "index.docker.io/onehumancorp/agent",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

