load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files([
    "deploy_dev.sh",
    "docker-compose.yml",
    "setup_k8s.sh",
])

# ── server image (onehumancorp/server) ────────────────────────────────────────

# Package backend binary
pkg_tar(
    name = "backend_pkg",
    srcs = ["//srcs/server:ohc"],
    package_dir = "/usr/local/bin",
)

# Published as onehumancorp/server – the single canonical image.
# Serves both the API and the Flutter web UI (static assets).
oci_image(
    name = "server_image",
    base = "@distroless_static",
    entrypoint = ["/usr/local/bin/ohc"],
    tars = [":backend_pkg"],
)

oci_load(
    name = "server_load",
    image = ":server_image",
    repo_tags = ["onehumancorp/server:latest"],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "server_push_ghcr",
    image = ":server_image",
    repository = "ghcr.io/onehumancorp/server",
    visibility = ["//visibility:public"],
)

oci_push(
    name = "server_push_dockerhub",
    image = ":server_image",
    repository = "index.docker.io/onehumancorp/server",
    visibility = ["//visibility:public"],
)

# ── agent image (onehumancorp/agent) ──────────────────────────────────────────
# The agent image bundles the ironclaw CLI alongside the ohc server binary so
# that any specialised AI agent container can be started from this base.

pkg_tar(
    name = "agent_pkg",
    srcs = [
        "//srcs/server:ohc",
        "//srcs/server/agents/mcp:github",
        "//srcs/server/ironclaw",
    ],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "agent_image",
    base = "@distroless_static",
    # The agent container runs the ohc server; the ironclaw binary is available
    # as a sidecar tool inside the container.
    entrypoint = ["/usr/local/bin/ohc"],
    tars = [":agent_pkg"],
)

oci_load(
    name = "agent_load",
    image = ":agent_image",
    repo_tags = ["onehumancorp/agent:bazel"],
    visibility = ["//visibility:public"],
)

oci_image(
    name = "default_agent_image",
    base = "@distroless_static",
    # Internal default agent runtime: same Bazel-built server image, configured
    # to bootstrap the builtin provider when no external workforce exists.
    entrypoint = ["/usr/local/bin/ohc"],
    tars = [":agent_pkg"],
)

oci_load(
    name = "default_agent_load",
    image = ":default_agent_image",
    repo_tags = ["onehumancorp/internal-default-agent:bazel"],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "agent_push_ghcr",
    image = ":agent_image",
    repository = "ghcr.io/onehumancorp/agent",
    visibility = ["//visibility:public"],
)

oci_push(
    name = "agent_push_dockerhub",
    image = ":agent_image",
    repository = "index.docker.io/onehumancorp/agent",
    visibility = ["//visibility:public"],
)

sh_test(
    name = "deploy_artifacts_test",
    srcs = ["tests/deploy_artifacts_test.sh"],
    data = glob([
        "docker/**/*",
        "helm/ohc/**",
        "docker-compose.yml",
    ]) + ["BUILD.bazel"],
)

# End-to-end smoke test against a real Kind cluster.
# Requires kind, helm, kubectl, docker, curl on PATH.
# Run with: bazel test //deploy:kind_e2e_test
sh_test(
    name = "kind_e2e_test",
    size = "large",
    srcs = ["tests/kind_e2e_test.sh"],
    data = glob([
        "docker/**/*",
        "helm/ohc/**",
        "docker-compose.yml",
    ]) + [
        ":server_load",
        "//:go.mod",
        "//srcs/server:ohc",
    ],
    tags = [
        "large",
        "manual",
        "no-remote-exec",
        "requires-docker",
    ],
    visibility = ["//visibility:public"],
)
