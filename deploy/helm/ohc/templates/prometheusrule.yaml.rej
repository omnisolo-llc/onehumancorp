--- prometheusrule.yaml
+++ prometheusrule.yaml
@@ -107,7 +107,7 @@
         - alert: PodCrashLooping
           annotations:
             summary: Pod {{ $labels.namespace }}/{{ $labels.pod }} ({{ $labels.container }}) is restarting {{ printf "%.2f" $value }} / second
-          expr: rate(kube_pod_container_status_restarts_total{job="kube-state-metrics", namespace=".*"}[15m]) * 60 > 0
+          expr: rate(kube_pod_container_status_restarts_total{job="kube-state-metrics", namespace=".*"}[5m]) * 60 > 0
           for: 15m
           labels:
             severity: warning
