{
  "title": "Harness Efficiency Dashboard",
  "panels": [
    {
      "type": "text",
      "title": "Premium CSS Override",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "<style>\\n* { font-family: \\'Outfit\\', \\'Inter\\', sans-serif; }\\n.panel-container { backdrop-filter: blur(20px) saturate(200%); background: rgba(255, 255, 255, 0.03) !important; border-radius: 12px !important; border: 1px solid rgba(255, 255, 255, 0.1) !important; }\\n.grafana-app { backdrop-filter: blur(20px) saturate(200%) !important; background: rgba(255, 255, 255, 0.03) !important; background-color: #0b0c10 !important; }\\n</style>"
      }
    },
    {
      "type": "text",
      "title": "OHC Aesthetics",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "options": {
        "mode": "html",
        "content": "<link rel=\"stylesheet\" href=\"/public/css/custom.css\">\n"
      },
      "transparent": true
    },
    {
      "title": "Harness Init Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(harness_init_latency_seconds_bucket[5m])) by (le, deployment_mode))",
          "legendFormat": "{{deployment_mode}} Init Latency (p95)"
        }
      ]
    },
    {
      "title": "Harness DB I/O Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(harness_db_io_latency_seconds_bucket[5m])) by (le, deployment_mode, operation))",
          "legendFormat": "{{deployment_mode}} {{operation}} Latency (p95)"
        }
      ]
    }
  ]
}