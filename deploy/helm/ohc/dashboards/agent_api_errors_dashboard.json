{
  "title": "Agent API Errors",
  "uid": "agent-api-errors",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "OHC",
    "Observability",
    "Agent",
    "Errors"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "OHC Aesthetic Injector",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "<link rel=\"stylesheet\" href=\"/public/css/custom.css\">"
      },
      "transparent": true
    },
    {
      "type": "timeseries",
      "title": "Total Errors by API and Role",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(ohc_agent_api_errors_total[1m])) by (api, role)",
          "legendFormat": "{{role}} - {{api}}",
          "refId": "A"
        }
      ],
      "transparent": true
    },
    {
      "type": "barchart",
      "title": "Errors by Agent ID",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(ohc_agent_api_errors_total) by (agent_id)",
          "legendFormat": "{{agent_id}}",
          "refId": "A"
        }
      ],
      "transparent": true
    }
  ]
}
