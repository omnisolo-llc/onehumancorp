    {
      "title": "Total Requests by Provider",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (provider) (rate(ohc_llm_requests_total[1m]))",
