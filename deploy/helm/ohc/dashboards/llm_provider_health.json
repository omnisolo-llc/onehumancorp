      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 11 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(ohc_llm_latency_seconds_bucket[5m])) by (le, provider))",
