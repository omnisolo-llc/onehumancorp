{
  "title": "Hybrid Database Metrics",
  "uid": "database-metrics",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "Database",
    "OHC",
    "Hybrid"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "OHC Aesthetics",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "\n<style>\n  .panel-container {\n    backdrop-filter: blur(20px) saturate(200%);\n    background: rgba(255, 255, 255, 0.03) !important;\n    border-radius: 12px;\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    font-family: 'Outfit', 'Inter', sans-serif !important;\n    animation: ohc-enter 300ms cubic-bezier(0.4, 0, 0.2, 1);\n  }\n  .grafana-app {\n      backdrop-filter: blur(20px) saturate(200%) !important;\n      background: rgba(255, 255, 255, 0.03) !important;\n      font-family: 'Outfit', 'Inter', sans-serif !important;\n  }\n  @keyframes ohc-enter {\n    from { opacity: 0; transform: translateY(10px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n  .panel-container.exiting {\n    animation: ohc-exit 200ms cubic-bezier(0.4, 0, 0.2, 1) forwards;\n  }\n  @keyframes ohc-exit {\n    from { opacity: 1; transform: translateY(0); }\n    to { opacity: 0; transform: translateY(10px); }\n  }\n</style>"
      },
      "transparent": true
    },
    {
      "type": "text",
      "title": "OHC Aesthetic Injector",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "\n<style>\n  .panel-container {\n    backdrop-filter: blur(20px) saturate(200%);\n    background: rgba(255, 255, 255, 0.03) !important;\n    border-radius: 12px;\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    font-family: 'Outfit', 'Inter', sans-serif !important;\n    animation: ohc-enter 300ms cubic-bezier(0.4, 0, 0.2, 1);\n  }\n  .grafana-app {\n      backdrop-filter: blur(20px) saturate(200%) !important;\n      background: rgba(255, 255, 255, 0.03) !important;\n      font-family: 'Outfit', 'Inter', sans-serif !important;\n  }\n  @keyframes ohc-enter {\n    from { opacity: 0; transform: translateY(10px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n  .panel-container.exiting {\n    animation: ohc-exit 200ms cubic-bezier(0.4, 0, 0.2, 1) forwards;\n  }\n  @keyframes ohc-exit {\n    from { opacity: 1; transform: translateY(0); }\n    to { opacity: 0; transform: translateY(10px); }\n  }\n</style>"
      },
      "transparent": true
    },
    {
      "type": "timeseries",
      "title": "Total QPS",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(db_client_operation_duration_seconds_count[5m])) by (db_type)",
          "legendFormat": "{{db_type}}",
          "refId": "A"
        }
      ],
      "transparent": true,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Global Error Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(db_client_operation_errors_total[5m])) by (db_type)",
          "legendFormat": "{{db_type}}",
          "refId": "A"
        }
      ],
      "transparent": true,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Total Query Latency",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(db_client_operation_duration_seconds_bucket[5m])) by (le, db_type))",
          "legendFormat": "P50 {{db_type}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(db_client_operation_duration_seconds_bucket[5m])) by (le, db_type))",
          "legendFormat": "P90 {{db_type}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(db_client_operation_duration_seconds_bucket[5m])) by (le, db_type))",
          "legendFormat": "P99 {{db_type}}",
          "refId": "C"
        }
      ],
      "transparent": true,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL SKIP LOCKED Rate",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(ohc_postgres_skip_locked_total[5m]))",
          "legendFormat": "Lock Contention",
          "refId": "A"
        }
      ],
      "transparent": true,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    }
  ]
}
