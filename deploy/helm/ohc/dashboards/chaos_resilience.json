{
  "title": "Chaos Resilience Dashboard",
  "panels": [
    {
      "type": "text",
      "options": {
        "content": "<style>\n  .panel-container {\n    backdrop-filter: blur(20px) saturate(200%);\n    background: rgba(255, 255, 255, 0.03) !important;\n    border-radius: 12px;\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    font-family: 'Outfit', 'Inter', sans-serif !important;\n  }\n</style>\n<div class=\"panel-container\" style=\"font-size: 24px; font-weight: bold; text-align: center; color: white; padding: 10px;\">\n  <h1 style=\"margin: 0; color: #fff; font-size: 24px;\">Chaos Resilience Dashboard</h1>\n  <p style=\"margin: 5px 0 0; color: #aaa; font-size: 14px;\">System Resilience & Recovery Metrics</p>\n</div>\n<style>\n  .grafana-app {\n      backdrop-filter: blur(20px) saturate(200%) !important;\n      background: rgba(255, 255, 255, 0.03) !important;\n      font-family: 'Outfit', 'Inter', sans-serif !important;\n  }\n</style>"
      }
    },
    {
      "title": "Chaos Events Injected",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ohc_chaos_injected_total[5m])) by (EnvMode)",
          "legendFormat": "{{EnvMode}} Chaos Events"
        }
      ]
    },
    {
      "title": "Task Recovery Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ohc_task_recovery_time_ms_bucket[5m])) by (le, EnvMode))",
          "legendFormat": "{{EnvMode}} Recovery Time (p95 ms)"
        }
      ]
    },
    {
      "title": "Sandbox Violations",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ohc_sandbox_violation_total[5m])) by (EnvMode)",
          "legendFormat": "{{EnvMode}} Violations"
        }
      ]
    }
  ]
}