  "timepicker": {},
  "timezone": "",
  "title": "Agent API Errors Dashboard",
  "uid": "agent-api-errors-dashboard",
  "version": 1,
  "panels": [
    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "mode": "html",
        "content": "<link rel=\"stylesheet\" href=\"/public/css/custom.css\">\n<style>\n  .grafana-app {\n      backdrop-filter: blur(20px) saturate(200%) !important;\n      background: rgba(255, 255, 255, 0.03) !important;\n      font-family: 'Outfit', 'Inter', sans-serif !important;\n  }\n</style>\n<h1 >Agent API Errors</h1>\n  <p >Full-Spectrum Observability for Agent API Health</p>"
      },
      "title": "Aesthetic Injector",
      "transparent": true,
      "type": "text"
    },
    {
      "type": "timeseries",
      "title": "Total Errors by API and Role",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (api, role) (rate(ohc_agent_api_errors_total[1m]))",
          "legendFormat": "{{api}} - {{role}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Errors by Agent",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (agent_id) (rate(ohc_agent_api_errors_total[1m]))",
          "legendFormat": "{{agent_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
