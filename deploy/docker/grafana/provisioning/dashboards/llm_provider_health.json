{
  "title": "LLM Provider Health",
  "uid": "llm-provider-health",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "Cost",
    "OHC",
    "Observability",
    "Provider"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "OHC Aesthetic Injector",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "<link rel=\"stylesheet\" href=\"/public/css/custom.css\">"
      },
      "transparent": true
    },
    {
      "type": "timeseries",
      "title": "Total Requests by Provider",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 2
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(ohc_llm_network_latency_seconds_count[5m])) by (model)",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "transparent": true
    },
    {
      "type": "timeseries",
      "title": "Global Error Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 2
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(ohc_agent_api_errors_total[5m])) / sum(rate(ohc_llm_network_latency_seconds_count[5m]))",
          "legendFormat": "Global Error Rate",
          "refId": "A"
        }
      ],
      "transparent": true
    },
    {
      "type": "timeseries",
      "title": "API Response Latency (P50, P90, P99)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by(le, model) (rate(ohc_llm_network_latency_seconds_bucket[5m])))",
          "legendFormat": "P50 - {{model}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum by(le, model) (rate(ohc_llm_network_latency_seconds_bucket[5m])))",
          "legendFormat": "P90 - {{model}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by(le, model) (rate(ohc_llm_network_latency_seconds_bucket[5m])))",
          "legendFormat": "P99 - {{model}}",
          "refId": "C"
        }
      ],
      "transparent": true
    },
    {
      "type": "timeseries",
      "title": "HTTP 4xx and 5xx Error Rates by Provider",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(ohc_agent_api_errors_total[5m])) by (api)",
          "legendFormat": "{{api}}",
          "refId": "A"
        }
      ],
      "transparent": true
    }
  ]
}
