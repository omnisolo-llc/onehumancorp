FROM python-worker-base AS goose
ARG TARGETARCH
USER root
RUN set -eux; \
    apt-get update; \
    apt-get install --yes --no-install-recommends libgomp1; \
    rm -rf /var/lib/apt/lists/*; \
    case "$TARGETARCH" in \
      amd64) \
        archive='goose-x86_64-unknown-linux-gnu.tar.gz'; \
        digest='437a32e2bd304e6544036bec117436712f7847f72ddbe46d6c2c4009e0ffcca8'; \
        ;; \
      arm64) \
        archive='goose-aarch64-unknown-linux-gnu.tar.gz'; \
        digest='6d13427f99804b9ad4d9684f9c5e9f4c781e83b1da4872326ea7098d149e9cd2'; \
        ;; \
      *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    url="https://github.com/aaif-goose/goose/releases/download/v1.33.1/$archive"; \
    wget --quiet --output-document=/tmp/goose.tar.gz "$url"; \
    echo "$digest  /tmp/goose.tar.gz" | sha256sum --check --status; \
    tar --extract --gzip --file=/tmp/goose.tar.gz --directory=/usr/local/bin ./goose; \
    chmod 0755 /usr/local/bin/goose; \
    rm /tmp/goose.tar.gz; \
    goose --version
USER 1000:1000

