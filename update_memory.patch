use std::env;

/// Ring-buffer memory store — mirrors Go MemoryStore.
pub struct MemoryStore {
    entries: Mutex<VecDeque<MemoryEntry>>,
    capacity: usize,
    pg_conn_str: Option<String>,
}

impl MemoryStore {
    pub fn new(capacity: usize) -> Self {
        let capacity = if capacity == 0 {
            MEMORY_RING_SIZE
        } else {
            capacity
