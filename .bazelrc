# Bazel configuration for MCP Any

# Keep this checkout's output base away from stale root-owned runfiles that can
# be left behind by Docker-backed Playwright tests in Bazel's default cache.
startup --output_user_root=~/.cache/bazel/bazel-output-ohc

build --color=yes
build --config=remote
build --config=nativelink

# ── Default: local builds/tests ───────────────────────────────────────────────
build --jobs=8

# ── Download strategy ─────────────────────────────────────────────────────────
# Download all outputs so that local test wrappers and generated scripts are
# available.  Flutter test runners require the pub-cache and workspace trees
# to be materialised on the local host since test execution uses processwrapper-sandbox.
build --remote_download_toplevel

# ── CGO / SQLite ──────────────────────────────────────────────────────────────
build --action_env=CGO_ENABLED=1

# ── Sandboxing ────────────────────────────────────────────────────────────────
build --spawn_strategy=sandboxed,local
build --sandbox_add_mount_pair=/var/run/docker.sock
build --incompatible_strict_action_env
build --announce_rc
build --linkopt=-fuse-ld=bfd
build --host_linkopt=-fuse-ld=bfd
build --features=-supports_start_end_lib
build --host_features=-supports_start_end_lib
# ── Rust toolchains ─────────────────────────────────────────────────────────────
# Default Rust toolchain (stable channel)
build --@rules_rust//rust/toolchain/channel=stable

# Use rust_toolchains for asan and windows builds (like nativelink)
# because asan explicitly needs to _not_ use the Nix toolchains
# and Windows doesn't support LRE.
build:asan --extra_toolchains=@rust_toolchains//:all
build:windows --extra_toolchains=@rust_toolchains//:all
build:windows --keep_going

# Nightly toolchain
build:nightly --@rules_rust//rust/toolchain/channel=nightly

# ── Remote execution resilience ───────────────────────────────────────────────
# Automatically rewind and retry actions when their remote inputs are lost
# (e.g. due to remote-cache eviction). Stabilised in Bazel 9.1.0.
build --rewind_lost_inputs

# ── Test defaults ─────────────────────────────────────────────────────────────
# Show test output only on failure
test --test_output=errors
test --build_tests_only
# Keep the default wildcard suite complete: `bazel test //...` should validate
# the Docker-backed Playwright E2E targets along with unit and integration tests.
test --test_timeout=60,120,300,600
# Limit concurrent local test jobs to prevent disk exhaustion on CI runners.
# Flutter tests in particular copy large pub_cache trees into TEST_TMPDIR.
test --local_test_jobs=1

# ── Stream test output for debugging (use --config=verbose) ───────────────────
test:verbose --test_output=streamed

# ── Fast test loop (use --config=no-e2e) ─────────────────────────────────────
# Optional local shortcut for skipping Docker-backed browser tests. The default
# `bazel test //...` intentionally includes them.
test:no-e2e --test_tag_filters=-e2e,-requires-docker

# ── High parallelism (use --config=remote-jobs) ──────────────────────────────
# Useful with a remote executor/cache setup. Keep the default local test path
# conservative so `bazel test //...` can include Docker-backed Playwright tests
# without overwhelming the Bazel server or host.
test:remote-jobs --jobs=200

# ── Test environment pass-through ─────────────────────────────────────────────
test --test_env=GEMINI_API_KEY
test --test_env=MINIMAX_API_KEY
test --test_env=MCP_BUNDLE_DIR
test --test_env=CI
test --test_env=HOME
test --test_env=MCPANY_DEBUG
test --test_env=MCPANY_DANGEROUS_ALLOW_LOCAL_IPS
test --test_env=PATH

# ── Action environment ────────────────────────────────────────────────────────
build --action_env=GEMINI_API_KEY
build --action_env=MINIMAX_API_KEY
build --action_env=MCP_BUNDLE_DIR
build --action_env=CI

# ── nativelink official (default) ─────────────────────────────────────────────
# Remote cache + executor at nativelink.phslc.com with BES streaming.
# common:nativelink --bes_timeout=600s
# build:nativelink --bes_results_url=https://nativelink.phslc.com/invocation/
# build:nativelink --bes_backend=grpcs://nativelink-grpc.phslc.com
# Upload BES data asynchronously so the build/test result is available sooner.
# build:nativelink --bes_upload_mode=fully_async
build:nativelink --verbose_failures
common:nativelink --remote_cache=grpcs://nativelink-grpc.phslc.com
# common:nativelink --remote_executor=grpcs://nativelink-grpc.phslc.com
# Proxy artifact downloads through nativelink's CAS for faster blob fetches.
common:nativelink --experimental_remote_downloader=grpcs://nativelink-grpc.phslc.com
common:nativelink --remote_upload_local_results
common:nativelink --remote_timeout=10m
# common:nativelink --remote_cache_compression
common:nativelink --remote_local_fallback
# Fall back to direct download when CAS doesn't have the blob.
# Prevents CacheNotFoundException from failing repository rule fetches.
common:nativelink --experimental_remote_downloader_local_fallback
common:nativelink --jobs=8

# ── BuildBuddy self-hosted ──────────────────────────────────────
# # Alternative self-hosted BuildBuddy cluster; use with --config=buildbuddy.
# Note: uses --spawn_strategy=remote (all eligible actions remote-first) unlike
# # buildbuddy-official which relies on the global sandboxed,local fallback chain.
# common:buildbuddy --bes_timeout=600s
# common:buildbuddy --bes_results_url=https://buildbuddy.phslc.com/invocation/
# common:buildbuddy --bes_backend=grpcs://buildbuddy-grpc.phslc.com
# common:buildbuddy --remote_cache=grpcs://buildbuddy-grpc.phslc.com
# common:buildbuddy --experimental_remote_downloader=grpcs://buildbuddy-grpc.phslc.com
# # common:buildbuddy --remote_executor=grpcs://buildbuddy-grpc.phslc.com
# common:buildbuddy --remote_local_fallback
# common:buildbuddy --remote_upload_local_results
# # common:buildbuddy --remote_cache_compression
# Fall back to direct download when BuildBuddy CAS doesn't have the blob.
# common:buildbuddy --experimental_remote_downloader_local_fallback
# common:buildbuddy --jobs=200
# Read only Bazel cache
# common:buildbuddy --remote_header=x-buildbuddy-api-key=GZRlHAyqIIcVJw9dJ9n9
# common:buildbuddy --remote_timeout=10m
# build:buildbuddy --verbose_failures
# build:buildbuddy --bes_upload_mode=fully_async

# ── Local: disable remote cache/execution ─────────────────────────────────────
build:local --remote_cache=
build:local --remote_executor=
build:local --experimental_remote_downloader=
build:local --spawn_strategy=sandboxed,local

# ── Local test: run tests locally and load .env ───────────────────────────────
# For local development/testing: loads .env and runs tests without remote execution.
# Usage: bazel test --config=local //path/to:target
# Or use the wrapper: ./scripts/bazel-test-local.sh //path/to:target
test:local --test_output=streamed

# ── Platform configs ───────────────────────────────────────────────────────────
build:linux_x86_64 --platforms=//bazel/platforms:linux_x86_64
build:linux_arm64 --platforms=//bazel/platforms:linux_arm64
build:linux_arm64 --extra_execution_platforms=//bazel/platforms:linux_arm64
build:linux_aarch64 --platforms=//bazel/platforms:linux_aarch64
build:linux_aarch64 --extra_execution_platforms=//bazel/platforms:linux_aarch64
build:android --platforms=//bazel/platforms:android_aarch64
build:ios --platforms=//bazel/platforms:ios_aarch64
build:macos --platforms=//bazel/platforms:macos_aarch64
build:windows_x86_64 --platforms=//bazel/platforms:windows_x86_64
build:windows_i686 --platforms=//bazel/platforms:windows_i686
build:wasm32 --platforms=//bazel/platforms:wasm32
build:windows --config=windows_x86_64
build:linux --config=linux_x86_64
