# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.pyc
*.pyo
*.pyd

# AI likes to create temporary files, which we don't want to commit
/*.py
/*.txt
/*.sh
/bazelisk
/CLAUDE_OHC.md
/test-results
/code_review_response.md
/code_review_reply.json
/mcp_code_review_response.md
/.[jJ]ules

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.ohc/

.claude-code/
.kilo/

# Editor/IDE
# .idea/
# .vscode/

# Bazel outputs
/bazel-*

coverage_html/
/artifacts/

# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

node_modules/
*.log
.vscode/
*.tgz
*.tar.gz
Chart.lock
/.claude-code
/.claude
/.agent-task
/*.md
!/README.md
!/CHANGELOG.md
!/RELEASE_NOTES.md

# Golang is not allowed in this project



# Rust build artifacts
/target/
site/

# Android/Flutter local properties (auto-generated, machine-specific)
/src/app/android/local.properties
/src/app/android/.gradle/
/src/app/ios/Flutter/Flutter.podspec
/src/app/ios/Flutter/Generated.xcconfig
/src/app/macos/Flutter/Flutter.podspec
/src/app/macos/Flutter/GeneratedPluginRegistrant.swift
/src/app/**/ephemeral/
playwright-report/
debian-binary
/*.diff
/srcs/
/scratch/
*.db

dummy.*
dummy_*
.next/
/*.patch

