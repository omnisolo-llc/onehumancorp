load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "mesh_proto",
    srcs = ["teammate_mesh.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "mesh_go_proto",
    compilers = ["@rules_go//proto:go_grpc"],
    importpath = "github.com/onehumancorp/mono/api/proto",
    proto = ":mesh_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "proto",
    embed = [":mesh_go_proto"],
    importpath = "github.com/onehumancorp/mono/api/proto",
    visibility = ["//visibility:public"],
)
