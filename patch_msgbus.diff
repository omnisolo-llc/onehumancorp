pub struct RedisBus {
    client: redis::Client,
}

impl RedisBus {
    pub fn new(redis_url: &str) -> Result<Self, String> {
        let client = redis::Client::open(redis_url).map_err(|e| e.to_string())?;
        Ok(Self {
            client,
        })
    }
}

#[async_trait]
impl Bus for RedisBus {
    async fn publish(&self, msg: Message) -> Result<(), String> {
        let mut con = self.client.get_multiplexed_async_connection().await.map_err(|e| e.to_string())?;
        let _: () = redis::cmd("PUBLISH")
            .arg(&msg.topic)
            .arg(&msg.payload)
            .query_async(&mut con)
            .await
            .map_err(|e| e.to_string())?;
        Ok(())
    }

    async fn subscribe(&self, topic: String, handler: Box<dyn Fn(Message) + Send + Sync>) -> Result<Box<dyn Fn() + Send + Sync>, String> {
        let client = self.client.clone();
        let topic_clone = topic.clone();
        let handler = Arc::new(handler);

        let worker = tokio::spawn(async move {
            let mut pubsub = match client.get_async_pubsub().await {
                Ok(p) => p,
                Err(e) => {
                    eprintln!("Failed to get pubsub connection: {}", e);
                    return;
                }
            };

            if let Err(e) = pubsub.subscribe(&topic_clone).await {
                eprintln!("Failed to subscribe to topic {}: {}", topic_clone, e);
                return;
            }

            let mut stream = pubsub.into_on_message();
            while let Some(msg) = stream.next().await {
                let payload: Vec<u8> = msg.get_payload().unwrap_or_default();
                handler(Message {
                    topic: topic_clone.clone(),
                    payload,
                });
            }
        });

        let cancel = Box::new(move || {
            worker.abort();
        });

        Ok(cancel)
    }

    async fn close(&self) -> Result<(), String> {
        Ok(())
    }
}

pub struct MeshTransport {
    bus: Box<dyn Bus>,
}

impl MeshTransport {
    pub fn new(bus: Box<dyn Bus>) -> Self {
        Self { bus }
    }

    pub async fn publish(&self, msg: Message) -> Result<(), String> {
        self.bus.publish(msg).await
    }

    pub async fn subscribe(&self, topic: String, handler: Box<dyn Fn(Message) + Send + Sync>) -> Result<Box<dyn Fn() + Send + Sync>, String> {
        self.bus.subscribe(topic, handler).await
    }
}
