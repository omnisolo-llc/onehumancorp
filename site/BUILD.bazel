load("@rules_python//python:defs.bzl", "py_binary")
load("@docs_pip//:requirements.bzl", "requirement")

exports_files([
    "requirements.txt",
    "requirements.lock",
])

# Hermetic mkdocs binary backed by pip-locked dependencies.
py_binary(
    name = "mkdocs_bin",
    srcs = ["mkdocs_main.py"],
    main = "mkdocs_main.py",
    deps = [
        requirement("mkdocs"),
        requirement("mkdocs-material"),
        requirement("pymdown-extensions"),
    ],
    visibility = ["//visibility:public"],
)
