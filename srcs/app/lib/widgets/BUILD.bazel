load("@rules_flutter//flutter:defs.bzl", "flutter_library", "flutter_test")

package(default_visibility = ["//srcs/app:__subpackages__"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["*.dart"],
        allow_empty = True,
    ) + ["BUILD.bazel"],
    visibility = ["//srcs/app:__pkg__"],
)

filegroup(
    name = "dart_srcs",
    srcs = glob(
        ["*.dart"],
        allow_empty = True,
        exclude = ["*_test.dart"],
    ),
    visibility = ["//srcs/app:__pkg__"],
)

# All widget sources in ONE library → single pub-prepare action.
flutter_library(
    name = "widgets_lib",
    srcs = glob(
        ["*.dart"],
        exclude = ["*_test.dart"],
    ),
    pubspec = "//srcs/app:pubspec.yaml",
    workspace_pubspec = "//:pubspec.yaml",
    deps = [
        "//srcs/app/lib/models:models_lib",
        "//srcs/app/lib/services:services_lib",
        "@flutter_sdk//flutter/packages/flutter",
        "@pub_web_socket_channel//:web_socket_channel",
    ],
)

alias(
    name = "org_tree_widget",
    actual = ":widgets_lib",
)

alias(
    name = "slide_to_approve",
    actual = ":widgets_lib",
)

alias(
    name = "sub_agent_queue_widget",
    actual = ":widgets_lib",
)

flutter_library(
    name = "widgets_for_tests",
    srcs = [],
    pubspec = "//srcs/app:pubspec.yaml",
    workspace_pubspec = "//:pubspec.yaml",
    deps = [
        ":widgets_lib",
        "@pub_mocktail//:mocktail",
    ],
)

WIDGET_TESTS = glob(["*_test.dart"])

flutter_test(
    name = "widgets_test",
    srcs = WIDGET_TESTS,
    embed = [":widgets_for_tests"],
    test_files = ["."],
    workspace_pubspec = "//:pubspec.yaml",
    data = ["//srcs/app/test:testdata/quota.json"],
)

test_suite(
    name = "all_tests",
    tags = ["manual"],
    tests = [":widgets_test"],
)
