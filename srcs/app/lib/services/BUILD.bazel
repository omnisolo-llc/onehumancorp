load("@rules_flutter//flutter:defs.bzl", "flutter_library", "flutter_test")

package(default_visibility = ["//srcs/app:__subpackages__"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["*.dart"],
        allow_empty = True,
    ) + ["BUILD.bazel"],
    visibility = ["//srcs/app:__pkg__"],
)

filegroup(
    name = "dart_srcs",
    srcs = glob(
        ["*.dart"],
        allow_empty = True,
        exclude = ["*_test.dart"],
    ),
    visibility = ["//srcs/app:__pkg__"],
)

# All service sources in ONE library → single pub-prepare action instead of
# one per service file.  This eliminates the 5-step dependency chain.
flutter_library(
    name = "services_lib",
    srcs = glob(
        ["*.dart"],
        exclude = ["*_test.dart"],
    ),
    pubspec = "//srcs/app:pubspec.yaml",
    workspace_pubspec = "//:pubspec.yaml",
    deps = [
        "//srcs/app/lib/models:models_lib",
        "@flutter_sdk//flutter/packages/flutter",
        "@pub_centrifuge//:centrifuge",
        "@pub_flutter_riverpod//:flutter_riverpod",
        "@pub_http//:http",
        "@pub_path//:path",
        "@pub_shared_preferences//:shared_preferences",
    ],
)

# Keep individual service libraries as aliases for backward compatibility
# (they're needed in tests that want minimal embeds, but since services are
# small, keeping them pointing to services_lib is fine).
alias(
    name = "api_service",
    actual = ":services_lib",
)

alias(
    name = "auth_service",
    actual = ":services_lib",
)

alias(
    name = "centrifuge_service",
    actual = ":services_lib",
)

alias(
    name = "local_manager_service",
    actual = ":services_lib",
)

alias(
    name = "settings_service",
    actual = ":services_lib",
)

# ── Test-only aggregate library ───────────────────────────────────────────────
# services_lib + mocktail for tests that need mock support.

flutter_library(
    name = "services_for_tests",
    srcs = [],
    pubspec = "//srcs/app:pubspec.yaml",
    workspace_pubspec = "//:pubspec.yaml",
    deps = [
        ":services_lib",
        "@pub_mocktail//:mocktail",
    ],
)

SERVICE_TESTS = glob(["*_test.dart"])

[
    flutter_test(
        name = file.replace(".dart", ""),
        srcs = [file],
        embed = [":services_for_tests"],
        tags = ["no-remote", "no-remote-exec"],
        test_files = [file],
        workspace_pubspec = "//:pubspec.yaml",
    )
    for file in SERVICE_TESTS
]

test_suite(
    name = "all_tests",
    tags = ["manual"],
    tests = [":" + file.replace(".dart", "") for file in SERVICE_TESTS],
)

flutter_test(
    name = "coverage_test",
    srcs = SERVICE_TESTS,
    coverage = True,
    coverage_min = 90,
    embed = [":services_lib"],
    tags = ["manual", "no-remote", "no-remote-exec"],
    test_files = ["."],
    workspace_pubspec = "//:pubspec.yaml",
)
