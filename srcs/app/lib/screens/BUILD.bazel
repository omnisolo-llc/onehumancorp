load("@rules_flutter//flutter:defs.bzl", "flutter_library", "flutter_test")

package(default_visibility = ["//srcs/app:__subpackages__"])

filegroup(
    name = "srcs",
    srcs = glob(["**/*.dart"], allow_empty = True) + ["BUILD.bazel"],
    visibility = ["//srcs/app:__pkg__"],
)

filegroup(
    name = "dart_srcs",
    srcs = glob(
        ["**/*.dart"],
        exclude = ["**/*_test.dart"],
        allow_empty = True,
    ),
    visibility = ["//srcs/app:__pkg__"],
)

# Base dependencies for most screens
SCREEN_DEPS = [
    "//srcs/app/lib/models:models_lib",
    "//srcs/app/lib/services:services_lib",
    "//srcs/app/lib/widgets:widgets_lib",
    "@flutter_sdk//flutter/packages/flutter",
    "@pub_flutter_riverpod//:flutter_riverpod",
    "@pub_go_router//:go_router",
    "@pub_intl//:intl",
]

[
    flutter_library(
        name = file.replace(".dart", ""),
        srcs = [file],
        pubspec = "//srcs/app:pubspec.yaml",
        workspace_pubspec = "//:pubspec.yaml",
        deps = SCREEN_DEPS,
    )
    for file in glob(
        ["*.dart"],
        exclude = ["*_test.dart"],
    )
]

flutter_library(
    name = "screens_lib",
    srcs = [],
    pubspec = "//srcs/app:pubspec.yaml",
    workspace_pubspec = "//:pubspec.yaml",
    deps = [":" + file.replace(".dart", "") for file in glob(
        ["*.dart"],
        exclude = ["*_test.dart"],
    )],
)

# ── Test-only aggregate library ───────────────────────────────────────────────
# screens_lib + mocktail for tests that need mock support but not the full router.

flutter_library(
    name = "screens_for_tests",
    srcs = [],
    pubspec = "//srcs/app:pubspec.yaml",
    workspace_pubspec = "//:pubspec.yaml",
    deps = [
        ":screens_lib",
        "@pub_mocktail//:mocktail",
    ],
)

# Per-test embed configuration: each test uses the smallest sufficient library.
#   advanced_widget_test  — needs router.dart (AppShell) → use app_for_tests
#   wizard_screen_test    — only needs one screen, no mocktail → use wizard_screen
#   all others            — need screens + mocktail → use screens_for_tests
_SCREEN_TEST_EMBEDS = {
    "advanced_widget_test.dart": ["//srcs/app:app_for_tests"],
    "wizard_screen_test.dart": [":wizard_screen"],
}

_DEFAULT_SCREEN_TEST_EMBED = [":screens_for_tests"]

SCREEN_TESTS = glob(["**/*_test.dart"])

[
    flutter_test(
        name = file.replace(".dart", "").replace("/", "_"),
        srcs = [file],
        embed = _SCREEN_TEST_EMBEDS.get(file, _DEFAULT_SCREEN_TEST_EMBED),
        test_files = [file],
        workspace_pubspec = "//:pubspec.yaml",
    )
    for file in SCREEN_TESTS
]

test_suite(
    name = "all_tests",
    tests = [":" + file.replace(".dart", "").replace("/", "_") for file in SCREEN_TESTS],
    tags = ["manual"],
)

flutter_test(
    name = "coverage_test",
    srcs = SCREEN_TESTS,
    embed = [":screens_lib"],
    test_files = ["."],
    coverage = True,
    coverage_min = 90,
    tags = ["manual"],
    workspace_pubspec = "//:pubspec.yaml",
)
