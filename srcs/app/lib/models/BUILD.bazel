load("@rules_flutter//flutter:defs.bzl", "flutter_library", "flutter_test")

package(default_visibility = ["//srcs/app:__subpackages__"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["*.dart"],
        allow_empty = True,
    ) + ["BUILD.bazel"],
    visibility = ["//srcs/app:__pkg__"],
)

filegroup(
    name = "dart_srcs",
    srcs = glob(
        ["*.dart"],
        allow_empty = True,
        exclude = ["*_test.dart"],
    ),
    visibility = ["//srcs/app:__pkg__"],
)

# All model sources in ONE library → single pub-prepare action.
flutter_library(
    name = "models_lib",
    srcs = glob(
        ["*.dart"],
        exclude = ["*_test.dart"],
    ),
    data = ["//srcs/app:app_assets"],
    pubspec = "//srcs/app:pubspec.yaml",
    workspace_pubspec = "//:pubspec.yaml",
)

MODEL_TEST_DEPS = [
    ":models_lib",
    "@flutter_sdk//flutter/packages/flutter",
    "@flutter_sdk//flutter/packages/flutter_test",
    "@pub_async//:async",
    "@pub_boolean_selector//:boolean_selector",
    "@pub_characters//:characters",
    "@pub_clock//:clock",
    "@pub_collection//:collection",
    "@pub_fake_async//:fake_async",
    "@pub_leak_tracker//:leak_tracker",
    "@pub_leak_tracker_flutter_testing//:leak_tracker_flutter_testing",
    "@pub_leak_tracker_testing//:leak_tracker_testing",
    "@pub_matcher//:matcher",
    "@pub_material_color_utilities//:material_color_utilities",
    "@pub_meta//:meta",
    "@pub_path//:path",
    "@pub_source_span//:source_span",
    "@pub_stack_trace//:stack_trace",
    "@pub_stream_channel//:stream_channel",
    "@pub_string_scanner//:string_scanner",
    "@pub_term_glyph//:term_glyph",
    "@pub_test_api//:test_api",
    "@pub_vector_math//:vector_math",
    "@pub_vm_service//:vm_service",
]

flutter_library(
    name = "models_for_tests",
    srcs = [],
    pubspec = "//srcs/app:pubspec.yaml",
    workspace_pubspec = "//:pubspec.yaml",
    deps = MODEL_TEST_DEPS,
)

# Keep individual model names as aliases for any existing embed references.
alias(
    name = "agent_model",
    actual = ":models_lib",
)

alias(
    name = "ai_provider_model",
    actual = ":models_lib",
)

alias(
    name = "channel_model",
    actual = ":models_lib",
)

alias(
    name = "dashboard_model",
    actual = ":models_lib",
)

alias(
    name = "handoff_model",
    actual = ":models_lib",
)

alias(
    name = "pipeline_model",
    actual = ":models_lib",
)

alias(
    name = "security_issue_model",
    actual = ":models_lib",
)

alias(
    name = "settings_model",
    actual = ":models_lib",
)

alias(
    name = "skill_model",
    actual = ":models_lib",
)

alias(
    name = "user_model",
    actual = ":models_lib",
)

MODEL_TESTS = glob(["*_test.dart"])

[
    flutter_test(
        name = file.replace(".dart", ""),
        srcs = [file],
        embed = [":models_for_tests"],
        test_files = [file],
    )
    for file in MODEL_TESTS
]

test_suite(
    name = "all_tests",
    tags = ["manual"],
    tests = [":" + file.replace(".dart", "") for file in MODEL_TESTS],
)

flutter_test(
    name = "coverage_test",
    srcs = MODEL_TESTS,
    coverage = True,
    coverage_min = 90,
    embed = [":models_for_tests"],
    tags = ["manual"],
    test_files = ["."],
)
