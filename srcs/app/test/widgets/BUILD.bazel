load("@rules_flutter//flutter:defs.bzl", "flutter_test")

package(default_visibility = ["//srcs/app:__subpackages__"])

WIDGET_TESTS = glob(["*_test.dart"])

[
    flutter_test(
        name = file.replace(".dart", ""),
        srcs = [file],
        embed = ["//srcs/app:app_for_tests"],
        test_files = [file],
        workspace_pubspec = "//:pubspec.yaml",
    )
    for file in WIDGET_TESTS
]
