load("@rules_flutter//flutter:defs.bzl", "flutter_app", "flutter_library", "flutter_test")
load("@rules_pkg//pkg:deb.bzl", "pkg_deb")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "pkg_mklink")
load("@rules_pkg//pkg:rpm.bzl", "pkg_rpm")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

APP_PACKAGE_NAME = "ohc-desktop"

APP_PACKAGE_VERSION = "0.3.9"

exports_files([
    "pubspec.yaml",
    "pub_deps.json",
    "standalone_linux_launcher.sh",
    "test/linux_package_structure_test.sh",
    "test/standalone_e2e_test.sh",
])

# ── App assets (logo, images, etc.) ──────────────────────────────────────────
# Exposed as a data dependency so flutter_library targets that reference this
# app's pubspec.yaml (and therefore its declared assets) can include the asset
# files in their prepared test workspace.

filegroup(
    name = "app_assets",
    srcs = glob(["assets/**"]),
    visibility = ["//srcs/app:__subpackages__"],
)

# ── Source filegroup (non-flutter uses, e.g. layout checks) ──────────────────

filegroup(
    name = "srcs",
    srcs = glob(
        [
            "assets/**",
            "android/**",
            "BUILD.bazel",
            "e2e/**",
            "ios/**",
            "lib/*.dart",
            "linux/**",
            "macos/**",
            "test/**",
            "web/**",
            "windows/**",
            "pubspec.yaml",
            "pubspec.lock",
            "pub_deps.json",
            "standalone_linux_launcher.sh",
        ],
        allow_empty = True,
    ) + [
        "//srcs/app/lib/models:srcs",
        "//srcs/app/lib/screens:srcs",
        "//srcs/app/lib/services:srcs",
        "//srcs/app/lib/widgets:srcs",
    ],
    visibility = ["//visibility:public"],
)

# ── Flutter Libraries ─────────────────────────────────────────────────────────

flutter_library(
    name = "router_lib",
    srcs = ["lib/router.dart"],
    pubspec = "pubspec.yaml",
    workspace_pubspec = "//:pubspec.yaml",
    deps = [
        "//srcs/app/lib/models:models_lib",
        "//srcs/app/lib/screens:screens_lib",
        "//srcs/app/lib/services:auth_service",
        "@pub_go_router//:go_router",
    ],
)

flutter_library(
    name = "main_lib",
    srcs = ["lib/main.dart"],
    pubspec = "pubspec.yaml",
    workspace_pubspec = "//:pubspec.yaml",
    deps = [
        ":router_lib",
        "//srcs/app/lib/services:services_lib",
        "//srcs/app/lib/widgets:widgets_lib",
        "@flutter_sdk//flutter/packages/flutter",
        "@pub_flutter_riverpod//:flutter_riverpod",
    ],
)

# Aggregate target for embedding and testing
flutter_library(
    name = "app_lib",
    srcs = ["lib/main.dart"],
    pubspec = "pubspec.yaml",
    visibility = ["//srcs/app:__subpackages__"],
    workspace_pubspec = "//:pubspec.yaml",
    deps = [
        ":main_lib",
        ":router_lib",
        "//srcs/app/lib/models:models_lib",
        "//srcs/app/lib/services:services_lib",
        "//srcs/app/lib/screens:screens_lib",
        "//srcs/app/lib/widgets:widgets_lib",
        # SDK and third-party deps
        "@flutter_sdk//flutter/packages/flutter",
        "@pub_go_router//:go_router",
        "@pub_flutter_riverpod//:flutter_riverpod",
        "@pub_http//:http",
        "@pub_intl//:intl",
        "@pub_uuid//:uuid",
        "@pub_shared_preferences//:shared_preferences",
        "@pub_web_socket_channel//:web_socket_channel",
        "@pub_centrifuge//:centrifuge",
        "@pub_mocktail//:mocktail",
        "@pub_cupertino_icons//:cupertino_icons",
        "@pub_flutter_lints//:flutter_lints",
    ],
)

# ── Test-only aggregate library ───────────────────────────────────────────────
# Provides router.dart (AppShell) + test-only deps (mocktail) for screen tests
# that need router-level access.  Intentionally excludes main_lib to keep the
# build graph smaller and maximise cache hit rate for those tests.

flutter_library(
    name = "app_for_tests",
    srcs = [],
    pubspec = "pubspec.yaml",
    visibility = ["//srcs/app:__subpackages__"],
    workspace_pubspec = "//:pubspec.yaml",
    deps = [
        ":router_lib",
        "@pub_mocktail//:mocktail",
    ],
)

# ── Flutter Tests ─────────────────────────────────────────────────────────────

# (Individual tests are now in lib/*/BUILD.bazel)

test_suite(
    name = "flutter_unit_tests",
    tags = ["manual"],
    tests = [
        "//srcs/app/lib/models:all_tests",
        "//srcs/app/lib/screens:all_tests",
        "//srcs/app/lib/services:all_tests",
    ],
)

test_suite(
    name = "flutter_coverage_tests",
    tags = ["manual"],
    tests = [
        "//srcs/app/lib/models:coverage_test",
        "//srcs/app/lib/screens:coverage_test",
        "//srcs/app/lib/services:coverage_test",
    ],
)

# ── Layout / structure test (no Flutter required) ─────────────────────────────
# Verifies all expected source files are present in the app tree.
# Always runs; no Flutter SDK needed.

sh_test(
    name = "app_layout_test",
    srcs = ["test/flutter_layout_test.sh"],
    data = [":srcs"],
)

flutter_test(
    name = "app_desktop_e2e_test",
    srcs = ["test/desktop_e2e_test.dart"],
    embed = [":app_lib"],
    tags = ["manual"],
    test_files = ["test/desktop_e2e_test.dart"],
    workspace_pubspec = "//:pubspec.yaml",
)

# ── Flutter web app build ─────────────────────────────────────────────────────
# Builds the Flutter app for the web platform.  The resulting artifacts are used
# by the Playwright e2e test target below.

flutter_app(
    name = "app",
    srcs = ["lib/main.dart"],
    apk = glob(
        ["android/**"],
        allow_empty = True,
    ),
    aab = glob(
        ["android/**"],
        allow_empty = True,
    ),
    embed = [":app_lib"],
    ios = glob(
        ["ios/**"],
        allow_empty = True,
    ),
    linux = glob(
        ["linux/**"],
        allow_empty = True,
    ),
    macos = glob(
        ["macos/**"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
    web = glob(
        ["web/**"],
        allow_empty = True,
    ),
    windows = glob(
        ["windows/**"],
        allow_empty = True,
    ),
    workspace_pubspec = "//:pubspec.yaml",
)

flutter_app(
    name = "standalone_app",
    srcs = ["lib/main.dart"],
    build_args = ["--dart-define=OHC_STANDALONE=true"],
    embed = [":app_lib"],
    linux = glob(
        ["linux/**"],
        allow_empty = True,
    ),
    workspace_pubspec = "//:pubspec.yaml",
)

# ── Web E2E tests (Playwright) ────────────────────────────────────────────────
# Serves the built Flutter web app and runs Playwright tests against it in a
# real Chromium browser.  Depends on the web build artifacts from :app_web.

sh_test(
    name = "app_web_e2e_test",
    srcs = ["test/flutter_web_e2e_test.sh"],
    data = [
        "e2e/playwright.config.ts",
        "e2e/web.spec.ts",
        ":app",
        "//:node_modules/@playwright/test",
        "//srcs/server:ohc",
    ],
    tags = [
        "manual",
        "requires-network",
    ],  # browser download may need network on first run
)

# ── Local Development targets ─────────────────────────────────────────────────

sh_binary(
    name = "start",
    srcs = ["test/start_web.sh"],
    data = [":app"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "capture_screenshots",
    srcs = ["test/capture_screenshots.sh"],
    data = [
        "e2e/capture_screenshots.mjs",
        ":app",
        "//:node_modules/@playwright/test",
    ],
    visibility = ["//visibility:public"],
)

pkg_files(
    name = "linux_runtime_bundle",
    srcs = [":standalone_app.linux"],
    prefix = "opt/ohc-desktop",
)

pkg_files(
    name = "linux_runtime_binaries",
    srcs = [
        "standalone_linux_launcher.sh",
        "//srcs/server:ohc",
        "//srcs/server:standalone_ohc_exec",
    ],
    attributes = pkg_attributes(mode = "0755"),
    renames = {
        "//srcs/server:ohc": "opt/ohc-desktop/libexec/ohc-server",
        "//srcs/server:standalone_ohc_exec": "opt/ohc-desktop/libexec/ohc",
        "//srcs/app:standalone_linux_launcher.sh": "opt/ohc-desktop/libexec/ohc-desktop",
    },
)

pkg_mklink(
    name = "linux_runtime_ohc_link",
    link_name = "usr/bin/ohc",
    target = "/opt/ohc-desktop/libexec/ohc",
)

pkg_mklink(
    name = "linux_runtime_launcher_link",
    link_name = "usr/bin/ohc-desktop",
    target = "/opt/ohc-desktop/libexec/ohc-desktop",
)

pkg_filegroup(
    name = "linux_runtime_payload",
    srcs = [
        ":linux_runtime_bundle",
        ":linux_runtime_binaries",
        ":linux_runtime_launcher_link",
        ":linux_runtime_ohc_link",
    ],
)

pkg_tar(
    name = "app_runtime_tar",
    srcs = [":linux_runtime_payload"],
    visibility = ["//visibility:public"],
)

pkg_deb(
    name = "app_deb",
    architecture = "amd64",
    data = ":app_runtime_tar",
    description = "OHC standalone desktop runtime package with a self-contained Linux bundle and backend helpers.",
    maintainer = "One Human Corp",
    package = APP_PACKAGE_NAME,
    version = APP_PACKAGE_VERSION,
    visibility = ["//visibility:public"],
)

pkg_rpm(
    name = "app_rpm",
    package_name = APP_PACKAGE_NAME,
    srcs = [":linux_runtime_payload"],
    architecture = "x86_64",
    description = "OHC standalone desktop runtime package with a self-contained Linux bundle and backend helpers.",
    license = "Apache-2.0",
    release = "1",
    summary = "OHC standalone desktop runtime",
    tags = ["manual"],
    version = APP_PACKAGE_VERSION,
    visibility = ["//visibility:public"],
)
