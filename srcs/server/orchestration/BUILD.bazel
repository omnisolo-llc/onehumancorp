load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "orchestration",
    srcs = [
        "mesh.go",
        "tasks_db.go",
        "sip.go",
    ],
    importpath = "onehumancorp/srcs/server/orchestration",
    visibility = ["//visibility:public"],
)

go_test(
    name = "orchestration_test",
    srcs = [
        "mesh_test.go",
        "tasks_db_test.go",
        "sip_test.go",
    ],
    embed = [":orchestration"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@com_github_mattn_go_sqlite3//:go_sqlite3",
    ],
)
