load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "harness",
    srcs = [
        "macos_sandbox.go",
        "assistant_sandbox.go",
        "bwrap_sandbox.go",
    ],
    importpath = "onehumancorp/srcs/server/orchestration/harness",
    visibility = ["//visibility:public"],
    deps = [
        "//srcs/server/telemetry",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

go_test(
    name = "harness_test",
    srcs = [
        "macos_sandbox_test.go",
        "assistant_sandbox_test.go",
        "bwrap_sandbox_test.go",
    ],
    embed = [":harness"],
)
