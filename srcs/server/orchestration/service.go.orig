	defer h.mu.Unlock()
	h.storage = provider
}

// SIPDB returns the configured database-driven Swarm Intelligence Protocol interface.
func (h *Hub) SIPDB() *SIPDB {
	h.mu.RLock()
	defer h.mu.RUnlock()
