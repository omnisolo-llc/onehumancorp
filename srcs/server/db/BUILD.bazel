load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "db",
    srcs = ["provider.go"],
    embedsrcs = [
        "migrations/001_users.sql",
        "migrations/002_billing.sql",
        "migrations/003_scheduler.sql",
        "migrations/004_hub.sql",
        "migrations/005_sip.sql",
