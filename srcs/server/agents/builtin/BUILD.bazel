load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# Test target: delegates to `cargo test` so that
# `bazelisk test //...` exercises the Rust crate alongside the Go tests.
# The test runs locally (no sandbox) so the cargo toolchain and the
# workspace's target/ directory are accessible.
sh_test(
    name = "cargo_test",
    size = "large",
    srcs = ["cargo_test.sh"],
    tags = [
        # Run locally without Bazel sandboxing so cargo can access its
        # toolchain, registry cache, and write to target/.
        "local",
        "no-sandbox",
    ],
)
