load("@rules_go//go:def.bzl", "go_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

# ── Go LLM client library ──────────────────────────────────────────────────────
# Provides the LLMClient interface, Tool type, and concrete LLM client
# implementations (Anthropic, OpenAI, Ollama) used by autodream_pipeline,
# mcp/client_manager, and mcp_config_sync.
go_library(
    name = "builtin",
    srcs = [
        "llm_anthropic.go",
        "llm_ollama.go",
        "llm_openai.go",
        "tools.go",
        "types.go",
    ],
    importpath = "github.com/onehumancorp/mono/srcs/server/agents/builtin",
    visibility = ["//visibility:public"],
    deps = [
        "//srcs/server/telemetry",
        "//srcs/server/utils",
    ],
)

# Rust sources include pre-generated proto code in src/gen/.
# No protoc dependency needed in the Bazel build.
RUST_DEPS = [
    "@crates//:base64",
    "@crates//:chrono",
    "@crates//:flate2",
    "@crates//:futures",
    "@crates//:glob",
    "@crates//:hex",
    "@crates//:hmac",
    "@crates//:once_cell",
    "@crates//:prost",
    "@crates//:rand",
    "@crates//:regex",
    "@crates//:reqwest",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:sha2",
    "@crates//:tokio",
    "@crates//:tokio-stream",
    "@crates//:tonic",
    "@crates//:tracing",
    "@crates//:tracing-subscriber",
    "@crates//:urlencoding",
    "@crates//:uuid",
]

# Proc-macro crates must be in proc_macro_deps, not deps.
RUST_PROC_MACRO_DEPS = [
    "@crates//:async-recursion",
    "@crates//:async-trait",
]

# Main agent library.
rust_library(
    name = "ohc_builtin_agent_lib",
    srcs = [
        "src/agent.rs",
        "src/lib.rs",
        "src/service.rs",
    ],
    crate_name = "ohc_builtin_agent",
    edition = "2024",
    proc_macro_deps = RUST_PROC_MACRO_DEPS,
    visibility = ["//visibility:public"],
    deps = [
        "//srcs/server/agents/builtin/src:core",
        "//srcs/server/agents/builtin/src/gen:proto",
        "//srcs/server/agents/builtin/src/llm",
        "//srcs/server/agents/builtin/src/tools",
    ] + RUST_DEPS,
)

rust_binary(
    name = "ohc-builtin-agent",
    srcs = ["src/main.rs"],
    edition = "2024",
    proc_macro_deps = RUST_PROC_MACRO_DEPS,
    visibility = ["//visibility:public"],
    deps = [
        ":ohc_builtin_agent_lib",
        "//srcs/server/agents/builtin/src:core",
    ] + RUST_DEPS,
)

rust_test(
    name = "unit_tests",
    crate = ":ohc_builtin_agent_lib",
    edition = "2024",
)
