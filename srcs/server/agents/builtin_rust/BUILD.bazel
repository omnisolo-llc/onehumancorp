load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

# Rust sources include pre-generated proto code in src/gen/.
# No protoc dependency needed in the Bazel build.
RUST_SRCS = glob(["src/**/*.rs"])

RUST_DEPS = [
    "@crates//:base64",
    "@crates//:chrono",
    "@crates//:flate2",
    "@crates//:futures",
    "@crates//:glob",
    "@crates//:hex",
    "@crates//:hmac",
    "@crates//:once_cell",
    "@crates//:prost",
    "@crates//:rand",
    "@crates//:regex",
    "@crates//:reqwest",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:sha2",
    "@crates//:tokio",
    "@crates//:tokio-stream",
    "@crates//:tonic",
    "@crates//:tracing",
    "@crates//:tracing-subscriber",
    "@crates//:urlencoding",
    "@crates//:uuid",
]

# Proc-macro crates must be in proc_macro_deps, not deps.
RUST_PROC_MACRO_DEPS = [
    "@crates//:async-recursion",
    "@crates//:async-trait",
]

rust_library(
    name = "ohc_builtin_agent_lib",
    srcs = RUST_SRCS,
    crate_name = "ohc_builtin_agent",
    edition = "2021",
    deps = RUST_DEPS,
    proc_macro_deps = RUST_PROC_MACRO_DEPS,
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "ohc-builtin-agent",
    srcs = ["src/main.rs"],
    edition = "2021",
    deps = [":ohc_builtin_agent_lib"] + RUST_DEPS,
    proc_macro_deps = RUST_PROC_MACRO_DEPS,
    visibility = ["//visibility:public"],
)

rust_test(
    name = "unit_tests",
    crate = ":ohc_builtin_agent_lib",
    edition = "2021",
)
