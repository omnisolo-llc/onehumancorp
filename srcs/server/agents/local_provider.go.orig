package agents

import (
	"bytes"
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"github.com/onehumancorp/mono/srcs/server/orchestration"
	"io"
	"net"
	"net/http"
	"os"
)

// LocalLLMProvider implements orchestration.MinimaxClient but uses a local endpoint.
type LocalLLMProvider struct {
	endpoint      string
	embedEndpoint string
	model         string
}

func NewLocalLLMProvider() *LocalLLMProvider {
	endpoint := os.Getenv("OHC_LOCAL_LLM_ENDPOINT")
	if endpoint == "" {
		endpoint = "http://127.0.0.1:11434/api/generate"
	}
	embedEndpoint := os.Getenv("OHC_LOCAL_LLM_EMBED_ENDPOINT")
	if embedEndpoint == "" {
		embedEndpoint = "http://127.0.0.1:11434/api/embeddings"
	}
	model := os.Getenv("OHC_LOCAL_MODEL_NAME")
	if model == "" {
		model = "llama3"
	}
	return &LocalLLMProvider{
		endpoint:      endpoint,
		embedEndpoint: embedEndpoint,
		model:         model,
	}
}

func (l *LocalLLMProvider) Reason(ctx context.Context, prompt string) (string, error) {
	reqBody, _ := json.Marshal(map[string]interface{}{
		"model":  l.model,
		"prompt": prompt,
		"stream": false,
	})

	req, err := http.NewRequestWithContext(ctx, "POST", l.endpoint, bytes.NewBuffer(reqBody))
	if err != nil {
		return "", err
	}
	req.Header.Set("Content-Type", "application/json")

	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return "", err
	}
	defer resp.Body.Close()

	if resp.StatusCode != http.StatusOK {
		respBody, _ := io.ReadAll(resp.Body)
		return "", fmt.Errorf("local LLM error (status %d): %s", resp.StatusCode, string(respBody))
	}

	var result struct {
		Response string `json:"response"`
	}
	if err := json.NewDecoder(resp.Body).Decode(&result); err != nil {
		return "", err
	}

	return result.Response, nil
}

func (l *LocalLLMProvider) GenerateEmbedding(ctx context.Context, text string) ([]float32, error) {
	reqBody, _ := json.Marshal(map[string]interface{}{
		"model":  l.model,
		"prompt": text,
	})

	req, err := http.NewRequestWithContext(ctx, "POST", l.embedEndpoint, bytes.NewBuffer(reqBody))
	if err != nil {
		return nil, err
	}
	req.Header.Set("Content-Type", "application/json")

	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()

	if resp.StatusCode != http.StatusOK {
		respBody, _ := io.ReadAll(resp.Body)
		return nil, fmt.Errorf("local LLM embedding error (status %d): %s", resp.StatusCode, string(respBody))
	}

	var result struct {
		Embedding []float32 `json:"embedding"`
	}
	if err := json.NewDecoder(resp.Body).Decode(&result); err != nil {
		return nil, err
	}

	return result.Embedding, nil
}

// ResilientProvider wraps a primary orchestration.MinimaxClient and falls back to LocalLLMProvider on network errors.
type ResilientProvider struct {
	primary  orchestration.MinimaxClient
	fallback orchestration.MinimaxClient
}

func NewResilientProvider(primary orchestration.MinimaxClient, fallback orchestration.MinimaxClient) *ResilientProvider {
	if fallback == nil {
		fallback = NewLocalLLMProvider()
	}
	return &ResilientProvider{
		primary:  primary,
		fallback: fallback,
	}
}

func isNetworkError(err error) bool {
	if err == nil {
		return false
	}
	var netErr net.Error
	if errors.As(err, &netErr) && netErr.Timeout() {
		return true
	}
	// Also fallback on connection refused
	if errors.Is(err, net.ErrClosed) {
		return true
	}
	if err.Error() == "http: server closed" || err.Error() == "local LLM error (status 503)" {
		return true
	}
	return false
}

func (r *ResilientProvider) Reason(ctx context.Context, prompt string) (string, error) {
	resp, err := r.primary.Reason(ctx, prompt)
	if err != nil && isNetworkError(err) {
		fallbackResp, fallbackErr := r.fallback.Reason(ctx, prompt)
		if fallbackErr != nil {
			return "", fmt.Errorf("primary failed: %v, fallback failed: %v", err, fallbackErr)
		}
		return fallbackResp, nil
	}
	return resp, err
}

func (r *ResilientProvider) GenerateEmbedding(ctx context.Context, text string) ([]float32, error) {
	emb, err := r.primary.GenerateEmbedding(ctx, text)
	if err != nil && isNetworkError(err) {
		fallbackEmb, fallbackErr := r.fallback.GenerateEmbedding(ctx, text)
		if fallbackErr != nil {
			return nil, fmt.Errorf("primary failed: %v, fallback failed: %v", err, fallbackErr)
		}
		return fallbackEmb, nil
	}
	return emb, err
}
