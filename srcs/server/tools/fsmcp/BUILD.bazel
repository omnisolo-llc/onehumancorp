load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "fsmcp",
    srcs = [
        "factory.rs",
        "mod.rs",
        "provider.rs",
        "server.rs",
    ],
    edition = "2024",
    deps = [
        "//src/server/ohc:server_ohc",
        "//src/server/auth:server_auth",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:sqlx",
        "@crates//:serde_json",
        "@crates//:tracing",
        "@crates//:uuid",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "fsmcp_test",
    crate = ":fsmcp",
    srcs = ["tests.rs"],
    edition = "2024",
    deps = [
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)
