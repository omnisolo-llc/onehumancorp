)

go_test(
    name = "sync_test",
    srcs = ["autodream_sync_test.go"],
    embed = [":sync"],
    deps = [
        "//srcs/server/db",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
