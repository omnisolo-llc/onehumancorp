load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = ["server.go"],
    importpath = "github.com/onehumancorp/mono/srcs/server/frontend/server",
    visibility = ["//visibility:public"],
)

go_test(
    name = "server_test",
    srcs = ["server_test.go"],
    embed = [":server"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**/*.go"]),
    visibility = ["//visibility:public"],
)
