load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "mesh",
    srcs = [
        "memory_pubsub.go",
        "publish.go",
        "pubsub.go",
        "redis_pubsub.go",
        "ws.go",
    ],
    importpath = "github.com/onehumancorp/mono/srcs/server/api/mesh",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_redis_go_redis_v9//:go-redis",
        "@com_github_gorilla_websocket//:websocket",
    ],
)

go_test(
    name = "mesh_test",
    srcs = ["pubsub_test.go"],
    embed = [":mesh"],
    deps = [
        "@com_github_redis_go_redis_v9//:go-redis",
        "@com_github_stretchr_testify//assert",
    ],
)
