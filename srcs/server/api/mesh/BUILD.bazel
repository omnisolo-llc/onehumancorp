go_test(
    name = "mesh_test",
    srcs = [
        "pubsub_test.go",
        "publish_test.go",
        "ws_test.go",
    ],
    embed = [":mesh"],
    deps = [
        "//srcs/server/auth",
        "@com_github_gorilla_websocket//:websocket",
    ],
)
