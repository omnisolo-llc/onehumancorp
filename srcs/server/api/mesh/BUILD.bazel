load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "mesh",
    srcs = [
        "pubsub.go",
        "pubsub_memory.go",
        "pubsub_redis.go",
        "publish.go",
        "ws.go",
    ],
    importpath = "github.com/onehumancorp/mono/srcs/server/api/mesh",
