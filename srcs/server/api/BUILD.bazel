        "teammate_mesh_test.go",
    ],
    embed = [":api"],
    deps = [
        "//srcs/server/api/proto",
        "//srcs/server/orchestration",
        "//srcs/server/orchestration/hybrid_sync",
        "@com_github_alicebob_miniredis_v2//:miniredis",
        "@com_github_redis_go_redis_v9//:go-redis",
