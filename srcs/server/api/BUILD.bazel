load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "api",
    srcs = [
        "sync_escalation_handler.go",
        "sync_handler.go",
        "teammate_mesh.go",
    ],
    importpath = "github.com/onehumancorp/mono/srcs/server/api",
    visibility = ["//visibility:public"],
    deps = [
        "//srcs/server/api/proto",
        "//srcs/server/orchestration",
        "//srcs/server/orchestration/hybrid_sync",
        "//srcs/server/orchestration/queue",
