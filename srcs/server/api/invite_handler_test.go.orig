package api

import (
	"bytes"
	"context"
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"testing"

	"github.com/onehumancorp/mono/srcs/server/domain"
)

func TestHandleCreateInvite(t *testing.T) {
	svc := domain.NewInviteService()
	handler := NewInviteHandler(svc)

	// Test GET method not allowed
	req := httptest.NewRequest(http.MethodGet, "/api/invites", nil)
	rr := httptest.NewRecorder()
	handler.HandleCreateInvite(rr, req)
	if rr.Code != http.StatusMethodNotAllowed {
		t.Fatalf("expected status 405, got %d", rr.Code)
	}

	// Test invalid JSON
	req = httptest.NewRequest(http.MethodPost, "/api/invites", bytes.NewBuffer([]byte("{invalid-json")))
	rr = httptest.NewRecorder()
	handler.HandleCreateInvite(rr, req)
	if rr.Code != http.StatusBadRequest {
		t.Fatalf("expected status 400 for invalid JSON, got %d", rr.Code)
	}

	// Test validation error
	reqBody := createInviteRequest{InviterID: "user1", InviteeID: ""}
	b, _ := json.Marshal(reqBody)
	req = httptest.NewRequest(http.MethodPost, "/api/invites", bytes.NewBuffer(b))
	rr = httptest.NewRecorder()
	handler.HandleCreateInvite(rr, req)
	if rr.Code != http.StatusBadRequest {
		t.Fatalf("expected status 400 for validation error, got %d", rr.Code)
	}

	// Test success
	reqBody = createInviteRequest{InviterID: "user1", InviteeID: "user2"}
	b, _ = json.Marshal(reqBody)
	req = httptest.NewRequest(http.MethodPost, "/api/invites", bytes.NewBuffer(b))
	rr = httptest.NewRecorder()
	handler.HandleCreateInvite(rr, req)
	if rr.Code != http.StatusCreated {
		t.Fatalf("expected status 201, got %d", rr.Code)
	}
	var invite domain.TeamInvite
	if err := json.NewDecoder(rr.Body).Decode(&invite); err != nil {
		t.Fatalf("failed to decode response: %v", err)
	}
	if invite.Status != "PENDING" {
		t.Fatalf("expected status PENDING, got %s", invite.Status)
	}
}

func TestHandleAcceptInvite(t *testing.T) {
	svc := domain.NewInviteService()
	handler := NewInviteHandler(svc)

	// Create an invite to accept
	inv, _ := svc.CreateInvite(context.Background(), "user1", "user2")

	// Test GET method not allowed
	req := httptest.NewRequest(http.MethodGet, "/api/invites/"+inv.ID+"/accept", nil)
	rr := httptest.NewRecorder()
	handler.HandleAcceptInvite(rr, req)
	if rr.Code != http.StatusMethodNotAllowed {
		t.Fatalf("expected status 405, got %d", rr.Code)
	}

	// Test invalid path length
	req = httptest.NewRequest(http.MethodPost, "/api/invites/abc", nil)
	rr = httptest.NewRecorder()
	handler.HandleAcceptInvite(rr, req)
	if rr.Code != http.StatusBadRequest {
		t.Fatalf("expected status 400 for invalid path length, got %d", rr.Code)
	}

	// Test empty id
	req = httptest.NewRequest(http.MethodPost, "/api/invites//accept", nil)
	rr = httptest.NewRecorder()
	handler.HandleAcceptInvite(rr, req)
	if rr.Code != http.StatusBadRequest {
		t.Fatalf("expected status 400 for empty id, got %d", rr.Code)
	}

	// Test non-existent invite
	req = httptest.NewRequest(http.MethodPost, "/api/invites/nonexistent/accept", nil)
	rr = httptest.NewRecorder()
	handler.HandleAcceptInvite(rr, req)
	if rr.Code != http.StatusBadRequest {
		t.Fatalf("expected status 400 for non-existent invite, got %d", rr.Code)
	}

	// Test success
	req = httptest.NewRequest(http.MethodPost, "/api/invites/"+inv.ID+"/accept", nil)
	rr = httptest.NewRecorder()
	handler.HandleAcceptInvite(rr, req)
	if rr.Code != http.StatusOK {
		t.Fatalf("expected status 200, got %d", rr.Code)
	}
	var invite domain.TeamInvite
	if err := json.NewDecoder(rr.Body).Decode(&invite); err != nil {
		t.Fatalf("failed to decode response: %v", err)
	}
	if invite.Status != "ACCEPTED" {
		t.Fatalf("expected status ACCEPTED, got %s", invite.Status)
	}
}
