load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "github.com/onehumancorp/mono/srcs/server",
    visibility = ["//visibility:private"],
    deps = [
        "//srcs/server/auth",
        "//srcs/server/billing",
        "//srcs/server/dashboard",
        "//srcs/server/db",
        "//srcs/server/domain",
        "//srcs/server/integrations/chatwoot",
        "//srcs/server/orchestration",
        "//srcs/server/orchestration/hybrid_sync",
        "//srcs/server/pipeline",
        "//srcs/server/scheduler",
        "//srcs/server/settings",
        "//srcs/server/sync",
        "//srcs/server/telemetry",
        "//srcs/server/integrations/mcp_sync",
        "//srcs/server/workers",
        "//srcs/server/workers/distillation",
        "//srcs/server/checkpointer",
        "//srcs/server/memory/autodream",
        "//srcs/server/memory",
        "@org_golang_google_grpc//:grpc",
        "@com_github_redis_rueidis//:rueidis",
    ],
)

go_binary(
    name = "ohc",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)

# To build the standalone desktop distribution (SQLite + embedded NATS only,
# no env-var overrides for storage backend), run:
#
#   bazel build //srcs/server:ohc --@rules_go//go/config:tags=standalone
#
# This activates the build constraints in config_standalone.go which force
# SQLite and standalone mode regardless of DATABASE_URL / REDIS_URL env vars.

genrule(
    name = "standalone_ohc_exec_file",
    srcs = ["standalone_ohc.sh"],
    outs = ["standalone_ohc_exec"],
    cmd = "cp $< $@ && chmod 0755 $@",
    visibility = ["//visibility:public"],
)

sh_test(
    name = "standalone_cleanup_test",
    srcs = ["standalone_cleanup_test.sh"],
    data = ["standalone_ohc.sh"],
)

# Added repository to deps if needed. It usually should be, let's keep it simple.
