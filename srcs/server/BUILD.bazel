load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "onehumancorp/srcs/server",
    visibility = ["//visibility:private"],
    deps = [
        "//srcs/server/builder",
        "//srcs/server/db",
        "//srcs/server/growth",
        "//srcs/server/memory",
        "//srcs/server/onboarding",
        "//srcs/server/orchestration",
        "@com_github_mattn_go_sqlite3//:go-sqlite3",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)
