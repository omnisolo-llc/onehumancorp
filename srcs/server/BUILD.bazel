load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "github.com/onehumancorp/mono/srcs/server",
    visibility = ["//visibility:private"],
    deps = [
        "//srcs/orchestration",
        "//srcs/server/auth",
        "//srcs/server/billing",
        "//srcs/server/dashboard",
        "//srcs/server/domain",
        "//srcs/server/integrations/chatwoot",
        "//srcs/server/scheduler",
        "//srcs/server/settings",
        "//srcs/server/telemetry",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "ohc",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)
