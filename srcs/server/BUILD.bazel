load("@rules_go//go:def.bzl", "go_binary")

filegroup(
    name = "all_go_files",
    srcs = glob(["**/*.go"]),
    visibility = ["//visibility:public"],
)

go_binary(
    name = "server",
    srcs = ["main.go"],
    visibility = ["//visibility:public"],
    deps = [
        "//srcs/server/memory:memory",
        "//srcs/server/onboarding:onboarding",
        "//srcs/server/tiers:tiers",
        "//srcs/server/orchestration:orchestration",
        "//srcs/server/growth:growth",
        "//srcs/server/telemetry:telemetry",
        "//srcs/server/api/mesh:mesh",
        "//srcs/server/dashboard:dashboard",
        "//srcs/server/services/sync:sync",
        "@io_opentelemetry_go_otel//:otel",
        "@com_github_mutecomm_go_sqlcipher_v4//:go_sqlcipher",
    ],
)
