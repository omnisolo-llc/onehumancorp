load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "github.com/onehumancorp/mono/srcs/server",
    visibility = ["//visibility:private"],
    deps = [
        "//srcs/proto:agent_service_go_proto",
        "//srcs/server/agents/builtinclient",
        "//srcs/server/auth",
        "//srcs/server/billing",
        "//srcs/server/dashboard",
        "//srcs/server/db",
        "//srcs/server/domain",
        "//srcs/server/integrations/chatwoot",
        "//srcs/server/orchestration",
        "//srcs/server/pipeline",
        "//srcs/server/scheduler",
        "//srcs/server/settings",
        "//srcs/server/sync",
        "//srcs/server/telemetry",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_protobuf//proto",
        "@com_github_redis_rueidis//:rueidis",
        "//srcs/server/orchestration/mesh",
        "@com_github_redis_go_redis_v9//:go-redis",
    ],
)

go_binary(
    name = "ohc",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "standalone_ohc_exec_file",
    srcs = ["standalone_ohc.sh"],
    outs = ["standalone_ohc_exec"],
    cmd = "cp $< $@ && chmod 0755 $@",
    visibility = ["//visibility:public"],
)
