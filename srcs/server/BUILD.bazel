load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "github.com/onehumancorp/mono/srcs/server",
    visibility = ["//visibility:private"],
    deps = [
        "//srcs/server/agents",
        "//srcs/server/auth",
        "//srcs/server/billing",
        "//srcs/server/dashboard",
        "//srcs/server/db",
        "//srcs/server/domain",
        "//srcs/server/integrations/chatwoot",
        "//srcs/server/orchestration",
        "//srcs/server/scheduler",
        "//srcs/server/settings",
        "//srcs/server/telemetry",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "ohc",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "standalone_ohc_exec_file",
    srcs = ["standalone_ohc.sh"],
    outs = ["standalone_ohc_exec"],
    cmd = "cp $< $@ && chmod 0755 $@",
    visibility = ["//visibility:public"],
)

# Note: We will probably need to update gazelle or manually add deps,
# but running bazel test might fail first, let's just make sure gazelle is run
