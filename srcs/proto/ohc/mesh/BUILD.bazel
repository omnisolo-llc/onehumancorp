load("@rules_proto//proto:defs.bzl", "proto_library")
load("//bazel/rules:proto_go_grpc_library.bzl", "proto_go_grpc_library", "go_proto_library_with_tags")
load("@rules_go//go:def.bzl", "go_library")

proto_library(
    name = "meshpb_proto",
    srcs = ["mesh.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library_with_tags(
    name = "meshpb_go_proto",
    protos = ["mesh.proto"],
    importpath = "github.com/onehumancorp/mono/srcs/proto/ohc/mesh",
    visibility = ["//visibility:public"],
)

go_library(
    name = "mesh",
    embed = [":meshpb_go_proto"],
    importpath = "github.com/onehumancorp/mono/srcs/proto/ohc/mesh",
    visibility = ["//visibility:public"],
)
