load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:resolve go github.com/onehumancorp/mono/srcs/proto //srcs/proto:hub_go_proto

go_library(
    name = "orchestration",
    srcs = [
        "service.go",
    ],
    importpath = "github.com/onehumancorp/mono/srcs/orchestration",
    visibility = ["//visibility:public"],
    deps = [
        "//srcs/proto:hub_go_proto",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "//srcs/agents",
    ],
)

go_test(
    name = "orchestration_test",
    srcs = [
        "service_test.go",
    ],
    embed = [":orchestration"],
    deps = [
        "//srcs/proto:hub_go_proto",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "//srcs/agents",
    ],
)
