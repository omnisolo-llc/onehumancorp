load("@rules_go//go:def.bzl", "go_test")
load(":playwright_tests.bzl", "define_playwright_tests")

go_test(
    name = "e2e_test",
    srcs = glob(["*_test.go"]),
    importpath = "github.com/onehumancorp/mono/srcs/tests/e2e",
    data = [
        "//srcs/server:ohc",
    ],
    deps = [
        "@com_github_playwright_community_playwright_go//:playwright-go",
    ],
    size = "large",
    timeout = "eternal",
    tags = [
        "local",
        "requires-network",
    ],
)

# Filegroup that exposes all TypeScript e2e sources to Playwright js_test targets.
filegroup(
    name = "srcs",
    srcs = glob([
        "*.ts",
        "*.mjs",
        "*.json",
    ]),
    visibility = ["//visibility:public"],
)

# Define per-category Playwright js_test targets and the combined test_suite.
define_playwright_tests()
